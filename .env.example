# ResQWay Environment Configuration
# Copy this file to .env and configure your credentials

# Default Alert Recipient Email
RESQWAY_ALERT_RECIPIENT_EMAIL=pkfb46@proton.me

# Gmail SMTP Delivery (Required for actual live email delivery to inboxes)
# Note: GMAIL_SMTP_APP_PASSWORD is a 16-character Google App Password (not your normal Gmail password)
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_SMTP_USERNAME=pkfb46@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_16_digit_app_password
