<div class="space-y-8 max-w-7xl mx-auto pb-16">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-slate-200 gap-4">
    <div>
      <div class="flex items-center space-x-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-indigo-100 text-indigo-800 border border-indigo-200">
          Smart Navigation Engine
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Multi-Route Navigation &amp; Recommendation</h2>
      </div>
      <p class="text-xs text-slate-500 mt-1">Multi-criteria road routing, terrain risk evaluation, and turn-by-turn logistics guidance across North East India.</p>
    </div>

    <% if @active_emergencies_count > 0 %>
      <div>
        <%= link_to emergencies_path, class: "inline-flex items-center px-3.5 py-2 bg-red-50 hover:bg-red-100 text-red-700 text-xs font-bold rounded-xl border border-red-200 transition-colors" do %>
          <i class="fas fa-radiation mr-1.5 animate-pulse"></i>
          <span><%= @active_emergencies_count %> Active Emergencies</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Route Configuration Form -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
    <div class="border-b border-slate-100 pb-3 mb-5 flex items-center justify-between">
      <div>
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center">
          <i class="fas fa-route text-indigo-600 mr-2"></i>
          Configure Logistics Mission
        </h3>
        <p class="text-xs text-slate-500 mt-0.5">Select dispatch origin, destination settlement, and vehicle profile to evaluate road routes.</p>
      </div>
    </div>

    <%= form_with url: calculate_routes_path, method: :post, local: true, class: "space-y-5" do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Origin -->
        <div>
          <label for="origin_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block mr-1.5"></span>
            Dispatch Origin
          </label>
          <%= select_tag :origin_id,
                         options_from_collection_for_select(@locations, :id, :name, @origin&.id),
                         prompt: "-- Select Origin Settlement --",
                         required: true,
                         class: "w-full px-3.5 py-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs font-medium text-slate-900 bg-slate-50/50 hover:bg-white transition-colors" %>
        </div>

        <!-- Destination -->
        <div>
          <label for="destination_id" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block mr-1.5"></span>
            Destination
          </label>
          <%= select_tag :destination_id,
                         options_from_collection_for_select(@locations, :id, :name, @destination&.id),
                         prompt: "-- Select Destination Settlement --",
                         required: true,
                         class: "w-full px-3.5 py-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs font-medium text-slate-900 bg-slate-50/50 hover:bg-white transition-colors" %>
        </div>

        <!-- Vehicle Profile -->
        <div>
          <label for="vehicle_type" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center">
            <i class="fas fa-truck-moving text-indigo-600 mr-1.5"></i>
            Vehicle Asset Profile
          </label>
          <%= select_tag :vehicle_type,
                         options_for_select(@vehicle_types, @selected_vehicle),
                         class: "w-full px-3.5 py-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs font-medium text-slate-900 bg-slate-50/50 hover:bg-white transition-colors" %>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <span class="text-[11px] text-slate-400 font-medium">OSRM Highway Routing &bull; ENMA AI Multi-Risk Evaluation</span>
        <%= f.submit "Analyze & Recommend Routes",
                     class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs rounded-xl shadow-md transition-all duration-150 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @results.present? %>
    <!-- Analysis Results Section -->
    <div class="space-y-6"
         data-controller="route-planner-map"
         data-route-planner-map-origin-value="<%= @origin.to_json %>"
         data-route-planner-map-destination-value="<%= @destination.to_json %>"
         data-route-planner-map-routes-value="<%= @results[:routes].to_json %>"
         data-route-planner-map-emergencies-value="<%= @results[:active_emergencies].to_json %>"
         data-route-planner-map-active-route-value="<%= @results[:recommended_route_type] %>">

      <!-- Route Alternatives Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <% @results[:routes].each do |type_key, rdata| %>
          <% is_rec = rdata[:is_recommended] %>
          <div data-route-planner-map-target="routeCard"
               data-action="click->route-planner-map#highlightRoute"
               data-route-type="<%= type_key %>"
               class="p-5 rounded-2xl bg-white border <%= is_rec ? 'border-indigo-500 ring-2 ring-indigo-500/30 shadow-md' : 'border-slate-200 hover:border-slate-300 shadow-sm opacity-80' %> transition-all cursor-pointer flex flex-col justify-between space-y-4">
            
            <!-- Card Top Header -->
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase border <%= rdata[:badge_class] %>">
                <i class="fas <%= rdata[:icon] %> mr-1"></i>
                <%= rdata[:title] %>
              </span>

              <% if is_rec %>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-emerald-100 text-emerald-800 border border-emerald-300 animate-pulse">
                  ⭐ RECOMMENDED
                </span>
              <% end %>
            </div>

            <!-- Distance & ETA Big Metrics -->
            <div class="grid grid-cols-2 gap-2 border-y border-slate-100 py-3 text-center">
              <div>
                <span class="text-[10px] text-slate-400 font-bold uppercase block">Distance</span>
                <span class="text-xl font-black text-slate-900"><%= rdata[:distance_km] %> <span class="text-xs font-normal text-slate-500">km</span></span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 font-bold uppercase block">Est. Time</span>
                <span class="text-xl font-black text-slate-900"><%= rdata[:estimated_time_formatted] %></span>
              </div>
            </div>

            <!-- Risk & Safety Score Bars -->
            <div class="space-y-2 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-slate-600 font-medium">Logistics Risk Score:</span>
                <span class="font-bold <%= rdata[:risk_score] <= 25 ? 'text-emerald-600' : (rdata[:risk_score] <= 50 ? 'text-amber-600' : 'text-rose-600') %>">
                  <%= rdata[:risk_score] %> / 100 (<%= rdata[:risk_level] %>)
                </span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-600 font-medium">Safety Rating:</span>
                <span class="font-bold text-indigo-600"><%= rdata[:scores][:safety] %> / 100</span>
              </div>
            </div>

            <button type="button" class="w-full py-2 bg-slate-50 hover:bg-indigo-50 text-indigo-600 font-bold text-xs rounded-xl border border-slate-200 transition-colors">
              <span>View Route On Map &rarr;</span>
            </button>
          </div>
        <% end %>
      </div>

      <!-- Explainable Recommendation Banner ("Why ENMA AI Recommends This Route") -->
      <% rec = @results[:recommendation] %>
      <div class="p-6 rounded-2xl bg-gradient-to-br from-indigo-950 to-slate-900 text-white shadow-xl border border-indigo-900 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-indigo-800 pb-3">
          <div class="flex items-center space-x-2">
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-emerald-500 text-slate-950 shadow">
              AI Decision Confidence: <%= rec[:confidence_percentage] %>%
            </span>
            <h3 class="text-base font-black text-white">Why ENMA AI Recommends This Route</h3>
          </div>
          <span class="text-xs text-indigo-300 font-mono"><%= rec[:vehicle_context] %></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <!-- Bullet Reasons -->
          <div class="space-y-2">
            <span class="text-[10px] font-black uppercase text-indigo-400 tracking-wider block">Decision Factors</span>
            <ul class="space-y-1.5">
              <% rec[:reasons].each do |reason| %>
                <li class="flex items-start space-x-2 text-slate-200">
                  <i class="fas fa-check-circle text-emerald-400 mt-0.5 flex-shrink-0"></i>
                  <span><%= reason %></span>
                </li>
              <% end %>
            </ul>
          </div>

          <!-- Trade-off Analysis -->
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-2">
            <span class="text-[10px] font-black uppercase text-amber-300 tracking-wider block">Strategic Trade-off Analysis</span>
            <p class="text-slate-300 leading-relaxed"><%= rec[:trade_off] %></p>
          </div>
        </div>
      </div>

      <!-- Main Navigation Map & Interactive HUD -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden relative">
        <!-- Top Map Header -->
        <div class="p-4 border-b border-slate-200 bg-slate-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center space-x-2">
            <i class="fas fa-map-marked-alt text-indigo-600"></i>
            <h4 class="text-xs font-black uppercase text-slate-800 tracking-wider">
              Interactive Highway Corridors: <%= @origin.name %> &rarr; <%= @destination.name %>
            </h4>
          </div>

          <div class="flex items-center space-x-3">
            <button type="button"
                    data-action="click->route-planner-map#startNavigation"
                    class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-xl shadow-md transition-all flex items-center cursor-pointer">
              <i class="fas fa-location-arrow mr-1.5 text-xs"></i>
              <span>Start Navigation Mode</span>
            </button>
          </div>
        </div>

        <!-- Live Navigation HUD Overlay (Hidden until Start Navigation is clicked) -->
        <div data-route-planner-map-target="navHud"
             class="hidden absolute top-4 left-4 right-4 z-30 max-w-xl mx-auto bg-slate-900/95 backdrop-blur-md text-white p-4 rounded-2xl shadow-2xl border border-slate-700 space-y-3">
          
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div class="flex items-center space-x-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              <span class="text-[10px] font-black uppercase text-indigo-300 tracking-wider">Live Navigation HUD</span>
            </div>
            <span data-route-planner-map-target="navStepCounter" class="text-[10px] font-mono text-slate-400">Step 1 of 6</span>
          </div>

          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-600 flex items-center justify-center text-xl shadow-md flex-shrink-0">
              <i data-route-planner-map-target="navManeuverIcon" class="fas fa-arrow-up text-white"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h5 data-route-planner-map-target="navInstruction" class="text-sm font-black text-white truncate">
                Proceed toward corridor
              </h5>
              <div class="flex items-center space-x-3 text-xs text-slate-300 mt-0.5">
                <span>Next turn in <strong data-route-planner-map-target="navDistance" class="text-emerald-400">1.2 km</strong></span>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-slate-800 text-xs">
            <div class="flex items-center space-x-2">
              <button type="button" data-action="click->route-planner-map#prevNavStep" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded-lg text-slate-300">
                <i class="fas fa-chevron-left"></i>
              </button>
              <button type="button" data-action="click->route-planner-map#nextNavStep" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded-lg text-slate-300">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>

            <button type="button" data-action="click->route-planner-map#exitNavigation" class="px-3 py-1 bg-red-900/80 hover:bg-red-800 text-red-200 rounded-lg font-bold">
              Exit Navigation
            </button>
          </div>
        </div>

        <!-- The Leaflet Map Canvas -->
        <div data-route-planner-map-target="container"
             style="height: 600px; min-height: 500px; width: 100%; display: block;"
             class="w-full z-10">
        </div>
      </div>

      <!-- Turn-by-Turn Instruction Drawer & Strategy Comparison Table Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Turn-by-Turn Steps List -->
        <div class="lg:col-span-1 bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-3">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
            <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider flex items-center">
              <i class="fas fa-directions text-indigo-600 mr-2"></i>
              Turn-by-Turn Guidance
            </h4>
            <span class="text-[10px] text-slate-400 font-semibold">Active Track</span>
          </div>

          <div data-route-planner-map-target="turnList" class="max-h-96 overflow-y-auto divide-y divide-slate-100">
            <% current_rec_route = @results[:routes][@results[:recommended_route_type]] %>
            <% if current_rec_route && current_rec_route[:steps].any? %>
              <% current_rec_route[:steps].each do |st| %>
                <div class="py-2.5 flex items-start space-x-2.5 text-xs">
                  <div class="w-5 h-5 rounded-full bg-indigo-50 text-indigo-700 font-bold flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5">
                    <%= st[:step_number] %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-bold text-slate-900"><%= st[:instruction] %></p>
                    <span class="text-[10px] text-slate-500"><%= st[:road_name] %> &bull; <%= st[:distance_km] || (st[:distance_m].to_f / 1000).round(1) %> km</span>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-xs text-slate-500 p-3 text-center">Standard highway corridor route active.</p>
            <% end %>
          </div>
        </div>

        <!-- Strategy Benchmark Table -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="p-5 border-b border-slate-100 bg-slate-50">
            <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider">
              Multi-Criteria Route Strategy Comparison
            </h4>
            <p class="text-xs text-slate-500 mt-0.5">Benchmark comparing transit time, safety index, and accessibility ratings.</p>
          </div>

          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-left text-xs">
              <thead class="bg-slate-50 font-bold text-slate-600 uppercase tracking-wider">
                <tr>
                  <th class="px-5 py-3">Metric Dimension</th>
                  <th class="px-5 py-3 text-blue-600">⚡ Fastest Route</th>
                  <th class="px-5 py-3 text-emerald-600">🛡 Safest Route</th>
                  <th class="px-5 py-3 text-amber-600">⚖ Efficient Route</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white font-medium text-slate-700">
                <% f = @results[:routes][:fastest]; s = @results[:routes][:safest]; e = @results[:routes][:efficient] %>
                <tr>
                  <td class="px-5 py-3 font-bold text-slate-900">Total Distance</td>
                  <td class="px-5 py-3 font-mono font-bold text-blue-600"><%= f[:distance_km] %> km</td>
                  <td class="px-5 py-3 font-mono font-bold text-emerald-600"><%= s[:distance_km] %> km</td>
                  <td class="px-5 py-3 font-mono font-bold text-amber-600"><%= e[:distance_km] %> km</td>
                </tr>
                <tr>
                  <td class="px-5 py-3 font-bold text-slate-900">Estimated Duration</td>
                  <td class="px-5 py-3 font-mono font-bold text-blue-600"><%= f[:estimated_time_formatted] %></td>
                  <td class="px-5 py-3 font-mono font-bold text-emerald-600"><%= s[:estimated_time_formatted] %></td>
                  <td class="px-5 py-3 font-mono font-bold text-amber-600"><%= e[:estimated_time_formatted] %></td>
                </tr>
                <tr>
                  <td class="px-5 py-3 font-bold text-slate-900">Logistics Risk Score</td>
                  <td class="px-5 py-3"><span class="px-2 py-0.5 rounded font-bold bg-blue-50 text-blue-800"><%= f[:risk_score] %> / 100</span></td>
                  <td class="px-5 py-3"><span class="px-2 py-0.5 rounded font-bold bg-emerald-50 text-emerald-800"><%= s[:risk_score] %> / 100</span></td>
                  <td class="px-5 py-3"><span class="px-2 py-0.5 rounded font-bold bg-amber-50 text-amber-800"><%= e[:risk_score] %> / 100</span></td>
                </tr>
                <tr>
                  <td class="px-5 py-3 font-bold text-slate-900">Safety Rating</td>
                  <td class="px-5 py-3 font-bold"><%= f[:scores][:safety] %> / 100</td>
                  <td class="px-5 py-3 font-bold text-emerald-600"><%= s[:scores][:safety] %> / 100</td>
                  <td class="px-5 py-3 font-bold"><%= e[:scores][:safety] %> / 100</td>
                </tr>
                <tr>
                  <td class="px-5 py-3 font-bold text-slate-900">Overall Intelligence Score</td>
                  <td class="px-5 py-3 font-black text-blue-700"><%= f[:scores][:overall_intelligence] %> / 100</td>
                  <td class="px-5 py-3 font-black text-emerald-700"><%= s[:scores][:overall_intelligence] %> / 100</td>
                  <td class="px-5 py-3 font-black text-amber-700"><%= e[:scores][:overall_intelligence] %> / 100</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Recent Route Analysis History Table -->
  <% if @recent_routes.any? %>
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="p-5 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
        <h4 class="text-xs font-black uppercase text-slate-900 tracking-wider flex items-center">
          <i class="fas fa-history text-indigo-600 mr-2"></i>
          Recent Route Analyses &amp; Missions
        </h4>
        <span class="text-[11px] text-slate-500 font-medium">Logged Dispatches</span>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-left text-xs">
          <thead class="bg-slate-50 font-bold text-slate-600 uppercase tracking-wider">
            <tr>
              <th class="px-5 py-3">Origin &rarr; Destination</th>
              <th class="px-5 py-3">Vehicle Profile</th>
              <th class="px-5 py-3">Strategy</th>
              <th class="px-5 py-3">Distance / ETA</th>
              <th class="px-5 py-3">Risk</th>
              <th class="px-5 py-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white font-medium text-slate-700">
            <% @recent_routes.each do |r| %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-5 py-3 font-bold text-slate-900">
                  <%= r.origin&.name %> &rarr; <%= r.destination&.name %>
                </td>
                <td class="px-5 py-3"><%= r.vehicle_type %></td>
                <td class="px-5 py-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= r.recommended ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700' %>">
                    <%= r.route_type.titleize %>
                  </span>
                </td>
                <td class="px-5 py-3 font-mono"><%= r.distance %> km &bull; <%= (r.estimated_time.to_f).round(1) %> hrs</td>
                <td class="px-5 py-3 font-bold <%= r.risk_score.to_f <= 30 ? 'text-emerald-600' : 'text-amber-600' %>"><%= r.risk_score %> / 100</td>
                <td class="px-5 py-3 text-right">
                  <%= link_to routes_path(origin_id: r.origin_id, destination_id: r.destination_id, vehicle_type: r.vehicle_type), class: "text-xs font-bold text-indigo-600 hover:text-indigo-800" do %>
                    <span>Reopen &rarr;</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
