<div class="space-y-6 max-w-7xl mx-auto pb-12 w-full"
     data-controller="route-planner-map"
     <% if @origin && @destination && @results.present? %>
       data-route-planner-map-origin-value="<%= @origin.to_json %>"
       data-route-planner-map-destination-value="<%= @destination.to_json %>"
       data-route-planner-map-routes-value="<%= @results[:routes].to_json %>"
       data-route-planner-map-emergencies-value="<%= @results[:active_emergencies].to_json %>"
       data-route-planner-map-active-route-value="<%= @results[:recommended_route_type] %>"
     <% end %>>

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-2 border-b border-slate-200 dark:border-slate-800 gap-2">
    <div>
      <div class="flex items-center space-x-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-indigo-100 dark:bg-indigo-950 text-indigo-800 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
          Google Maps Navigation
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">Multi-Route Navigation &amp; Recommendation</h2>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Turn-by-turn road routing, hazard bypass intelligence, and GPS navigation across the North East.</p>
    </div>
  </div>

  <!-- Main Google Maps-Style Dual Layout (Flexbox Container) -->
  <div class="flex flex-col lg:flex-row gap-6 items-start w-full">
    
    <!-- LEFT COLUMN: Directions Search, Vehicle Mode, Route Options & Turn-by-Turn (w-full lg:w-[420px] flex-shrink-0) -->
    <div class="w-full lg:w-[420px] flex-shrink-0 space-y-4">
      
      <!-- Directions Input Card -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 space-y-4">
        
        <!-- Transportation Mode Tabs (Scrollable on small mobile) -->
        <div class="flex items-center justify-between bg-slate-100 dark:bg-slate-800/80 p-1 rounded-xl text-xs font-bold overflow-x-auto no-scrollbar space-x-1">
          <% [
            ["Truck", "fa-truck-moving", "Truck"],
            ["Ambulance", "fa-ambulance", "Ambulance"],
            ["Emergency Vehicle", "fa-shield-alt", "Emergency"],
            ["Supply Vehicle", "fa-box-open", "Supply"],
            ["Personal Vehicle", "fa-car", "Personal"]
          ].each do |v_type, v_icon, v_label| %>
            <% active = (@selected_vehicle == v_type) %>
            <button type="button"
                    data-action="click->route-planner-map#selectVehicle"
                    data-vehicle-type="<%= v_type %>"
                    title="<%= v_type %>"
                    class="flex-1 min-w-[58px] py-1.5 px-1 rounded-lg text-center transition-all flex flex-col items-center justify-center space-y-0.5 cursor-pointer <%= active ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/60 dark:hover:bg-slate-700' %>">
              <i class="fas <%= v_icon %> text-xs"></i>
              <span class="text-[9px] font-black leading-tight"><%= v_label %></span>
            </button>
          <% end %>
        </div>

        <!-- Google Maps Style A & B Search Form -->
        <%= form_with url: calculate_routes_path, method: :post, local: true, class: "space-y-3", data: { turbo: false, route_planner_map_target: "searchForm" } do |f| %>
          <input type="hidden" name="origin_lat" data-route-planner-map-target="originLat">
          <input type="hidden" name="origin_lon" data-route-planner-map-target="originLon">

          <div class="flex items-center justify-between">
            <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Vehicle Profile</label>
            <%= select_tag :vehicle_type,
                           options_for_select(@vehicle_types, @selected_vehicle),
                           data: { route_planner_map_target: "vehicleInput" },
                           class: "text-[11px] font-bold text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-2 py-1 focus:ring-1 focus:ring-indigo-500 focus:outline-none" %>
          </div>

          <div class="flex items-center justify-between pt-1">
            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Origin &amp; Destination</span>
            <button type="button"
                    data-action="click->route-planner-map#locateUser"
                    title="Populate origin with browser coordinates"
                    class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 flex items-center space-x-1 cursor-pointer transition-colors">
              <i class="fas fa-crosshairs text-[9px]"></i>
              <span>Use My Current Location</span>
            </button>
          </div>

          <div class="relative flex items-center space-x-3">
            <!-- Left Icon Track Line (Google Maps Style A -> B connector) -->
            <div class="flex flex-col items-center py-2 self-stretch justify-between">
              <div class="w-4 h-4 rounded-full border-2 border-emerald-500 bg-white dark:bg-slate-900 flex items-center justify-center">
                <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
              </div>
              <div class="w-0.5 flex-1 bg-slate-300 dark:bg-slate-700 my-1 border-dashed"></div>
              <div class="w-4 h-4 rounded-full border-2 border-rose-500 bg-white dark:bg-slate-900 flex items-center justify-center">
                <div class="w-1.5 h-1.5 rounded-full bg-rose-500"></div>
              </div>
            </div>

            <!-- Inputs Box -->
            <div class="flex-1 space-y-2">
              <!-- Point A -->
              <div>
                <%= select_tag :origin_id,
                               options_from_collection_for_select(@locations, :id, :name, @origin&.id),
                               prompt: "-- Choose Starting Point (A) --",
                               required: true,
                               data: { route_planner_map_target: "originSelect" },
                               class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100/80 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:bg-white dark:focus:bg-slate-900 focus:outline-none transition-all" %>
              </div>

              <!-- Point B -->
              <div>
                <%= select_tag :destination_id,
                               options_from_collection_for_select(@locations, :id, :name, @destination&.id),
                               prompt: "-- Choose Destination (B) --",
                               required: true,
                               data: { route_planner_map_target: "destinationSelect" },
                               class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100/80 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:bg-white dark:focus:bg-slate-900 focus:outline-none transition-all" %>
              </div>
            </div>

            <!-- Swap Button (⇅) -->
            <div>
              <button type="button"
                      data-action="click->route-planner-map#swapLocations"
                      title="Swap Origin & Destination"
                      class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center text-sm shadow-sm transition-colors cursor-pointer">
                <i class="fas fa-arrows-up-down"></i>
              </button>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <%= f.submit "Get Directions & Compare Routes",
                         class: "w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs rounded-xl shadow-md transition-all cursor-pointer" %>
          </div>
        <% end %>

      </div>

      <!-- Route Cards & Comparison Options (Google Maps Route Alternative Choices) -->
      <% if @results.present? && @results[:routes].present? %>
        <div class="space-y-3">
          <div class="flex items-center justify-between px-1">
            <span class="text-xs font-black uppercase text-slate-600 dark:text-slate-400 tracking-wider">Available Routes</span>
            <div class="flex items-center space-x-1.5 text-[10px] font-mono">
              <% if @results[:corridor_weather].present? && @results[:corridor_weather][:source] == "live" %>
                <span class="px-2 py-0.5 rounded-full uppercase font-black bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 flex items-center">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping mr-1"></span>
                  Live Weather
                </span>
              <% else %>
                <span class="px-2 py-0.5 rounded-full uppercase font-bold bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                  Demo Environmental Data
                </span>
              <% end %>
              <span class="text-slate-400">&bull; <%= @results[:fallback_used] ? "Terrain Corridors" : "Real Road OSRM" %></span>
            </div>
          </div>

          <% @results[:routes].slice(:fastest, :safest, :balanced).each do |type_key, rdata| %>
            <% next if rdata.blank? %>
            <% is_recommended = rdata[:is_recommended] %>
            <div data-route-planner-map-target="routeCard"
                 data-route-type="<%= type_key %>"
                 data-action="click->route-planner-map#selectRoute"
                 class="p-4 rounded-2xl bg-white dark:bg-slate-900 border-2 cursor-pointer transition-all shadow-sm <%= is_recommended ? 'border-indigo-600 bg-indigo-50/20 dark:bg-indigo-950/30 ring-2 ring-indigo-500/20' : 'border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700' %> space-y-3">
              
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase <%= rdata[:badge_class] || rdata[:badge_color] %>">
                    <i class="fas <%= rdata[:icon] || rdata[:badge_icon] %> mr-1"></i>
                    <%= rdata[:type].to_s.upcase %>
                  </span>
                  <span class="text-xs font-bold text-slate-800 dark:text-slate-200"><%= rdata[:title] || rdata[:name] %></span>
                </div>

                <% if is_recommended %>
                  <span class="text-[9px] font-black text-white bg-indigo-600 px-2.5 py-0.5 rounded-full shadow-sm flex items-center">
                    <i class="fas fa-star text-[8px] mr-1"></i>
                    ENMA AI RECOMMENDED
                  </span>
                <% end %>
              </div>

              <!-- Route Telemetry Row -->
              <div class="flex items-baseline justify-between">
                <div class="space-x-1.5">
                  <span class="text-xl font-black text-slate-900 dark:text-white"><%= rdata[:estimated_time_formatted] %></span>
                  <span class="text-xs font-bold text-slate-500 dark:text-slate-400">(<%= rdata[:distance_km] %> km)</span>
                </div>

                <div class="flex items-center space-x-1.5">
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-md <%= rdata[:risk_score] <= 25 ? 'bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300' : (rdata[:risk_score] <= 50 ? 'bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300' : 'bg-rose-50 dark:bg-rose-950 text-rose-700 dark:text-rose-300') %>">
                    Risk: <%= rdata[:risk_score] %>/100
                  </span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300">
                    Score: <%= rdata[:scores][:overall_score] || rdata[:scores][:overall_intelligence] %>/100
                  </span>
                </div>
              </div>

              <!-- Multi-Criteria Score Breakdown Pill Row -->
              <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-100 dark:border-slate-800 text-[10px] font-mono text-center">
                <div class="p-1 rounded bg-slate-50 dark:bg-slate-800/60">
                  <span class="text-slate-400 block text-[8px] uppercase">Safety</span>
                  <strong class="text-emerald-600 dark:text-emerald-400"><%= rdata[:scores][:safety] %>/100</strong>
                </div>
                <div class="p-1 rounded bg-slate-50 dark:bg-slate-800/60">
                  <span class="text-slate-400 block text-[8px] uppercase">Access</span>
                  <strong class="text-indigo-600 dark:text-indigo-400"><%= rdata[:scores][:accessibility] %>/100</strong>
                </div>
                <div class="p-1 rounded bg-slate-50 dark:bg-slate-800/60">
                  <span class="text-slate-400 block text-[8px] uppercase">Efficiency</span>
                  <strong class="text-amber-600 dark:text-amber-400"><%= rdata[:scores][:efficiency] || 85.0 %>/100</strong>
                </div>
              </div>

              <!-- Expandable Intelligence Factors Drawer -->
              <details class="pt-2 border-t border-slate-100 dark:border-slate-800 text-[11px] group">
                <summary class="cursor-pointer font-bold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 flex items-center justify-between">
                  <span class="flex items-center space-x-1.5">
                    <i class="fas fa-microchip text-[10px] text-indigo-500"></i>
                    <span>Why this route?</span>
                  </span>
                  <i class="fas fa-chevron-down text-[9px] group-open:rotate-180 transition-transform"></i>
                </summary>
                
                <div class="mt-2 space-y-1 pl-1 font-mono text-[10px] bg-slate-50 dark:bg-slate-800/40 p-2 rounded-lg">
                  <% if rdata[:positive_factors].present? %>
                    <% rdata[:positive_factors].each do |pos| %>
                      <div class="text-emerald-700 dark:text-emerald-300 flex items-start space-x-1.5">
                        <span class="font-bold">✓</span>
                        <span><%= pos.sub(/^✓\s*/, '') %></span>
                      </div>
                    <% end %>
                  <% end %>

                  <% if rdata[:negative_factors].present? %>
                    <% rdata[:negative_factors].each do |neg| %>
                      <div class="text-rose-600 dark:text-rose-400 flex items-start space-x-1.5">
                        <span class="font-bold">⚠</span>
                        <span><%= neg.sub(/^⚠\s*/, '') %></span>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </details>
            </div>
          <% end %>
        </div>

        <!-- Explainable Recommendation Card -->
        <% rec = @results[:recommendation] %>
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border-2 border-indigo-500 dark:border-indigo-600 shadow-sm space-y-3">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
            <h3 class="text-xs font-black uppercase text-indigo-700 dark:text-indigo-300 flex items-center">
              <i class="fas fa-brain mr-1.5 text-indigo-600 dark:text-indigo-400"></i>
              Why ENMA AI Recommends This Route (<%= rec[:confidence_percentage] %>% Confidence)
            </h3>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono"><%= rec[:vehicle_context] %></span>
          </div>

          <p class="text-xs text-slate-700 dark:text-slate-200 font-medium leading-relaxed"><%= rec[:trade_off] %></p>

          <ul class="space-y-1.5 text-[11px] text-slate-600 dark:text-slate-300">
            <% rec[:reasons].first(3).each do |reason| %>
              <li class="flex items-start space-x-2">
                <i class="fas fa-check-circle text-emerald-600 dark:text-emerald-400 mt-0.5 text-xs flex-shrink-0"></i>
                <span><%= reason %></span>
              </li>
            <% end %>
          </ul>
        </div>

        <!-- Turn-by-Turn Instruction Accordion -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-4 space-y-2.5">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
            <h4 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
              <i class="fas fa-list-ol text-indigo-600 mr-1.5"></i>
              Turn-by-Turn Directions
            </h4>
            <span class="text-[10px] text-slate-400 font-semibold">Active Corridor</span>
          </div>

          <div data-route-planner-map-target="turnList" class="max-h-72 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800">
            <% current_rec = @results[:routes][@results[:recommended_route_type]] %>
            <% if current_rec && current_rec[:steps].any? %>
              <% current_rec[:steps].each do |st| %>
                <div class="py-2 flex items-start space-x-2.5 text-xs">
                  <div class="w-5 h-5 rounded-full bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 font-bold flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5">
                    <%= st[:step_number] %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-bold text-slate-900 dark:text-white"><%= st[:instruction] %></p>
                    <span class="text-[10px] text-slate-500 dark:text-slate-400"><%= st[:road_name] %> &bull; <%= st[:distance_km] || (st[:distance_m].to_f / 1000).round(1) %> km</span>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-xs text-slate-500 p-3 text-center">Highway corridor active.</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- RIGHT COLUMN: Interactive Leaflet Map & Full-Screen Navigation HUD (w-full flex-1 min-w-0) -->
    <div class="w-full flex-1 min-w-0 space-y-4">
      
      <!-- The Map Card with Floating Navigation HUD -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden relative w-full">
        
        <!-- Map Top Bar Controls -->
        <div class="p-3.5 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/80 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center space-x-2">
            <i class="fas fa-map-marked-alt text-indigo-600"></i>
            <span class="text-xs font-black uppercase text-slate-800 dark:text-slate-200 tracking-wider">
              <% if @origin && @destination %>
                <%= @origin.name %> &rarr; <%= @destination.name %> Corridor
              <% else %>
                North East Highway Corridor Navigation
              <% end %>
            </span>
          </div>

          <% if @results.present? %>
            <div class="flex items-center space-x-2">
              <button type="button"
                      data-action="click->route-planner-map#startNavigation"
                      class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-xl shadow-md transition-all flex items-center cursor-pointer">
                <i class="fas fa-location-arrow mr-1.5 text-xs"></i>
                <span>Start Navigation</span>
              </button>
            </div>
          <% end %>
        </div>

        <!-- Floating Google Maps-Style Navigation HUD (Active during "Start Navigation") -->
        <div data-route-planner-map-target="navHud"
             class="hidden absolute top-4 left-4 right-4 z-30 max-w-lg mx-auto bg-slate-900/95 backdrop-blur-md text-white p-4 rounded-2xl shadow-2xl border border-slate-700 space-y-3">
          
          <!-- Top Green Maneuver Bar -->
          <div class="bg-emerald-600 text-white p-3.5 rounded-xl flex items-center space-x-3.5 shadow-md">
            <div class="w-10 h-10 rounded-lg bg-emerald-700/80 flex items-center justify-center text-xl shadow flex-shrink-0">
              <i data-route-planner-map-target="navManeuverIcon" class="fas fa-arrow-up text-white"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h5 data-route-planner-map-target="navInstruction" class="text-sm font-black truncate">
                Proceed toward corridor
              </h5>
              <p class="text-xs text-emerald-100 mt-0.5">In <strong data-route-planner-map-target="navDistance">1.2 km</strong></p>
            </div>
            <button type="button" data-action="click->route-planner-map#toggleVoice" data-route-planner-map-target="voiceToggle" title="Toggle Voice Guidance" class="p-2 rounded-lg bg-emerald-700 text-white hover:bg-emerald-800 transition-colors cursor-pointer">
              <i class="fas fa-volume-up"></i>
            </button>
          </div>

          <!-- Bottom Telemetry & Controls -->
          <div class="flex items-center justify-between pt-1 border-t border-slate-800 text-xs text-slate-300">
            <div class="flex items-center space-x-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              <span data-route-planner-map-target="navStepCounter" class="font-mono text-[11px] text-slate-400">Step 1</span>
            </div>

            <div class="flex items-center space-x-2">
              <button type="button" data-action="click->route-planner-map#prevNavStep" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded-lg text-slate-200 cursor-pointer">
                <i class="fas fa-chevron-left"></i>
              </button>
              <button type="button" data-action="click->route-planner-map#nextNavStep" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded-lg text-slate-200 cursor-pointer">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>

            <button type="button" data-action="click->route-planner-map#exitNavigation" class="px-3 py-1 bg-red-900/80 hover:bg-red-800 text-red-200 rounded-lg font-bold cursor-pointer">
              Exit
            </button>
          </div>
        </div>

        <!-- The Leaflet Map Canvas (Responsive height: 360px on mobile, 480px on tablet, 680px on desktop) -->
        <div data-route-planner-map-target="container"
             style="min-height: 320px; width: 100%; display: block;"
             class="w-full z-10 h-[360px] sm:h-[480px] lg:h-[680px]">
        </div>
      </div>

      <!-- Recent Routes Bar -->
      <% if @recent_routes.any? %>
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-4">
          <div class="flex items-center justify-between mb-3 border-b border-slate-100 dark:border-slate-800 pb-2">
            <span class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
              <i class="fas fa-history text-indigo-600 mr-1.5"></i> Recent Dispatches
            </span>
            <span class="text-[10px] text-slate-400 font-medium">Quick Reload</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-2.5">
            <% @recent_routes.first(4).each do |r| %>
              <%= link_to routes_path(origin_id: r.origin_id, destination_id: r.destination_id, vehicle_type: r.vehicle_type), class: "p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 border border-slate-100 dark:border-slate-700/60 hover:border-indigo-200 dark:hover:border-indigo-800 transition-all text-xs block group" do %>
                <div class="flex items-center justify-between">
                  <strong class="text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate"><%= r.origin&.name %> &rarr; <%= r.destination&.name %></strong>
                  <span class="text-[10px] font-black uppercase <%= r.recommended ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-400' %>"><%= r.route_type %></span>
                </div>
                <div class="flex items-center justify-between text-[10px] text-slate-500 dark:text-slate-400 mt-1">
                  <span><%= r.vehicle_type %></span>
                  <span><%= r.distance %> km</span>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
