<div class="space-y-6 max-w-7xl mx-auto pb-12 w-full text-slate-100"
     data-controller="route-planner-map"
     <% if @origin && @destination && @results.present? %>
       data-route-planner-map-origin-value="<%= @origin.to_json %>"
       data-route-planner-map-destination-value="<%= @destination.to_json %>"
       data-route-planner-map-routes-value="<%= @results[:routes].to_json %>"
       data-route-planner-map-emergencies-value="<%= @results[:active_emergencies].to_json %>"
       data-route-planner-map-active-route-value="<%= @results[:recommended_route_type] %>"
     <% end %>>

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 border-b border-white/[0.08] gap-3">
    <div>
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-accent/10 text-accent border border-accent/20 shadow-sm shadow-accent/5">
          <span class="w-2 h-2 rounded-full bg-accent mr-2 animate-pulse"></span>
          ENMA AI DECISION ENGINE
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Multi-Route Navigation &amp; Risk Optimization</h2>
      </div>
      <p class="text-xs text-slate-400 mt-1">Multi-criteria logistics routing: Real-Time Road Status • Hybrid Risk • ML Disruption Probability • Active Weather Corridor.</p>
    </div>
  </div>

  <!-- Main Dual Layout (Left: Search & Intelligence Cards, Right: Leaflet GIS Map) -->
  <div class="flex flex-col lg:flex-row gap-6 items-start w-full">
    
    <!-- LEFT COLUMN: Directions Search, Vehicle Mode, Priority Selector & Route Options -->
    <div class="w-full lg:w-[440px] flex-shrink-0 space-y-4">
      
      <!-- Directions Input Card (Glassmorphic) -->
      <div class="bg-slate-900/80 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/[0.08] p-5 space-y-4">
        
        <!-- Transportation Mode Tabs -->
        <div>
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1.5">Vehicle Profile</label>
          <div class="flex items-center justify-between bg-black/40 border border-white/[0.05] p-1 rounded-xl text-xs font-bold overflow-x-auto no-scrollbar space-x-1">
            <% [
              ["Truck", "fa-truck-moving", "Truck"],
              ["Ambulance", "fa-ambulance", "Ambulance"],
              ["Emergency Vehicle", "fa-shield-alt", "Emergency"],
              ["Supply Vehicle", "fa-box-open", "Supply"],
              ["Personal Vehicle", "fa-car", "Personal"]
            ].each do |v_type, v_icon, v_label| %>
              <% active = (@selected_vehicle == v_type) %>
              <button type="button"
                      data-action="click->route-planner-map#selectVehicle"
                      data-vehicle-type="<%= v_type %>"
                      title="<%= v_type %>"
                      class="flex-1 min-w-[58px] py-1.5 px-1 rounded-lg text-center transition-all flex flex-col items-center justify-center space-y-0.5 cursor-pointer <%= active ? 'bg-accent text-white shadow-md shadow-accent/20' : 'text-slate-400 hover:text-white hover:bg-white/[0.06]' %>">
                <i class="fas <%= v_icon %> text-xs"></i>
                <span class="text-[9px] font-black leading-tight"><%= v_label %></span>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Google Maps Style A & B Search Form -->
        <%= form_with url: calculate_routes_path, method: :post, local: true, class: "space-y-3", data: { turbo: false, route_planner_map_target: "searchForm" } do |f| %>
          <input type="hidden" name="origin_lat" data-route-planner-map-target="originLat">
          <input type="hidden" name="origin_lon" data-route-planner-map-target="originLon">
          <input type="hidden" name="priority_mode" value="<%= @selected_priority || 'balanced' %>" data-route-planner-map-target="priorityInput">

          <div class="flex items-center justify-between">
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Vehicle Profile</label>
            <%= select_tag :vehicle_type,
                           options_for_select(@vehicle_types, @selected_vehicle),
                           data: { route_planner_map_target: "vehicleInput" },
                           class: "text-[11px] font-bold text-slate-200 bg-black/50 border border-white/[0.08] rounded-lg px-2.5 py-1 focus:ring-1 focus:ring-accent focus:outline-none" %>
          </div>

          <!-- Priority Mode Segmented Control -->
          <div>
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1.5">Optimization Priority</label>
            <div class="grid grid-cols-2 gap-1.5 bg-black/40 border border-white/[0.05] p-1.5 rounded-xl">
              <% @priority_modes.each do |pm| %>
                <% is_p_active = (@selected_priority == pm[:key]) %>
                <button type="button"
                        data-action="click->route-planner-map#selectPriority"
                        data-priority-mode="<%= pm[:key] %>"
                        class="py-1.5 px-2 rounded-lg text-left transition-all cursor-pointer <%= is_p_active ? 'bg-slate-800/90 shadow-md border border-accent/40 text-accent font-black' : 'text-slate-400 font-bold hover:bg-white/[0.05]' %>">
                  <div class="text-xs font-black"><%= pm[:label] %></div>
                  <div class="text-[9px] text-slate-500 truncate"><%= pm[:tagline] %></div>
                </button>
              <% end %>
            </div>
          </div>

          <!-- Cargo Profile Selector -->
          <div class="flex items-center justify-between pt-1">
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Cargo Type</label>
            <%= select_tag :cargo_type,
                           options_for_select(@cargo_types, @selected_cargo),
                           class: "text-[11px] font-bold text-slate-200 bg-black/50 border border-white/[0.08] rounded-lg px-2.5 py-1 focus:ring-1 focus:ring-accent focus:outline-none" %>
          </div>

          <!-- Origin & Destination Inputs -->
          <div class="pt-1">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Origin &amp; Destination</span>
              <button type="button"
                      data-action="click->route-planner-map#locateUser"
                      title="Populate origin with browser coordinates"
                      class="text-[10px] font-bold text-accent hover:opacity-80 hover:underline flex items-center space-x-1 cursor-pointer">
                <i class="fas fa-crosshairs text-[9px]"></i>
                <span>Use Current Location</span>
              </button>
            </div>

            <div class="relative flex items-center space-x-3">
              <!-- Left Connector -->
              <div class="flex flex-col items-center py-2 self-stretch justify-between">
                <div class="w-4 h-4 rounded-full border-2 border-emerald-500 bg-slate-950 flex items-center justify-center">
                  <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
                </div>
                <div class="w-0.5 flex-1 bg-slate-700 my-1 border-dashed"></div>
                <div class="w-4 h-4 rounded-full border-2 border-rose-500 bg-slate-950 flex items-center justify-center">
                  <div class="w-1.5 h-1.5 rounded-full bg-rose-500"></div>
                </div>
              </div>

              <!-- Selects -->
              <div class="flex-1 space-y-2">
                <div>
                  <%= select_tag :origin_id,
                                 options_from_collection_for_select(@locations, :id, :name, @origin&.id),
                                 prompt: "-- Choose Starting Point (A) --",
                                 required: true,
                                 data: { route_planner_map_target: "originSelect" },
                                 class: "w-full px-3 py-2 text-xs font-bold text-white bg-black/60 hover:bg-black/80 border border-white/[0.1] rounded-xl focus:ring-2 focus:ring-accent focus:outline-none transition-all" %>
                </div>

                <div>
                  <%= select_tag :destination_id,
                                 options_from_collection_for_select(@locations, :id, :name, @destination&.id),
                                 prompt: "-- Choose Destination (B) --",
                                 required: true,
                                 data: { route_planner_map_target: "destinationSelect" },
                                 class: "w-full px-3 py-2 text-xs font-bold text-white bg-black/60 hover:bg-black/80 border border-white/[0.1] rounded-xl focus:ring-2 focus:ring-accent focus:outline-none transition-all" %>
                </div>
              </div>

              <!-- Swap Button -->
              <div>
                <button type="button"
                        data-action="click->route-planner-map#swapLocations"
                        title="Swap Origin & Destination"
                        class="w-8 h-8 rounded-full bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 flex items-center justify-center text-sm border border-white/[0.08] shadow-sm transition-colors cursor-pointer">
                  <i class="fas fa-arrows-up-down"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <%= f.submit "Analyze & Optimize Routes",
                         class: "w-full py-2.5 px-4 bg-accent hover:opacity-90 text-white font-black text-xs rounded-xl shadow-md shadow-accent/20 transition-all cursor-pointer" %>
          </div>
        <% end %>

      </div>

      <!-- Route Cards & Multi-Criteria Intelligence Choices -->
      <% if @results.present? && @results[:routes].present? %>
        <div class="space-y-3">
          <div class="flex items-center justify-between px-1">
            <span class="text-xs font-black uppercase text-slate-400 tracking-wider">Candidate Routes Evaluated</span>
            <div class="flex items-center space-x-1.5 text-[10px] font-mono">
              <span class="px-2.5 py-0.5 rounded-full uppercase font-black bg-accent/10 text-accent border border-accent/20 flex items-center">
                <i class="fas fa-brain text-[8px] mr-1"></i>
                ML Model Active
              </span>
            </div>
          </div>

          <% @results[:routes].slice(:fastest, :safest, :balanced).each do |type_key, rdata| %>
            <% next if rdata.blank? %>
            <% is_recommended = rdata[:is_recommended] %>
            <% is_blocked = rdata[:is_blocked] %>
            <% ml_pct = (rdata[:ml_disruption_probability] ? (rdata[:ml_disruption_probability] * 100).round(1) : (rdata[:ml_disruption_percentage] || 20.0)) %>
            <% enma_eta = rdata[:enma_adjusted_eta_formatted] || rdata[:estimated_time_formatted] %>
            <% prov_eta = rdata[:provider_eta_formatted] || rdata[:estimated_time_formatted] %>
            <% delay_mins = rdata[:delay_minutes] || 0 %>

            <div data-route-planner-map-target="routeCard"
                 data-route-type="<%= type_key %>"
                 data-action="click->route-planner-map#selectRoute"
                 class="p-4 rounded-2xl bg-slate-900/80 backdrop-blur-xl border-2 cursor-pointer transition-all shadow-xl <%= is_recommended ? 'border-accent bg-accent/10 ring-1 ring-accent/40 shadow-accent/10' : 'border-white/[0.08] opacity-75 hover:opacity-100 hover:border-white/[0.2]' %> space-y-3">
              
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase <%= rdata[:badge_class] || 'bg-slate-800 text-slate-300 border border-slate-700' %>">
                    <i class="fas <%= rdata[:icon] || 'fa-route' %> mr-1"></i>
                    <%= rdata[:type].to_s.upcase %>
                  </span>
                  <span class="text-xs font-bold text-white"><%= rdata[:title] || rdata[:name] %></span>
                </div>

                <% if is_recommended %>
                  <span class="text-[9px] font-black text-white bg-accent px-2.5 py-0.5 rounded-full shadow-sm flex items-center">
                    <i class="fas fa-star text-[8px] mr-1"></i>
                    RECOMMENDED
                  </span>
                <% elsif is_blocked %>
                  <span class="text-[9px] font-black text-red-300 bg-red-950 px-2 py-0.5 rounded-full border border-red-800">
                    UNAVAILABLE
                  </span>
                <% end %>
              </div>

              <!-- Route Telemetry Row (Provider ETA vs ENMA Adjusted ETA) -->
              <div class="flex items-baseline justify-between">
                <div>
                  <div class="flex items-baseline space-x-1.5">
                    <span class="text-xl font-black text-white"><%= enma_eta %></span>
                    <span class="text-xs font-bold text-slate-400">(<%= rdata[:distance_km] %> km)</span>
                  </div>
                  <% if delay_mins > 0 %>
                    <span class="text-[10px] font-mono text-amber-400 font-bold">
                      Base ETA: <%= prov_eta %> (+<%= delay_mins %>m delay)
                    </span>
                  <% else %>
                    <span class="text-[10px] font-mono text-emerald-400 font-bold">
                      On schedule &bull; <%= prov_eta %>
                    </span>
                  <% end %>
                </div>

                <div class="flex flex-col items-end space-y-1">
                  <div class="flex items-center space-x-1">
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md <%= rdata[:risk_score] <= 25 ? 'bg-emerald-950/80 text-emerald-300 border border-emerald-800' : (rdata[:risk_score] <= 50 ? 'bg-amber-950/80 text-amber-300 border border-amber-800' : 'bg-rose-950/80 text-rose-300 border border-rose-800') %>">
                      Risk: <%= rdata[:risk_score] %>/100
                    </span>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-accent bg-accent/10 border border-accent/20 px-2 py-0.5 rounded">
                    🤖 ML Disruption: <%= ml_pct %>%
                  </span>
                </div>
              </div>

              <!-- Multi-Criteria Score Breakdown Pill Row -->
              <div class="grid grid-cols-3 gap-2 pt-2 border-t border-white/[0.06] text-[10px] font-mono text-center">
                <div class="p-1.5 rounded-xl bg-black/40 border border-white/[0.05]">
                  <span class="text-slate-500 block text-[8px] uppercase">Safety</span>
                  <strong class="text-emerald-400"><%= rdata.dig(:scores, :safety) || 85 %>/100</strong>
                </div>
                <div class="p-1.5 rounded-xl bg-black/40 border border-white/[0.05]">
                  <span class="text-slate-500 block text-[8px] uppercase">Accessibility</span>
                  <strong class="text-accent"><%= rdata.dig(:scores, :accessibility) || 80 %>/100</strong>
                </div>
                <div class="p-1.5 rounded-xl bg-black/40 border border-white/[0.05]">
                  <span class="text-slate-500 block text-[8px] uppercase">Cost Index</span>
                  <strong class="text-amber-400"><%= rdata[:optimization_score] || 32.5 %></strong>
                </div>
              </div>

              <!-- Expandable Intelligence Factors Drawer -->
              <details class="pt-2 border-t border-white/[0.06] text-[11px] group">
                <summary class="cursor-pointer font-bold text-slate-300 hover:text-accent flex items-center justify-between">
                  <span class="flex items-center space-x-1.5">
                    <i class="fas fa-microchip text-[10px] text-accent"></i>
                    <span>Route Intelligence Breakdown</span>
                  </span>
                  <i class="fas fa-chevron-down text-[9px] group-open:rotate-180 transition-transform"></i>
                </summary>
                
                <div class="mt-2 space-y-1.5 font-mono text-[10px] bg-black/50 border border-white/[0.05] p-2.5 rounded-xl">
                  <% if rdata[:delay_reason].present? %>
                    <div class="text-slate-400 pb-1 border-b border-white/[0.06]">
                      <strong class="text-slate-200">Delay Telemetry:</strong> <%= rdata[:delay_reason] %>
                    </div>
                  <% end %>

                  <% if rdata[:positive_factors].present? %>
                    <% rdata[:positive_factors].each do |pos| %>
                      <div class="text-emerald-300 flex items-start space-x-1.5">
                        <span class="font-bold">✓</span>
                        <span><%= pos.sub(/^✓\s*/, '') %></span>
                      </div>
                    <% end %>
                  <% end %>

                  <% if rdata[:negative_factors].present? %>
                    <% rdata[:negative_factors].each do |neg| %>
                      <div class="text-rose-400 flex items-start space-x-1.5">
                        <span class="font-bold">⚠</span>
                        <span><%= neg.sub(/^⚠\s*/, '') %></span>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </details>
            </div>
          <% end %>
        </div>

        <!-- Explainable AI Recommendation Card -->
        <% rec = @results[:recommendation] %>
        <% if rec.present? %>
          <div class="p-4 rounded-2xl bg-slate-900/90 backdrop-blur-xl border-2 border-accent/40 shadow-xl space-y-3">
            <div class="flex items-center justify-between border-b border-white/[0.08] pb-2">
              <h3 class="text-xs font-black uppercase text-accent flex items-center">
                <i class="fas fa-brain mr-1.5 text-accent"></i>
                Why ENMA AI Recommends This Route (<%= rec[:confidence_percentage] %>% Confidence)
              </h3>
              <span class="text-[10px] text-slate-400 font-mono"><%= rec[:vehicle_context] %></span>
            </div>

            <p class="text-xs text-slate-200 font-medium leading-relaxed"><%= rec[:trade_off] || rec[:summary] %></p>

            <% if rec[:reasons].present? %>
              <ul class="space-y-1.5 text-[11px] text-slate-300">
                <% rec[:reasons].first(3).each do |reason| %>
                  <li class="flex items-start space-x-2">
                    <i class="fas fa-check-circle text-emerald-400 mt-0.5 text-xs flex-shrink-0"></i>
                    <span><%= reason %></span>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>

        <!-- Turn-by-Turn Instruction Accordion -->
        <div class="bg-slate-900/80 backdrop-blur-xl rounded-2xl shadow-xl border border-white/[0.08] p-4 space-y-2.5">
          <div class="flex items-center justify-between border-b border-white/[0.08] pb-2">
            <h4 class="text-xs font-black uppercase text-white tracking-wider flex items-center">
              <i class="fas fa-list-ol text-accent mr-1.5"></i>
              Turn-by-Turn Directions
            </h4>
            <span class="text-[10px] text-slate-400 font-semibold">Active Corridor</span>
          </div>

          <div data-route-planner-map-target="turnList" class="max-h-72 overflow-y-auto divide-y divide-white/[0.05]">
            <% current_rec = @results[:routes][@results[:recommended_route_type]] %>
            <% if current_rec && current_rec[:steps].any? %>
              <% current_rec[:steps].each do |st| %>
                <div class="py-2 flex items-start space-x-2.5 text-xs">
                  <div class="w-5 h-5 rounded-full bg-orange-500/20 text-accent font-bold flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5 border border-orange-500/30">
                    <%= st[:step_number] %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-bold text-white"><%= st[:instruction] %></p>
                    <span class="text-[10px] text-slate-400"><%= st[:road_name] %> &bull; <%= st[:distance_km] || (st[:distance_m].to_f / 1000).round(1) %> km</span>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-xs text-slate-500 p-3 text-center">Highway corridor active.</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- RIGHT COLUMN: Interactive Leaflet Map & Full-Screen Navigation HUD -->
    <div class="w-full flex-1 min-w-0 space-y-4">
      
      <!-- The Map Card with Floating Navigation HUD -->
      <div class="bg-slate-900/80 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/[0.08] overflow-hidden relative w-full">
        
        <!-- Map Top Bar Controls -->
        <div class="p-3.5 border-b border-white/[0.08] bg-black/40 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center space-x-2">
            <i class="fas fa-map-marked-alt text-accent"></i>
            <span class="text-xs font-black uppercase text-white tracking-wider">
              <% if @origin && @destination %>
                <%= @origin.name %> &rarr; <%= @destination.name %> Corridor
              <% else %>
                North East Highway Corridor Navigation
              <% end %>
            </span>
          </div>

          <% if @results.present? %>
            <div class="flex items-center space-x-2">
              <button type="button"
                      data-action="click->route-planner-map#startNavigation"
                      class="px-4 py-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-black text-xs rounded-xl shadow-lg shadow-emerald-600/25 transition-all flex items-center cursor-pointer">
                <i class="fas fa-location-arrow mr-1.5 text-xs"></i>
                <span>Start Navigation</span>
              </button>
            </div>
          <% end %>
        </div>

        <!-- Floating Navigation HUD (Active during "Start Navigation") -->
        <div data-route-planner-map-target="navHud"
             class="hidden absolute top-4 left-4 right-4 z-30 max-w-lg mx-auto bg-slate-950/95 backdrop-blur-md text-white p-4 rounded-2xl shadow-2xl border border-white/[0.1] space-y-3">
          
          <!-- Top Green Maneuver Bar -->
          <div class="bg-gradient-to-r from-emerald-600 to-teal-600 text-white p-3.5 rounded-xl flex items-center space-x-3.5 shadow-md">
            <div class="w-10 h-10 rounded-lg bg-emerald-800/80 flex items-center justify-center text-xl shadow flex-shrink-0">
              <i data-route-planner-map-target="navManeuverIcon" class="fas fa-arrow-up text-white"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h5 data-route-planner-map-target="navInstruction" class="text-sm font-black truncate">
                Proceed toward corridor
              </h5>
              <p class="text-xs text-emerald-100 mt-0.5">In <strong data-route-planner-map-target="navDistance">1.2 km</strong></p>
            </div>
            <button type="button" data-action="click->route-planner-map#toggleVoice" data-route-planner-map-target="voiceToggle" title="Toggle Voice Guidance" class="p-2 rounded-lg bg-emerald-800 text-white hover:bg-emerald-700 transition-colors cursor-pointer">
              <i class="fas fa-volume-up"></i>
            </button>
          </div>

          <!-- Bottom Telemetry & Controls -->
          <div class="flex items-center justify-between pt-1 border-t border-slate-800 text-xs text-slate-300">
            <div class="flex items-center space-x-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              <span data-route-planner-map-target="navStepCounter" class="font-mono text-[11px] text-slate-400">Step 1</span>
            </div>

            <div class="flex items-center space-x-2">
              <button type="button" data-action="click->route-planner-map#prevNavStep" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded-lg text-slate-200 cursor-pointer">
                <i class="fas fa-chevron-left"></i>
              </button>
              <button type="button" data-action="click->route-planner-map#nextNavStep" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded-lg text-slate-200 cursor-pointer">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>

            <button type="button" data-action="click->route-planner-map#exitNavigation" class="px-3 py-1 bg-red-950 hover:bg-red-900 text-red-200 rounded-lg font-bold border border-red-800 cursor-pointer">
              Exit
            </button>
          </div>
        </div>

        <!-- The Leaflet Map Canvas -->
        <div data-route-planner-map-target="container"
             style="min-height: 340px; width: 100%; display: block;"
             class="w-full z-10 h-[380px] sm:h-[500px] lg:h-[700px]">
        </div>
      </div>

      <!-- Recent Routes Bar -->
      <% if @recent_routes.any? %>
        <div class="bg-slate-900/80 backdrop-blur-xl rounded-2xl shadow-xl border border-white/[0.08] p-4">
          <div class="flex items-center justify-between mb-3 border-b border-white/[0.08] pb-2">
            <span class="text-xs font-black uppercase text-white tracking-wider flex items-center">
              <i class="fas fa-history text-accent mr-1.5"></i> Recent Dispatches
            </span>
            <span class="text-[10px] text-slate-400 font-medium">Quick Reload</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-2.5">
            <% @recent_routes.first(4).each do |r| %>
              <%= link_to routes_path(origin_id: r.origin_id, destination_id: r.destination_id, vehicle_type: r.vehicle_type), class: "p-2.5 rounded-xl bg-black/40 hover:bg-accent/10 border border-white/[0.05] hover:border-accent/30 transition-all text-xs block group" do %>
                <div class="flex items-center justify-between">
                  <strong class="text-white group-hover:text-accent truncate"><%= r.origin&.name %> &rarr; <%= r.destination&.name %></strong>
                  <span class="text-[10px] font-black uppercase <%= r.recommended ? 'text-emerald-400' : 'text-slate-400' %>"><%= r.route_type %></span>
                </div>
                <div class="flex items-center justify-between text-[10px] text-slate-400 mt-1">
                  <span><%= r.vehicle_type %></span>
                  <span><%= r.distance %> km</span>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
