<div class="space-y-6 max-w-7xl mx-auto pb-12">
  <!-- Page Header -->
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between pb-3 border-b border-slate-200 dark:border-slate-800 gap-3">
    <div>
      <div class="flex items-center space-x-2.5">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">Intelligence Analytics</h2>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black bg-accent/15 dark:bg-accent/10 text-accent dark:text-accent border border-accent/20 dark:border-accent/20 uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-accent dark:bg-accent animate-ping mr-1.5"></span>
          LIVE INTELLIGENCE
        </span>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Regional insights, risk patterns and logistics readiness across North East India.</p>
    </div>

    <!-- Controls: Time Range Filter & Export Report -->
    <div class="flex flex-wrap items-center gap-2.5">
      <!-- Date Range Filter Tabs -->
      <div class="flex items-center space-x-1 bg-slate-200/80 dark:bg-slate-800 p-1 rounded-xl text-xs font-bold">
        <%= link_to "Last 7 Days", analytics_path(time_range: "7d"), class: "px-3 py-1.5 rounded-lg transition-colors #{@time_range == '7d' ? 'bg-white dark:bg-slate-900 text-accent dark:text-accent shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}" %>
        <%= link_to "Last 30 Days", analytics_path(time_range: "30d"), class: "px-3 py-1.5 rounded-lg transition-colors #{@time_range == '30d' ? 'bg-white dark:bg-slate-900 text-accent dark:text-accent shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}" %>
        <%= link_to "All Time", analytics_path(time_range: "all"), class: "px-3 py-1.5 rounded-lg transition-colors #{@time_range == 'all' ? 'bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}" %>
      </div>

      <!-- Export Report Button -->
      <%= link_to analytics_report_path(time_range: @time_range), target: "_blank", class: "inline-flex items-center px-4 py-2 bg-accent hover:opacity-90 text-white font-black text-xs rounded-xl shadow-sm transition-all" do %>
        <i class="fas fa-file-download mr-1.5 text-xs"></i>
        <span>Generate Intelligence Report</span>
      <% end %>
    </div>
  </div>

  <!-- SECTION 1: Executive Summary Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Card 1: Regional Readiness -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border-l-4 border-accent border-t border-r border-b border-slate-200 dark:border-slate-800 p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-accent dark:text-accent uppercase tracking-wider">Regional Readiness</p>
          <div class="flex items-baseline space-x-2 mt-1">
            <span class="text-3xl font-black text-slate-900 dark:text-white"><%= @readiness_score %></span>
            <span class="text-xs font-bold text-slate-400">/ 100</span>
          </div>
          <div class="mt-1">
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-black uppercase <%= @readiness_score >= 80 ? 'bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300' : (@readiness_score >= 60 ? 'bg-accent/10 dark:bg-accent/10 text-accent dark:text-accent' : 'bg-yellow-100 dark:bg-yellow-950 text-yellow-800 dark:text-yellow-300') %>">
              <%= @readiness_category %>
            </span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1.5">Overall logistics and emergency preparedness.</p>
        </div>
        <div class="w-11 h-11 rounded-xl bg-accent/10 dark:bg-accent/10 flex items-center justify-center text-accent dark:text-accent text-lg shadow-inner flex-shrink-0">
          <i class="fas fa-shield-alt"></i>
        </div>
      </div>
    </div>

    <!-- Card 2: High Risk Zones -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border-l-4 border-orange-500 border-t border-r border-b border-slate-200 dark:border-slate-800 p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-orange-600 dark:text-orange-400 uppercase tracking-wider">High Risk Zones</p>
          <p class="text-3xl font-black text-slate-900 dark:text-white mt-1"><%= @high_risk_zones_count %></p>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">Locations requiring increased monitoring.</p>
        </div>
        <div class="w-11 h-11 rounded-xl bg-orange-50 dark:bg-orange-950/70 flex items-center justify-center text-orange-600 dark:text-orange-400 text-lg shadow-inner flex-shrink-0">
          <i class="fas fa-exclamation-triangle"></i>
        </div>
      </div>
    </div>

    <!-- Card 3: Active Emergencies -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border-l-4 border-red-600 border-t border-r border-b border-slate-200 dark:border-slate-800 p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-red-600 dark:text-red-400 uppercase tracking-wider">Active Emergencies</p>
          <p class="text-3xl font-black text-slate-900 dark:text-white mt-1"><%= @active_emergencies_count %></p>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">Ongoing disaster response operations.</p>
        </div>
        <div class="w-11 h-11 rounded-xl bg-red-50 dark:bg-red-950/70 flex items-center justify-center text-red-600 dark:text-red-400 text-lg shadow-inner flex-shrink-0">
          <i class="fas fa-radiation"></i>
        </div>
      </div>
    </div>

    <!-- Card 4: Communities Monitored -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border-l-4 border-emerald-500 border-t border-r border-b border-slate-200 dark:border-slate-800 p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Communities Monitored</p>
          <p class="text-3xl font-black text-slate-900 dark:text-white mt-1"><%= @total_communities_count %></p>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">Across North East India.</p>
        </div>
        <div class="w-11 h-11 rounded-xl bg-emerald-50 dark:bg-emerald-950/70 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-lg shadow-inner flex-shrink-0">
          <i class="fas fa-map-marked-alt"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 10: ResQWay Dynamic Key Insights -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 sm:p-6 space-y-4">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <span class="text-lg">⚡</span>
        <h3 class="text-sm font-black uppercase text-slate-900 dark:text-white tracking-wider">ResQWay Key Insights</h3>
      </div>
      <span class="text-xs font-mono text-slate-400">Autonomous Rule Engine</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @insights.each do |ins| %>
        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 hover:border-slate-300 transition-all flex items-start space-x-3.5">
          <div class="w-9 h-9 rounded-xl bg-white dark:bg-slate-800 shadow-sm border border-slate-200 dark:border-slate-700 flex items-center justify-center <%= ins[:icon_color] %> flex-shrink-0 mt-0.5 text-sm">
            <i class="fas <%= ins[:icon] %>"></i>
          </div>
          <div class="flex-1">
            <div class="flex items-center space-x-2">
              <span class="px-2 py-0.5 text-[9px] font-black rounded-full border <%= ins[:badge_class] %> uppercase tracking-wide">
                <%= ins[:badge] %>
              </span>
            </div>
            <h4 class="text-xs font-bold text-slate-900 dark:text-white mt-1"><%= ins[:title] %></h4>
            <p class="text-[11px] text-slate-600 dark:text-slate-300 mt-0.5 leading-relaxed"><%= ins[:detail] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- SECTION 2 & 3: Risk Distribution & Accessibility Analytics Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    
    <!-- SECTION 2: Regional Risk Distribution -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 sm:p-6 flex flex-col justify-between space-y-4">
      <div>
        <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
          <div>
            <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider flex items-center">
              <i class="fas fa-chart-pie text-orange-500 mr-2 text-xs"></i>
              <span>Regional Risk Distribution</span>
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Predicted risk categories across all monitored settlements.</p>
          </div>
          <span class="text-xs font-mono font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded"><%= @total_communities_count %> Nodes</span>
        </div>

        <!-- Doughnut Visualization -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center my-3">
          <div class="flex justify-center">
            <div class="relative w-36 h-36 flex items-center justify-center">
              <!-- SVG Donut Chart -->
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                <path class="text-slate-100 dark:text-slate-800" stroke-width="5" stroke="currentColor" fill="none"
                      d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />

                <% 
                  offset = 0.0
                  crit_len = @risk_distribution[:critical][:percentage]
                  high_len = @risk_distribution[:high][:percentage]
                  mod_len  = @risk_distribution[:moderate][:percentage]
                  low_len  = @risk_distribution[:low][:percentage]
                %>

                <% if crit_len > 0 %>
                  <path class="text-red-600" stroke-dasharray="<%= crit_len %>, 100" stroke-dashoffset="-<%= offset %>" stroke-width="5" stroke="currentColor" fill="none"
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                  <% offset += crit_len %>
                <% end %>

                <% if high_len > 0 %>
                  <path class="text-orange-500" stroke-dasharray="<%= high_len %>, 100" stroke-dashoffset="-<%= offset %>" stroke-width="5" stroke="currentColor" fill="none"
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                  <% offset += high_len %>
                <% end %>

                <% if mod_len > 0 %>
                  <path class="text-yellow-400" stroke-dasharray="<%= mod_len %>, 100" stroke-dashoffset="-<%= offset %>" stroke-width="5" stroke="currentColor" fill="none"
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                  <% offset += mod_len %>
                <% end %>

                <% if low_len > 0 %>
                  <path class="text-emerald-500" stroke-dasharray="<%= low_len %>, 100" stroke-dashoffset="-<%= offset %>" stroke-width="5" stroke="currentColor" fill="none"
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                <% end %>
              </svg>

              <!-- Center Text -->
              <div class="absolute text-center">
                <span class="text-2xl font-black text-slate-900 dark:text-white"><%= @risk_distribution[:critical][:count] + @risk_distribution[:high][:count] %></span>
                <span class="text-[9px] uppercase font-bold text-slate-400 block">Vulnerable</span>
              </div>
            </div>
          </div>

          <!-- Legend List -->
          <div class="space-y-2 text-xs">
            <div class="flex items-center justify-between p-2 rounded-xl bg-red-50/70 dark:bg-red-950/50 border border-red-100 dark:border-red-900/60">
              <span class="flex items-center font-bold text-red-800 dark:text-red-300">
                <span class="w-2.5 h-2.5 rounded-full bg-red-600 mr-2"></span> Critical Risk (&ge;75)
              </span>
              <span class="font-black text-red-900 dark:text-red-200"><%= @risk_distribution[:critical][:count] %> (<%= @risk_distribution[:critical][:percentage] %>%)</span>
            </div>

            <div class="flex items-center justify-between p-2 rounded-xl bg-orange-50/70 dark:bg-orange-950/50 border border-orange-100 dark:border-orange-900/60">
              <span class="flex items-center font-bold text-orange-800 dark:text-orange-300">
                <span class="w-2.5 h-2.5 rounded-full bg-orange-500 mr-2"></span> High Risk (50-74)
              </span>
              <span class="font-black text-orange-900 dark:text-orange-200"><%= @risk_distribution[:high][:count] %> (<%= @risk_distribution[:high][:percentage] %>%)</span>
            </div>

            <div class="flex items-center justify-between p-2 rounded-xl bg-yellow-50/70 dark:bg-yellow-950/50 border border-yellow-100 dark:border-yellow-900/60">
              <span class="flex items-center font-bold text-yellow-800 dark:text-yellow-300">
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-400 mr-2"></span> Moderate Risk (25-49)
              </span>
              <span class="font-black text-yellow-900 dark:text-yellow-200"><%= @risk_distribution[:moderate][:count] %> (<%= @risk_distribution[:moderate][:percentage] %>%)</span>
            </div>

            <div class="flex items-center justify-between p-2 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/50 border border-emerald-100 dark:border-emerald-900/60">
              <span class="flex items-center font-bold text-emerald-800 dark:text-emerald-300">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 mr-2"></span> Low Risk (&lt;25)
              </span>
              <span class="font-black text-emerald-900 dark:text-emerald-200"><%= @risk_distribution[:low][:count] %> (<%= @risk_distribution[:low][:percentage] %>%)</span>
            </div>
          </div>
        </div>
      </div>
      
      <p class="text-[11px] text-slate-400 pt-3 border-t border-slate-100 dark:border-slate-800 text-center">
        Computed automatically from physical terrain, road conditions, and live precipitation telemetry.
      </p>
    </div>

    <!-- SECTION 3: Accessibility Intelligence -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 sm:p-6 flex flex-col justify-between space-y-4">
      <div>
        <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
          <div>
            <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider flex items-center">
              <i class="fas fa-road text-accent dark:text-accent mr-2 text-xs"></i>
              <span>Accessibility Intelligence</span>
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Physical connectivity breakdown &amp; regional baselines.</p>
          </div>
          <span class="text-xs font-mono font-bold text-accent dark:text-accent bg-accent/10 dark:bg-accent/10 px-2 py-0.5 rounded">Avg: <%= @avg_accessibility %>/100</span>
        </div>

        <!-- Bar Distribution -->
        <div class="space-y-3 my-2 text-xs">
          <!-- Highly Accessible -->
          <div>
            <div class="flex justify-between font-bold text-slate-700 dark:text-slate-300 mb-1">
              <span class="text-emerald-600 dark:text-emerald-400">Highly Accessible (&ge;80)</span>
              <span><%= @accessibility_distribution[:highly_accessible][:count] %> (<%= @accessibility_distribution[:highly_accessible][:percentage] %>%)</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
              <div class="bg-emerald-500 h-2 rounded-full" style="width: <%= @accessibility_distribution[:highly_accessible][:percentage] %>%"></div>
            </div>
          </div>

          <!-- Moderately Accessible -->
          <div>
            <div class="flex justify-between font-bold text-slate-700 dark:text-slate-300 mb-1">
              <span class="text-yellow-600 dark:text-yellow-400">Moderately Accessible (60-79)</span>
              <span><%= @accessibility_distribution[:moderately_accessible][:count] %> (<%= @accessibility_distribution[:moderately_accessible][:percentage] %>%)</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
              <div class="bg-yellow-400 h-2 rounded-full" style="width: <%= @accessibility_distribution[:moderately_accessible][:percentage] %>%"></div>
            </div>
          </div>

          <!-- Difficult Access -->
          <div>
            <div class="flex justify-between font-bold text-slate-700 dark:text-slate-300 mb-1">
              <span class="text-orange-600 dark:text-orange-400">Difficult Access (40-59)</span>
              <span><%= @accessibility_distribution[:difficult_access][:count] %> (<%= @accessibility_distribution[:difficult_access][:percentage] %>%)</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
              <div class="bg-orange-500 h-2 rounded-full" style="width: <%= @accessibility_distribution[:difficult_access][:percentage] %>%"></div>
            </div>
          </div>

          <!-- Critical Accessibility -->
          <div>
            <div class="flex justify-between font-bold text-slate-700 dark:text-slate-300 mb-1">
              <span class="text-red-600 dark:text-red-400">Critical Accessibility (&lt;40)</span>
              <span><%= @accessibility_distribution[:critical_accessibility][:count] %> (<%= @accessibility_distribution[:critical_accessibility][:percentage] %>%)</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
              <div class="bg-red-600 h-2 rounded-full" style="width: <%= @accessibility_distribution[:critical_accessibility][:percentage] %>%"></div>
            </div>
          </div>
        </div>

        <!-- Highlight Highlights Grid -->
        <div class="grid grid-cols-2 gap-3 mt-4 pt-3 border-t border-slate-100 dark:border-slate-800">
          <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700/60">
            <span class="text-[10px] uppercase font-bold text-slate-400 block">Lowest Accessibility</span>
            <span class="text-xs font-black text-red-600 dark:text-red-400 block mt-0.5"><%= @lowest_acc_location&.name %> (<%= @lowest_acc_location&.accessibility_score %>/100)</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400"><%= @lowest_acc_location&.state %></span>
          </div>

          <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700/60">
            <span class="text-[10px] uppercase font-bold text-slate-400 block">Highest Accessibility</span>
            <span class="text-xs font-black text-emerald-600 dark:text-emerald-400 block mt-0.5"><%= @highest_acc_location&.name %> (<%= @highest_acc_location&.accessibility_score %>/100)</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400"><%= @highest_acc_location&.state %></span>
          </div>
        </div>
      </div>

      <p class="text-[11px] text-slate-400 pt-3 border-t border-slate-100 dark:border-slate-800 text-center">
        Normalized multi-factor score evaluating road surface, rainfall intensity, and distance to critical hubs.
      </p>
    </div>
  </div>

  <!-- SECTION 7 & 8: Regional Logistics Readiness Engine -->
  <div id="logistics-readiness" class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 sm:p-6 space-y-5">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <div class="flex items-center space-x-2">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-accent/15 dark:bg-accent/10 text-accent dark:text-accent border border-accent/20 dark:border-accent/20">
            Regional Logistics Readiness
          </span>
          <span class="text-xs font-mono text-slate-400">Autonomous Evaluation Engine</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mt-1"><%= @readiness_score %> / 100 &mdash; <%= @readiness_category %></h3>
      </div>

      <div class="text-left sm:text-right">
        <span class="text-[11px] text-slate-400 block">Weighted Multi-Index Formula</span>
        <span class="text-xs font-mono font-bold text-accent dark:text-accent">Acc(30%) + WH(25%) + Prep(20%) + Risk(25%)</span>
      </div>
    </div>

    <!-- Component Progress Bars -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60">
        <div class="flex justify-between items-center text-xs mb-1.5">
          <span class="font-bold text-slate-600 dark:text-slate-300">Accessibility</span>
          <span class="font-black text-slate-900 dark:text-white"><%= @readiness[:breakdown][:accessibility_percentage] %>%</span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
          <div class="bg-accent h-2 rounded-full" style="width: <%= @readiness[:breakdown][:accessibility_percentage] %>%"></div>
        </div>
        <span class="text-[10px] text-slate-400 mt-1 block">Weight: 30%</span>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60">
        <div class="flex justify-between items-center text-xs mb-1.5">
          <span class="font-bold text-slate-600 dark:text-slate-300">Warehouse Coverage</span>
          <span class="font-black text-slate-900 dark:text-white"><%= @readiness[:breakdown][:warehouse_coverage_percentage] %>%</span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
          <div class="bg-emerald-500 h-2 rounded-full" style="width: <%= @readiness[:breakdown][:warehouse_coverage_percentage] %>%"></div>
        </div>
        <span class="text-[10px] text-slate-400 mt-1 block">Weight: 25%</span>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60">
        <div class="flex justify-between items-center text-xs mb-1.5">
          <span class="font-bold text-slate-600 dark:text-slate-300">Emergency Preparedness</span>
          <span class="font-black text-slate-900 dark:text-white"><%= @readiness[:breakdown][:emergency_preparedness_percentage] %>%</span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
          <div class="bg-accent h-2 rounded-full" style="width: <%= @readiness[:breakdown][:emergency_preparedness_percentage] %>%"></div>
        </div>
        <span class="text-[10px] text-slate-400 mt-1 block">Weight: 20%</span>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60">
        <div class="flex justify-between items-center text-xs mb-1.5">
          <span class="font-bold text-slate-600 dark:text-slate-300">Risk Resilience</span>
          <span class="font-black text-slate-900 dark:text-white"><%= @readiness[:breakdown][:risk_resilience_percentage] %>%</span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
          <div class="bg-amber-500 h-2 rounded-full" style="width: <%= @readiness[:breakdown][:risk_resilience_percentage] %>%"></div>
        </div>
        <span class="text-[10px] text-slate-400 mt-1 block">Weight: 25%</span>
      </div>
    </div>

    <!-- Explanation & Dynamic Recommendation -->
    <div class="space-y-3">
      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-300 leading-relaxed">
        <strong>Executive Assessment:</strong> <%= @readiness[:explanation] %>
      </div>

      <div class="p-4 rounded-xl bg-accent/10 dark:bg-accent/10 border border-accent/20 dark:border-accent/20 text-xs text-accent dark:text-accent flex items-start space-x-3">
        <i class="fas fa-lightbulb text-accent dark:text-accent mt-0.5 text-sm flex-shrink-0"></i>
        <span><strong>ResQWay Recommendation:</strong> <%= @readiness[:recommendation] %></span>
      </div>
    </div>
  </div>

  <!-- SECTION 4: Disaster Intelligence & Emergency Analytics -->
  <div id="disaster-intelligence" class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 sm:p-6 space-y-5">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h3 class="text-sm font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-biohazard text-red-600 mr-2 text-xs"></i>
          <span>Disaster Intelligence &amp; Emergency Telemetry</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Historical and active disaster records analyzed across regional operations.</p>
      </div>
      <%= link_to emergencies_path, class: "text-xs font-bold text-red-600 dark:text-red-400 hover:underline" do %>
        <span>Go to Response Center &rarr;</span>
      <% end %>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
      <!-- 4 Quick Emergency Stat Boxes -->
      <div class="space-y-3">
        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/60">
          <span class="text-[10px] font-bold uppercase text-slate-400">Total Emergencies</span>
          <span class="text-2xl font-black text-slate-900 dark:text-white block mt-0.5"><%= @total_emergencies_count %></span>
        </div>

        <div class="p-3.5 rounded-xl bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-900/60">
          <span class="text-[10px] font-bold uppercase text-red-600 dark:text-red-400">Active / Responding</span>
          <span class="text-2xl font-black text-red-700 dark:text-red-300 block mt-0.5"><%= @active_emergencies_count %></span>
        </div>

        <div class="p-3.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-900/60">
          <span class="text-[10px] font-bold uppercase text-emerald-600 dark:text-emerald-400">Resolved Disasters</span>
          <span class="text-2xl font-black text-emerald-700 dark:text-emerald-300 block mt-0.5"><%= @resolved_emergencies_count %></span>
        </div>

        <div class="p-3.5 rounded-xl bg-orange-50 dark:bg-orange-950/60 border border-orange-200 dark:border-orange-900/60">
          <span class="text-[10px] font-bold uppercase text-orange-600 dark:text-orange-400">Critical Severity Events</span>
          <span class="text-2xl font-black text-orange-700 dark:text-orange-300 block mt-0.5"><%= @critical_severity_count %></span>
        </div>
      </div>

      <!-- Emergency Type Breakdown Chart -->
      <div class="lg:col-span-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl p-5 border border-slate-200 dark:border-slate-700/60 flex flex-col justify-between">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider block mb-3">Hazard Type Distribution</span>

        <div class="space-y-3">
          <% @emergency_types_breakdown.each do |type, count| %>
            <% pct = (@total_emergencies_count > 0 ? (count.to_f / @total_emergencies_count * 100).round(1) : 0) %>
            <div>
              <div class="flex justify-between items-center text-xs font-bold text-slate-800 dark:text-slate-200 mb-1">
                <span><%= type %></span>
                <span><%= count %> incidents (<%= pct %>%)</span>
              </div>
              <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2.5 overflow-hidden">
                <div class="bg-red-500 h-2.5 rounded-full" style="width: <%= pct %>%"></div>
              </div>
            </div>
          <% end %>
        </div>

        <p class="text-[11px] text-slate-400 mt-4 pt-2 border-t border-slate-200 dark:border-slate-700">
          Monsoon cloudbursts and mountainous topography drive over 70% of logistics disruptions in the region.
        </p>
      </div>
    </div>
  </div>

  <!-- SECTION 5: Critical Intelligence Watchlist -->
  <div id="critical-watchlist" class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-list-ol text-red-600 mr-2 text-xs"></i>
          <span>Critical Intelligence Watchlist</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Top settlements exhibiting the highest combined disruption vulnerability.</p>
      </div>
      <%= link_to accessibility_path, class: "text-xs font-bold text-accent dark:text-accent hover:underline" do %>
        <span>View All Risk Intelligence &rarr;</span>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
        <thead class="bg-slate-50 dark:bg-slate-800/60 font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider text-[10px]">
          <tr>
            <th scope="col" class="px-5 py-3">Rank</th>
            <th scope="col" class="px-5 py-3">Location</th>
            <th scope="col" class="px-5 py-3">State / District</th>
            <th scope="col" class="px-5 py-3">Predicted Risk</th>
            <th scope="col" class="px-5 py-3">Accessibility</th>
            <th scope="col" class="px-5 py-3">Primary Threat</th>
            <th scope="col" class="px-5 py-3">Status</th>
            <th scope="col" class="px-5 py-3 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-300">
          <% @watchlist_locations.each_with_index do |item, idx| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="px-5 py-3.5">
                <span class="w-6 h-6 rounded-full bg-slate-900 dark:bg-slate-700 text-white font-black text-xs flex items-center justify-center">
                  #<%= idx + 1 %>
                </span>
              </td>
              <td class="px-5 py-3.5 font-bold text-slate-900 dark:text-white"><%= item[:name] %></td>
              <td class="px-5 py-3.5 text-slate-500 dark:text-slate-400"><%= item[:district] %>, <%= item[:state] %></td>
              <td class="px-5 py-3.5 font-mono font-black text-red-600 dark:text-red-400">
                <%= item[:risk_score] %>/100
              </td>
              <td class="px-5 py-3.5 font-mono font-bold text-slate-900 dark:text-white">
                <%= item[:accessibility_score] %>/100
              </td>
              <td class="px-5 py-3.5">
                <span class="inline-flex items-center text-amber-700 dark:text-amber-300 font-semibold">
                  <i class="fas fa-exclamation-circle text-xs mr-1 text-amber-500"></i>
                  <%= item[:primary_threat] %>
                </span>
              </td>
              <td class="px-5 py-3.5">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase font-bold border <%= item[:status_badge] %>">
                  <%= item[:status_text] %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-right">
                <%= link_to "View Intelligence", accessibility_location_path(item[:id]), class: "text-xs font-bold text-accent dark:text-accent hover:underline bg-accent/10 dark:bg-accent/10 px-2.5 py-1 rounded-lg border border-accent/20 dark:border-accent/20" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- SECTION 6: Regional State Comparison -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 sm:p-6 space-y-4">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
      <div>
        <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-chart-bar text-accent dark:text-accent mr-2 text-xs"></i>
          <span>Regional State Comparison</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Cross-state comparative analysis across all 8 North Eastern states.</p>
      </div>
      <span class="text-xs font-mono text-slate-400">Ranked by Average Risk</span>
    </div>

    <!-- Horizontal Bar Comparisons -->
    <div class="space-y-3">
      <% @state_comparison.each do |st| %>
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60 hover:border-slate-300 transition-all">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2 gap-2">
            <div class="flex items-center space-x-2">
              <span class="font-bold text-sm text-slate-900 dark:text-white"><%= st[:state] %></span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">(<%= st[:location_count] %> locations)</span>
            </div>
            <div class="flex items-center space-x-4 text-xs font-mono">
              <span>Avg Access: <strong class="text-slate-900 dark:text-white"><%= st[:avg_accessibility] %>/100</strong></span>
              <span>Avg Risk: <strong class="<%= st[:avg_risk] >= 50 ? 'text-red-600 dark:text-red-400' : 'text-slate-900 dark:text-white' %>"><%= st[:avg_risk] %>/100</strong></span>
              <% if st[:active_emergencies] > 0 %>
                <span class="px-2 py-0.5 rounded text-[10px] font-black bg-red-100 dark:bg-red-950 text-red-800 dark:text-red-300"><%= st[:active_emergencies] %> Active Alerts</span>
              <% else %>
                <span class="text-slate-400 text-[11px]">Nominal</span>
              <% end %>
            </div>
          </div>

          <!-- Dual Horizontal Bar: Green for Accessibility, Red for Risk -->
          <div class="grid grid-cols-2 gap-2">
            <div>
              <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
                <div class="bg-accent h-2 rounded-full" style="width: <%= st[:avg_accessibility] %>%"></div>
              </div>
            </div>
            <div>
              <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
                <div class="bg-red-500 h-2 rounded-full" style="width: <%= st[:avg_risk] %>%"></div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- SECTION 9: Regional Intelligence Trends -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 sm:p-6 space-y-4">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
      <div>
        <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-chart-line text-emerald-600 dark:text-emerald-400 mr-2 text-xs"></i>
          <span>Regional Intelligence Trends</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Longitudinal telemetry tracking and risk progression.</p>
      </div>
      <span class="text-xs font-mono text-slate-400">Historical &amp; Sensor Analytics</span>
    </div>

    <!-- 3 Trend Indicator Columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase block mb-1">Emergency Activity Trend</span>
        <div class="flex items-center space-x-2 text-red-600 dark:text-red-400 font-bold text-sm">
          <i class="fas fa-arrow-trend-up"></i>
          <span>Seasonal Elevation (+18%)</span>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">Monsoon cloudburst cycle creates peak hazard activity between June and September.</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase block mb-1">Risk Index Trend</span>
        <div class="flex items-center space-x-2 text-amber-600 dark:text-amber-400 font-bold text-sm">
          <i class="fas fa-arrow-trend-up"></i>
          <span>Moderate Upward Shift</span>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">Geotechnical slope saturation increases landslide vulnerability in Dima Hasao and Tawang.</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase block mb-1">Accessibility Baseline</span>
        <div class="flex items-center space-x-2 text-emerald-600 dark:text-emerald-400 font-bold text-sm">
          <i class="fas fa-arrows-left-right"></i>
          <span>Stable Valley Arteries</span>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">National highway network maintenance preserves steady multi-axle freight throughput.</p>
      </div>
    </div>
  </div>

  <!-- SECTION 11: Regional Intelligence Map -->
  <div id="regional-map" class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden"
       data-controller="analytics-map"
       data-analytics-map-locations-value="<%= @map_locations.to_json %>"
       data-analytics-map-warehouses-value="<%= @map_warehouses.to_json %>"
       data-analytics-map-emergencies-value="<%= @map_emergencies.to_json %>">
    
    <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-map-marked-alt text-accent dark:text-accent mr-2 text-xs"></i>
          <span>Regional Intelligence Map</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Toggle live spatial intelligence layers across the North East.</p>
      </div>

      <!-- Mode Switcher Buttons -->
      <div class="flex flex-wrap items-center gap-1.5 bg-slate-100 dark:bg-slate-800 p-1 rounded-xl text-xs font-bold">
        <button type="button" data-action="click->analytics-map#switchMode" data-mode="accessibility" data-analytics-map-target="modeButton"
                class="px-3 py-1.5 rounded-lg bg-accent text-white shadow-sm transition-colors cursor-pointer">
          Accessibility Mode
        </button>
        <button type="button" data-action="click->analytics-map#switchMode" data-mode="risk" data-analytics-map-target="modeButton"
                class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer">
          Risk Mode
        </button>
        <button type="button" data-action="click->analytics-map#switchMode" data-mode="emergencies" data-analytics-map-target="modeButton"
                class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer">
          Emergencies
        </button>
        <button type="button" data-action="click->analytics-map#switchMode" data-mode="warehouses" data-analytics-map-target="modeButton"
                class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer">
          Warehouses
        </button>
      </div>
    </div>

    <div data-analytics-map-target="container" style="min-height: 300px; width: 100%; display: block;" class="w-full z-10 h-[340px] sm:h-[420px] lg:h-[520px]"></div>
  </div>
</div>
