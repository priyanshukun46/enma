<div class="max-w-4xl mx-auto space-y-6 pb-16"
     data-controller="incident-modal">

  <!-- Breadcrumbs & Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 border-b border-slate-200 dark:border-slate-800 gap-3">
    <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400">
      <%= link_to incidents_path, class: "text-accent dark:text-accent hover:underline font-bold flex items-center" do %>
        <i class="fas fa-arrow-left mr-1.5 text-xs"></i>
        <span>Field Incidents</span>
      <% end %>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-black">Report #<%= @incident.id %></span>
    </div>

    <div class="flex items-center space-x-2.5">
      <%= link_to map_path, class: "inline-flex items-center px-3.5 py-1.5 rounded-xl bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs font-bold shadow-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-all" do %>
        <i class="fas fa-map-location-dot text-accent dark:text-accent mr-1.5 text-xs"></i>
        <span>View on GIS Map</span>
      <% end %>

      <%= link_to new_incident_path, class: "inline-flex items-center px-3.5 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-black rounded-xl shadow-sm transition-all" do %>
        <i class="fas fa-plus mr-1.5 text-xs"></i>
        <span>New Report</span>
      <% end %>
    </div>
  </div>

  <!-- Incident Primary Header Card -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
      
      <div class="space-y-3 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider border <%= @incident.severity_badge_class %>">
            Severity: <%= @incident.severity.upcase %>
          </span>

          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider border <%= @incident.status_badge_class %>">
            Status: <%= @incident.status.upcase %>
          </span>

          <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
            <%= @incident.type_emoji %> <%= @incident.type_label %>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
          <%= @incident.location_name.presence || "#{@incident.type_label} Incident" %>
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400 font-mono">
          <span class="flex items-center">
            <i class="fas fa-crosshairs text-accent mr-1.5"></i>
            <%= @incident.latitude.round(5) %>°N, <%= @incident.longitude.round(5) %>°E
          </span>
          <% if @incident.district.present? || @incident.state.present? %>
            <span>&bull;</span>
            <span><%= [@incident.district, @incident.state].compact.join(", ") %></span>
          <% end %>
          <span>&bull;</span>
          <span><i class="fas fa-clock mr-1"></i> Reported <%= @incident.formatted_reported_time %></span>
        </div>
      </div>

      <!-- Reporter Info -->
      <div class="bg-slate-50 dark:bg-slate-800/60 rounded-2xl p-4 border border-slate-200 dark:border-slate-700 min-w-[220px]">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Field Reporting Officer</span>
        <div class="flex items-center space-x-2.5 mt-2">
          <div class="w-8 h-8 rounded-full bg-accent text-white font-black text-xs flex items-center justify-center shadow">
            <%= @incident.user&.initials || "FO" %>
          </div>
          <div>
            <div class="text-xs font-black text-slate-900 dark:text-white"><%= @incident.user&.name || "Field Officer" %></div>
            <div class="text-[10px] text-slate-400 font-mono"><%= @incident.user&.role&.titleize || "Authorized Reporter" %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Multi-Source Data Confidence Intelligence Card -->
  <% conf = @incident.confidence_data %>
  <% overall = (conf[:overall_confidence] || @incident.confidence_score).to_f.round(1) %>
  <% trust = (conf[:data_trust_score] || overall).to_f.round(1) %>
  <% relevance = (conf[:operational_relevance_score] || overall).to_f.round(1) %>
  <% breakdown = conf[:breakdown] || {} %>

  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-slate-100 dark:border-slate-800 gap-4">
      <div>
        <div class="flex items-center space-x-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
            <i class="fas fa-microchip-ai mr-1"></i> Confidence Intelligence Engine
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase border <%= @incident.confidence_badge_class %>">
            <%= @incident.confidence_level %> CONFIDENCE
          </span>
        </div>
        <h2 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white mt-1">Multi-Source Verification &amp; Operational Relevance</h2>
      </div>

      <div class="flex items-center space-x-3 bg-slate-50 dark:bg-slate-800/80 px-4 py-2.5 rounded-2xl border border-slate-200 dark:border-slate-700">
        <div class="text-right">
          <span class="text-[10px] uppercase font-bold text-slate-400 block leading-tight">Composite Score</span>
          <span class="text-xs font-semibold text-slate-600 dark:text-slate-300 font-mono"><%= @incident.confidence_level %></span>
        </div>
        <div class="text-3xl font-black font-mono text-slate-900 dark:text-white">
          <%= overall.round(0) %><span class="text-xs text-slate-400 font-normal">/100</span>
        </div>
      </div>
    </div>

    <!-- Trust vs Operational Relevance Split -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center">
            <i class="fas fa-shield-halved text-accent mr-1.5"></i>
            Data Trust Score
          </span>
          <span class="text-base font-black font-mono text-slate-900 dark:text-white"><%= trust %>%</span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
          <div class="bg-indigo-600 h-full rounded-full transition-all duration-500" style="width: <%= [trust, 100].min %>%"></div>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">
          Evaluates empirical truth, coordinate accuracy, photo authenticity, weather cross-checks, and reporter integrity.
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center">
            <i class="fas fa-hourglass-half text-amber-500 mr-1.5"></i>
            Operational Dispatch Relevance
          </span>
          <span class="text-base font-black font-mono text-slate-900 dark:text-white"><%= relevance %>%</span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
          <div class="bg-amber-500 h-full rounded-full transition-all duration-500" style="width: <%= [relevance, 100].min %>%"></div>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">
          Real-time logistical relevance dynamically decayed over time as physical hazards evolve or resolve.
        </p>
      </div>
    </div>

    <!-- 6 Signal Vector Breakdown Grid -->
    <div class="space-y-3">
      <h3 class="text-xs font-black uppercase text-slate-600 dark:text-slate-400 tracking-wider">
        6-Dimensional Corroboration Matrix
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <!-- 1. GPS Authenticity -->
        <% gps = breakdown[:gps_authenticity] || {} %>
        <% gps_score = (gps[:score] || 15.0).to_f %>
        <div class="p-3.5 rounded-2xl border border-slate-150 dark:border-slate-800 bg-white dark:bg-slate-900/60 space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center">
              <i class="fas fa-location-crosshairs text-blue-500 mr-1.5"></i> GPS Precision
            </span>
            <span class="font-mono font-black text-slate-900 dark:text-white"><%= gps_score.round(1) %>/20</span>
          </div>
          <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
            <div class="bg-blue-500 h-full rounded-full" style="width: <%= (gps_score / 20.0 * 100).clamp(0, 100) %>%"></div>
          </div>
          <p class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">
            <%= gps[:explanation] || "Sub-meter precision coordinate validation." %>
          </p>
        </div>

        <!-- 2. Photographic Evidence -->
        <% photo = breakdown[:photographic_evidence] || {} %>
        <% photo_score = (photo[:score] || 0.0).to_f %>
        <div class="p-3.5 rounded-2xl border border-slate-150 dark:border-slate-800 bg-white dark:bg-slate-900/60 space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center">
              <i class="fas fa-camera text-emerald-500 mr-1.5"></i> Photo Evidence
            </span>
            <span class="font-mono font-black text-slate-900 dark:text-white"><%= photo_score.round(1) %>/20</span>
          </div>
          <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
            <div class="bg-emerald-500 h-full rounded-full" style="width: <%= (photo_score / 20.0 * 100).clamp(0, 100) %>%"></div>
          </div>
          <p class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">
            <%= photo[:explanation] || "Attached visual telemetry check." %>
          </p>
        </div>

        <!-- 3. Temporal Freshness -->
        <% temp = breakdown[:temporal_freshness] || {} %>
        <% temp_score = (temp[:score] || 15.0).to_f %>
        <div class="p-3.5 rounded-2xl border border-slate-150 dark:border-slate-800 bg-white dark:bg-slate-900/60 space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center">
              <i class="fas fa-clock text-amber-500 mr-1.5"></i> Freshness
            </span>
            <span class="font-mono font-black text-slate-900 dark:text-white"><%= temp_score.round(1) %>/15</span>
          </div>
          <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
            <div class="bg-amber-500 h-full rounded-full" style="width: <%= (temp_score / 15.0 * 100).clamp(0, 100) %>%"></div>
          </div>
          <p class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">
            <%= temp[:explanation] || "Age decay scoring." %>
          </p>
        </div>

        <!-- 4. Environmental Weather Corroboration -->
        <% env = breakdown[:environmental_weather] || {} %>
        <% env_score = (env[:score] || 10.0).to_f %>
        <div class="p-3.5 rounded-2xl border border-slate-150 dark:border-slate-800 bg-white dark:bg-slate-900/60 space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center">
              <i class="fas fa-cloud-bolt text-indigo-500 mr-1.5"></i> Weather Verification
            </span>
            <span class="font-mono font-black text-slate-900 dark:text-white"><%= env_score.round(1) %>/20</span>
          </div>
          <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
            <div class="bg-indigo-500 h-full rounded-full" style="width: <%= (env_score / 20.0 * 100).clamp(0, 100) %>%"></div>
          </div>
          <p class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">
            <%= env[:explanation] || "Cross-referenced with regional telemetry." %>
          </p>
        </div>

        <!-- 5. Spatial Consensus -->
        <% spat = breakdown[:spatial_consensus] || {} %>
        <% spat_score = (spat[:score] || 0.0).to_f %>
        <div class="p-3.5 rounded-2xl border border-slate-150 dark:border-slate-800 bg-white dark:bg-slate-900/60 space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center">
              <i class="fas fa-bullseye text-purple-500 mr-1.5"></i> Spatial Consensus
            </span>
            <span class="font-mono font-black text-slate-900 dark:text-white"><%= spat_score.round(1) %>/15</span>
          </div>
          <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
            <div class="bg-purple-500 h-full rounded-full" style="width: <%= (spat_score / 15.0 * 100).clamp(0, 100) %>%"></div>
          </div>
          <p class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">
            <%= spat[:explanation] || "Cluster corroboration from nearby incidents." %>
          </p>
        </div>

        <!-- 6. Reporter Reliability -->
        <% rep = breakdown[:reporter_reliability] || {} %>
        <% rep_score = (rep[:score] || 6.0).to_f %>
        <div class="p-3.5 rounded-2xl border border-slate-150 dark:border-slate-800 bg-white dark:bg-slate-900/60 space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center">
              <i class="fas fa-user-check text-teal-500 mr-1.5"></i> Reporter Reliability
            </span>
            <span class="font-mono font-black text-slate-900 dark:text-white"><%= rep_score.round(1) %>/10</span>
          </div>
          <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
            <div class="bg-teal-500 h-full rounded-full" style="width: <%= (rep_score / 10.0 * 100).clamp(0, 100) %>%"></div>
          </div>
          <p class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">
            <%= rep[:explanation] || "Historical verification track record." %>
          </p>
        </div>
      </div>
    </div>

    <!-- Warnings / Alerts Banner if any -->
    <% if conf[:warnings].present? && conf[:warnings].any? %>
      <div class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/80 space-y-1.5">
        <div class="flex items-center text-xs font-bold text-amber-800 dark:text-amber-300">
          <i class="fas fa-triangle-exclamation mr-2"></i>
          Intelligence Reliability Notices (<%= conf[:warnings].size %>)
        </div>
        <ul class="text-xs text-amber-700 dark:text-amber-400 list-disc list-inside space-y-0.5">
          <% conf[:warnings].each do |warn| %>
            <li><%= warn %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Actionable Dispatch Recommendations -->
    <% if conf[:actionable_recommendations].present? && conf[:actionable_recommendations].any? %>
      <div class="p-4 rounded-2xl bg-indigo-50/60 dark:bg-indigo-950/30 border border-indigo-100 dark:border-indigo-900/60 space-y-2">
        <div class="flex items-center text-xs font-bold text-indigo-900 dark:text-indigo-200">
          <i class="fas fa-route mr-2 text-accent"></i>
          Operational Dispatch Protocol
        </div>
        <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-1">
          <% conf[:actionable_recommendations].each do |rec| %>
            <li class="flex items-start">
              <i class="fas fa-check-circle text-emerald-500 text-[11px] mt-0.5 mr-2 flex-shrink-0"></i>
              <span><%= rec %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <!-- Description Card -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
    <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
      <i class="fas fa-align-left text-accent mr-2"></i>
      Field Observation Telemetry
    </h3>
    <p class="text-sm sm:text-base text-slate-700 dark:text-slate-200 leading-relaxed whitespace-pre-line">
      <%= @incident.description %>
    </p>
  </div>

  <!-- Photographic Evidence Gallery -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
      <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
        <i class="fas fa-camera-retro text-accent mr-2"></i>
        Photographic Evidence (<%= @incident.photos.attached? ? @incident.photos.count : 0 %>)
      </h3>
      <span class="text-[11px] text-slate-400 font-mono">Touch photo to expand</span>
    </div>

    <% if @incident.photos.attached? && @incident.photos.any? %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        <% @incident.photos.each_with_index do |photo, idx| %>
          <div class="relative group rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 aspect-square shadow-sm cursor-pointer"
               data-action="click->incident-modal#open"
               data-full-src="<%= url_for(photo) %>"
               data-caption="Evidence Photo #<%= idx + 1 %> — <%= @incident.type_label %> (<%= @incident.location_name %>)">
            <%= image_tag photo, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300", alt: "Incident evidence photo" %>
            <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
              <i class="fas fa-magnifying-glass-plus text-xl drop-shadow"></i>
            </div>
            <div class="absolute bottom-1.5 left-1.5 px-2 py-0.5 rounded bg-black/70 text-white text-[9px] font-mono">
              Photo <%= idx + 1 %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8 text-slate-400 text-xs italic">
        <i class="fas fa-image text-2xl text-slate-300 dark:text-slate-700 mb-2 block"></i>
        No photographic evidence was attached to this initial field report.
      </div>
    <% end %>
  </div>

  <!-- Fullscreen Photo Lightbox Modal -->
  <div data-incident-modal-target="modal"
       class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex flex-col items-center justify-center p-4">
    <button type="button"
            data-action="click->incident-modal#close"
            class="absolute top-5 right-5 text-white/80 hover:text-white text-2xl p-2 cursor-pointer transition-colors">
      <i class="fas fa-times"></i>
    </button>

    <div class="max-w-4xl max-h-[85vh] w-full flex flex-col items-center">
      <img data-incident-modal-target="modalImage"
           src=""
           alt="Fullscreen preview"
           class="max-w-full max-h-[75vh] object-contain rounded-2xl shadow-2xl border border-white/10">
      <p data-incident-modal-target="modalCaption"
         class="text-white/80 text-xs sm:text-sm font-medium mt-3 text-center"></p>
    </div>
  </div>
</div>
