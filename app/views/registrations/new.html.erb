<div class="min-h-[80vh] flex flex-col justify-center items-center py-6 px-4">
  <div class="max-w-md w-full space-y-6">
    <!-- Header with Branding -->
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-600 text-white shadow-xl mb-3">
        <span class="text-3xl">⚡</span>
      </div>
      <h2 class="text-3xl font-black text-gray-900 tracking-tight">ENMA AI</h2>
      <p class="text-xs text-gray-500 font-semibold mt-1">Smart Logistics &amp; Accessibility Intelligence</p>
      <p class="text-sm font-bold text-gray-700 mt-2">Create your Operator Account</p>
    </div>

    <!-- Registration Form Card -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-7 md:p-8 space-y-5">
      <%= form_with model: @user, url: sign_up_path, local: true, class: "space-y-4" do |f| %>
        
        <div>
          <%= f.label :name, "Full Name", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :name,
                           required: true,
                           autofocus: true,
                           placeholder: "e.g. Captain Ananya Roy",
                           class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div>
          <%= f.label :email_address, "Email Address", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email_address,
                            required: true,
                            placeholder: "officer@ndrf.gov.in",
                            class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div>
          <%= f.label :password, "Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password,
                               required: true,
                               placeholder: "Minimum 8 characters",
                               class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password_confirmation,
                               required: true,
                               placeholder: "Re-enter password",
                               class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div class="p-3.5 rounded-xl bg-gray-50 border border-gray-200 text-[11px] text-gray-600 flex items-start space-x-2">
          <i class="fas fa-shield-alt text-indigo-600 mt-0.5 flex-shrink-0"></i>
          <span>New accounts are assigned <strong>Operator</strong> permissions by default. Administrator roles are granted securely by system administrators.</span>
        </div>

        <div>
          <%= f.submit "Create Account & Sign In",
                       class: "w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-sm rounded-xl shadow-md hover:shadow-lg transition-all duration-150 cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      <% end %>

      <!-- Back to Login Link -->
      <div class="text-center pt-2 border-t border-gray-100">
        <p class="text-xs text-gray-600">
          Already registered?
          <%= link_to "Sign In", login_path, class: "font-bold text-indigo-600 hover:text-indigo-800 ml-1" %>
        </p>
      </div>
    </div>
  </div>
</div>
