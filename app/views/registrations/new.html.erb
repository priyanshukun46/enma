<div class="min-h-[85vh] flex flex-col justify-center items-center py-10 px-4 sm:px-6">
  <div class="max-w-md w-full space-y-6">
    
    <!-- Header with Branding (Google Stitch Style) -->
    <div class="text-center space-y-2">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-600 dark:bg-indigo-500 text-white shadow-lg shadow-indigo-600/20 mb-1">
        <span class="text-2xl font-black">⚡</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">ENMA AI</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Smart Logistics &amp; Accessibility Intelligence</p>
      <p class="text-sm font-bold text-slate-800 dark:text-slate-200 pt-1">Create your Operator Account</p>
    </div>

    <!-- Registration Form Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-5">
      <%= form_with model: @user, url: sign_up_path, local: true, data: { turbo: false }, class: "space-y-4" do |f| %>
        
        <div>
          <%= f.label :name, "Full Name", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :name,
                           required: true,
                           autofocus: true,
                           placeholder: "e.g. Captain Ananya Roy",
                           class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>

        <div>
          <%= f.label :email_address, "Email Address", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email_address,
                            required: true,
                            placeholder: "officer@ndrf.gov.in",
                            class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>

        <div>
          <%= f.label :username, "Username (Optional - auto-generated if left blank)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :username,
                           placeholder: "e.g. ananya_roy",
                           class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>

        <div>
          <%= f.label :password, "Password", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password,
                               required: true,
                               placeholder: "Minimum 8 characters",
                               class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password_confirmation,
                               required: true,
                               placeholder: "Re-enter password",
                               class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 text-[11px] text-slate-600 dark:text-slate-300 flex items-start space-x-2.5">
          <i class="fas fa-shield-alt text-indigo-600 dark:text-indigo-400 mt-0.5 flex-shrink-0"></i>
          <span>New accounts are assigned <strong>Operator</strong> permissions by default. Administrator roles are granted securely by system administrators.</span>
        </div>

        <div class="pt-1">
          <%= f.submit "Create Account & Sign In",
                       class: "w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs sm:text-sm rounded-xl shadow-md transition-all cursor-pointer" %>
        </div>
      <% end %>

      <!-- Back to Login Link -->
      <div class="text-center pt-2 border-t border-slate-100 dark:border-slate-800">
        <p class="text-xs text-slate-600 dark:text-slate-400">
          Already registered?
          <%= link_to "Sign In", login_path, class: "font-black text-indigo-600 dark:text-indigo-400 hover:underline ml-1" %>
        </p>
      </div>
    </div>
  </div>
</div>
