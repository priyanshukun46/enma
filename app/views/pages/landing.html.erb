<div data-controller="landing-page" class="w-full relative bg-[#EAEEF0] text-[#212121] min-h-screen selection:bg-[#FF471D] selection:text-white font-sans">

  <!-- ============================================================== -->
  <!-- TOP NAVIGATION HEADER (#212121)                                -->
  <!-- ============================================================== -->
  <%= render "shared/resqway_header" %>

  <!-- ============================================================== -->
  <!-- HERO SECTION WITH BACKGROUND & FEDEX-STYLE TELEMETRY CARD      -->
  <!-- ============================================================== -->
  <section class="relative pt-24 sm:pt-28 min-h-[760px] flex flex-col justify-between overflow-hidden bg-cover bg-no-repeat"
           style="background-image: linear-gradient(to bottom, rgba(33, 33, 33, 0.70) 0%, rgba(16, 46, 57, 0.40) 36%, rgba(234, 238, 240, 0.90) 85%, #EAEEF0 100%), url('<%= image_path("hero_bg.jpg") %>'); background-position: center 34%;">
    
    <!-- Hero Center Headline (Clean, bold, authoritative FedEx logistics feel) -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-10 sm:pt-16 pb-8 relative z-10">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.85)]">
        Welcome to ResQWay
      </h1>
      <p class="text-xs sm:text-sm text-slate-200 max-w-xl mx-auto font-medium mt-3 drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
        Logistics, Real-Time Tracking &amp; Predictive Risk Intelligence Cockpit
      </p>
    </div>

    <!-- Floating Interactive Multi-Tab Telemetry Widget -->
    <div class="w-full max-w-3xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="bg-white rounded-t-2xl shadow-[0_20px_50px_rgba(16,46,57,0.18)] overflow-hidden border border-slate-200/90 transition-all duration-300">
        
        <!-- Tab Navigation Bar -->
        <div class="grid grid-cols-3 border-b border-slate-200 text-center text-xs font-bold uppercase tracking-wider">
          
          <!-- Tab 1: Smart Route -->
          <button type="button"
                  data-landing-page-target="tabBtn"
                  data-tab="smart_route"
                  data-action="click->landing-page#switchTab"
                  class="py-3.5 px-4 bg-white text-slate-700 hover:bg-[#EAEEF0] hover:text-[#212121] flex items-center justify-center space-x-2 transition-all focus:outline-none cursor-pointer">
            <i class="fas fa-route text-slate-500"></i>
            <span class="truncate">Smart Route</span>
          </button>

          <!-- Tab 2: Live Fleet (Default Active Tab) -->
          <button type="button"
                  data-landing-page-target="tabBtn"
                  data-tab="live_fleet"
                  data-action="click->landing-page#switchTab"
                  class="py-3.5 px-4 bg-[#102E39] text-white flex items-center justify-center space-x-2 transition-all focus:outline-none cursor-pointer"
                  aria-selected="true">
            <i class="fas fa-ship text-slate-300"></i>
            <span class="truncate">Live Fleet</span>
          </button>

          <!-- Tab 3: Field Incidence -->
          <button type="button"
                  data-landing-page-target="tabBtn"
                  data-tab="field_incidence"
                  data-action="click->landing-page#switchTab"
                  class="py-3.5 px-4 bg-white text-slate-700 hover:bg-[#EAEEF0] hover:text-[#212121] flex items-center justify-center space-x-2 transition-all focus:outline-none cursor-pointer">
            <i class="fas fa-triangle-exclamation text-slate-500"></i>
            <span class="truncate">Field Incidence</span>
          </button>

        </div>

        <!-- Tab Panes Container -->
        <div class="p-6 sm:p-7 text-[#212121] bg-white">
          
          <!-- Pane 1: Smart Route -->
          <div data-landing-page-target="tabPane" data-tab="smart_route" class="hidden space-y-5">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-3xl font-black text-[#212121]">0.1ms</span>
                <span class="text-xs font-black uppercase tracking-wider text-slate-700 ml-2">Triple-Buffered Optimizer</span>
              </div>
              <span class="text-xs font-semibold text-slate-500">Instant Risk Detour In-Memory</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-y border-slate-100 py-4">
              <div>
                <span class="text-xl font-bold text-[#212121]">NH-27 / NH-10</span>
                <span class="block text-xs text-slate-500">Siliguri Arterial Lifeline</span>
              </div>
              <div>
                <span class="text-xl font-bold text-emerald-600">98.4%</span>
                <span class="block text-xs text-slate-500">Corridor Reliability</span>
              </div>
              <div>
                <span class="text-xl font-bold text-[#FF471D]">3 Alts</span>
                <span class="block text-xs text-slate-500">Dynamic Alternate Corridors</span>
              </div>
            </div>

            <div class="flex items-center justify-between pt-2">
              <span class="text-xs font-medium text-emerald-600 flex items-center space-x-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Real-time terrain gradient analysis</span>
              </span>
              <%= link_to routes_path, class: "px-6 py-2.5 rounded-lg bg-[#FF471D] hover:bg-[#e03e18] text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-orange-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center space-x-1.5" do %>
                <span>Calculate Smart Routes</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              <% end %>
            </div>
          </div>

          <!-- Pane 2: Live Fleet (Default Active Tab) -->
          <div data-landing-page-target="tabPane" data-tab="live_fleet" class="space-y-6">
            <!-- Active Global Fleets Counter -->
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="text-3xl sm:text-4xl font-black text-[#212121] leading-none">48</span>
                <div class="flex items-center space-x-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-xs font-extrabold uppercase tracking-wider text-[#212121]">
                    Active Global Fleets
                  </span>
                </div>
              </div>
              <span class="text-xs font-semibold text-slate-500">
                100% AIS Coverage
              </span>
            </div>

            <!-- Fleet Category Breakdown Columns -->
            <div class="grid grid-cols-3 divide-x divide-slate-200 border-y border-slate-100 py-3">
              <div class="pr-4">
                <span class="text-2xl font-bold text-[#212121] block leading-tight">24</span>
                <span class="text-xs text-slate-500">Ocean Vessels</span>
              </div>
              <div class="px-4">
                <span class="text-2xl font-bold text-[#212121] block leading-tight">14</span>
                <span class="text-xs text-slate-500">Air Freighters</span>
              </div>
              <div class="pl-4">
                <span class="text-2xl font-bold text-[#212121] block leading-tight">10</span>
                <span class="text-xs text-slate-500">Intermodal Rail</span>
              </div>
            </div>

            <!-- Bottom Live Telemetry Row & Action -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-1">
              <div class="flex items-center space-x-2 text-xs font-medium text-emerald-600">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Real-time GPS telemetry active</span>
              </div>

              <%= link_to shipments_path, class: "w-full sm:w-auto px-6 py-2.5 rounded-lg bg-[#FF471D] hover:bg-[#e03e18] text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-orange-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center space-x-1.5" do %>
                <span>View Live Fleet</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              <% end %>
            </div>
          </div>

          <!-- Pane 3: Field Incidence -->
          <div data-landing-page-target="tabPane" data-tab="field_incidence" class="hidden space-y-5">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-3xl font-black text-rose-600 leading-none">
                  <%= @total_emergencies.present? ? @total_emergencies : 6 %>
                </span>
                <span class="text-xs font-black uppercase tracking-wider text-[#212121] ml-2">Active Field Incidents</span>
              </div>
              <span class="text-xs font-semibold text-slate-500">Real-time Citizen &amp; Sensor Radar</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-y border-slate-100 py-4">
              <div>
                <span class="text-xl font-bold text-[#212121]">4</span>
                <span class="block text-xs text-slate-500">Monsoon Landslides</span>
              </div>
              <div>
                <span class="text-xl font-bold text-amber-600">2</span>
                <span class="block text-xs text-slate-500">Flooded Bridges</span>
              </div>
              <div>
                <span class="text-xl font-bold text-emerald-600">100%</span>
                <span class="block text-xs text-slate-500">Depots Pre-staged</span>
              </div>
            </div>

            <div class="flex items-center justify-between pt-2">
              <span class="text-xs font-medium text-slate-500 flex items-center space-x-1.5">
                <i class="fas fa-camera text-[#FF471D] text-xs"></i>
                <span>Geo-tagged photos attached to dispatch models</span>
              </span>
              <%= link_to incidents_path, class: "px-6 py-2.5 rounded-lg bg-[#FF471D] hover:bg-[#e03e18] text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-orange-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center space-x-1.5" do %>
                <span>View Field Incidents</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              <% end %>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Centered Scroll to Explore Indicator -->
    <div class="pt-6 pb-4 text-center relative z-10">
      <a href="#explore" class="inline-flex flex-col items-center space-y-1 text-slate-600 hover:text-[#FF471D] transition-colors group">
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-slate-600 group-hover:text-[#FF471D]">
          Scroll to explore
        </span>
        <i class="fas fa-chevron-down text-xs text-slate-600 group-hover:text-[#FF471D] animate-bounce"></i>
      </a>
    </div>

  </section>

  <!-- ============================================================== -->
  <!-- SPLIT PROMOTIONAL CALLOUT BANNER (FEDEX PRIORITY STYLE)        -->
  <!-- ============================================================== -->
  <section id="explore" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-2 pt-8 pb-16 relative z-20 reveal-on-scroll">
    <div class="rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl flex flex-col md:flex-row border border-[#102E39]/30 transition-all duration-300 hover:border-[#102E39]/50">
      
      <!-- Left Panel: Deep Teal/Petrol Essence (#102E39) Priority Offer -->
      <div class="bg-[#102E39] text-white p-8 sm:p-12 md:w-2/3 flex flex-col justify-between space-y-6 relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-56 h-56 rounded-full bg-cyan-500/10 blur-2xl pointer-events-none"></div>

        <div class="space-y-4 relative z-10">
          <!-- Discount Tag Icon -->
          <div class="w-12 h-12 rounded-xl bg-[#FF471D]/20 text-[#FF471D] flex items-center justify-center text-xl transition-transform duration-300 hover:scale-110 hover:rotate-6 shadow-inner">
            <i class="fas fa-tag"></i>
          </div>

          <!-- Headline -->
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight leading-tight">
            Sign up now and access priority rapid routing &amp; tactical supply chain corridors!
          </h2>

          <p class="text-sm sm:text-base text-slate-300 font-normal leading-relaxed">
            Benefit from our services and solutions designed to meet all of your shipping needs.
          </p>
        </div>

        <!-- Disclaimers -->
        <div class="space-y-1 pt-4 text-[10px] sm:text-[11px] text-slate-400 border-t border-white/10 relative z-10">
          <p>*This discount doesn't apply to freight-forwarders, re-sellers and organizations shipping dangerous goods or valuable items.</p>
          <p class="font-semibold">*Terms &amp; Conditions apply.</p>
        </div>
      </div>

      <!-- Right Panel: Crisp Off-White/White with Open Account Action -->
      <div class="bg-white text-[#212121] p-8 sm:p-12 md:w-1/3 flex items-center justify-center text-center">
        <div class="space-y-4 w-full">
          <%= link_to sign_up_path, class: "w-full block py-4 px-8 rounded-full bg-[#FF471D] hover:bg-[#e03e18] text-white font-black text-sm uppercase tracking-wider shadow-lg hover:shadow-orange-500/30 transition-all duration-200 hover:-translate-y-0.5 hover:scale-[1.02] active:scale-[0.98] text-center" do %>
            Open an Account
          <% end %>
          <p class="text-xs text-slate-500 font-medium">
            Instant setup in &lt; 2 minutes
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================== -->
  <!-- OPERATIONAL INTELLIGENCE & RESOURCES SECTION                   -->
  <!-- ============================================================== -->
  <section class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14 reveal-on-scroll">
    
    <!-- Section Headline -->
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[#212121]">
        Operational Intelligence &amp; Resources
      </h2>
      <p class="text-xs sm:text-sm text-slate-600">
        AI-enabled resilience systems guarding transportation corridors against natural bottlenecks.
      </p>
    </div>

    <!-- 3 Feature Cards Grid (Crisp White Cards on #EAEEF0 Background) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Feature Card 1: Global Fleet & GIS Mapping -->
      <div class="bg-white rounded-2xl overflow-hidden border border-slate-200/90 shadow-md flex flex-col group hover:border-[#102E39]/40 hover:-translate-y-2 hover:shadow-xl transition-all duration-300">
        <div class="h-48 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1559136555-9303baea8ebd?auto=format&fit=crop&w=800&q=80"
               alt="Global Maritime"
               class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <span class="absolute bottom-3 left-4 text-[10px] font-mono font-bold uppercase tracking-widest text-white bg-[#102E39] border border-white/20 backdrop-blur-xs px-2.5 py-1 rounded">
            Global Maritime
          </span>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <h3 class="text-lg font-bold text-[#212121] group-hover:text-[#102E39] tracking-tight transition-colors">
              Global Fleet &amp; GIS Mapping
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Track transpacific and transatlantic cargo vessels with real-time SATCOM AIS telemetry, live port congestion layers, and chokepoint monitoring.
            </p>
          </div>
          <%= link_to map_path, class: "inline-flex items-center space-x-1 text-xs font-bold text-[#FF471D] hover:text-[#e03e18] uppercase tracking-wider pt-2 group-hover:translate-x-1.5 transition-transform duration-200" do %>
            <span>Explore Intelligence Map</span>
            <i class="fas fa-arrow-right text-[10px]"></i>
          <% end %>
        </div>
      </div>

      <!-- Feature Card 2: Predictive Risk & Disruption AI -->
      <div class="bg-white rounded-2xl overflow-hidden border border-slate-200/90 shadow-md flex flex-col group hover:border-[#102E39]/40 hover:-translate-y-2 hover:shadow-xl transition-all duration-300">
        <div class="h-48 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1580674684081-7617fbf3d745?auto=format&fit=crop&w=800&q=80"
               alt="Predictive Risk"
               class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <span class="absolute bottom-3 left-4 text-[10px] font-mono font-bold uppercase tracking-widest text-white bg-[#102E39] border border-white/20 backdrop-blur-xs px-2.5 py-1 rounded">
            Disruption AI
          </span>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <h3 class="text-lg font-bold text-[#212121] group-hover:text-[#102E39] tracking-tight transition-colors">
              Predictive Risk &amp; Disruption AI
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Anticipate typhoon paths, canal congestion, and customs hold risks with proactive early warnings up to 72 hours before schedules are impacted.
            </p>
          </div>
          <%= link_to accessibility_path, class: "inline-flex items-center space-x-1 text-xs font-bold text-[#FF471D] hover:text-[#e03e18] uppercase tracking-wider pt-2 group-hover:translate-x-1.5 transition-transform duration-200" do %>
            <span>View Risk Radar</span>
            <i class="fas fa-arrow-right text-[10px]"></i>
          <% end %>
        </div>
      </div>

      <!-- Feature Card 3: Tactical Response & Relief Depots -->
      <div class="bg-white rounded-2xl overflow-hidden border border-slate-200/90 shadow-md flex flex-col group hover:border-[#102E39]/40 hover:-translate-y-2 hover:shadow-xl transition-all duration-300">
        <div class="h-48 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=800&q=80"
               alt="Cargo Logistics"
               class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <span class="absolute bottom-3 left-4 text-[10px] font-mono font-bold uppercase tracking-widest text-white bg-[#102E39] border border-white/20 backdrop-blur-xs px-2.5 py-1 rounded">
            Cargo Logistics
          </span>
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <h3 class="text-lg font-bold text-[#212121] group-hover:text-[#102E39] tracking-tight transition-colors">
              Tactical Response &amp; Relief Depots
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Activate 24/7 emergency dispatch, coordinate rapid cargo diversions, and deploy pre-staged humanitarian and medical inventory seamlessly.
            </p>
          </div>
          <%= link_to emergencies_path, class: "inline-flex items-center space-x-1 text-xs font-bold text-[#FF471D] hover:text-[#e03e18] uppercase tracking-wider pt-2 group-hover:translate-x-1.5 transition-transform duration-200" do %>
            <span>Access Emergency Center</span>
            <i class="fas fa-arrow-right text-[10px]"></i>
          <% end %>
        </div>
      </div>

    </div>

    <!-- Dual Showcase: Mountain Corridor Photography + High-Tech Dashboard Telemetry -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 reveal-on-scroll">
      
      <!-- Left Showcase: Mountain Corridors (Forest) -->
      <div class="rounded-2xl overflow-hidden border border-slate-300 shadow-xl relative min-h-[340px] flex items-end group hover:border-[#102E39]/40 hover:-translate-y-1 hover:shadow-2xl transition-all duration-300">
        <img src="https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1200&q=80"
             alt="Himalayan Corridors"
             class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out">
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent"></div>
        <div class="relative z-10 p-6 sm:p-8 space-y-1 text-white">
          <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#FF471D]">
            Geospatial Topography
          </span>
          <h4 class="text-xl font-bold">Alpine &amp; Mountain Corridors</h4>
          <p class="text-xs text-slate-200 leading-relaxed">
            Continuous elevation and precipitation analysis monitoring over 700km of remote high-altitude routes.
          </p>
        </div>
      </div>

      <!-- Right Showcase: Analytics Dashboard UI (Deep #102E39 Visual Dashboard) -->
      <div class="rounded-2xl overflow-hidden border border-[#0b2028] bg-[#102E39] p-6 sm:p-7 shadow-xl space-y-5 text-white flex flex-col justify-between hover:border-cyan-500/40 transition-all duration-300">
        
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <div class="flex items-center space-x-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-200">
              Users: Last 7 Days Using Median
            </span>
            <i class="fas fa-chevron-down text-[10px] text-slate-400"></i>
          </div>
          <span class="text-[11px] font-mono text-white font-bold bg-[#FF471D] px-2 py-0.5 rounded shadow-sm">
            Live Stream
          </span>
        </div>

        <!-- Simulated Median Load Time Chart -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs text-slate-300">
            <span>Median Load Time: <strong class="text-white">0.7s</strong></span>
            <span class="text-[#FF471D] font-semibold font-mono">57.1%</span>
          </div>

          <!-- Bar distribution visual -->
          <div class="h-24 flex items-end justify-between gap-1.5 pt-4">
            <div class="w-full bg-cyan-400/20 hover:bg-cyan-300 rounded-t h-[35%] transition-all duration-300 cursor-pointer" title="Day 1"></div>
            <div class="w-full bg-cyan-400/30 hover:bg-cyan-300 rounded-t h-[45%] transition-all duration-300 cursor-pointer" title="Day 2"></div>
            <div class="w-full bg-cyan-400/40 hover:bg-cyan-300 rounded-t h-[65%] transition-all duration-300 cursor-pointer" title="Day 3"></div>
            <div class="w-full bg-cyan-400/60 hover:bg-cyan-300 rounded-t h-[80%] transition-all duration-300 cursor-pointer" title="Day 4"></div>
            <div class="w-full bg-[#FF471D] rounded-t h-[95%] shadow-lg shadow-[#FF471D]/40 transition-all duration-300 cursor-pointer" title="Day 5 Peak"></div>
            <div class="w-full bg-cyan-400/70 hover:bg-cyan-300 rounded-t h-[75%] transition-all duration-300 cursor-pointer" title="Day 6"></div>
            <div class="w-full bg-cyan-400/50 hover:bg-cyan-300 rounded-t h-[55%] transition-all duration-300 cursor-pointer" title="Day 7"></div>
            <div class="w-full bg-cyan-400/30 hover:bg-cyan-300 rounded-t h-[40%] transition-all duration-300 cursor-pointer" title="Day 8"></div>
            <div class="w-full bg-cyan-400/20 hover:bg-cyan-300 rounded-t h-[25%] transition-all duration-300 cursor-pointer" title="Day 9"></div>
          </div>
        </div>

        <!-- Metric Cards Row -->
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 pt-2 border-t border-white/10 text-center font-mono">
          <div class="space-y-0.5 p-1 rounded-lg hover:bg-white/5 transition-colors">
            <span class="text-[10px] text-slate-300 block uppercase">Page Load</span>
            <span class="text-xs font-bold text-white">0.7s</span>
          </div>
          <div class="space-y-0.5 p-1 rounded-lg hover:bg-white/5 transition-colors">
            <span class="text-[10px] text-slate-300 block uppercase">Pageviews</span>
            <span class="text-xs font-bold text-[#FF471D]">2.7Mpvs</span>
          </div>
          <div class="space-y-0.5 p-1 rounded-lg hover:bg-white/5 transition-colors">
