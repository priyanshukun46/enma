<div data-controller="landing-page" class="w-full relative bg-white text-[#212121] min-h-screen selection:bg-[#FF471D] selection:text-white font-sans">

  <!-- ============================================================== -->
  <!-- TOP NAVIGATION HEADER (#212121)                                -->
  <!-- ============================================================== -->
  <%= render "shared/resqway_header" %>

  <!-- ============================================================== -->
  <!-- HERO SECTION: FULL FIRST SCROLL (100VH / MIN-H-SCREEN)         -->
  <!-- ============================================================== -->
  <section class="relative min-h-screen h-screen flex flex-col justify-between items-center overflow-hidden bg-cover bg-center bg-no-repeat pt-20 sm:pt-24 pb-4"
           style="background-image: linear-gradient(to bottom, rgba(16,46,57,0.62) 0%, rgba(33,33,33,0.38) 45%, rgba(16,46,57,0.72) 100%), url('<%= image_path("resqway_mountain_hero.jpg") %>');">
    
    <!-- Top spacer balancing vertical flexbox -->
    <div class="w-full"></div>

    <!-- Centered Hero Headline & Telemetry Cockpit Card -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center my-auto py-2 sm:py-4">
      
      <!-- Headline: Welcome to ResQWay -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white text-center mb-2 sm:mb-3 drop-shadow-lg tracking-tight font-sans">
        Welcome to ResQWay
      </h1>
      <p class="text-xs sm:text-sm md:text-base text-white/90 font-medium max-w-2xl mx-auto mb-6 sm:mb-8 drop-shadow">
        Logistics, Real-Time Tracking &amp; Predictive Risk Intelligence Cockpit
      </p>

      <!-- Centered 3-Tab Floating Widget Card -->
      <div class="w-full max-w-2xl mx-auto shadow-2xl rounded-2xl overflow-hidden bg-white text-left transition-all duration-300 hover:shadow-3xl">
        
        <!-- Top 3 Tabs Sitting Horizontally Across Card Top -->
        <div class="grid grid-cols-3 border-b border-slate-200" role="tablist">
          
          <!-- Tab 1: SMART ROUTE -->
          <button type="button"
                  data-action="click->landing-page#switchTab"
                  data-tab="routes"
                  data-landing-page-target="tabBtn"
                  role="tab"
                  aria-selected="false"
                  class="py-3 sm:py-3.5 px-2 sm:px-4 bg-white text-[#102E39] hover:bg-slate-50 flex items-center justify-center space-x-2 transition-all cursor-pointer border-r border-slate-200">
            <i class="fas fa-route text-sm sm:text-base text-[#102E39]"></i>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-center leading-none">SMART ROUTE</span>
          </button>

          <!-- Tab 2: LIVE FLEET (Default Active) -->
          <button type="button"
                  data-action="click->landing-page#switchTab"
                  data-tab="fleet"
                  data-landing-page-target="tabBtn"
                  role="tab"
                  aria-selected="true"
                  class="py-3 sm:py-3.5 px-2 sm:px-4 bg-[#102E39] text-white flex items-center justify-center space-x-2 transition-all cursor-pointer">
            <i class="fas fa-ship text-sm sm:text-base text-white"></i>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-center leading-none">LIVE FLEET</span>
          </button>

          <!-- Tab 3: FIELD INCIDENCE -->
          <button type="button"
                  data-action="click->landing-page#switchTab"
                  data-tab="incidents"
                  data-landing-page-target="tabBtn"
                  role="tab"
                  aria-selected="false"
                  class="py-3 sm:py-3.5 px-2 sm:px-4 bg-white text-[#102E39] hover:bg-slate-50 flex items-center justify-center space-x-2 transition-all cursor-pointer border-l border-slate-200">
            <i class="fas fa-triangle-exclamation text-sm sm:text-base text-[#102E39]"></i>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-center leading-none">FIELD INCIDENCE</span>
          </button>

        </div>

        <!-- Card Body -->
        <div class="p-5 sm:p-6">
          
          <!-- Pane 1: LIVE FLEET (Default Active) -->
          <div data-landing-page-target="tabPane" data-tab="fleet" class="space-y-4">
            
            <!-- Top Metric Row -->
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="text-3xl sm:text-4xl font-extrabold text-[#212121] tracking-tight font-sans">48</span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shadow-sm animate-pulse"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700">ACTIVE GLOBAL FLEETS</span>
              </div>
              <div class="text-xs text-slate-500 font-medium">
                100% AIS Coverage
              </div>
            </div>

            <!-- 3-Column Metric Box -->
            <div class="border border-slate-200 rounded-lg p-3 sm:p-4 bg-white">
              <div class="grid grid-cols-3 divide-x divide-slate-200 text-left">
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">24</div>
                  <div class="text-xs text-slate-500 font-normal">Ocean Vessels</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">14</div>
                  <div class="text-xs text-slate-500 font-normal">Air Freighters</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">10</div>
                  <div class="text-xs text-slate-500 font-normal">Intermodal Rail</div>
                </div>
              </div>
            </div>

            <!-- Bottom Status & Action Row -->
            <div class="flex items-center justify-between pt-1">
              <div class="flex items-center space-x-2 text-xs text-slate-500">
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                <span>Real-time GPS telemetry active</span>
              </div>
              <%= link_to shipments_path, class: "bg-[#FF471D] hover:bg-[#e03d15] text-white font-bold text-xs uppercase tracking-wider px-5 sm:px-6 py-2.5 sm:py-3 rounded-md flex items-center space-x-2 shadow-md hover:shadow-lg transition-all cursor-pointer shrink-0" do %>
                <span>VIEW LIVE FLEET</span>
                <i class="fas fa-arrow-right text-xs"></i>
              <% end %>
            </div>

          </div>

          <!-- Pane 2: SMART ROUTE -->
          <div data-landing-page-target="tabPane" data-tab="routes" class="hidden space-y-4">
            
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="text-3xl sm:text-4xl font-extrabold text-[#212121] tracking-tight font-sans">342</span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shadow-sm animate-pulse"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700">OPTIMIZED CORRIDORS</span>
              </div>
              <div class="text-xs text-slate-500 font-medium">
                AI Routing Engine Active
              </div>
            </div>

            <div class="border border-slate-200 rounded-lg p-3 sm:p-4 bg-white">
              <div class="grid grid-cols-3 divide-x divide-slate-200 text-left">
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">0.42s</div>
                  <div class="text-xs text-slate-500 font-normal">Route Compute</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">99.8%</div>
                  <div class="text-xs text-slate-500 font-normal">On-Time Transit</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">18.4%</div>
                  <div class="text-xs text-slate-500 font-normal">Fuel Saved</div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between pt-1">
              <div class="flex items-center space-x-2 text-xs text-slate-500">
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                <span>Dynamic weather &amp; choke-point avoidance</span>
              </div>
              <%= link_to routes_path, class: "bg-[#FF471D] hover:bg-[#e03d15] text-white font-bold text-xs uppercase tracking-wider px-5 sm:px-6 py-2.5 sm:py-3 rounded-md flex items-center space-x-2 shadow-md hover:shadow-lg transition-all cursor-pointer shrink-0" do %>
                <span>CALCULATE SMART ROUTE</span>
                <i class="fas fa-arrow-right text-xs"></i>
              <% end %>
            </div>

          </div>

          <!-- Pane 3: FIELD INCIDENCE -->
          <div data-landing-page-target="tabPane" data-tab="incidents" class="hidden space-y-4">
            
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="text-3xl sm:text-4xl font-extrabold text-[#212121] tracking-tight font-sans">3</span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block shadow-sm animate-pulse"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700">FIELD INCIDENTS</span>
              </div>
              <div class="text-xs text-slate-500 font-medium">
                Computer Vision Active
              </div>
            </div>

            <div class="border border-slate-200 rounded-lg p-3 sm:p-4 bg-white">
              <div class="grid grid-cols-3 divide-x divide-slate-200 text-left">
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">1</div>
                  <div class="text-xs text-slate-500 font-normal">Severe Blockage</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">2</div>
                  <div class="text-xs text-slate-500 font-normal">Weather Advisory</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">0</div>
                  <div class="text-xs text-slate-500 font-normal">Security Alerts</div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between pt-1">
              <div class="flex items-center space-x-2 text-xs text-slate-500">
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                <span>24/7 automated drone &amp; satellite telemetry</span>
              </div>
              <%= link_to incidents_path, class: "bg-[#FF471D] hover:bg-[#e03d15] text-white font-bold text-xs uppercase tracking-wider px-5 sm:px-6 py-2.5 sm:py-3 rounded-md flex items-center space-x-2 shadow-md hover:shadow-lg transition-all cursor-pointer shrink-0" do %>
                <span>VIEW FIELD INCIDENTS</span>
                <i class="fas fa-arrow-right text-xs"></i>
              <% end %>
            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- Bottom Scroll Indicator (Full First Screen Fold Anchor) -->
    <button type="button"
            data-action="click->landing-page#scrollToContent"
            class="w-full pb-3 flex flex-col items-center justify-center text-white/80 hover:text-white transition-colors cursor-pointer group focus:outline-none"
            aria-label="Scroll down to explore features">
      <span class="text-[10px] sm:text-xs uppercase tracking-widest font-bold text-white/90 group-hover:tracking-wider transition-all">SCROLL TO EXPLORE</span>
      <i class="fas fa-chevron-down text-xs animate-bounce text-white group-hover:translate-y-0.5 transition-transform mt-1"></i>
    </button>

  </section>

  <!-- Anchor for Smooth Scroll Down Navigation -->
  <div id="main-content-start" class="relative -top-16"></div>

  <!-- ============================================================== -->
  <!-- 1. MINIMAL STRATEGIC COMMAND STRIP (#102E39 ESSENCE)           -->
  <!-- ============================================================== -->
  <section class="w-full bg-[#102E39] text-white py-6 sm:py-8 border-b border-white/10 reveal-on-scroll">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
      
      <!-- Left: Status & Platform Summary -->
      <div class="flex items-center space-x-4 text-center md:text-left">
        <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-[#FF471D] shrink-0 hidden sm:flex">
          <i class="fas fa-tower-broadcast text-lg"></i>
        </div>
        <div>
          <div class="flex items-center justify-center md:justify-start space-x-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-[11px] font-bold uppercase tracking-wider text-white/70">24/7 Active Tactical Grid</span>
          </div>
          <p class="text-sm sm:text-base font-semibold text-white tracking-tight">
            Autonomous multi-modal logistics &amp; predictive road risk telemetry for North East India.
          </p>
        </div>
      </div>

      <!-- Right: Direct Quick Actions -->
      <div class="flex items-center space-x-3 shrink-0">
        <%= link_to new_emergency_path, class: "px-5 py-2.5 rounded-lg bg-[#FF471D] hover:bg-[#e03d15] text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all flex items-center space-x-1.5" do %>
          <i class="fas fa-bolt text-xs"></i>
          <span>DISPATCH UNIT</span>
        <% end %>
        <%= link_to map_path, class: "px-5 py-2.5 rounded-lg border border-white/20 text-white hover:bg-white/10 font-bold text-xs uppercase tracking-wider transition-all flex items-center space-x-1.5" do %>
          <i class="fas fa-map-location-dot text-xs"></i>
          <span>LIVE MAP</span>
        <% end %>
      </div>

    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 2. CORE OPERATIONAL MODULES (MINIMAL 6-CARD GRID)              -->
  <!-- ============================================================== -->
  <section class="py-16 sm:py-20 bg-[#EAEEF0]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Minimal Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#212121] tracking-tight reveal-on-scroll">
          Core Operational Modules
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-2 reveal-on-scroll delay-100">
          Direct access to real-time telemetry, routing engines, and emergency crisis response networks.
        </p>
      </div>

      <!-- 6 Clean Minimal Interactive Cards -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6">
        
        <!-- Card 1: Route Planner -->
        <%= link_to routes_path, class: "bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-[#FF471D]/40 transition-all duration-300 flex flex-col items-center justify-between text-center group cursor-pointer reveal-on-scroll delay-75" do %>
          <div class="w-12 h-12 rounded-xl bg-orange-50 text-[#FF471D] flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <i class="fas fa-route text-lg"></i>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#212121] group-hover:text-[#FF471D] transition-colors leading-tight">
              Route Planner
            </h3>
            <p class="text-[11px] text-slate-500 mt-1 leading-snug">
              Choke-point avoidance
            </p>
          </div>
          <span class="text-[10px] font-bold text-[#FF471D] mt-3 flex items-center uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
            Open &rarr;
          </span>
        <% end %>

        <!-- Card 2: Fleet Telemetry -->
        <%= link_to shipments_path, class: "bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-[#102E39]/40 transition-all duration-300 flex flex-col items-center justify-between text-center group cursor-pointer reveal-on-scroll delay-150" do %>
          <div class="w-12 h-12 rounded-xl bg-teal-50 text-[#102E39] flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <i class="fas fa-satellite text-lg"></i>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#212121] group-hover:text-[#102E39] transition-colors leading-tight">
              Fleet Telemetry
            </h3>
            <p class="text-[11px] text-slate-500 mt-1 leading-snug">
              Live AIS &amp; GPS tracking
            </p>
          </div>
          <span class="text-[10px] font-bold text-[#102E39] mt-3 flex items-center uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
            Open &rarr;
          </span>
        <% end %>

        <!-- Card 3: Road Disruption Risks -->
        <%= link_to accessibility_path, class: "bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-[#FF471D]/40 transition-all duration-300 flex flex-col items-center justify-between text-center group cursor-pointer reveal-on-scroll delay-200" do %>
          <div class="w-12 h-12 rounded-xl bg-orange-50 text-[#FF471D] flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <i class="fas fa-mountain-sun text-lg"></i>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#212121] group-hover:text-[#FF471D] transition-colors leading-tight">
              Predictive Risk
            </h3>
            <p class="text-[11px] text-slate-500 mt-1 leading-snug">
              Landslide &amp; flood vectors
            </p>
          </div>
          <span class="text-[10px] font-bold text-[#FF471D] mt-3 flex items-center uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
            Open &rarr;
          </span>
        <% end %>

        <!-- Card 4: Tactical Command -->
        <%= link_to intelligence_command_path, class: "bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-[#102E39]/40 transition-all duration-300 flex flex-col items-center justify-between text-center group cursor-pointer reveal-on-scroll delay-250" do %>
          <div class="w-12 h-12 rounded-xl bg-teal-50 text-[#102E39] flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <i class="fas fa-shield-halved text-lg"></i>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#212121] group-hover:text-[#102E39] transition-colors leading-tight">
              Tactical Command
            </h3>
            <p class="text-[11px] text-slate-500 mt-1 leading-snug">
              Closed-loop control
            </p>
          </div>
          <span class="text-[10px] font-bold text-[#102E39] mt-3 flex items-center uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
            Open &rarr;
          </span>
        <% end %>

        <!-- Card 5: Field Incidents -->
        <%= link_to incidents_path, class: "bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-[#FF471D]/40 transition-all duration-300 flex flex-col items-center justify-between text-center group cursor-pointer reveal-on-scroll delay-300" do %>
          <div class="w-12 h-12 rounded-xl bg-orange-50 text-[#FF471D] flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <i class="fas fa-camera-retro text-lg"></i>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#212121] group-hover:text-[#FF471D] transition-colors leading-tight">
              Field Incidents
            </h3>
            <p class="text-[11px] text-slate-500 mt-1 leading-snug">
              Photo dispatch &amp; alerts
            </p>
          </div>
          <span class="text-[10px] font-bold text-[#FF471D] mt-3 flex items-center uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
            Open &rarr;
          </span>
        <% end %>

        <!-- Card 6: Relief Depots -->
        <%= link_to warehouses_path, class: "bg-white rounded-xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-[#102E39]/40 transition-all duration-300 flex flex-col items-center justify-between text-center group cursor-pointer reveal-on-scroll delay-400" do %>
          <div class="w-12 h-12 rounded-xl bg-teal-50 text-[#102E39] flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <i class="fas fa-warehouse text-lg"></i>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#212121] group-hover:text-[#102E39] transition-colors leading-tight">
              Relief Depots
            </h3>
            <p class="text-[11px] text-slate-500 mt-1 leading-snug">
              Hub inventory tracking
            </p>
          </div>
          <span class="text-[10px] font-bold text-[#102E39] mt-3 flex items-center uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
            Open &rarr;
          </span>
        <% end %>

      </div>

    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 3. STRATEGIC INTELLIGENCE HIGHLIGHTS (3 MINIMAL CARDS)         -->
  <!-- ============================================================== -->
  <section class="py-16 sm:py-20 bg-white border-t border-slate-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#212121] tracking-tight reveal-on-scroll">
          Intelligent Infrastructure &amp; Resilient Telemetry
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-2 reveal-on-scroll delay-100">
          Engineered for extreme topological conditions, monsoon swelling, and rapid humanitarian mobilization.
        </p>
      </div>

      <!-- 3 Minimal White Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Card 1: Sub-Second Route Optimization -->
        <div class="bg-[#EAEEF0]/60 rounded-2xl p-6 sm:p-7 border border-slate-200/80 flex flex-col justify-between hover:shadow-lg transition-all duration-300 reveal-on-scroll delay-75">
          <div class="space-y-3">
            <span class="inline-block px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-white text-[#102E39] shadow-xs">
              AI ROUTING ENGINE
            </span>
            <h3 class="text-lg font-bold text-[#212121]">
              Sub-Second Route Optimization
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Algorithms dynamically monitor 342 mountain corridors and bridge networks, recomputing alternate dispatch paths before consignments reach blocked choke points.
            </p>
          </div>
          <div class="pt-6 border-t border-slate-200/70 mt-6 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-500 font-medium">0.42s &bull; 99.8% On-Time</span>
            <%= link_to routes_path, class: "text-xs font-bold text-[#FF471D] hover:underline uppercase tracking-wider flex items-center" do %>
              <span>PLAN ROUTE</span>
              <i class="fas fa-chevron-right ml-1 text-[9px]"></i>
            <% end %>
          </div>
        </div>

        <!-- Card 2: Multi-Modal Fleet Tracking -->
        <div class="bg-[#EAEEF0]/60 rounded-2xl p-6 sm:p-7 border border-slate-200/80 flex flex-col justify-between hover:shadow-lg transition-all duration-300 reveal-on-scroll delay-150">
          <div class="space-y-3">
            <span class="inline-block px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-white text-[#102E39] shadow-xs">
              AIS TELEMETRY
            </span>
            <h3 class="text-lg font-bold text-[#212121]">
              Multi-Modal Fleet Tracking
