<div data-controller="landing-page" class="w-full relative bg-white text-[#212121] min-h-screen selection:bg-[#FF471D] selection:text-white font-sans">

  <!-- ============================================================== -->
  <!-- TOP NAVIGATION HEADER (#212121)                                -->
  <!-- ============================================================== -->
  <%= render "shared/resqway_header" %>

  <!-- ============================================================== -->
  <!-- HERO SECTION WITH MOUNTAIN ROAD & TELEMETRY WIDGET CARD        -->
  <!-- ============================================================== -->
  <section class="relative pt-24 sm:pt-28 pb-12 sm:pb-16 min-h-[580px] sm:min-h-[640px] flex flex-col justify-center items-center overflow-hidden bg-cover bg-center bg-no-repeat"
           style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.40) 0%, rgba(0,0,0,0.22) 50%, rgba(0,0,0,0.48) 100%), url('<%= image_path("resqway_mountain_hero.jpg") %>');">
    
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center relative z-10 py-6 sm:py-10">
      
      <!-- Headline: Welcome to ResQWay (Crisp white sans-serif) -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white text-center mb-8 sm:mb-10 drop-shadow-md tracking-tight font-sans">
        Welcome to ResQWay
      </h1>

      <!-- Centered 3-Tab Floating Widget Card -->
      <div class="w-full max-w-2xl mx-auto shadow-2xl rounded-2xl overflow-hidden bg-white text-left">
        
        <!-- Top 3 Tabs Sitting Horizontally Across Card Top -->
        <div class="grid grid-cols-3 border-b border-slate-200" role="tablist">
          
          <!-- Tab 1: SMART ROUTE -->
          <button type="button"
                  data-action="click->landing-page#switchTab"
                  data-tab="routes"
                  data-landing-page-target="tabBtn"
                  role="tab"
                  aria-selected="false"
                  class="py-3.5 sm:py-4 px-2 sm:px-4 bg-white text-[#102E39] hover:bg-white flex items-center justify-center space-x-2 transition-all cursor-pointer border-r border-slate-200">
            <i class="fas fa-route text-sm sm:text-base text-[#102E39]"></i>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-center leading-none">SMART ROUTE</span>
          </button>

          <!-- Tab 2: LIVE FLEET (Default Active) -->
          <button type="button"
                  data-action="click->landing-page#switchTab"
                  data-tab="fleet"
                  data-landing-page-target="tabBtn"
                  role="tab"
                  aria-selected="true"
                  class="py-3.5 sm:py-4 px-2 sm:px-4 bg-[#102E39] text-white flex items-center justify-center space-x-2 transition-all cursor-pointer">
            <i class="fas fa-ship text-sm sm:text-base text-white"></i>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-center leading-none">LIVE FLEET</span>
          </button>

          <!-- Tab 3: FIELD INCIDENCE -->
          <button type="button"
                  data-action="click->landing-page#switchTab"
                  data-tab="incidents"
                  data-landing-page-target="tabBtn"
                  role="tab"
                  aria-selected="false"
                  class="py-3.5 sm:py-4 px-2 sm:px-4 bg-white text-[#102E39] hover:bg-white flex items-center justify-center space-x-2 transition-all cursor-pointer border-l border-slate-200">
            <i class="fas fa-triangle-exclamation text-sm sm:text-base text-[#102E39]"></i>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-center leading-none">FIELD INCIDENCE</span>
          </button>

        </div>

        <!-- Card Body -->
        <div class="p-5 sm:p-7">
          
          <!-- Pane 1: LIVE FLEET (Default Active) -->
          <div data-landing-page-target="tabPane" data-tab="fleet" class="space-y-4">
            
            <!-- Top Metric Row -->
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="text-3xl sm:text-4xl font-extrabold text-[#212121] tracking-tight font-sans">48</span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shadow-sm"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700">ACTIVE GLOBAL FLEETS</span>
              </div>
              <div class="text-xs text-slate-500 font-medium">
                100% AIS Coverage
              </div>
            </div>

            <!-- 3-Column Metric Box -->
            <div class="border border-slate-200 rounded-lg p-3 sm:p-4 bg-white">
              <div class="grid grid-cols-3 divide-x divide-slate-200 text-left">
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">24</div>
                  <div class="text-xs text-slate-500 font-normal">Ocean Vessels</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">14</div>
                  <div class="text-xs text-slate-500 font-normal">Air Freighters</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">10</div>
                  <div class="text-xs text-slate-500 font-normal">Intermodal Rail</div>
                </div>
              </div>
            </div>

            <!-- Bottom Status & Action Row -->
            <div class="flex items-center justify-between pt-1">
              <div class="flex items-center space-x-2 text-xs text-slate-500">
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                <span>Real-time GPS telemetry active</span>
              </div>
              <%= link_to shipments_path, class: "bg-[#FF471D] hover:bg-[#e03d15] text-white font-bold text-xs uppercase tracking-wider px-5 sm:px-6 py-2.5 sm:py-3 rounded-md flex items-center space-x-2 shadow-md transition-all cursor-pointer shrink-0" do %>
                <span>VIEW LIVE FLEET</span>
                <i class="fas fa-arrow-right text-xs"></i>
              <% end %>
            </div>

          </div>

          <!-- Pane 2: SMART ROUTE -->
          <div data-landing-page-target="tabPane" data-tab="routes" class="hidden space-y-4">
            
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="text-3xl sm:text-4xl font-extrabold text-[#212121] tracking-tight font-sans">342</span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shadow-sm"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700">OPTIMIZED CORRIDORS</span>
              </div>
              <div class="text-xs text-slate-500 font-medium">
                AI Routing Engine Active
              </div>
            </div>

            <div class="border border-slate-200 rounded-lg p-3 sm:p-4 bg-white">
              <div class="grid grid-cols-3 divide-x divide-slate-200 text-left">
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">0.42s</div>
                  <div class="text-xs text-slate-500 font-normal">Route Compute</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">99.8%</div>
                  <div class="text-xs text-slate-500 font-normal">On-Time Transit</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">18.4%</div>
                  <div class="text-xs text-slate-500 font-normal">Fuel Saved</div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between pt-1">
              <div class="flex items-center space-x-2 text-xs text-slate-500">
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                <span>Dynamic weather &amp; choke-point avoidance</span>
              </div>
              <%= link_to routes_path, class: "bg-[#FF471D] hover:bg-[#e03d15] text-white font-bold text-xs uppercase tracking-wider px-5 sm:px-6 py-2.5 sm:py-3 rounded-md flex items-center space-x-2 shadow-md transition-all cursor-pointer shrink-0" do %>
                <span>CALCULATE SMART ROUTE</span>
                <i class="fas fa-arrow-right text-xs"></i>
              <% end %>
            </div>

          </div>

          <!-- Pane 3: FIELD INCIDENCE -->
          <div data-landing-page-target="tabPane" data-tab="incidents" class="hidden space-y-4">
            
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2.5">
                <span class="text-3xl sm:text-4xl font-extrabold text-[#212121] tracking-tight font-sans">3</span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block shadow-sm"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700">FIELD INCIDENTS</span>
              </div>
              <div class="text-xs text-slate-500 font-medium">
                Computer Vision Active
              </div>
            </div>

            <div class="border border-slate-200 rounded-lg p-3 sm:p-4 bg-white">
              <div class="grid grid-cols-3 divide-x divide-slate-200 text-left">
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">1</div>
                  <div class="text-xs text-slate-500 font-normal">Severe Blockage</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">2</div>
                  <div class="text-xs text-slate-500 font-normal">Weather Advisory</div>
                </div>
                <div class="px-2 sm:px-4">
                  <div class="text-2xl sm:text-3xl font-bold text-[#212121] leading-none mb-1">0</div>
                  <div class="text-xs text-slate-500 font-normal">Security Alerts</div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between pt-1">
              <div class="flex items-center space-x-2 text-xs text-slate-500">
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                <span>24/7 automated drone &amp; satellite telemetry</span>
              </div>
              <%= link_to incidents_path, class: "bg-[#FF471D] hover:bg-[#e03d15] text-white font-bold text-xs uppercase tracking-wider px-5 sm:px-6 py-2.5 sm:py-3 rounded-md flex items-center space-x-2 shadow-md transition-all cursor-pointer shrink-0" do %>
                <span>VIEW FIELD INCIDENTS</span>
                <i class="fas fa-arrow-right text-xs"></i>
              <% end %>
            </div>

          </div>

        </div>

      </div>

      <!-- Scroll Indicator Under Card -->
      <div class="mt-8 sm:mt-12 flex flex-col items-center justify-center text-white/80 space-y-1">
        <span class="text-[10px] sm:text-xs uppercase tracking-widest font-semibold">SCROLL TO EXPLORE</span>
        <i class="fas fa-chevron-down text-xs animate-bounce"></i>
      </div>

    </div>

  </section>

  <!-- ============================================================== -->
  <!-- SPLIT PROMOTIONAL BANNER (#102E39 ESSENCE & WHITE)             -->
  <!-- ============================================================== -->
  <section class="w-full bg-[#102E39]">
    <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[160px]">
      
      <!-- Left 65% in Solid Petrol #102E39 -->
      <div class="lg:col-span-8 bg-[#102E39] text-white py-10 px-6 sm:px-12 lg:px-20 flex items-start space-x-6">
        <div class="hidden sm:block shrink-0 mt-1">
          <svg class="w-14 h-14 text-[#FF471D]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
        </div>
        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-snug">
            Sign up now and save up to 65%* off your logistics rates!
          </h2>
          <p class="text-sm sm:text-base text-white/90 font-normal">
            Benefit from our AI-assisted route intelligence and solutions designed to meet all of your multi-modal shipping needs.
          </p>
          <p class="text-xs text-white/70 pt-1 leading-relaxed">
            *This discount applies to relief consignments, humanitarian freight and verified commercial partners.
          </p>
          <p class="text-xs text-white font-bold">
            *Terms &amp; Conditions apply.
          </p>
        </div>
      </div>

      <!-- Right 35% in Crisp White with Outline Button -->
      <div class="lg:col-span-4 bg-white py-10 px-8 sm:px-12 flex items-center justify-center">
        <%= link_to sign_up_path, class: "px-8 py-3.5 rounded-full border-2 border-[#102E39] text-[#102E39] hover:bg-[#102E39] hover:text-white font-bold text-xs sm:text-sm uppercase tracking-wider transition-all text-center cursor-pointer shadow-sm" do %>
          OPEN AN ACCOUNT
        <% end %>
      </div>

    </div>
  </section>

  <!-- ============================================================== -->
  <!-- CORE TECHNOLOGY STACK SECTION                                  -->
  <!-- ============================================================== -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading in Deep #212121 -->
      <h2 class="text-3xl sm:text-4xl font-bold text-[#212121] text-center mb-3 tracking-tight">
        Core Technology Stack
      </h2>
      <p class="text-sm text-slate-600 text-center max-w-2xl mx-auto mb-14 font-medium">
        Engineered with resilient, modern frameworks built for mission-critical logistics and real-time emergency telemetry.
      </p>

      <!-- 6 Tech Stack Badges in the Same Design Language & Effects -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 sm:gap-8 mb-20 text-center">
        
        <!-- 1: Ruby on Rails 8 -->
        <%= link_to architecture_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#FF471D] bg-white flex items-center justify-center p-4 transition-all duration-300 group-hover:scale-110 group-hover:border-[#FF471D] shadow-sm group-hover:shadow-md">
            <i class="fa-solid fa-gem text-2xl text-[#FF471D] transition-transform group-hover:rotate-12"></i>
          </div>
          <span class="text-xs font-bold text-[#102E39] group-hover:text-[#FF471D] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            RUBY ON RAILS 8<br><span class="text-[10px] text-slate-500 font-normal normal-case block mt-0.5">Full-Stack Core</span>
          </span>
        <% end %>

        <!-- 2: Python & PyTorch ML -->
        <%= link_to intelligence_predictions_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#102E39] bg-white flex items-center justify-center p-4 transition-all duration-300 group-hover:scale-110 group-hover:border-[#FF471D] shadow-sm group-hover:shadow-md">
            <i class="fa-brands fa-python text-2xl text-[#102E39] group-hover:text-[#FF471D] transition-colors"></i>
          </div>
          <span class="text-xs font-bold text-[#102E39] group-hover:text-[#FF471D] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            PYTHON &amp; ML<br><span class="text-[10px] text-slate-500 font-normal normal-case block mt-0.5">Risk Predictor</span>
          </span>
        <% end %>

        <!-- 3: Hotwire & Stimulus -->
        <%= link_to dashboard_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#102E39] bg-white flex items-center justify-center p-4 transition-all duration-300 group-hover:scale-110 group-hover:border-[#FF471D] shadow-sm group-hover:shadow-md">
            <i class="fa-solid fa-bolt text-2xl text-[#102E39] group-hover:text-[#FF471D] transition-colors"></i>
          </div>
          <span class="text-xs font-bold text-[#102E39] group-hover:text-[#FF471D] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            HOTWIRE TURBO<br><span class="text-[10px] text-slate-500 font-normal normal-case block mt-0.5">Live Telemetry UI</span>
          </span>
        <% end %>

        <!-- 4: Tailwind CSS -->
        <%= link_to overview_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#FF471D] bg-white flex items-center justify-center p-4 transition-all duration-300 group-hover:scale-110 group-hover:border-[#FF471D] shadow-sm group-hover:shadow-md">
            <i class="fa-brands fa-css3-alt text-2xl text-[#FF471D] transition-transform group-hover:scale-110"></i>
          </div>
          <span class="text-xs font-bold text-[#102E39] group-hover:text-[#FF471D] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            TAILWIND CSS<br><span class="text-[10px] text-slate-500 font-normal normal-case block mt-0.5">Design System</span>
          </span>
        <% end %>

        <!-- 5: Leaflet GIS Engine -->
        <%= link_to map_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#102E39] bg-white flex items-center justify-center p-4 transition-all duration-300 group-hover:scale-110 group-hover:border-[#FF471D] shadow-sm group-hover:shadow-md">
            <i class="fa-solid fa-map-location-dot text-2xl text-[#102E39] group-hover:text-[#FF471D] transition-colors"></i>
          </div>
          <span class="text-xs font-bold text-[#102E39] group-hover:text-[#FF471D] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            LEAFLET GIS<br><span class="text-[10px] text-slate-500 font-normal normal-case block mt-0.5">Spatial Engine</span>
          </span>
        <% end %>

        <!-- 6: PostgreSQL Database -->
        <%= link_to analytics_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#102E39] bg-white flex items-center justify-center p-4 transition-all duration-300 group-hover:scale-110 group-hover:border-[#FF471D] shadow-sm group-hover:shadow-md">
            <i class="fa-solid fa-database text-2xl text-[#102E39] group-hover:text-[#FF471D] transition-colors"></i>
          </div>
          <span class="text-xs font-bold text-[#102E39] group-hover:text-[#FF471D] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            POSTGRESQL<br><span class="text-[10px] text-slate-500 font-normal normal-case block mt-0.5">Spatial Data Store</span>
          </span>
        <% end %>

      </div>

      <!-- Two-Column Feature Showcase -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        
        <!-- Card 1: North Eastern Logistics -->
        <div class="flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200/80">
          <div class="overflow-hidden">
            <%= image_tag "fedex_us_shipping.jpg", alt: "Navigate High-Altitude Corridors with Ease", class: "w-full h-64 sm:h-72 object-cover transition-transform duration-500 hover:scale-102" %>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-2xl font-bold text-[#212121]">
              Navigate High-Altitude Corridors with Ease
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              In dynamic terrain environments, having real-time clearance and topological compliance is crucial. ResQWay assists multi-modal fleets with predictive road risk intelligence, automated convoy routing, and live satellite dispatch.
            </p>
          </div>
        </div>

        <!-- Card 2: Strategic Cross-Border Network -->
        <div class="flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200/80">
          <div class="overflow-hidden">
            <%= image_tag "fedex_eu_market.jpg", alt: "Unlock Multi-Modal Logistics Corridors", class: "w-full h-64 sm:h-72 object-cover transition-transform duration-500 hover:scale-102" %>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-2xl font-bold text-[#212121]">
              Unlock Multi-Modal Logistics Corridors
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Reach regional distribution depots with an integrated telemetry network that synchronizes air freighters, ocean vessels, and intermodal freight for unprecedented turnaround speeds.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ============================================================== -->
  <!-- "YOUR BUSINESS RESOURCE" 3-COLUMN SECTION                      -->
  <!-- ============================================================== -->
  <section class="py-16 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Title -->
      <h2 class="text-3xl sm:text-4xl font-bold text-[#212121] text-center mb-14 tracking-tight">
        Your Logistics &amp; Emergency Resource
      </h2>

      <!-- 3-Column Resource Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <!-- Card 1: New to ResQWay? -->
        <div class="flex flex-col justify-between bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
          <div class="space-y-4">
            <div class="overflow-hidden rounded-xl">
              <%= image_tag "fedex_resource_1.jpg", alt: "New to ResQWay?", class: "w-full h-48 object-cover" %>
            </div>
            <h4 class="text-xl font-bold text-[#212121]">
              New to ResQWay?
            </h4>
            <p class="text-sm text-slate-600 leading-relaxed">
              Our Quick Start Onboarding guides you through setting up relief shipments, configuring telemetry API webhooks, and accessing tactical command.
            </p>
          </div>
          <div class="pt-6">
            <%= link_to demo_path, class: "text-xs font-bold text-[#102E39] hover:text-[#FF471D] hover:underline uppercase tracking-wider flex items-center" do %>
              <span>TRY INTERACTIVE DEMO</span>
              <i class="fas fa-chevron-right ml-1 text-[10px]"></i>
            <% end %>
          </div>
        </div>

        <!-- Card 2: Simplify your Dispatch Logistics -->
        <div class="flex flex-col justify-between bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
          <div class="space-y-4">
            <div class="overflow-hidden rounded-xl">
              <%= image_tag "fedex_resource_2.jpg", alt: "Simplify your Dispatch Logistics", class: "w-full h-48 object-cover" %>
            </div>
            <h4 class="text-xl font-bold text-[#212121]">
              Simplify your Dispatch Logistics
            </h4>
            <p class="text-sm text-slate-600 leading-relaxed">
              Comprehensive emergency dispatch workflows that free response teams to focus on life safety while autonomous routing takes care of choke points.
            </p>
          </div>
          <div class="pt-6">
            <%= link_to routes_path, class: "text-xs font-bold text-[#102E39] hover:text-[#FF471D] hover:underline uppercase tracking-wider flex items-center" do %>
              <span>FIND OUT MORE</span>
              <i class="fas fa-chevron-right ml-1 text-[10px]"></i>
            <% end %>
          </div>
        </div>

        <!-- Card 3: AI Choke Point Avoidance -->
        <div class="flex flex-col justify-between bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all">
          <div class="space-y-4">
            <div class="overflow-hidden rounded-xl">
              <%= image_tag "fedex_resource_3.jpg", alt: "Predictive Risk Avoidance", class: "w-full h-48 object-cover" %>
            </div>
            <h4 class="text-xl font-bold text-[#212121]">
              Predictive Risk Avoidance
            </h4>
            <p class="text-sm text-slate-600 leading-relaxed">
              Learn about AI-powered telemetry models trained on landslide susceptibility, monsoon flooding vectors, and real-time citizen road blockages.
            </p>
