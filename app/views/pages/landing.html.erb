<div data-controller="landing-page" class="w-full relative bg-[#0c1612] text-slate-100 min-h-screen selection:bg-orange-500 selection:text-white font-sans">

  <!-- ============================================================== -->
  <!-- TOP ACCENT BAR & STICKY NAVIGATION                             -->
  <!-- ============================================================== -->
  <div class="fixed top-0 left-0 right-0 z-50">
    <!-- Thin 3px orange accent line -->
    <div class="h-[3px] w-full bg-gradient-to-r from-orange-600 via-amber-500 to-orange-500"></div>

    <header data-landing-page-target="navbar" class="w-full bg-[#0c1713]/85 resqway-dark-header border-b border-[#1b3328] shadow-md transition-all duration-300 backdrop-blur-sm" style="background-color: rgba(12, 23, 19, 0.90) !important; border-bottom: 1px solid #1c3328 !important;">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
          
          <!-- Brand Logo (Horizontal Lockup matching reference design) -->
          <div class="flex items-center space-x-3 flex-shrink-0">
            <%= link_to root_path, class: "flex items-center space-x-2.5 group focus:outline-none" do %>
              <%= image_tag "logo_icon.png", alt: "ResQWay", class: "h-7 sm:h-8 w-auto object-contain transition-transform group-hover:scale-105" %>
              <span class="text-xl sm:text-2xl font-black tracking-tight text-white font-sans">ResQ<span class="text-[#ff5500]">Way</span></span>
            <% end %>
          </div>

          <!-- Desktop Navigation Menus (Operational Engine, Tactical Response, Insights and Simulations) -->
          <nav class="hidden lg:flex items-center space-x-1 sm:space-x-3 text-sm font-medium text-slate-200">
            
            <!-- Menu 1: Operational Engine -->
            <div class="relative" data-landing-page-target="dropdown">
              <button type="button"
                      data-action="click->landing-page#toggleDropdown"
                      class="px-3.5 py-2 rounded-lg hover:bg-[#132a21] hover:text-emerald-300 flex items-center space-x-1.5 transition-all focus:outline-none cursor-pointer">
                <span>Operational Engine</span>
                <i data-dropdown-arrow class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"></i>
              </button>

              <div data-dropdown-menu class="hidden absolute top-full left-0 mt-1.5 w-64 bg-[#0c1713] text-slate-200 rounded-xl shadow-2xl border border-[#1b3328] py-2 z-50 backdrop-blur-md">
                <%= link_to dashboard_path, class: "block px-4 py-2.5 text-xs font-semibold text-slate-200 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Dashboard
                <% end %>
                <%= link_to map_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Intelligence Map
                <% end %>
                <%= link_to accessibility_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Predictive Risks
                <% end %>
                <%= link_to network_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Network Graph
                <% end %>
                <%= link_to intelligence_predictions_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Cascade Predictions
                <% end %>
                <%= link_to intelligence_response_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Autonomous Response
                <% end %>
                <%= link_to intelligence_command_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Unified Command
                <% end %>
                <%= link_to routes_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Smart Routes
                <% end %>
                <%= link_to shipments_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Live Fleet Telemetry
                <% end %>
                <div class="border-t border-[#1b3328] my-1"></div>
                <%= link_to dashboard_path, class: "block px-4 py-2 text-xs font-black text-orange-500 uppercase tracking-wider hover:bg-[#132a21] hover:text-orange-400 transition-colors" do %>
                  All Operational Tools &rarr;
                <% end %>
              </div>
            </div>

            <!-- Menu 2: Tactical Response -->
            <div class="relative" data-landing-page-target="dropdown">
              <button type="button"
                      data-action="click->landing-page#toggleDropdown"
                      class="px-3.5 py-2 rounded-lg hover:bg-[#132a21] hover:text-emerald-300 flex items-center space-x-1.5 transition-all focus:outline-none cursor-pointer">
                <span>Tactical Response</span>
                <i data-dropdown-arrow class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"></i>
              </button>

              <div data-dropdown-menu class="hidden absolute top-full left-0 mt-1.5 w-64 bg-[#0c1713] text-slate-200 rounded-xl shadow-2xl border border-[#1b3328] py-2 z-50 backdrop-blur-md">
                <%= link_to emergencies_path, class: "block px-4 py-2.5 text-xs font-semibold text-slate-200 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Emergency Center
                <% end %>
                <%= link_to incidents_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Field Incidents (Photo Dispatch)
                <% end %>
                <%= link_to warehouses_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Relief Depots &amp; Stock
                <% end %>
                <%= link_to logistics_alerts_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Corridor Disruption Alerts
                <% end %>
                <div class="border-t border-[#1b3328] my-1"></div>
                <%= link_to intelligence_command_path, class: "block px-4 py-2 text-xs font-black text-orange-500 uppercase tracking-wider hover:bg-[#132a21] hover:text-orange-400 transition-colors" do %>
                  Live Convoy Dispatch &rarr;
                <% end %>
              </div>
            </div>

            <!-- Menu 3: Insights and Simulations -->
            <div class="relative" data-landing-page-target="dropdown">
              <button type="button"
                      data-action="click->landing-page#toggleDropdown"
                      class="px-3.5 py-2 rounded-lg hover:bg-[#132a21] hover:text-emerald-300 flex items-center space-x-1.5 transition-all focus:outline-none cursor-pointer">
                <span>Insights and Simulations</span>
                <i data-dropdown-arrow class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"></i>
              </button>

              <div data-dropdown-menu class="hidden absolute top-full left-0 mt-1.5 w-64 bg-[#0c1713] text-slate-200 rounded-xl shadow-2xl border border-[#1b3328] py-2 z-50 backdrop-blur-md">
                <%= link_to analytics_path, class: "block px-4 py-2.5 text-xs font-semibold text-slate-200 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Historical Performance Analytics
                <% end %>
                <%= link_to demo_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Interactive Demo Scenario
                <% end %>
                <%= link_to architecture_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  System Architecture
                <% end %>
                <%= link_to overview_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                  Smart India Hackathon Overview
                <% end %>
                <% if authenticated? && current_user.admin? %>
                  <div class="border-t border-[#1b3328] my-1"></div>
                  <%= link_to admin_users_path, class: "block px-4 py-2 text-xs font-bold text-orange-500 hover:bg-[#132a21] hover:text-orange-400 transition-colors" do %>
                    User Administration
                  <% end %>
                <% end %>
              </div>
            </div>

          </nav>

          <!-- Right Nav Controls: Sign In / Account + Search Trigger -->
          <div class="hidden sm:flex items-center space-x-3">
            
            <!-- Sign Up / Log In Dropdown -->
            <div class="relative" data-landing-page-target="dropdown">
              <button type="button"
                      data-action="click->landing-page#toggleDropdown"
                      class="px-3 py-1.5 rounded-lg hover:bg-[#132a21] text-slate-200 hover:text-emerald-300 flex items-center space-x-2 text-sm font-medium transition-all focus:outline-none cursor-pointer">
                <span><%= authenticated? ? (current_user.first_name || "Account") : "Sign Up/Log In" %></span>
                <div class="w-7 h-7 rounded-full bg-[#132a21] border border-[#1b3328] flex items-center justify-center text-slate-300">
                  <i class="far fa-user text-xs"></i>
                </div>
                <i data-dropdown-arrow class="fas fa-chevron-down text-[9px] text-slate-400 transition-transform duration-200"></i>
              </button>

              <div data-dropdown-menu class="hidden absolute top-full right-0 mt-1.5 w-56 bg-[#0c1713] text-slate-200 rounded-xl shadow-2xl border border-[#1b3328] py-2 z-50 backdrop-blur-md">
                <% if authenticated? %>
                  <div class="px-4 py-2 border-b border-[#1b3328]">
                    <p class="text-[11px] text-slate-400 uppercase font-mono tracking-wider">Signed in as</p>
                    <p class="text-xs font-bold text-white truncate"><%= current_user.email %></p>
                  </div>
                  <%= link_to dashboard_path, class: "block px-4 py-2 text-xs font-semibold text-slate-200 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                    <i class="fas fa-chart-line mr-2 text-emerald-400"></i> Live Dashboard
                  <% end %>
                  <%= link_to profile_path, class: "block px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                    <i class="fas fa-user-gear mr-2 text-slate-400"></i> Profile Settings
                  <% end %>
                  <div class="border-t border-[#1b3328] my-1"></div>
                  <%= button_to logout_path, method: :delete, class: "w-full text-left px-4 py-2 text-xs font-semibold text-rose-400 hover:bg-rose-950/30 transition-colors cursor-pointer" do %>
                    <i class="fas fa-sign-out-alt mr-2 text-rose-400"></i> Sign Out
                  <% end %>
                <% else %>
                  <%= link_to login_path, class: "block px-4 py-2 text-xs font-semibold text-slate-200 hover:bg-[#132a21] hover:text-emerald-400 transition-colors" do %>
                    Sign In
                  <% end %>
                  <%= link_to sign_up_path, class: "block px-4 py-2 text-xs font-semibold text-orange-500 hover:bg-[#132a21] hover:text-orange-400 transition-colors" do %>
                    Create Account
                  <% end %>
                  <div class="border-t border-[#1b3328] my-1"></div>
                  <%= button_to demo_sso_login_path, method: :post, class: "w-full text-left px-4 py-2 text-xs font-medium text-slate-300 hover:bg-[#132a21] hover:text-white transition-colors cursor-pointer" do %>
                    <i class="fas fa-bolt text-amber-500 mr-1.5"></i> 1-Click Demo SSO
                  <% end %>
                <% end %>
              </div>
            </div>

            <!-- Search Command Trigger (⌘K) -->
            <button type="button"
                    data-action="click->search-modal#open"
                    title="Search Corridors, Vessels & Emergencies (⌘K)"
                    class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-[#132a21] transition-all focus:outline-none cursor-pointer">
              <i class="fas fa-search text-sm"></i>
            </button>
          </div>

          <!-- Mobile Menu & Search Button -->
          <div class="flex items-center lg:hidden space-x-2">
            <button type="button"
                    data-action="click->search-modal#open"
                    title="Search (⌘K)"
                    class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-[#132a21] transition-colors">
              <i class="fas fa-search text-sm"></i>
            </button>
            <button type="button"
                    data-action="click->landing-page#toggleMobileMenu"
                    class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-[#132a21] transition-colors focus:outline-none"
                    aria-label="Toggle navigation">
              <i class="fas fa-bars text-lg"></i>
            </button>
          </div>

        </div>
      </div>

      <!-- Mobile Dropdown Slide-Out -->
      <div data-landing-page-target="mobileMenu" class="hidden lg:hidden border-t border-[#1b3328] bg-[#0c1713] px-6 py-5 space-y-4 shadow-2xl">
        <div class="space-y-2">
          <p class="text-[10px] font-mono uppercase tracking-widest text-slate-500 font-bold">Navigation</p>
          <div class="space-y-1 text-sm font-medium">
            <%= link_to "Dashboard", dashboard_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Intelligence Map", map_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Predictive Risks", accessibility_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Network Graph", network_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Smart Routes", routes_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Live Fleet Telemetry", shipments_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Emergency Response Center", emergencies_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Field Incidents", incidents_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Relief Depots", warehouses_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Demo Scenario", demo_path, class: "block py-2 text-orange-400 font-bold" %>
          </div>
        </div>

        <div class="pt-3 border-t border-[#1b3328] space-y-2">
          <% if authenticated? %>
            <%= link_to "Open Live Dashboard", dashboard_path, class: "w-full flex items-center justify-center py-3 rounded-xl text-xs font-bold text-white bg-orange-600 hover:bg-orange-500 shadow-md transition-all" %>
          <% else %>
            <div class="grid grid-cols-2 gap-2">
              <%= link_to "Sign In", login_path, class: "flex items-center justify-center py-2.5 rounded-xl text-xs font-bold text-slate-200 bg-[#132a21] hover:bg-[#1a382c] transition-colors" %>
              <%= link_to "Open Account", sign_up_path, class: "flex items-center justify-center py-2.5 rounded-xl text-xs font-bold text-white bg-orange-600 hover:bg-orange-500 shadow transition-colors" %>
            </div>
          <% end %>
        </div>
      </div>
    </header>
  </div>

  <!-- ============================================================== -->
  <!-- HERO SECTION WITH BACKGROUND & MULTI-TAB TELEMETRY CARD        -->
  <!-- ============================================================== -->
  <section class="relative pt-24 sm:pt-28 min-h-[760px] flex flex-col justify-between overflow-hidden bg-cover bg-no-repeat"
           style="background-image: linear-gradient(to bottom, rgba(12, 22, 18, 0.60) 0%, rgba(12, 22, 18, 0.32) 36%, rgba(12, 22, 18, 0.88) 85%, #0c1612 100%), url('<%= image_path("hero_bg.jpg") %>'); background-position: center 34%;">
    
    <!-- Hero Center Headline -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-10 sm:pt-16 pb-8 relative z-10">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.8)]">
        Welcome to ResQWay
      </h1>
      <p class="text-xs sm:text-sm text-slate-200 max-w-xl mx-auto font-medium mt-3 drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]">
        Logistics, Real-Time Tracking &amp; Predictive Risk Intelligence Cockpit
      </p>
    </div>

    <!-- Floating Interactive Multi-Tab Telemetry Widget -->
    <div class="w-full max-w-3xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="bg-white rounded-t-2xl shadow-[0_25px_60px_-15px_rgba(0,0,0,0.7)] overflow-hidden border border-slate-200/80 transition-all duration-300 hover:shadow-[0_30px_70px_-10px_rgba(16,185,129,0.18)]">
        
        <!-- Tab Navigation Bar -->
        <div class="grid grid-cols-3 border-b border-slate-200 text-center text-xs font-bold uppercase tracking-wider">
          
          <!-- Tab 1: Smart Route -->
          <button type="button"
                  data-landing-page-target="tabBtn"
                  data-tab="smart_route"
                  data-action="click->landing-page#switchTab"
                  class="py-3.5 px-4 bg-white text-slate-700 hover:bg-emerald-50/50 hover:text-emerald-900 flex items-center justify-center space-x-2 transition-all focus:outline-none cursor-pointer">
            <i class="fas fa-route text-slate-500"></i>
            <span class="truncate">Smart Route</span>
          </button>

          <!-- Tab 2: Live Fleet (Default Active as per screenshot) -->
          <button type="button"
                  data-landing-page-target="tabBtn"
                  data-tab="live_fleet"
                  data-action="click->landing-page#switchTab"
                  class="py-3.5 px-4 bg-[#0f261d] text-white flex items-center justify-center space-x-2 transition-all focus:outline-none cursor-pointer"
                  aria-selected="true">
            <i class="fas fa-ship text-slate-300"></i>
            <span class="truncate">Live Fleet</span>
          </button>

          <!-- Tab 3: Field Incidence -->
          <button type="button"
                  data-landing-page-target="tabBtn"
                  data-tab="field_incidence"
                  data-action="click->landing-page#switchTab"
                  class="py-3.5 px-4 bg-white text-slate-700 hover:bg-emerald-50/50 hover:text-emerald-900 flex items-center justify-center space-x-2 transition-all focus:outline-none cursor-pointer">
            <i class="fas fa-triangle-exclamation text-slate-500"></i>
            <span class="truncate">Field Incidence</span>
          </button>

        </div>

        <!-- Tab Panes Container -->
        <div class="p-6 sm:p-7 text-slate-900 bg-white">
          
          <!-- Pane 1: Smart Route -->
          <div data-landing-page-target="tabPane" data-tab="smart_route" class="hidden space-y-5">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-3xl font-black text-slate-900">0.1ms</span>
                <span class="text-xs font-black uppercase tracking-wider text-slate-800 ml-2">Triple-Buffered Optimizer</span>
              </div>
              <span class="text-xs font-semibold text-slate-500">Instant Risk Detour In-Memory</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-y border-slate-100 py-4">
              <div>
                <span class="text-xl font-bold text-slate-900">NH-27 / NH-10</span>
                <span class="block text-xs text-slate-500">Siliguri Arterial Lifeline</span>
              </div>
              <div>
                <span class="text-xl font-bold text-emerald-600">98.4%</span>
                <span class="block text-xs text-slate-500">Corridor Reliability</span>
              </div>
              <div>
                <span class="text-xl font-bold text-orange-600">3 Alts</span>
                <span class="block text-xs text-slate-500">Dynamic Alternate Corridors</span>
              </div>
            </div>

            <div class="flex items-center justify-between pt-2">
              <span class="text-xs font-medium text-emerald-600 flex items-center space-x-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Real-time terrain gradient analysis</span>
              </span>
              <%= link_to routes_path, class: "px-5 py-2.5 rounded-lg bg-orange-600 hover:bg-orange-500 text-white font-bold text-xs uppercase tracking-wider shadow hover:shadow-orange-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center space-x-1.5" do %>
                <span>Calculate Smart Routes</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              <% end %>
            </div>
          </div>

          <!-- Pane 2: Live Fleet (Default Active Tab) -->
          <div data-landing-page-target="tabPane" data-tab="live_fleet" class="space-y-6">
            <!-- Active Global Fleets Counter -->
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="text-3xl sm:text-4xl font-black text-slate-900 leading-none">48</span>
                <div class="flex items-center space-x-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-xs font-extrabold uppercase tracking-wider text-slate-900">
                    Active Global Fleets
                  </span>
                </div>
              </div>
              <span class="text-xs font-semibold text-slate-500">
                100% AIS Coverage
              </span>
            </div>

            <!-- Fleet Category Breakdown Columns -->
            <div class="grid grid-cols-3 divide-x divide-slate-200 border-y border-slate-100 py-3">
              <div class="pr-4">
                <span class="text-2xl font-bold text-slate-900 block leading-tight">24</span>
                <span class="text-xs text-slate-500">Ocean Vessels</span>
              </div>
              <div class="px-4">
                <span class="text-2xl font-bold text-slate-900 block leading-tight">14</span>
                <span class="text-xs text-slate-500">Air Freighters</span>
              </div>
              <div class="pl-4">
                <span class="text-2xl font-bold text-slate-900 block leading-tight">10</span>
                <span class="text-xs text-slate-500">Intermodal Rail</span>
              </div>
            </div>

            <!-- Bottom Live Telemetry Row & Action -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-1">
              <div class="flex items-center space-x-2 text-xs font-medium text-emerald-600">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Real-time GPS telemetry active</span>
              </div>

              <%= link_to shipments_path, class: "w-full sm:w-auto px-6 py-2.5 rounded-lg bg-orange-600 hover:bg-orange-500 text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-orange-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center space-x-1.5" do %>
                <span>View Live Fleet</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              <% end %>
            </div>
          </div>

          <!-- Pane 3: Field Incidence -->
          <div data-landing-page-target="tabPane" data-tab="field_incidence" class="hidden space-y-5">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-3xl font-black text-rose-600 leading-none">
                  <%= @total_emergencies.present? ? @total_emergencies : 6 %>
                </span>
                <span class="text-xs font-black uppercase tracking-wider text-slate-800 ml-2">Active Field Incidents</span>
              </div>
              <span class="text-xs font-semibold text-slate-500">Real-time Citizen &amp; Sensor Radar</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-y border-slate-100 py-4">
              <div>
                <span class="text-xl font-bold text-slate-900">4</span>
                <span class="block text-xs text-slate-500">Monsoon Landslides</span>
              </div>
              <div>
