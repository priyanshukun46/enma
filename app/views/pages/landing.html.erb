<div data-controller="landing-page" class="w-full relative bg-[#111315] text-slate-100 min-h-screen selection:bg-orange-500 selection:text-white font-sans">

  <!-- ============================================================== -->
  <!-- TOP ACCENT BAR & STICKY NAVIGATION                             -->
  <!-- ============================================================== -->
  <div class="fixed top-0 left-0 right-0 z-50">
    <!-- Thin 3px orange accent line -->
    <div class="h-[3px] w-full bg-gradient-to-r from-orange-600 via-amber-500 to-orange-500"></div>

    <header class="w-full bg-[#181a1d]/95 backdrop-blur-md border-b border-slate-800/80 shadow-lg transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
          
          <!-- Brand Logo (Transparent Logo Uploaded by User) -->
          <div class="flex items-center space-x-3 flex-shrink-0">
            <%= link_to root_path, class: "flex items-center group focus:outline-none" do %>
              <%= image_tag "logo.png", alt: "ResQWay", class: "h-9 sm:h-11 w-auto object-contain transition-transform group-hover:scale-[1.02]" %>
            <% end %>
          </div>

          <!-- Desktop Navigation Menus (Operational Engine, Tactical Response, Insights and Simulations) -->
          <nav class="hidden lg:flex items-center space-x-1 sm:space-x-3 text-sm font-medium text-slate-200">
            
            <!-- Menu 1: Operational Engine -->
            <div class="relative" data-landing-page-target="dropdown">
              <button type="button"
                      data-action="click->landing-page#toggleDropdown"
                      class="px-3.5 py-2 rounded-lg hover:bg-slate-800/80 hover:text-white flex items-center space-x-1.5 transition-colors focus:outline-none cursor-pointer">
                <span>Operational Engine</span>
                <i data-dropdown-arrow class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"></i>
              </button>

              <div data-dropdown-menu class="hidden absolute top-full left-0 mt-1.5 w-64 bg-white text-slate-900 rounded-xl shadow-2xl border border-slate-200/90 py-2 z-50">
                <%= link_to dashboard_path, class: "block px-4 py-2.5 text-xs font-semibold text-slate-800 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Dashboard
                <% end %>
                <%= link_to map_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Intelligence Map
                <% end %>
                <%= link_to accessibility_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Predictive Risks
                <% end %>
                <%= link_to network_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Network Graph
                <% end %>
                <%= link_to intelligence_predictions_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Cascade Predictions
                <% end %>
                <%= link_to intelligence_response_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Autonomous Response
                <% end %>
                <%= link_to intelligence_command_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Unified Command
                <% end %>
                <%= link_to routes_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Smart Routes
                <% end %>
                <%= link_to shipments_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Live Fleet Telemetry
                <% end %>
                <div class="border-t border-slate-100 my-1"></div>
                <%= link_to dashboard_path, class: "block px-4 py-2 text-xs font-black text-orange-600 uppercase tracking-wider hover:bg-orange-50 transition-colors" do %>
                  All Operational Tools &rarr;
                <% end %>
              </div>
            </div>

            <!-- Menu 2: Tactical Response -->
            <div class="relative" data-landing-page-target="dropdown">
              <button type="button"
                      data-action="click->landing-page#toggleDropdown"
                      class="px-3.5 py-2 rounded-lg hover:bg-slate-800/80 hover:text-white flex items-center space-x-1.5 transition-colors focus:outline-none cursor-pointer">
                <span>Tactical Response</span>
                <i data-dropdown-arrow class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"></i>
              </button>

              <div data-dropdown-menu class="hidden absolute top-full left-0 mt-1.5 w-64 bg-white text-slate-900 rounded-xl shadow-2xl border border-slate-200/90 py-2 z-50">
                <%= link_to emergencies_path, class: "block px-4 py-2.5 text-xs font-semibold text-slate-800 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Emergency Center
                <% end %>
                <%= link_to incidents_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Field Incidents (Photo Dispatch)
                <% end %>
                <%= link_to warehouses_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Relief Depots &amp; Stock
                <% end %>
                <%= link_to logistics_alerts_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Corridor Disruption Alerts
                <% end %>
                <div class="border-t border-slate-100 my-1"></div>
                <%= link_to intelligence_command_path, class: "block px-4 py-2 text-xs font-black text-orange-600 uppercase tracking-wider hover:bg-orange-50 transition-colors" do %>
                  Live Convoy Dispatch &rarr;
                <% end %>
              </div>
            </div>

            <!-- Menu 3: Insights and Simulations -->
            <div class="relative" data-landing-page-target="dropdown">
              <button type="button"
                      data-action="click->landing-page#toggleDropdown"
                      class="px-3.5 py-2 rounded-lg hover:bg-slate-800/80 hover:text-white flex items-center space-x-1.5 transition-colors focus:outline-none cursor-pointer">
                <span>Insights and Simulations</span>
                <i data-dropdown-arrow class="fas fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"></i>
              </button>

              <div data-dropdown-menu class="hidden absolute top-full left-0 mt-1.5 w-64 bg-white text-slate-900 rounded-xl shadow-2xl border border-slate-200/90 py-2 z-50">
                <%= link_to analytics_path, class: "block px-4 py-2.5 text-xs font-semibold text-slate-800 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Historical Performance Analytics
                <% end %>
                <%= link_to demo_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Interactive Demo Scenario
                <% end %>
                <%= link_to architecture_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  System Architecture
                <% end %>
                <%= link_to overview_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                  Smart India Hackathon Overview
                <% end %>
                <% if authenticated? && current_user.admin? %>
                  <div class="border-t border-slate-100 my-1"></div>
                  <%= link_to admin_users_path, class: "block px-4 py-2 text-xs font-bold text-orange-600 hover:bg-orange-50 transition-colors" do %>
                    User Administration
                  <% end %>
                <% end %>
              </div>
            </div>

          </nav>

          <!-- Right Nav Controls: Sign In / Account + Search Trigger -->
          <div class="hidden sm:flex items-center space-x-3">
            
            <!-- Sign Up / Log In Dropdown -->
            <div class="relative" data-landing-page-target="dropdown">
              <button type="button"
                      data-action="click->landing-page#toggleDropdown"
                      class="px-3 py-1.5 rounded-lg hover:bg-slate-800/80 text-slate-200 hover:text-white flex items-center space-x-2 text-sm font-medium transition-colors focus:outline-none cursor-pointer">
                <span><%= authenticated? ? (current_user.first_name || "Account") : "Sign Up/Log In" %></span>
                <div class="w-7 h-7 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-300">
                  <i class="far fa-user text-xs"></i>
                </div>
                <i data-dropdown-arrow class="fas fa-chevron-down text-[9px] text-slate-400 transition-transform duration-200"></i>
              </button>

              <div data-dropdown-menu class="hidden absolute top-full right-0 mt-1.5 w-56 bg-white text-slate-900 rounded-xl shadow-2xl border border-slate-200/90 py-2 z-50">
                <% if authenticated? %>
                  <div class="px-4 py-2 border-b border-slate-100">
                    <p class="text-[11px] text-slate-400 uppercase font-mono tracking-wider">Signed in as</p>
                    <p class="text-xs font-bold text-slate-800 truncate"><%= current_user.email %></p>
                  </div>
                  <%= link_to dashboard_path, class: "block px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                    <i class="fas fa-chart-line mr-2 text-slate-400"></i> Live Dashboard
                  <% end %>
                  <%= link_to profile_path, class: "block px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                    <i class="fas fa-user-gear mr-2 text-slate-400"></i> Profile Settings
                  <% end %>
                  <div class="border-t border-slate-100 my-1"></div>
                  <%= button_to logout_path, method: :delete, class: "w-full text-left px-4 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" do %>
                    <i class="fas fa-sign-out-alt mr-2 text-rose-500"></i> Sign Out
                  <% end %>
                <% else %>
                  <%= link_to login_path, class: "block px-4 py-2 text-xs font-semibold text-slate-800 hover:bg-slate-100 hover:text-orange-600 transition-colors" do %>
                    Sign In
                  <% end %>
                  <%= link_to sign_up_path, class: "block px-4 py-2 text-xs font-semibold text-orange-600 hover:bg-orange-50 transition-colors" do %>
                    Create Account
                  <% end %>
                  <div class="border-t border-slate-100 my-1"></div>
                  <%= button_to demo_sso_login_path, method: :post, class: "w-full text-left px-4 py-2 text-xs font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors cursor-pointer" do %>
                    <i class="fas fa-bolt text-amber-500 mr-1.5"></i> 1-Click Demo SSO
                  <% end %>
                <% end %>
              </div>
            </div>

            <!-- Search Command Trigger (⌘K) -->
            <button type="button"
                    data-action="click->search-modal#open"
                    title="Search Corridors, Vessels & Emergencies (⌘K)"
                    class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors focus:outline-none cursor-pointer">
              <i class="fas fa-search text-sm"></i>
            </button>
          </div>

          <!-- Mobile Menu & Search Button -->
          <div class="flex items-center lg:hidden space-x-2">
            <button type="button"
                    data-action="click->search-modal#open"
                    title="Search (⌘K)"
                    class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">
              <i class="fas fa-search text-sm"></i>
            </button>
            <button type="button"
                    data-action="click->landing-page#toggleMobileMenu"
                    class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors focus:outline-none"
                    aria-label="Toggle navigation">
              <i class="fas fa-bars text-lg"></i>
            </button>
          </div>

        </div>
      </div>

      <!-- Mobile Dropdown Slide-Out -->
      <div data-landing-page-target="mobileMenu" class="hidden lg:hidden border-t border-slate-800 bg-[#16181b] px-6 py-5 space-y-4 shadow-2xl">
        <div class="space-y-2">
          <p class="text-[10px] font-mono uppercase tracking-widest text-slate-500 font-bold">Navigation</p>
          <div class="space-y-1 text-sm font-medium">
            <%= link_to "Dashboard", dashboard_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Intelligence Map", map_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Predictive Risks", accessibility_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Network Graph", network_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Smart Routes", routes_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Live Fleet Telemetry", shipments_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Emergency Response Center", emergencies_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Field Incidents", incidents_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Relief Depots", warehouses_path, class: "block py-2 text-slate-200 hover:text-orange-500" %>
            <%= link_to "Demo Scenario", demo_path, class: "block py-2 text-orange-400 font-bold" %>
          </div>
        </div>

        <div class="pt-3 border-t border-slate-800 space-y-2">
          <% if authenticated? %>
            <%= link_to "Open Live Dashboard", dashboard_path, class: "w-full flex items-center justify-center py-3 rounded-xl text-xs font-bold text-white bg-orange-600 hover:bg-orange-500 shadow-md" %>
          <% else %>
            <div class="grid grid-cols-2 gap-2">
              <%= link_to "Sign In", login_path, class: "flex items-center justify-center py-2.5 rounded-xl text-xs font-bold text-slate-200 bg-slate-800 hover:bg-slate-700" %>
              <%= link_to "Open Account", sign_up_path, class: "flex items-center justify-center py-2.5 rounded-xl text-xs font-bold text-white bg-orange-600 hover:bg-orange-500 shadow" %>
            </div>
          <% end %>
        </div>
      </div>
    </header>
  </div>

  <!-- ============================================================== -->
  <!-- HERO SECTION WITH BACKGROUND & MULTI-TAB TELEMETRY CARD        -->
  <!-- ============================================================== -->
  <section class="relative pt-24 sm:pt-28 min-h-[720px] flex flex-col justify-between overflow-hidden bg-cover bg-center"
           style="background-image: linear-gradient(to bottom, rgba(15, 17, 20, 0.45), rgba(17, 19, 21, 0.85)), url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=2000&q=80');">
    
    <!-- Hero Center Headline -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-12 sm:pt-20 pb-8 relative z-10">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white drop-shadow-lg">
        Welcome to ResQWay
      </h1>
      <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto font-medium mt-3 drop-shadow">
        Logistics, Real-Time Tracking &amp; Predictive Risk Intelligence Cockpit
      </p>
    </div>

    <!-- Floating Interactive Multi-Tab Telemetry Widget -->
    <div class="w-full max-w-3xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="bg-white rounded-t-2xl shadow-2xl overflow-hidden border border-slate-200">
        
        <!-- Tab Navigation Bar -->
        <div class="grid grid-cols-3 border-b border-slate-200 text-center text-xs font-bold uppercase tracking-wider">
          
          <!-- Tab 1: Smart Route -->
          <button type="button"
                  data-landing-page-target="tabBtn"
                  data-tab="smart_route"
                  data-action="click->landing-page#switchTab"
                  class="py-3.5 px-4 bg-white text-slate-700 hover:bg-slate-50 flex items-center justify-center space-x-2 transition-colors focus:outline-none cursor-pointer">
            <i class="fas fa-route text-slate-500"></i>
            <span class="truncate">Smart Route</span>
          </button>

          <!-- Tab 2: Live Fleet (Default Active as per screenshot) -->
          <button type="button"
                  data-landing-page-target="tabBtn"
                  data-tab="live_fleet"
                  data-action="click->landing-page#switchTab"
                  class="py-3.5 px-4 bg-[#182938] text-white flex items-center justify-center space-x-2 transition-colors focus:outline-none cursor-pointer"
                  aria-selected="true">
            <i class="fas fa-ship text-slate-300"></i>
            <span class="truncate">Live Fleet</span>
          </button>

          <!-- Tab 3: Field Incidence -->
          <button type="button"
                  data-landing-page-target="tabBtn"
                  data-tab="field_incidence"
                  data-action="click->landing-page#switchTab"
                  class="py-3.5 px-4 bg-white text-slate-700 hover:bg-slate-50 flex items-center justify-center space-x-2 transition-colors focus:outline-none cursor-pointer">
            <i class="fas fa-triangle-exclamation text-slate-500"></i>
            <span class="truncate">Field Incidence</span>
          </button>

        </div>

        <!-- Tab Panes Container -->
        <div class="p-6 sm:p-7 text-slate-900 bg-white">
          
          <!-- Pane 1: Smart Route -->
          <div data-landing-page-target="tabPane" data-tab="smart_route" class="hidden space-y-5">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-3xl font-black text-slate-900">0.1ms</span>
                <span class="text-xs font-black uppercase tracking-wider text-slate-800 ml-2">Triple-Buffered Optimizer</span>
              </div>
              <span class="text-xs font-semibold text-slate-500">Instant Risk Detour In-Memory</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-y border-slate-100 py-4">
              <div>
                <span class="text-xl font-bold text-slate-900">NH-27 / NH-10</span>
                <span class="block text-xs text-slate-500">Siliguri Arterial Lifeline</span>
              </div>
              <div>
                <span class="text-xl font-bold text-emerald-600">98.4%</span>
                <span class="block text-xs text-slate-500">Corridor Reliability</span>
              </div>
              <div>
                <span class="text-xl font-bold text-orange-600">3 Alts</span>
                <span class="block text-xs text-slate-500">Dynamic Alternate Corridors</span>
              </div>
            </div>

            <div class="flex items-center justify-between pt-2">
              <span class="text-xs font-medium text-emerald-600 flex items-center space-x-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Real-time terrain gradient analysis</span>
              </span>
              <%= link_to routes_path, class: "px-5 py-2.5 rounded-lg bg-orange-600 hover:bg-orange-500 text-white font-bold text-xs uppercase tracking-wider shadow transition-all flex items-center space-x-1.5" do %>
                <span>Calculate Smart Routes</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              <% end %>
            </div>
          </div>

          <!-- Pane 2: Live Fleet (Default Active Tab) -->
          <div data-landing-page-target="tabPane" data-tab="live_fleet" class="space-y-6">
            <!-- Active Global Fleets Counter -->
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="text-3xl sm:text-4xl font-black text-slate-900 leading-none">
                  <%= @total_vehicles.present? && @total_vehicles > 0 ? @total_vehicles * 4 : 48 %>
                </span>
                <div class="flex items-center space-x-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-xs font-extrabold uppercase tracking-wider text-slate-900">
                    Active Global Fleets
                  </span>
                </div>
              </div>
              <span class="text-xs font-semibold text-slate-500">
                100% AIS Coverage
              </span>
            </div>

            <!-- Fleet Category Breakdown Columns -->
            <div class="grid grid-cols-3 divide-x divide-slate-200 border-y border-slate-100 py-3">
              <div class="pr-4">
                <span class="text-2xl font-bold text-slate-900 block leading-tight">24</span>
                <span class="text-xs text-slate-500">Ocean Vessels</span>
              </div>
              <div class="px-4">
                <span class="text-2xl font-bold text-slate-900 block leading-tight">14</span>
                <span class="text-xs text-slate-500">Air Freighters</span>
              </div>
              <div class="pl-4">
                <span class="text-2xl font-bold text-slate-900 block leading-tight">10</span>
                <span class="text-xs text-slate-500">Intermodal Rail</span>
              </div>
            </div>

            <!-- Bottom Live Telemetry Row & Action -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-1">
              <div class="flex items-center space-x-2 text-xs font-medium text-emerald-600">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Real-time GPS telemetry active</span>
              </div>

              <%= link_to shipments_path, class: "w-full sm:w-auto px-6 py-2.5 rounded-lg bg-orange-600 hover:bg-orange-500 text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all flex items-center justify-center space-x-1.5" do %>
                <span>View Live Fleet</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              <% end %>
            </div>
          </div>

          <!-- Pane 3: Field Incidence -->
          <div data-landing-page-target="tabPane" data-tab="field_incidence" class="hidden space-y-5">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-3xl font-black text-rose-600 leading-none">
                  <%= @total_emergencies.present? ? @total_emergencies : 6 %>
                </span>
                <span class="text-xs font-black uppercase tracking-wider text-slate-800 ml-2">Active Field Incidents</span>
              </div>
              <span class="text-xs font-semibold text-slate-500">Real-time Citizen &amp; Sensor Radar</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-y border-slate-100 py-4">
              <div>
                <span class="text-xl font-bold text-slate-900">4</span>
                <span class="block text-xs text-slate-500">Monsoon Landslides</span>
              </div>
              <div>
                <span class="text-xl font-bold text-amber-600">2</span>
                <span class="block text-xs text-slate-500">Flooded Bridges</span>
              </div>
              <div>
                <span class="text-xl font-bold text-emerald-600">100%</span>
                <span class="block text-xs text-slate-500">Depots Pre-staged</span>
              </div>
            </div>

            <div class="flex items-center justify-between pt-2">
              <span class="text-xs font-medium text-slate-500 flex items-center space-x-1.5">
                <i class="fas fa-camera text-orange-500 text-xs"></i>
                <span>Geo-tagged photos attached to dispatch models</span>
              </span>
              <%= link_to incidents_path, class: "px-5 py-2.5 rounded-lg bg-orange-600 hover:bg-orange-500 text-white font-bold text-xs uppercase tracking-wider shadow transition-all flex items-center space-x-1.5" do %>
                <span>View Field Incidents</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              <% end %>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Centered Scroll to Explore Indicator -->
    <div class="pt-6 pb-4 text-center relative z-10">
