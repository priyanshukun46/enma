<div data-controller="landing-page" class="w-full relative bg-white text-[#212121] min-h-screen selection:bg-[#FF6200] selection:text-white font-sans">

  <!-- ============================================================== -->
  <!-- TOP NAVIGATION HEADER (FEDEX PURPLE #4D148C)                   -->
  <!-- ============================================================== -->
  <%= render "shared/resqway_header" %>

  <!-- ============================================================== -->
  <!-- HERO SECTION WITH FEDEX HERO IMAGE & 3-TAB FLOATING WIDGET     -->
  <!-- ============================================================== -->
  <section class="relative pt-24 sm:pt-28 min-h-[500px] sm:min-h-[540px] flex flex-col justify-center overflow-hidden bg-cover bg-center bg-no-repeat"
           style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.30) 0%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.35) 100%), url('<%= image_path("fedex_hero_clean.jpg") %>');">
    
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center relative z-10 py-10 sm:py-14">
      
      <!-- Headline: Welcome to ResQWay (Clean, white sans-serif, matching "Welcome to FedEx") -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-normal text-white text-center mb-8 sm:mb-10 drop-shadow-md tracking-tight font-sans">
        Welcome to ResQWay
      </h1>

      <!-- Centered 3-Tab Floating Widget -->
      <div class="w-full max-w-2xl mx-auto">
        
        <!-- Top 3 Tabs Sitting Horizontally -->
        <div class="flex items-end justify-center">
          
          <!-- Tab 1: RATE & TRANSIT TIMES -->
          <button type="button"
                  data-action="click->landing-page#switchFedexTab"
                  data-fedex-tab="rate"
                  data-landing-page-target="fedexTabBtn"
                  class="w-36 sm:w-48 h-20 sm:h-24 bg-white text-[#212121] hover:bg-slate-50 flex flex-col items-center justify-center p-2 transition-all cursor-pointer border-r border-slate-200 shadow-md">
            <i class="fas fa-calculator text-2xl text-slate-700 mb-1.5"></i>
            <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-center leading-tight">RATE &amp; TRANSIT TIMES</span>
          </button>

          <!-- Tab 2: TRACK (Default Active Tab in #4D148C) -->
          <button type="button"
                  data-action="click->landing-page#switchFedexTab"
                  data-fedex-tab="track"
                  data-landing-page-target="fedexTabBtn"
                  class="w-36 sm:w-48 h-20 sm:h-24 bg-[#4D148C] text-white flex flex-col items-center justify-center p-2 transition-all cursor-pointer shadow-md">
            <i class="fas fa-search-location text-2xl text-white mb-1.5"></i>
            <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-center leading-tight">TRACK</span>
          </button>

          <!-- Tab 3: SHIP -->
          <button type="button"
                  data-action="click->landing-page#switchFedexTab"
                  data-fedex-tab="ship"
                  data-landing-page-target="fedexTabBtn"
                  class="w-36 sm:w-48 h-20 sm:h-24 bg-white text-[#212121] hover:bg-slate-50 flex flex-col items-center justify-center p-2 transition-all cursor-pointer border-l border-slate-200 shadow-md">
            <i class="fas fa-box text-2xl text-slate-700 mb-1.5"></i>
            <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-center leading-tight">SHIP</span>
          </button>

        </div>

        <!-- Flush Input Bar Directly Underneath Tabs -->
        <div class="shadow-2xl overflow-hidden rounded-b-md sm:rounded-b-none">
          
          <!-- Pane 1: TRACK (Default Active) -->
          <form action="<%= map_path %>" method="get" data-landing-page-target="fedexPane" data-fedex-pane="track" class="flex w-full">
            <input type="text"
                   name="q"
                   placeholder="TRACKING ID"
                   class="flex-1 bg-white text-[#212121] placeholder:italic placeholder:text-slate-400 placeholder:text-sm font-medium px-5 sm:px-7 py-4 sm:py-5 text-sm sm:text-base focus:outline-none uppercase tracking-wide">
            <button type="submit"
                    class="bg-[#FF6200] hover:bg-[#e05600] text-white font-bold uppercase text-xs sm:text-sm tracking-wider px-6 sm:px-10 flex items-center justify-center space-x-2 transition-colors cursor-pointer shrink-0">
              <span>TRACK</span>
              <i class="fas fa-arrow-right text-xs"></i>
            </button>
          </form>

          <!-- Pane 2: RATE & TRANSIT TIMES -->
          <form action="<%= routes_path %>" method="get" data-landing-page-target="fedexPane" data-fedex-pane="rate" class="hidden flex flex-col sm:flex-row w-full bg-white p-3 gap-2">
            <input type="text" name="origin" placeholder="FROM: CITY / HUB" class="flex-1 bg-slate-50 text-[#212121] placeholder:italic placeholder:text-slate-400 px-4 py-3 text-xs sm:text-sm border border-slate-200 rounded focus:outline-none">
            <input type="text" name="destination" placeholder="TO: CITY / HUB" class="flex-1 bg-slate-50 text-[#212121] placeholder:italic placeholder:text-slate-400 px-4 py-3 text-xs sm:text-sm border border-slate-200 rounded focus:outline-none">
            <button type="submit" class="bg-[#FF6200] hover:bg-[#e05600] text-white font-bold uppercase text-xs tracking-wider px-6 py-3 rounded flex items-center justify-center space-x-2 transition-colors cursor-pointer">
              <span>CALCULATE</span>
              <i class="fas fa-arrow-right text-xs"></i>
            </button>
          </form>

          <!-- Pane 3: SHIP -->
          <div data-landing-page-target="fedexPane" data-fedex-pane="ship" class="hidden bg-white p-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-left">
            <div>
              <h4 class="font-bold text-sm text-[#212121]">Create a Relief Consignment or Emergency Dispatch</h4>
              <p class="text-xs text-slate-500">Fast pre-cleared logistics dispatch across all regional corridors</p>
            </div>
            <%= link_to new_emergency_path, class: "bg-[#FF6200] hover:bg-[#e05600] text-white font-bold uppercase text-xs tracking-wider px-6 py-3 rounded flex items-center space-x-2 transition-colors shrink-0" do %>
              <span>CREATE SHIPMENT</span>
              <i class="fas fa-arrow-right text-xs"></i>
            <% end %>
          </div>

        </div>

      </div>

    </div>

  </section>

  <!-- ============================================================== -->
  <!-- SPLIT PROMOTIONAL BANNER (SCREENSHOT 1: PURPLE & WHITE)        -->
  <!-- ============================================================== -->
  <section class="w-full bg-[#4D148C]">
    <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[160px]">
      
      <!-- Left 65% in Solid FedEx Purple #4D148C -->
      <div class="lg:col-span-8 bg-[#4D148C] text-white py-10 px-6 sm:px-12 lg:px-20 flex items-start space-x-6">
        <div class="hidden sm:block shrink-0 mt-1">
          <svg class="w-14 h-14 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
        </div>
        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-snug">
            Sign up now and save up to 65%* off your shipping rates!
          </h2>
          <p class="text-sm sm:text-base text-white/90 font-normal">
            Benefit from our services and solutions designed to meet all of your shipping needs.
          </p>
          <p class="text-xs text-white/70 pt-1 leading-relaxed">
            *This discount doesn't apply to freight-forwarders, re-sellers and organizations shipping dangerous goods or valuable items.
          </p>
          <p class="text-xs text-white font-bold">
            *Terms &amp; Conditions apply.
          </p>
        </div>
      </div>

      <!-- Right 35% in Crisp White with Outline Button -->
      <div class="lg:col-span-4 bg-white py-10 px-8 sm:px-12 flex items-center justify-center">
        <%= link_to sign_up_path, class: "px-8 py-3.5 rounded-full border-2 border-[#4D148C] text-[#4D148C] font-bold text-xs sm:text-sm uppercase tracking-wider hover:bg-[#4D148C] hover:text-white transition-all text-center cursor-pointer shadow-sm" do %>
          OPEN AN ACCOUNT
        <% end %>
      </div>

    </div>
  </section>

  <!-- ============================================================== -->
  <!-- "WHAT ARE YOU LOOKING FOR TODAY?" SECTION (SCREENSHOT 3)       -->
  <!-- ============================================================== -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading in Deep Purple #4D148C -->
      <h2 class="text-3xl sm:text-4xl font-normal text-[#4D148C] text-center mb-14 tracking-tight">
        What are you looking for today?
      </h2>

      <!-- 6 Circular Outline Icons in a Row -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 sm:gap-8 mb-20 text-center">
        
        <!-- 1: SCHEDULE PICKUP -->
        <%= link_to routes_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#FF6200] flex items-center justify-center p-4 transition-transform group-hover:scale-105 shadow-sm">
            <svg class="w-10 h-10 text-[#FF6200]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11h3m-1.5-1.5v3" />
            </svg>
          </div>
          <span class="text-xs font-bold text-[#007AB7] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            SCHEDULE<br>PICKUP
          </span>
        <% end %>

        <!-- 2: REDIRECT YOUR PACKAGE -->
        <%= link_to shipments_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#4D148C] flex items-center justify-center p-4 transition-transform group-hover:scale-105 shadow-sm">
            <svg class="w-10 h-10 text-[#4D148C]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 17a2 2 0 100-4 2 2 0 000 4zm10 0a2 2 0 100-4 2 2 0 000 4zM3 9h11v7H3V9zm11 3h4l2 3v1h-6v-4z" />
            </svg>
          </div>
          <span class="text-xs font-bold text-[#007AB7] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            REDIRECT<br>YOUR PACKAGE
          </span>
        <% end %>

        <!-- 3: FIND LOCATIONS -->
        <%= link_to warehouses_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#4D148C] flex items-center justify-center p-4 transition-transform group-hover:scale-105 shadow-sm">
            <svg class="w-10 h-10 text-[#4D148C]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <span class="text-xs font-bold text-[#007AB7] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            FIND<br>LOCATIONS
          </span>
        <% end %>

        <!-- 4: FUEL SURCHARGE -->
        <%= link_to accessibility_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#FF6200] flex items-center justify-center p-4 transition-transform group-hover:scale-105 shadow-sm">
            <svg class="w-10 h-10 text-[#FF6200]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-xs font-bold text-[#007AB7] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            FUEL<br>SURCHARGE
          </span>
        <% end %>

        <!-- 5: CONTACT US -->
        <%= link_to emergencies_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#4D148C] flex items-center justify-center p-4 transition-transform group-hover:scale-105 shadow-sm">
            <svg class="w-10 h-10 text-[#4D148C]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
            </svg>
          </div>
          <span class="text-xs font-bold text-[#007AB7] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            CONTACT<br>US
          </span>
        <% end %>

        <!-- 6: FEDEX IMPORT TOOL -->
        <%= link_to intelligence_predictions_path, class: "flex flex-col items-center group cursor-pointer" do %>
          <div class="w-20 h-20 rounded-full border-2 border-[#4D148C] flex items-center justify-center p-4 transition-transform group-hover:scale-105 shadow-sm">
            <svg class="w-10 h-10 text-[#4D148C]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-xs font-bold text-[#007AB7] group-hover:underline uppercase tracking-wider mt-4 leading-snug">
            FEDEX<br>IMPORT TOOL
          </span>
        <% end %>

      </div>

      <!-- Two-Column Feature Showcase (Screenshot 3) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        
        <!-- Card 1: US Shipping -->
        <div class="flex flex-col">
          <div class="overflow-hidden">
            <%= image_tag "fedex_us_shipping.jpg", alt: "Navigate Shipping to the US with ease", class: "w-full h-64 sm:h-72 object-cover transition-transform duration-500 hover:scale-102" %>
          </div>
          <div class="pt-5 space-y-2">
            <h3 class="text-2xl font-normal text-[#212121]">
              Navigate Shipping to the US with ease
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              In today's dynamic trade environment, having expertise in clearance and compliance is crucial. We're here to assist your logistics with intelligent route clearance, real-time customs advisories, and corridor tracking.
            </p>
          </div>
        </div>

        <!-- Card 2: IN-EU Market -->
        <div class="flex flex-col">
          <div class="overflow-hidden">
            <%= image_tag "fedex_eu_market.jpg", alt: "Unlock IN-EU market", class: "w-full h-64 sm:h-72 object-cover transition-transform duration-500 hover:scale-102" %>
          </div>
          <div class="pt-5 space-y-2">
            <h3 class="text-2xl font-normal text-[#212121]">
              Unlock IN-EU market
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Reach your customers with the delivery network that connects you to more of Europe. Benefit from fast transit times, competitive rates, and seamless end-to-end multi-modal logistics.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ============================================================== -->
  <!-- "YOUR BUSINESS RESOURCE" 3-COLUMN SECTION (SCREENSHOT 2)       -->
  <!-- ============================================================== -->
  <section class="py-16 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Title -->
      <h2 class="text-3xl sm:text-4xl font-normal text-[#212121] text-center mb-14 tracking-tight">
        Your Business Resource
      </h2>

      <!-- 3-Column Resource Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        
        <!-- Card 1: New to FedEx? -->
        <div class="flex flex-col justify-between">
          <div class="space-y-4">
            <div class="overflow-hidden">
              <%= image_tag "fedex_resource_1.jpg", alt: "New to FedEx?", class: "w-full h-48 object-cover" %>
            </div>
            <h4 class="text-xl font-normal text-[#212121]">
              New to FedEx?
            </h4>
            <p class="text-sm text-slate-600 leading-relaxed">
              Our New Customer Center guides you through all the necessary steps when shipping with FedEx.
            </p>
          </div>
          <div class="pt-4">
            <%= link_to demo_path, class: "text-xs font-bold text-[#007AB7] hover:underline uppercase tracking-wider flex items-center" do %>
              <span>LET US HELP</span>
              <i class="fas fa-chevron-right ml-1 text-[10px]"></i>
            <% end %>
          </div>
        </div>

        <!-- Card 2: Simplify your Import Logistics -->
        <div class="flex flex-col justify-between">
          <div class="space-y-4">
            <div class="overflow-hidden">
              <%= image_tag "fedex_resource_2.jpg", alt: "Simplify your Import Logistics", class: "w-full h-48 object-cover" %>
            </div>
            <h4 class="text-xl font-normal text-[#212121]">
              Simplify your Import Logistics
            </h4>
            <p class="text-sm text-slate-600 leading-relaxed">
              Comprehensive shipping solutions that help you focus on growing your business while we manage your logistics and clearance.
            </p>
          </div>
          <div class="pt-4">
            <%= link_to routes_path, class: "text-xs font-bold text-[#007AB7] hover:underline uppercase tracking-wider flex items-center" do %>
              <span>FIND OUT MORE</span>
              <i class="fas fa-chevron-right ml-1 text-[10px]"></i>
            <% end %>
          </div>
        </div>

        <!-- Card 3: Customs Made Easier -->
        <div class="flex flex-col justify-between">
          <div class="space-y-4">
            <div class="overflow-hidden">
              <%= image_tag "fedex_resource_3.jpg", alt: "Customs Made Easier", class: "w-full h-48 object-cover" %>
            </div>
            <h4 class="text-xl font-normal text-[#212121]">
              Customs Made Easier
            </h4>
            <p class="text-sm text-slate-600 leading-relaxed">
              Learn about all the tools FedEx has to offer for shipping across borders. Prepare and find international documents, estimate duties and taxes, search country profiles, harmonized codes and much more.
            </p>
          </div>
          <div class="pt-4">
            <%= link_to analytics_path, class: "text-xs font-bold text-[#007AB7] hover:underline uppercase tracking-wider flex items-center" do %>
              <span>SEE SOLUTIONS</span>
              <i class="fas fa-chevron-right ml-1 text-[10px]"></i>
            <% end %>
          </div>
        </div>

      </div>

      <!-- Bottom 2-Column Wide Photo Cards (Screenshot 2 Bottom) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        
        <!-- Card 1: Green Forest Sustainability -->
        <div class="flex flex-col">
          <div class="overflow-hidden">
            <%= image_tag "fedex_bottom_1.jpg", alt: "Sustainable logistics for tomorrow", class: "w-full h-56 sm:h-64 object-cover" %>
          </div>
          <div class="pt-5 space-y-2">
            <h3 class="text-2xl font-normal text-[#212121]">
              Sustainable logistics for tomorrow
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Discover how our carbon-neutral routing and renewable fleet initiatives reduce operational footprints across high-density logistics corridors.
            </p>
            <%= link_to overview_path, class: "text-xs font-bold text-[#007AB7] hover:underline uppercase tracking-wider mt-2 inline-block" do %>
              LEARN ABOUT ESG
            <% end %>
          </div>
        </div>

        <!-- Card 2: Mobile Intelligence Smartphone -->
        <div class="flex flex-col">
          <div class="overflow-hidden">
            <%= image_tag "fedex_bottom_2.jpg", alt: "Keep shipments at your fingertips", class: "w-full h-56 sm:h-64 object-cover" %>
          </div>
          <div class="pt-5 space-y-2">
            <h3 class="text-2xl font-normal text-[#212121]">
              Keep shipments at your fingertips
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Download our mobile platform to track parcels in real time, receive predictive delay notifications, and redirect consignments on the go.
            </p>
            <%= link_to map_path, class: "text-xs font-bold text-[#007AB7] hover:underline uppercase tracking-wider mt-2 inline-block" do %>
              EXPLORE LIVE MAP
            <% end %>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ============================================================== -->
  <!-- COMPREHENSIVE GLOBAL FOOTER (#212121)                          -->
  <!-- ============================================================== -->
  <%= render "shared/resqway_footer" %>

</div>
