          </div>
          <div class="space-y-0.5 p-1 rounded-lg hover:bg-white/5 transition-colors">
            <span class="text-[10px] text-slate-300 block uppercase">Sessions</span>
            <span class="text-xs font-bold text-[#FF471D]">479K</span>
          </div>
          <div class="space-y-0.5 p-1 rounded-lg hover:bg-white/5 transition-colors">
