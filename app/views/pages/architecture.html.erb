<div class="max-w-5xl mx-auto space-y-10 pb-16">
  <!-- Header -->
  <div class="pb-4 border-b border-gray-200">
    <div class="flex items-center space-x-2">
      <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-indigo-100 text-indigo-800 border border-indigo-200">
        System Engineering Blueprint
      </span>
    </div>
    <h2 class="text-3xl font-black text-gray-900 tracking-tight mt-1">ENMA AI System Architecture</h2>
    <p class="text-xs text-gray-600 mt-0.5">End-to-end multi-tier architectural pipeline from environmental data ingestion to tactical response execution.</p>
  </div>

  <!-- Visual Architecture Blueprint -->
  <div class="space-y-6">
    
    <!-- Tier 1: Data Sources -->
    <div class="bg-white rounded-2xl p-6 border-2 border-slate-300 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b pb-2">
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center">
          <span class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs mr-2">1</span>
          Data &amp; Telemetry Ingestion Layer
        </h3>
        <span class="text-[10px] font-bold text-slate-500">Spatial &amp; Physical Feeds</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 text-xs">
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <strong class="text-slate-900 block font-bold"><i class="fas fa-cloud-rain text-blue-500 mr-1.5"></i> Weather Telemetry</strong>
          <span class="text-slate-600 mt-1 block">Live precipitation, rainfall rates &amp; storm warnings.</span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <strong class="text-slate-900 block font-bold"><i class="fas fa-road text-amber-500 mr-1.5"></i> Road &amp; Infrastructure</strong>
          <span class="text-slate-600 mt-1 block">Highway surface, bridges, culverts &amp; slope data.</span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <strong class="text-slate-900 block font-bold"><i class="fas fa-map-pin text-emerald-500 mr-1.5"></i> Settlement Demographics</strong>
          <span class="text-slate-600 mt-1 block">Population, hospital distance, warehouse proximity.</span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <strong class="text-slate-900 block font-bold"><i class="fas fa-radiation text-rose-500 mr-1.5"></i> Disaster Incidents</strong>
          <span class="text-slate-600 mt-1 block">Landslides, flash floods, snow &amp; road blockages.</span>
        </div>
      </div>
    </div>

    <!-- Arrow Down -->
    <div class="text-center text-indigo-600 text-2xl font-black">
      <i class="fas fa-arrow-down animate-bounce"></i>
    </div>

    <!-- Tier 2: AI Intelligence Engines -->
    <div class="bg-indigo-950 text-white rounded-2xl p-6 border-2 border-indigo-800 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-indigo-800 pb-2">
        <h3 class="text-sm font-black text-white uppercase tracking-wider flex items-center">
          <span class="w-6 h-6 rounded-full bg-indigo-500 text-white flex items-center justify-center text-xs mr-2">2</span>
          ENMA AI Intelligence &amp; Decision Engines
        </h3>
        <span class="text-[10px] font-bold text-indigo-300">Pure Ruby Multi-Criteria Algorithms</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 text-xs">
        <div class="p-3.5 rounded-xl bg-indigo-900/60 border border-indigo-700/60 space-y-1">
          <strong class="text-white block font-bold text-indigo-200">Accessibility Engine</strong>
          <span class="text-slate-300 block">AccessibilityScoreService (0-100 score, 6 factor deductions).</span>
        </div>

        <div class="p-3.5 rounded-xl bg-indigo-900/60 border border-indigo-700/60 space-y-1">
          <strong class="text-white block font-bold text-indigo-200">Route Planner Engine</strong>
          <span class="text-slate-300 block">RouteOptimizationService (Fastest, Safest, Efficient routing).</span>
        </div>

        <div class="p-3.5 rounded-xl bg-indigo-900/60 border border-indigo-700/60 space-y-1">
          <strong class="text-white block font-bold text-indigo-200">Disaster Response Engine</strong>
          <span class="text-slate-300 block">EmergencyResponseService (Priority score, radius buffering).</span>
        </div>

        <div class="p-3.5 rounded-xl bg-indigo-900/60 border border-indigo-700/60 space-y-1">
          <strong class="text-white block font-bold text-indigo-200">Logistics Readiness Engine</strong>
          <span class="text-slate-300 block">LogisticsReadinessService (Composite regional readiness index).</span>
        </div>
      </div>
    </div>

    <!-- Arrow Down -->
    <div class="text-center text-indigo-600 text-2xl font-black">
      <i class="fas fa-arrow-down animate-bounce"></i>
    </div>

    <!-- Tier 3: Tactical Action & Output Layer -->
    <div class="bg-white rounded-2xl p-6 border-2 border-emerald-500 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b pb-2">
        <h3 class="text-sm font-black text-gray-900 uppercase tracking-wider flex items-center">
          <span class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs mr-2">3</span>
          Decision &amp; Tactical Dispatch Layer
        </h3>
        <span class="text-[10px] font-bold text-emerald-600">Operational Directives</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-3.5 rounded-xl bg-emerald-50/60 border border-emerald-200 space-y-1">
          <strong class="text-emerald-950 block font-bold">Community Priority Triage</strong>
          <span class="text-gray-700 block">Ranks isolated settlements by urgency to prioritize relief drops.</span>
        </div>

        <div class="p-3.5 rounded-xl bg-emerald-50/60 border border-emerald-200 space-y-1">
          <strong class="text-emerald-950 block font-bold">Warehouse Stockpile Allocation</strong>
          <span class="text-gray-700 block">Recommends optimal staging base with explainable justification.</span>
        </div>

        <div class="p-3.5 rounded-xl bg-emerald-50/60 border border-emerald-200 space-y-1">
          <strong class="text-emerald-950 block font-bold">Safest Response Corridors</strong>
          <span class="text-gray-700 block">Generates detour corridors bypassing active landslides and washed-out roads.</span>
        </div>
      </div>
    </div>
  </div>
</div>
