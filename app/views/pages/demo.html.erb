<div class="max-w-5xl mx-auto space-y-8 pb-16">
  <!-- Demo Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-gray-200 gap-4">
    <div>
      <div class="flex items-center space-x-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
          ⚡ SIH 2026 Interactive Showcase
        </span>
        <span class="text-xs font-bold text-gray-500">Live Decision Simulation</span>
      </div>
      <h2 class="text-3xl font-black text-gray-900 tracking-tight mt-1">ENMA AI Guided Demo Scenario</h2>
      <p class="text-xs text-gray-600 mt-0.5">Scenario: Heavy Monsoon Rainfall triggers acute Landslide &amp; Road Blockage near Tawang (Arunachal Pradesh).</p>
    </div>

    <!-- Restart / Navigation shortcuts -->
    <div class="flex items-center space-x-3">
      <%= link_to demo_path(step: 1), class: "px-3.5 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl transition-colors" do %>
        <i class="fas fa-rotate-left mr-1.5"></i>
        <span>Restart Demo</span>
      <% end %>

      <%= link_to root_path, class: "px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-sm transition-all" do %>
        <i class="fas fa-desktop mr-1.5"></i>
        <span>Dashboard</span>
      <% end %>
    </div>
  </div>

  <!-- Step Progress Indicator (7 Steps) -->
  <div class="bg-white rounded-2xl p-5 border border-gray-200 shadow-sm space-y-3">
    <div class="flex items-center justify-between text-xs font-bold">
      <span class="text-indigo-600 uppercase tracking-wider">Step <%= @step %> of 7</span>
      <span class="text-gray-500"><%= ((@step / 7.0) * 100).round %>% Completed</span>
    </div>

    <div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
      <div class="bg-indigo-600 h-2 rounded-full transition-all duration-300" style="width: <%= ((@step / 7.0) * 100).round %>%"></div>
    </div>

    <!-- 7 Step Breadcrumb Pills -->
    <div class="grid grid-cols-7 gap-1 text-[10px] font-bold text-center pt-2">
      <% [
        "1. Risk Detected",
        "2. Predictive AI",
        "3. Critical Zones",
        "4. Impact Analysis",
        "5. Warehouse",
        "6. Safe Route",
        "7. Response Ready"
      ].each_with_index do |label, idx| %>
        <% step_num = idx + 1 %>
        <div class="p-1.5 rounded-lg <%= @step == step_num ? 'bg-indigo-600 text-white shadow-sm' : (@step > step_num ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-gray-50 text-gray-400') %> truncate">
          <%= label %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Active Scenario Card -->
  <div class="bg-white rounded-3xl p-8 md:p-10 border border-gray-200 shadow-xl space-y-6">
    <% case @step %>
    <% when 1 %>
      <!-- STEP 1: Environmental Risk Detected -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center text-2xl font-bold shadow-inner">
            <i class="fas fa-cloud-showers-heavy"></i>
          </div>
          <div>
            <span class="text-xs font-black uppercase text-red-600 tracking-wider">STEP 1: SENSOR INGESTION</span>
            <h3 class="text-2xl font-black text-gray-900">Environmental Risk Detected</h3>
          </div>
        </div>

        <p class="text-sm text-gray-600 leading-relaxed">
          Automated weather telemetry detected a torrential cloudburst (280 mm in 24 hours) along the Sela Pass / Tawang mountain corridor in Arunachal Pradesh.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-red-50/70 border border-red-200">
            <span class="text-[10px] font-bold uppercase text-red-700 block">Precipitation Level</span>
            <span class="text-xl font-black text-red-900 mt-1 block">Heavy Rainfall (Severe)</span>
            <span class="text-[11px] text-red-600 mt-0.5 block">280 mm / 24 hrs</span>
          </div>

          <div class="p-4 rounded-xl bg-orange-50/70 border border-orange-200">
            <span class="text-[10px] font-bold uppercase text-orange-700 block">Slope Soil Saturation</span>
            <span class="text-xl font-black text-orange-900 mt-1 block">High Landslide Probability</span>
            <span class="text-[11px] text-orange-600 mt-0.5 block">Geotechnical Index: 92%</span>
          </div>

          <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
            <span class="text-[10px] font-bold uppercase text-gray-500 block">Geographic Epicenter</span>
            <span class="text-xl font-black text-gray-900 mt-1 block">Tawang Sector</span>
            <span class="text-[11px] text-gray-600 mt-0.5 block">27.5855°N, 91.8679°E</span>
          </div>
        </div>
      </div>

    <% when 2 %>
      <!-- STEP 2: Predictive Intelligence Activated -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-2xl font-bold shadow-inner">
            <i class="fas fa-brain"></i>
          </div>
          <div>
            <span class="text-xs font-black uppercase text-indigo-600 tracking-wider">STEP 2: AUTONOMOUS PREDICTION</span>
            <h3 class="text-2xl font-black text-gray-900">Predictive Intelligence Activated</h3>
          </div>
        </div>

        <p class="text-sm text-gray-600 leading-relaxed">
          ENMA AI's Risk Prediction Engine evaluates terrain slope, road foundation vulnerabilities, and historical cutoffs to anticipate impending infrastructure collapse.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-red-50/70 border border-red-200">
            <span class="text-[10px] font-bold uppercase text-red-700 block">Predicted Risk Score</span>
            <span class="text-3xl font-black text-red-600 mt-1 block">88 <span class="text-xs text-gray-500">/ 100</span></span>
            <span class="text-[10px] font-black uppercase text-red-800 bg-red-100 px-2 py-0.5 rounded inline-block mt-1">CRITICAL RISK</span>
          </div>

          <div class="p-4 rounded-xl bg-indigo-50/70 border border-indigo-200">
            <span class="text-[10px] font-bold uppercase text-indigo-700 block">Decision Confidence</span>
            <span class="text-3xl font-black text-indigo-600 mt-1 block">94%</span>
            <span class="text-[10px] font-semibold text-indigo-700 mt-1 block">Multi-criteria verified</span>
          </div>

          <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
            <span class="text-[10px] font-bold uppercase text-gray-500 block">Primary Threat Classification</span>
            <span class="text-lg font-black text-gray-900 mt-1 block">Landslide &amp; Mudflow</span>
            <span class="text-[11px] text-gray-600 mt-0.5 block">Immediate arterial severance</span>
          </div>
        </div>
      </div>

    <% when 3 %>
      <!-- STEP 3: Critical Communities Identified -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-2xl bg-orange-100 text-orange-600 flex items-center justify-center text-2xl font-bold shadow-inner">
            <i class="fas fa-map-pin"></i>
          </div>
          <div>
            <span class="text-xs font-black uppercase text-orange-600 tracking-wider">STEP 3: SPATIAL BUFFERING</span>
            <h3 class="text-2xl font-black text-gray-900">Critical Communities Identified</h3>
          </div>
        </div>

        <p class="text-sm text-gray-600 leading-relaxed">
          Spatial buffer analysis detected 8 settlements within the 50 km impact zone. Settlements are ranked by Emergency Priority Score combining baseline accessibility and population.
        </p>

        <div class="overflow-x-auto rounded-xl border border-gray-200">
          <table class="min-w-full divide-y divide-gray-200 text-xs text-left">
            <thead class="bg-gray-50 font-bold text-gray-700 uppercase">
              <tr>
                <th class="px-4 py-2.5">Rank</th>
                <th class="px-4 py-2.5">Community</th>
                <th class="px-4 py-2.5">State</th>
                <th class="px-4 py-2.5">Population</th>
                <th class="px-4 py-2.5">Accessibility</th>
                <th class="px-4 py-2.5">Emergency Priority</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 font-medium">
              <tr class="bg-red-50/50">
                <td class="px-4 py-2 font-black text-red-900">#1</td>
                <td class="px-4 py-2 font-bold text-gray-900">Tawang</td>
                <td class="px-4 py-2 text-gray-600">Arunachal Pradesh</td>
                <td class="px-4 py-2">15,000</td>
                <td class="px-4 py-2 font-black text-red-600">0.0 / 100</td>
                <td class="px-4 py-2 font-black text-red-700">92.4 / 100 (CRITICAL)</td>
              </tr>
              <tr>
                <td class="px-4 py-2 font-bold text-gray-700">#2</td>
                <td class="px-4 py-2 font-bold text-gray-900">Bomdila</td>
                <td class="px-4 py-2 text-gray-600">Arunachal Pradesh</td>
                <td class="px-4 py-2">12,000</td>
                <td class="px-4 py-2 font-bold text-orange-600">40.0 / 100</td>
                <td class="px-4 py-2 font-bold text-orange-700">74.2 / 100 (HIGH)</td>
              </tr>
              <tr>
                <td class="px-4 py-2 font-bold text-gray-700">#3</td>
                <td class="px-4 py-2 font-bold text-gray-900">Dirang Valley</td>
                <td class="px-4 py-2 text-gray-600">Arunachal Pradesh</td>
                <td class="px-4 py-2">8,500</td>
                <td class="px-4 py-2 font-bold text-yellow-600">55.0 / 100</td>
                <td class="px-4 py-2 font-bold text-yellow-700">58.0 / 100 (MODERATE)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    <% when 4 %>
      <!-- STEP 4: Emergency Response Analysis -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center text-2xl font-bold shadow-inner">
            <i class="fas fa-radiation"></i>
          </div>
          <div>
            <span class="text-xs font-black uppercase text-red-600 tracking-wider">STEP 4: IMPACT TRIAGE</span>
            <h3 class="text-2xl font-black text-gray-900">Emergency Response Analysis</h3>
          </div>
        </div>

        <p class="text-sm text-gray-600 leading-relaxed">
          Aggregated assessment of total civilian exposure and logistics deficit across the affected disaster sector.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
            <span class="text-[10px] font-bold uppercase text-gray-500 block">Total Population at Risk</span>
            <span class="text-3xl font-black text-gray-900 mt-1 block">125,000</span>
            <span class="text-[11px] text-gray-600 mt-0.5 block">Across 8 isolated villages</span>
          </div>

          <div class="p-4 rounded-xl bg-red-50/70 border border-red-200">
            <span class="text-[10px] font-bold uppercase text-red-700 block">Critical Zones</span>
            <span class="text-3xl font-black text-red-600 mt-1 block">3 Zones</span>
            <span class="text-[11px] text-red-700 mt-0.5 block">Immediate air-drop / rescue needed</span>
          </div>

          <div class="p-4 rounded-xl bg-orange-50/70 border border-orange-200">
            <span class="text-[10px] font-bold uppercase text-orange-700 block">Accessibility Impact</span>
            <span class="text-3xl font-black text-orange-600 mt-1 block">CRITICAL</span>
            <span class="text-[11px] text-orange-700 mt-0.5 block">Major supply corridor severed</span>
          </div>
        </div>
      </div>

    <% when 5 %>
      <!-- STEP 5: Optimal Warehouse Selected -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl font-bold shadow-inner">
            <i class="fas fa-warehouse"></i>
          </div>
          <div>
            <span class="text-xs font-black uppercase text-emerald-600 tracking-wider">STEP 5: STOCKPILE ALLOCATION</span>
            <h3 class="text-2xl font-black text-gray-900">Optimal Warehouse Selected</h3>
          </div>
        </div>

        <p class="text-sm text-gray-600 leading-relaxed">
          ENMA AI evaluated all regional staging depots using multi-criteria optimization (Distance 35%, Stock Capacity 35%, Highway Reliability 30%).
        </p>

        <div class="p-6 rounded-2xl bg-emerald-50/70 border-2 border-emerald-500 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <h4 class="text-xl font-black text-gray-900">North East Regional Logistics Hub (Guwahati)</h4>
            <span class="px-3 py-1 rounded-full text-xs font-black uppercase bg-emerald-600 text-white">Score: 88.5 / 100</span>
          </div>

          <p class="text-xs text-emerald-950 leading-relaxed">
            <strong>Selection Justification:</strong> Selected because it possesses high disaster relief stock capacity (50,000 units) and strategic multi-lane highway connectivity, ensuring sustained multi-day supply convoys despite being 142 km away.
          </p>

          <div class="grid grid-cols-2 gap-4 pt-2 text-xs">
            <div><strong>Stockpile:</strong> 50,000 emergency ration packs &amp; trauma medical kits</div>
            <div><strong>Readiness:</strong> Operational 24/7 Rapid Response Staging Node</div>
          </div>
        </div>
      </div>

    <% when 6 %>
      <!-- STEP 6: Smart Emergency Route Generated -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-2xl font-bold shadow-inner">
            <i class="fas fa-route"></i>
          </div>
          <div>
            <span class="text-xs font-black uppercase text-indigo-600 tracking-wider">STEP 6: SMART CORRIDOR OPTIMIZATION</span>
            <h3 class="text-2xl font-black text-gray-900">Smart Emergency Route Generated</h3>
          </div>
        </div>

        <p class="text-sm text-gray-600 leading-relaxed">
          Calculated the Safest Emergency Route connecting Guwahati Regional Depot directly to Tawang, bypassing active mudslide choke points along NH-13.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
            <span class="text-[10px] font-bold uppercase text-gray-500 block">Dispatch Corridor</span>
            <span class="text-xl font-black text-gray-900 mt-1 block">Safest Route</span>
            <span class="text-[11px] text-gray-600 mt-0.5 block">142.5 km total distance</span>
          </div>

          <div class="p-4 rounded-xl bg-emerald-50/70 border border-emerald-200">
            <span class="text-[10px] font-bold uppercase text-emerald-700 block">Est. Response Time</span>
            <span class="text-xl font-black text-emerald-700 mt-1 block">3.4 Hours</span>
            <span class="text-[11px] text-emerald-600 mt-0.5 block">Emergency vehicle priority</span>
          </div>

          <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
            <span class="text-[10px] font-bold uppercase text-gray-500 block">Corridor Risk Score</span>
            <span class="text-xl font-black text-gray-900 mt-1 block">22.0 / 100</span>
            <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded inline-block mt-1">LOW HAZARD</span>
          </div>
        </div>
      </div>

    <% when 7 %>
      <!-- STEP 7: Response Plan Ready -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center text-2xl font-bold shadow-inner">
            <i class="fas fa-check-double"></i>
          </div>
          <div>
            <span class="text-xs font-black uppercase text-green-700 tracking-wider">STEP 7: MISSION DISPATCH</span>
            <h3 class="text-2xl font-black text-gray-900">Emergency Response Plan Ready &amp; Dispatched</h3>
          </div>
        </div>

        <p class="text-sm text-gray-600 leading-relaxed">
          Comprehensive multi-agency tactical directives and convoy clearances dispatched to NDRF, SDRF, and district disaster authorities.
        </p>

        <div class="space-y-3 pt-2">
          <div class="p-4 rounded-xl bg-red-50 border border-red-200 flex items-start space-x-3">
            <span class="w-6 h-6 rounded-full bg-red-600 text-white font-black text-xs flex items-center justify-center flex-shrink-0 mt-0.5">1</span>
            <div>
              <h5 class="text-xs font-bold text-red-900">Mobilize NDRF 12th Battalion Heavy Clearing Unit</h5>
              <p class="text-[11px] text-red-800 mt-0.5">Deploy tracked excavators to clear secondary debris at Sela Pass detour junction.</p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-blue-50 border border-blue-200 flex items-start space-x-3">
            <span class="w-6 h-6 rounded-full bg-blue-600 text-white font-black text-xs flex items-center justify-center flex-shrink-0 mt-0.5">2</span>
            <div>
              <h5 class="text-xs font-bold text-blue-900">Dispatch 4-Vehicle Medical &amp; Water Convoy</h5>
              <p class="text-[11px] text-blue-800 mt-0.5">Guwahati staging hub convoy en route to Tawang with 5,000 units of life-support supplies.</p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 flex items-start space-x-3">
            <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-black text-xs flex items-center justify-center flex-shrink-0 mt-0.5">3</span>
            <div>
              <h5 class="text-xs font-bold text-emerald-900">Designate Emergency Helipad Staging at Tawang Monastery Clearing</h5>
              <p class="text-[11px] text-emerald-800 mt-0.5">Rotary-wing resupply corridor cleared for heavy-lift helicopter operations.</p>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Interactive Navigation Controls -->
    <div class="pt-6 border-t border-gray-100 flex items-center justify-between">
      <div>
        <% if @step > 1 %>
          <%= link_to demo_path(step: @step - 1), class: "inline-flex items-center px-4 py-2.5 rounded-xl border border-gray-300 text-xs font-bold text-gray-700 hover:bg-gray-50 transition-colors" do %>
            <i class="fas fa-chevron-left mr-2"></i>
            <span>Previous Step</span>
          <% end %>
        <% else %>
          <span class="text-xs font-semibold text-gray-400">First Step</span>
        <% end %>
      </div>

      <div class="flex items-center space-x-3">
        <% if @step < 7 %>
          <%= link_to demo_path(step: @step + 1), class: "inline-flex items-center px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs rounded-xl shadow-md transition-all" do %>
            <span>Next Step</span>
            <i class="fas fa-chevron-right ml-2"></i>
          <% end %>
        <% else %>
          <%= link_to emergencies_path, class: "inline-flex items-center px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-xl shadow-md transition-all" do %>
            <i class="fas fa-check-circle mr-2"></i>
            <span>Explore Disaster Center</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
