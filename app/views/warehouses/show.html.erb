<div class="space-y-6 max-w-7xl mx-auto pb-12">
  <!-- Breadcrumb -->
  <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400 pb-3 border-b border-slate-200 dark:border-slate-800">
    <%= link_to warehouses_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline font-bold flex items-center" do %>
      <i class="fas fa-arrow-left mr-1.5 text-xs"></i>
      <span>Warehouse Intelligence</span>
    <% end %>
    <span>/</span>
    <span class="text-slate-900 dark:text-white font-black"><%= @warehouse.name.truncate(40) %></span>
  </div>

  <!-- Warehouse Header -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 dark:border-slate-800 space-y-4">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="space-y-3 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider border <%= @warehouse.status_badge_class %>">
            <%= @warehouse.dynamic_status %>
          </span>
          <% if @warehouse.district.present? %>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
              <i class="fas fa-map-pin mr-1"></i> <%= @warehouse.district %>, <%= @warehouse.state %>
            </span>
          <% end %>
        </div>

        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white"><%= @warehouse.name %></h1>

        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400 font-mono">
          <span class="flex items-center"><i class="fas fa-crosshairs mr-1.5 text-indigo-500"></i> <%= @warehouse.latitude&.round(4) %>°N, <%= @warehouse.longitude&.round(4) %>°E</span>
          <% if @warehouse.address.present? %>
            <span>&bull;</span>
            <span><%= @warehouse.address %></span>
          <% end %>
          <% if @warehouse.contact_phone.present? %>
            <span>&bull;</span>
            <span><i class="fas fa-phone mr-1"></i> <%= @warehouse.contact_phone %></span>
          <% end %>
        </div>
      </div>

      <!-- Readiness Gauge -->
      <div class="flex-shrink-0 bg-slate-50 dark:bg-slate-800/60 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 text-center min-w-[200px]">
        <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 dark:text-slate-400 block">Readiness Score</span>
        <div class="text-3xl sm:text-4xl font-black mt-1 <%= @warehouse.readiness_color_class %>">
          <%= @warehouse.readiness_score&.round(1) || '—' %><span class="text-lg font-bold text-slate-400">/100</span>
        </div>
        <span class="text-xs font-bold block mt-1 <%= @warehouse.readiness_color_class %>"><%= @warehouse.dynamic_status %></span>
      </div>
    </div>
  </div>

  <!-- Key Metrics Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5">
      <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Capacity</p>
      <div class="mt-2"><span class="text-3xl font-black text-slate-900 dark:text-white"><%= number_with_delimiter(@warehouse.capacity) %></span></div>
      <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Maximum stockpile units.</p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5">
      <p class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Available</p>
      <div class="mt-2"><span class="text-3xl font-black text-emerald-600 dark:text-emerald-400"><%= number_with_delimiter(@warehouse.available_capacity) %></span></div>
      <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Spare capacity for deployment.</p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5">
      <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Utilization</p>
      <div class="mt-2 flex items-baseline space-x-2">
        <span class="text-3xl font-black text-slate-900 dark:text-white"><%= @warehouse.utilization_percentage %>%</span>
      </div>
      <div class="mt-2 w-full h-2.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
        <div class="h-full rounded-full <%= @warehouse.utilization_percentage > 85 ? 'bg-red-500' : (@warehouse.utilization_percentage > 60 ? 'bg-amber-500' : 'bg-emerald-500') %>" style="width: <%= [@warehouse.utilization_percentage, 100].min %>%"></div>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5">
      <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Resources</p>
      <div class="mt-2"><span class="text-3xl font-black text-slate-900 dark:text-white"><%= number_with_delimiter(@warehouse.total_available_resources) %></span></div>
      <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Combined relief inventory.</p>
    </div>
  </div>

  <!-- Resource Inventory Grid -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/60">
      <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
        <i class="fas fa-boxes-stacked text-indigo-600 mr-2"></i>
        Resource Inventory
      </h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-5">
      <% Warehouse::RESOURCE_CATEGORIES.each do |key, meta| %>
        <% count = @warehouse.resource_count(key) %>
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 flex items-center space-x-4">
          <div class="w-11 h-11 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center flex-shrink-0">
            <i class="fas <%= meta[:icon] %> text-lg"></i>
          </div>
          <div class="flex-1">
            <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider"><%= meta[:label] %></p>
            <p class="text-xl font-black text-slate-900 dark:text-white mt-0.5"><%= number_with_delimiter(count) %> <span class="text-xs font-medium text-slate-400"><%= meta[:unit] %></span></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Active Emergencies in Region -->
  <% if @recent_emergencies.any? %>
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
      <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/60">
        <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-exclamation-triangle text-red-600 mr-2"></i>
          Active Regional Emergencies
        </h3>
      </div>
      <div class="divide-y divide-slate-100 dark:divide-slate-800">
        <% @recent_emergencies.each do |em| %>
          <div class="px-5 py-3.5 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
            <div>
              <span class="text-xs font-bold text-slate-900 dark:text-white"><%= em.title.truncate(50) %></span>
              <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5"><%= em.emergency_type %> &bull; <%= em.severity %></div>
            </div>
            <%= link_to emergency_path(em), class: "text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline" do %>
              View &rarr;
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
