<div class="space-y-6 max-w-2xl mx-auto pb-12">
  <!-- Breadcrumb -->
  <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400 pb-3 border-b border-slate-200 dark:border-slate-800">
    <%= link_to vehicles_path, class: "text-accent dark:text-accent hover:underline font-bold flex items-center" do %>
      <i class="fas fa-arrow-left mr-1.5 text-xs"></i>
      <span>Fleet Registry</span>
    <% end %>
    <span>/</span>
    <span class="text-slate-900 dark:text-white font-black">Register Vehicle</span>
  </div>

  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 dark:border-slate-800 space-y-6">
    <div>
      <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">Register Fleet Vehicle</h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Add a new transport unit to ResQWay's logistics telemetry network.</p>
    </div>

    <%= form_with model: @vehicle, url: vehicles_path, local: true, class: "space-y-4" do |f| %>
      <% if @vehicle.errors.any? %>
        <div class="p-4 rounded-xl bg-red-50 dark:bg-red-950/80 border border-red-200 dark:border-red-800 text-xs text-red-700 dark:text-red-300">
          <p class="font-bold">Please fix the following errors:</p>
          <ul class="list-disc pl-5 mt-1 space-y-0.5">
            <% @vehicle.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :registration_number, "Registration Number", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.text_field :registration_number, placeholder: "e.g. AS-01-EE-4589", class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500", required: true %>
        </div>

        <div>
          <%= f.label :vehicle_type, "Vehicle Type", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.select :vehicle_type, options_for_select(Vehicle::VEHICLE_TYPES, @vehicle.vehicle_type), {}, class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :driver_name, "Driver Name", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.text_field :driver_name, placeholder: "e.g. Rahul Boro", class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :driver_phone, "Driver Phone Number", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.text_field :driver_phone, placeholder: "+91 98765 43210", class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500" %>
        </div>
      </div>

      <div>
        <%= f.label :capacity, "Payload Capacity (kg)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
        <%= f.number_field :capacity, step: 100, value: @vehicle.capacity || 5000, class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div class="pt-4 flex items-center justify-end space-x-3 border-t border-slate-100 dark:border-slate-800">
        <%= link_to "Cancel", vehicles_path, class: "px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-400 hover:underline" %>
        <%= f.submit "Register Vehicle", class: "px-5 py-2.5 bg-accent hover:opacity-90 text-white font-black text-xs rounded-xl shadow-md cursor-pointer transition-all" %>
      </div>
    <% end %>
  </div>
</div>
