<div class="space-y-6 max-w-2xl mx-auto pb-12">
  <!-- Breadcrumb -->
  <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400 pb-3 border-b border-slate-200 dark:border-slate-800">
    <%= link_to vehicles_path, class: "text-accent dark:text-accent hover:underline font-bold flex items-center" do %>
      <i class="fas fa-arrow-left mr-1.5 text-xs"></i>
      <span>Fleet Registry</span>
    <% end %>
    <span>/</span>
    <%= link_to @vehicle.registration_number, vehicle_path(@vehicle), class: "text-slate-600 dark:text-slate-400 hover:underline font-mono" %>
    <span>/</span>
    <span class="text-slate-900 dark:text-white font-black">Edit Vehicle</span>
  </div>

  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 dark:border-slate-800 space-y-6">
    <div>
      <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">Edit Fleet Vehicle</h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Update specifications and driver assignment for unit <span class="font-mono font-bold text-slate-700 dark:text-slate-300"><%= @vehicle.registration_number %></span>.</p>
    </div>

    <%= form_with model: @vehicle, url: vehicle_path(@vehicle), method: :patch, local: true, class: "space-y-4" do |f| %>
      <% if @vehicle.errors.any? %>
        <div class="p-4 rounded-xl bg-red-50 dark:bg-red-950/80 border border-red-200 dark:border-red-800 text-xs text-red-700 dark:text-red-300">
          <p class="font-bold">Please fix the following errors:</p>
          <ul class="list-disc pl-5 mt-1 space-y-0.5">
            <% @vehicle.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :registration_number, "Registration Number", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.text_field :registration_number, class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500", required: true %>
        </div>

        <div>
          <%= f.label :vehicle_type, "Vehicle Type", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.select :vehicle_type, options_for_select(Vehicle::VEHICLE_TYPES, @vehicle.vehicle_type), {}, class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :status, "Fleet Status", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.select :status, options_for_select(Vehicle::STATUSES.map { |s| [s.humanize, s] }, @vehicle.status), {}, class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :capacity, "Payload Capacity (kg)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.number_field :capacity, step: 100, class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :driver_name, "Driver Name", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.text_field :driver_name, placeholder: "e.g. Rahul Boro", class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :driver_phone, "Driver Phone Number", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.text_field :driver_phone, placeholder: "+91 98765 43210", class: "w-full px-3 py-2 text-xs font-bold text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500" %>
        </div>
      </div>

      <div class="pt-4 flex items-center justify-between border-t border-slate-100 dark:border-slate-800">
        <div>
          <%= link_to vehicle_path(@vehicle), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete #{@vehicle.registration_number}? This will permanently remove its telemetry history." }, class: "text-xs font-bold text-red-600 hover:text-red-700 dark:text-red-400 flex items-center" do %>
            <i class="fas fa-trash-alt mr-1.5"></i>
            <span>Delete Vehicle</span>
          <% end %>
        </div>
        <div class="flex items-center space-x-3">
          <%= link_to "Cancel", vehicle_path(@vehicle), class: "px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-400 hover:underline" %>
          <%= f.submit "Update Vehicle", class: "px-5 py-2.5 bg-accent hover:opacity-90 text-white font-black text-xs rounded-xl shadow-md cursor-pointer transition-all" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
