<div class="max-w-4xl mx-auto space-y-6 pb-16">
  
  <!-- Search Header & Interactive Form -->
  <div class="pb-5 border-b border-[var(--line)] space-y-4">
    <div>
      <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">Global Search</h2>
      <p class="text-xs text-mute mt-0.5">Query settlements, highway corridors, relief depots, and real-time emergency incidents across North East India.</p>
    </div>

    <!-- Live Auto-Suggest Search Form -->
    <div data-controller="search-autocomplete"
         data-action="click@window->search-autocomplete#onClickOutside"
         class="relative max-w-2xl">
      <%= form_with url: search_path, method: :get, local: true, class: "flex items-center gap-2" do |f| %>
        <div class="relative flex-1">
          <i class="fas fa-search absolute left-4 top-3.5 text-mute text-sm pointer-events-none"></i>
          <%= f.text_field :q,
                           value: @query,
                           autocomplete: "off",
                           placeholder: "Type to search nodes, corridors, depots, or emergencies...",
                           data: {
                             "search-autocomplete-target": "input",
                             action: "focus->search-autocomplete#onFocus input->search-autocomplete#onInput keydown->search-autocomplete#onKeydown"
                           },
                           class: "w-full pl-11 pr-4 py-3 bg-surface text-ink border border-[var(--line)] rounded-xl focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm shadow-sm placeholder:text-mute transition-all" %>
        </div>
        <%= f.submit "Search", class: "px-6 py-3 bg-ink hover:bg-ink/90 text-paper font-black text-xs rounded-xl shadow-sm transition-all cursor-pointer flex-shrink-0" %>
      <% end %>

      <!-- Live Suggestions Floating Dropdown -->
      <div data-search-autocomplete-target="dropdown"
           class="hidden absolute left-0 right-0 top-full mt-2 bg-surface sketch-border rounded-2xl shadow-2xl z-50 overflow-hidden">
        <div class="p-2">
          <div class="px-3 py-1.5 text-[10px] font-black uppercase text-mute tracking-wider flex items-center justify-between border-b border-[var(--line)]/50 pb-1.5 mb-1">
            <span class="flex items-center gap-1.5">
              <i class="fas fa-bolt text-accent text-[10px]"></i>
              <span>Live Search Suggestions</span>
            </span>
            <span class="text-[9px] font-mono text-mute">instant</span>
          </div>
          <ul data-search-autocomplete-target="resultsList" class="space-y-0.5 max-h-[340px] overflow-y-auto">
            <!-- Populated via Stimulus -->
          </ul>
        </div>
      </div>
    </div>

    <!-- Quick Suggestion Chips -->
    <div class="space-y-2 pt-1">
      <span class="text-[10px] font-black uppercase text-mute tracking-wider block">Popular Search Suggestions:</span>
      <div class="flex flex-wrap gap-2">
        <% [
          { label: "Tawang Outpost", q: "Tawang", icon: "fa-map-pin" },
          { label: "Guwahati Hub", q: "Guwahati", icon: "fa-map-pin" },
          { label: "NH-13 Corridor", q: "NH-13", icon: "fa-road" },
          { label: "NH-15 Highway", q: "NH-15", icon: "fa-road" },
          { label: "Relief Warehouses", q: "Depot", icon: "fa-warehouse" },
          { label: "Landslide Detours", q: "Landslide", icon: "fa-triangle-exclamation" },
          { label: "Flood Disruption", q: "Flood", icon: "fa-droplet" },
          { label: "Haflong Hill Section", q: "Haflong", icon: "fa-mountain" }
        ].each do |chip| %>
          <%= link_to search_path(q: chip[:q]), class: "inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-full text-xs font-semibold sketch-border-soft bg-surface/80 hover:bg-surface text-ink hover:border-accent transition-all group shadow-sm" do %>
            <i class="fas <%= chip[:icon] %> text-[10px] text-accent group-hover:scale-110 transition-transform"></i>
            <span><%= chip[:label] %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Search Results Output -->
  <% if @query.present? %>
    <div class="flex items-center justify-between text-xs text-mute font-medium">
      <div>
        Found <strong class="text-ink font-black"><%= @total_results %></strong> matching records for "<span class="text-accent font-bold"><%= @query %></span>"
      </div>
      <%= link_to "Clear Search", search_path, class: "text-xs font-bold text-mute hover:text-accent underline" %>
    </div>

    <% if @total_results == 0 %>
      <div class="p-12 text-center bg-surface sketch-border rounded-2xl space-y-3">
        <div class="w-12 h-12 rounded-full bg-paper sketch-border-soft text-mute flex items-center justify-center text-xl mx-auto">
          <i class="fas fa-search"></i>
        </div>
        <h4 class="text-base font-bold text-ink">No matching records found</h4>
        <p class="text-xs text-mute max-w-md mx-auto">Try searching for settlements like "Tawang", highway corridors like "NH-13", or incident categories like "Landslide".</p>
      </div>
    <% else %>

      <!-- 1. Location Matches -->
      <% if @locations.any? %>
        <div class="bg-surface sketch-border rounded-2xl p-5 sm:p-6 space-y-4">
          <h3 class="text-xs font-black text-ink uppercase tracking-wider flex items-center">
            <i class="fas fa-map-marker-alt text-blue-500 mr-2"></i>
            Settlements &amp; Communities (<%= @locations.size %>)
          </h3>

          <div class="divide-y divide-[var(--line)]">
            <% @locations.each do |loc| %>
              <div class="py-3 flex items-center justify-between hover:bg-ink/5 px-2 rounded-xl transition-colors">
                <div>
                  <h4 class="text-sm font-bold text-ink"><%= loc.name %></h4>
                  <span class="text-xs text-mute"><%= loc.district %>, <%= loc.state %> &bull; Population: <%= number_with_delimiter(loc.population) %></span>
                </div>
                <div class="flex items-center space-x-3">
                  <span class="text-xs font-black font-mono <%= loc.accessibility_score.to_f < 40 ? 'text-red-500' : 'text-emerald-600' %>">
                    <%= loc.accessibility_score&.round(0) %>/100
                  </span>
                  <%= link_to "Accessibility Report &rarr;".html_safe, accessibility_location_path(loc), class: "text-xs font-bold text-accent hover:underline sketch-border-soft bg-paper px-2.5 py-1 rounded-lg" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- 2. Road Corridors Matches -->
      <% if @roads&.any? %>
        <div class="bg-surface sketch-border rounded-2xl p-5 sm:p-6 space-y-4">
          <h3 class="text-xs font-black text-ink uppercase tracking-wider flex items-center">
            <i class="fas fa-road text-accent mr-2"></i>
            Highway Corridors &amp; Passes (<%= @roads.size %>)
          </h3>

          <div class="divide-y divide-[var(--line)]">
            <% @roads.each do |road| %>
              <div class="py-3 flex items-center justify-between hover:bg-ink/5 px-2 rounded-xl transition-colors">
                <div>
                  <h4 class="text-sm font-bold text-ink font-mono"><%= road.road_number %> - <%= road.name %></h4>
                  <span class="text-xs text-mute"><%= road.district %>, <%= road.state %> &bull; Status: <strong class="uppercase font-mono text-[11px]"><%= road.status %></strong></span>
                </div>
                <div class="flex items-center space-x-3">
                  <span class="text-xs font-black font-mono <%= road.risk_score.to_f >= 75 ? 'text-red-500' : (road.risk_score.to_f >= 50 ? 'text-amber-500' : 'text-emerald-500') %>">
                    Risk <%= road.risk_score&.round(0) %>/100
                  </span>
                  <%= link_to "Optimize Route &rarr;".html_safe, routes_path, class: "text-xs font-bold text-accent hover:underline sketch-border-soft bg-paper px-2.5 py-1 rounded-lg" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- 3. Warehouse Matches -->
      <% if @warehouses.any? %>
        <div class="bg-surface sketch-border rounded-2xl p-5 sm:p-6 space-y-4">
          <h3 class="text-xs font-black text-ink uppercase tracking-wider flex items-center">
            <i class="fas fa-warehouse text-emerald-600 mr-2"></i>
            Relief Warehouses &amp; Staging Hubs (<%= @warehouses.size %>)
          </h3>

          <div class="divide-y divide-[var(--line)]">
            <% @warehouses.each do |wh| %>
              <div class="py-3 flex items-center justify-between hover:bg-ink/5 px-2 rounded-xl transition-colors">
                <div>
                  <h4 class="text-sm font-bold text-ink"><%= wh.name %></h4>
                  <span class="text-xs text-mute font-mono"><%= wh.latitude&.round(3) %>°N, <%= wh.longitude&.round(3) %>°E &bull; <%= wh.district %>, <%= wh.state %></span>
                </div>
                <div class="flex items-center space-x-3">
                  <span class="text-xs font-bold text-emerald-600 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20">
                    <%= number_with_delimiter(wh.capacity) %> Units Capacity
                  </span>
                  <%= link_to "Depot Details &rarr;".html_safe, warehouse_path(wh), class: "text-xs font-bold text-ink hover:underline sketch-border-soft bg-paper px-2.5 py-1 rounded-lg" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- 4. Emergency Matches -->
      <% if @emergencies.any? %>
        <div class="bg-surface sketch-border rounded-2xl p-5 sm:p-6 space-y-4">
          <h3 class="text-xs font-black text-ink uppercase tracking-wider flex items-center">
            <i class="fas fa-radiation text-red-600 mr-2"></i>
            Emergency &amp; Disaster Incidents (<%= @emergencies.size %>)
          </h3>

          <div class="divide-y divide-[var(--line)]">
            <% @emergencies.each do |em| %>
              <div class="py-3 flex items-center justify-between hover:bg-ink/5 px-2 rounded-xl transition-colors">
                <div>
                  <h4 class="text-sm font-bold text-ink"><%= em.title %></h4>
                  <span class="text-xs text-mute"><%= em.emergency_type %> &bull; Severity: <span class="uppercase font-bold text-red-500"><%= em.severity %></span></span>
                </div>
                <div class="flex items-center space-x-3">
                  <%= link_to "Dispatch & Plan &rarr;".html_safe, emergency_path(em), class: "text-xs font-bold text-red-600 hover:underline sketch-border-soft bg-paper px-2.5 py-1 rounded-lg" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    <% end %>
  <% end %>

</div>
