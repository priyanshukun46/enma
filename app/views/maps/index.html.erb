<div class="space-y-6 max-w-full mx-auto"
     data-controller="map"
     data-map-locations-value="<%= @locations.to_json %>"
     data-map-warehouses-value="<%= @warehouses.to_json %>"
     data-map-emergencies-value="<%= @emergencies.to_json %>">

  <!-- Header Banner -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-slate-200 gap-4">
    <div>
      <div class="flex items-center space-x-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-indigo-100 text-indigo-800 border border-indigo-200">
          GIS Active
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">North East Accessibility Intelligence Map</h2>
      </div>
      <p class="text-xs text-slate-500 mt-1">Real-time geospatial monitoring of settlements, accessibility risk tiers, relief depots, and active emergency zones.</p>
    </div>

    <div class="flex items-center space-x-3">
      <%= link_to accessibility_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-sm transition-all" do %>
        <i class="fas fa-list-ol mr-2 text-xs"></i>
        <span>Accessibility Engine</span>
      <% end %>
    </div>
  </div>

  <!-- Responsive Map Layout: Left Controls + Right Full-Width Map -->
  <div class="flex flex-col lg:flex-row items-start gap-6 w-full">
    <!-- Left Control Panel -->
    <div class="w-full lg:w-80 xl:w-96 flex-shrink-0 space-y-4">
      
      <!-- 1. Search Location Card -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center">
            <i class="fas fa-search-location text-indigo-600 mr-2"></i>
            Search Location
          </h3>
          <span class="text-[10px] text-slate-400 font-semibold">20 Monitored</span>
        </div>

        <div class="relative">
          <input type="text"
                 data-map-target="searchQuery"
                 data-action="input->map#search"
                 autocomplete="off"
                 placeholder="Search name, district, or state..."
                 class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:bg-white focus:outline-none text-xs text-slate-900 transition-colors">
          <div class="absolute left-3 top-2.5 text-slate-400 text-xs pointer-events-none">
            <i class="fas fa-search"></i>
          </div>

          <!-- Dynamic Search Results Dropdown -->
          <div data-map-target="searchResults"
               class="mt-1.5 hidden max-h-64 overflow-y-auto border border-slate-200 rounded-xl bg-white shadow-xl z-50 absolute inset-x-0">
          </div>
        </div>
      </div>

      <!-- 2. Map Layers & Filters Card -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-3">
        <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
          <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center">
            <i class="fas fa-layer-group text-indigo-600 mr-2"></i>
            Map Layers &amp; Filters
          </h3>
          <span class="text-[10px] text-slate-400 font-semibold">Interactive</span>
        </div>

        <div class="space-y-2.5">
          <label class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-colors cursor-pointer">
            <div class="flex items-center space-x-2.5 text-xs font-bold text-slate-700">
              <span class="w-3 h-3 rounded-full bg-blue-500 shadow-sm"></span>
              <span>Accessible Settlements</span>
            </div>
            <input type="checkbox"
                   data-action="change->map#toggleFilter"
                   data-filter="locations"
                   checked
                   class="h-4 w-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 cursor-pointer">
          </label>

          <label class="flex items-center justify-between p-2.5 rounded-xl hover:bg-red-50/50 border border-transparent hover:border-red-200 transition-colors cursor-pointer">
            <div class="flex items-center space-x-2.5 text-xs font-bold text-red-900">
              <span class="w-3 h-3 rounded-full bg-red-600 shadow-sm animate-pulse"></span>
              <span>Critical Zones (&lt; 40)</span>
            </div>
            <input type="checkbox"
                   data-action="change->map#toggleFilter"
                   data-filter="critical"
                   checked
                   class="h-4 w-4 text-red-600 border-slate-300 rounded focus:ring-red-500 cursor-pointer">
          </label>

          <label class="flex items-center justify-between p-2.5 rounded-xl hover:bg-emerald-50/50 border border-transparent hover:border-emerald-200 transition-colors cursor-pointer">
            <div class="flex items-center space-x-2.5 text-xs font-bold text-emerald-900">
              <span class="w-3 h-3 rounded-full bg-emerald-600 shadow-sm"></span>
              <span>Relief Warehouses</span>
            </div>
            <input type="checkbox"
                   data-action="change->map#toggleFilter"
                   data-filter="warehouses"
                   checked
                   class="h-4 w-4 text-emerald-600 border-slate-300 rounded focus:ring-emerald-500 cursor-pointer">
          </label>

          <label class="flex items-center justify-between p-2.5 rounded-xl hover:bg-amber-50/50 border border-transparent hover:border-amber-200 transition-colors cursor-pointer">
            <div class="flex items-center space-x-2.5 text-xs font-bold text-amber-900">
              <span class="w-3 h-3 rounded-full bg-amber-500 shadow-sm"></span>
              <span>Active Emergencies</span>
            </div>
            <input type="checkbox"
                   data-action="change->map#toggleFilter"
                   data-filter="emergencies"
                   checked
                   class="h-4 w-4 text-amber-500 border-slate-300 rounded focus:ring-amber-500 cursor-pointer">
          </label>
        </div>
      </div>

      <!-- 3. Legend Card -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-3">
        <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-2">
          Accessibility Legend
        </h3>
        
        <div class="space-y-2 text-xs">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-3 h-3 rounded-full bg-green-600"></span>
              <span class="text-slate-700 font-medium">Highly Accessible</span>
            </div>
            <span class="text-slate-400 font-mono text-[11px]">80 - 100</span>
          </div>

          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
              <span class="text-slate-700 font-medium">Moderately Accessible</span>
            </div>
            <span class="text-slate-400 font-mono text-[11px]">60 - 79</span>
          </div>

          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-3 h-3 rounded-full bg-orange-500"></span>
              <span class="text-slate-700 font-medium">Difficult Access</span>
            </div>
            <span class="text-slate-400 font-mono text-[11px]">40 - 59</span>
          </div>

          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-3 h-3 rounded-full bg-red-600"></span>
              <span class="text-red-700 font-bold">Critical Vulnerability</span>
            </div>
            <span class="text-red-600 font-mono text-[11px]">0 - 39</span>
          </div>

          <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-3 h-3 rounded-full bg-emerald-600"></span>
              <span class="text-slate-700 font-medium">Relief Warehouses</span>
            </div>
            <span class="text-slate-500 text-[11px]"><%= @warehouses.size %> Hubs</span>
          </div>

          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-3 h-3 rounded-full bg-amber-500"></span>
              <span class="text-slate-700 font-medium">Active Emergencies</span>
            </div>
            <span class="text-slate-500 text-[11px]"><%= @emergencies.size %> Active</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Map Container: Expands to fill all remaining space -->
    <div class="flex-1 min-w-0 w-full bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden relative">
      <div data-map-target="container"
           style="height: 680px; min-height: 550px; width: 100%; display: block;"
           class="w-full z-10">
      </div>
    </div>
  </div>
</div>
