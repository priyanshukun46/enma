<div class="space-y-6"
     data-controller="map"
     data-map-locations-value="<%= @locations.to_json %>"
     data-map-warehouses-value="<%= @warehouses.to_json %>"
     data-map-emergencies-value="<%= @emergencies.to_json %>">

  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4 gap-4">
    <div>
      <div class="flex items-center space-x-3">
        <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">North East Accessibility Intelligence Map</h2>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
          GIS Active
        </span>
      </div>
      <p class="text-sm text-gray-500 mt-1">Real-time visualization of logistics infrastructure, accessibility risk tiers, and active emergency zones.</p>
    </div>

    <div>
      <%= link_to accessibility_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-all" do %>
        <i class="fas fa-list-ol mr-2 text-xs"></i>
        <span>View Priority Ranking</span>
      <% end %>
    </div>
  </div>

  <!-- Main Layout Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Left Panel: Search, Filters & Legend -->
    <div class="space-y-6 lg:col-span-1">
      <!-- Search Panel -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-3">📍 Search Location</h3>
        <div class="relative">
          <input type="text"
                 data-map-target="searchQuery"
                 data-action="input->map#search"
                 autocomplete="off"
                 placeholder="Search name, state, district..."
                 class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
          <div class="absolute left-3 top-2.5 text-gray-400">
            <i class="fas fa-search"></i>
          </div>
        </div>

        <!-- Search Results Dropdown -->
        <div data-map-target="searchResults" class="mt-2 hidden max-h-60 overflow-y-auto border border-gray-200 rounded-lg bg-white shadow-lg z-50 absolute w-auto min-w-[220px] max-w-[280px]">
          <!-- Results populated dynamically -->
        </div>
      </div>

      <!-- Filters Panel -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-4">🎛 Map Layers &amp; Filters</h3>
        <div class="space-y-3">
          <label class="flex items-center space-x-3 cursor-pointer">
            <input type="checkbox"
                   data-action="change->map#toggleFilter"
                   data-filter="locations"
                   checked
                   class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
            <span class="text-sm font-medium text-gray-700 flex items-center">
              <span class="w-3 h-3 rounded-full bg-blue-500 inline-block mr-2"></span>
              Accessible Locations
            </span>
          </label>

          <label class="flex items-center space-x-3 cursor-pointer">
            <input type="checkbox"
                   data-action="change->map#toggleFilter"
                   data-filter="critical"
                   checked
                   class="h-4 w-4 text-red-600 border-gray-300 rounded focus:ring-red-500">
            <span class="text-sm font-medium text-gray-700 flex items-center">
              <span class="w-3 h-3 rounded-full bg-red-600 inline-block mr-2"></span>
              Critical Zones (&lt; 40)
            </span>
          </label>

          <label class="flex items-center space-x-3 cursor-pointer">
            <input type="checkbox"
                   data-action="change->map#toggleFilter"
                   data-filter="warehouses"
                   checked
                   class="h-4 w-4 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500">
            <span class="text-sm font-medium text-gray-700 flex items-center">
              <span class="w-3 h-3 rounded-full bg-emerald-600 inline-block mr-2"></span>
              Warehouses
            </span>
          </label>

          <label class="flex items-center space-x-3 cursor-pointer">
            <input type="checkbox"
                   data-action="change->map#toggleFilter"
                   data-filter="emergencies"
                   checked
                   class="h-4 w-4 text-amber-500 border-gray-300 rounded focus:ring-amber-500">
            <span class="text-sm font-medium text-gray-700 flex items-center">
              <span class="w-3 h-3 rounded-full bg-amber-500 inline-block mr-2"></span>
              Active Emergencies
            </span>
          </label>
        </div>
      </div>

      <!-- Legend Panel -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-3">Accessibility Legend</h3>
        <div class="space-y-2.5">
          <div class="flex items-center text-xs text-gray-700">
            <span class="w-3.5 h-3.5 rounded-full bg-green-600 border border-white shadow-sm mr-2.5"></span>
            <span>🟢 Highly Accessible (80 - 100)</span>
          </div>
          <div class="flex items-center text-xs text-gray-700">
            <span class="w-3.5 h-3.5 rounded-full bg-yellow-500 border border-white shadow-sm mr-2.5"></span>
            <span>🟡 Moderately Accessible (60 - 79)</span>
          </div>
          <div class="flex items-center text-xs text-gray-700">
            <span class="w-3.5 h-3.5 rounded-full bg-orange-500 border border-white shadow-sm mr-2.5"></span>
            <span>🟠 Difficult Access (40 - 59)</span>
          </div>
          <div class="flex items-center text-xs text-gray-700">
            <span class="w-3.5 h-3.5 rounded-full bg-red-600 border border-white shadow-sm mr-2.5"></span>
            <span>🔴 Critical Zones (0 - 39)</span>
          </div>
          <div class="pt-2 border-t border-gray-100 space-y-2">
            <div class="flex items-center text-xs text-gray-700">
              <span class="w-3.5 h-3.5 rounded-full bg-emerald-600 border border-white shadow-sm mr-2.5"></span>
              <span>🏢 Strategic Warehouses</span>
            </div>
            <div class="flex items-center text-xs text-gray-700">
              <span class="w-3.5 h-3.5 rounded-full bg-amber-500 border border-white shadow-sm mr-2.5"></span>
              <span>⚠️ Active Emergencies</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel: Interactive Map -->
    <div class="lg:col-span-3 flex flex-col h-full bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <!-- Live Map Container -->
      <div data-map-target="container" class="w-full flex-1 min-h-[600px] z-10"></div>
    </div>
  </div>
</div>
