<div class="min-h-[85vh] flex flex-col justify-center items-center py-10 px-4 sm:px-6">
  <div class="max-w-md w-full space-y-6">
    
    <!-- Header with Branding (Google Stitch Style) -->
    <div class="text-center space-y-2">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-600 dark:bg-indigo-500 text-white shadow-lg shadow-indigo-600/20 mb-1">
        <span class="text-2xl font-black">⚡</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">ENMA AI</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Smart Logistics, Accessibility Intelligence &amp; Emergency Response</p>
      <p class="text-sm font-bold text-slate-800 dark:text-slate-200 pt-1">Sign in to your operational account</p>
    </div>

    <!-- Main Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-5">
      
      <!-- Email / Username & Password Form -->
      <%= form_with url: login_path, local: true, data: { turbo: false }, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :login, "Username or Email Address", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :login,
                            required: true,
                            autofocus: true,
                            placeholder: "admin, operator, or user@enma.ai",
                            class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, "Password", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider" %>
            <%= link_to "Forgot Password?", new_password_path, class: "text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline" %>
          </div>
          <%= f.password_field :password,
                               required: true,
                               placeholder: "••••••••",
                               class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>

        <div class="pt-1">
          <%= f.submit "Sign In to Platform",
                       class: "w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs sm:text-sm rounded-xl shadow-md transition-all cursor-pointer" %>
        </div>
      <% end %>

      <!-- Symmetrical Center Divider -->
      <div class="relative flex items-center justify-center my-4">
        <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
        <span class="flex-shrink mx-3 text-[10px] font-black uppercase text-slate-400 dark:text-slate-500 tracking-wider">OR CONTINUE WITH</span>
        <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
      </div>

      <!-- OAuth SSO Buttons (Full Column Width) -->
      <div class="grid grid-cols-2 gap-3 w-full">
        <!-- Google OAuth Button -->
        <%= form_with url: demo_sso_login_path(provider: "google"), method: :post, local: true, data: { turbo: false }, class: "w-full" do |f| %>
          <button type="submit" class="w-full flex items-center justify-center py-2.5 px-3 border border-slate-200 dark:border-slate-700 rounded-xl shadow-sm bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-xs font-bold text-slate-700 dark:text-slate-200 transition-all cursor-pointer">
            <i class="fab fa-google text-red-500 mr-2 text-sm"></i>
            <span>Google SSO</span>
          </button>
        <% end %>

        <!-- GitHub OAuth Button -->
        <%= form_with url: demo_sso_login_path(provider: "github"), method: :post, local: true, data: { turbo: false }, class: "w-full" do |f| %>
          <button type="submit" class="w-full flex items-center justify-center py-2.5 px-3 border border-slate-800 dark:border-slate-700 rounded-xl shadow-sm bg-slate-900 hover:bg-black dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-bold text-white transition-all cursor-pointer">
            <i class="fab fa-github mr-2 text-sm"></i>
            <span>GitHub SSO</span>
          </button>
        <% end %>
      </div>

      <!-- SIH 2026 Judge & Demo Fast-Login Helper -->
      <div class="p-4 rounded-2xl bg-indigo-50/60 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/60 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-black uppercase text-indigo-900 dark:text-indigo-300 tracking-wider">⚡ SIH Demo Quick Login</span>
          <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-bold">1-Click Access</span>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 w-full">
          <%= form_with url: login_path, local: true, data: { turbo: false }, class: "w-full" do |f| %>
            <%= f.hidden_field :login, value: "admin" %>
            <%= f.hidden_field :password, value: "password123" %>
            <button type="submit" class="w-full py-2 px-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs rounded-xl shadow-sm cursor-pointer transition-colors flex flex-col items-center justify-center">
              <span>Admin Demo</span>
              <span class="text-[9px] font-normal text-indigo-200 truncate">admin (or admin@enma.ai)</span>
            </button>
          <% end %>

          <%= form_with url: login_path, local: true, data: { turbo: false }, class: "w-full" do |f| %>
            <%= f.hidden_field :login, value: "operator" %>
            <%= f.hidden_field :password, value: "password123" %>
            <button type="submit" class="w-full py-2 px-2.5 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-900 dark:text-white border border-slate-200 dark:border-slate-700 font-black text-xs rounded-xl shadow-sm cursor-pointer transition-colors flex flex-col items-center justify-center">
              <span>Operator Demo</span>
              <span class="text-[9px] font-normal text-slate-500 dark:text-slate-400 truncate">operator (or operator@enma.ai)</span>
            </button>
          <% end %>
        </div>
      </div>

      <!-- Registration Link -->
      <div class="text-center pt-2 border-t border-slate-100 dark:border-slate-800">
        <p class="text-xs text-slate-600 dark:text-slate-400">
          Don't have an operational account?
          <%= link_to "Create Account", sign_up_path, class: "font-black text-indigo-600 dark:text-indigo-400 hover:underline ml-1" %>
        </p>
      </div>

    </div>
  </div>
</div>
