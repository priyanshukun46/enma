<div class="min-h-[80vh] flex flex-col justify-center items-center py-6 px-4">
  <div class="max-w-md w-full space-y-6">
    <!-- Header with Branding -->
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-600 text-white shadow-xl mb-3">
        <span class="text-3xl">⚡</span>
      </div>
      <h2 class="text-3xl font-black text-gray-900 tracking-tight">ENMA AI</h2>
      <p class="text-xs text-gray-500 font-semibold mt-1">Intelligence That Reaches Where Roads Don't.</p>
      <p class="text-sm font-bold text-gray-700 mt-2">Sign in to your operational account</p>
    </div>

    <!-- Main Card -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-7 md:p-8 space-y-6">
      <!-- Email / Password Form -->
      <%= form_with url: login_path, local: true, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :email_address, "Email Address", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email_address,
                            required: true,
                            autofocus: true,
                            placeholder: "admin@enma.ai or operator@enma.ai",
                            class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, "Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider" %>
            <%= link_to "Forgot Password?", new_password_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-800" %>
          </div>
          <%= f.password_field :password,
                               required: true,
                               placeholder: "••••••••",
                               class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div>
          <%= f.submit "Sign In to Platform",
                       class: "w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-sm rounded-xl shadow-md hover:shadow-lg transition-all duration-150 cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      <% end %>

      <!-- Divider -->
      <div class="relative flex items-center justify-center my-4">
        <div class="border-t border-gray-200 w-full"></div>
        <span class="bg-white px-3 text-[11px] font-black uppercase text-gray-400 tracking-wider relative">OR CONTINUE WITH</span>
      </div>

      <!-- OAuth Buttons -->
      <div class="grid grid-cols-2 gap-3">
        <!-- Google OAuth Button -->
        <%= button_to demo_sso_login_path(provider: "google"), method: :post, class: "w-full flex items-center justify-center py-2.5 px-3 border border-gray-300 rounded-xl shadow-sm bg-white hover:bg-gray-50 text-xs font-bold text-gray-700 transition-colors cursor-pointer" do %>
          <i class="fab fa-google text-red-500 mr-2"></i>
          <span>Google SSO</span>
        <% end %>

        <!-- GitHub OAuth Button -->
        <%= button_to demo_sso_login_path(provider: "github"), method: :post, class: "w-full flex items-center justify-center py-2.5 px-3 border border-gray-300 rounded-xl shadow-sm bg-gray-900 hover:bg-gray-800 text-xs font-bold text-white transition-colors cursor-pointer" do %>
          <i class="fab fa-github mr-2"></i>
          <span>GitHub SSO</span>
        <% end %>
      </div>

      <!-- SIH 2026 Judge & Demo Fast-Login Helper -->
      <div class="p-4 rounded-xl bg-indigo-50/60 border border-indigo-100 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-black uppercase text-indigo-900 tracking-wider">⚡ SIH Demo Quick Login</span>
          <span class="text-[10px] text-indigo-600 font-semibold">1-Click Access</span>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <%= form_with url: login_path, local: true do |f| %>
            <%= f.hidden_field :email_address, value: "admin@enma.ai" %>
            <%= f.hidden_field :password, value: "password123" %>
            <%= f.submit "Admin (admin@enma.ai)", class: "w-full py-1.5 px-2 bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-[11px] rounded-lg shadow-sm cursor-pointer transition-colors" %>
          <% end %>

          <%= form_with url: login_path, local: true do |f| %>
            <%= f.hidden_field :email_address, value: "operator@enma.ai" %>
            <%= f.hidden_field :password, value: "password123" %>
            <%= f.submit "Operator (operator@enma.ai)", class: "w-full py-1.5 px-2 bg-white hover:bg-gray-100 text-indigo-900 border border-indigo-200 font-extrabold text-[11px] rounded-lg shadow-sm cursor-pointer transition-colors" %>
          <% end %>
        </div>
      </div>

      <!-- Registration Link -->
      <div class="text-center pt-2">
        <p class="text-xs text-gray-600">
          Don't have an operational account?
          <%= link_to "Create Account", sign_up_path, class: "font-bold text-indigo-600 hover:text-indigo-800 ml-1" %>
        </p>
      </div>
    </div>
  </div>
</div>
