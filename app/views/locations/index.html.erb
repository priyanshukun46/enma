<div class="space-y-6 max-w-7xl mx-auto pb-12">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 border-b border-slate-200 dark:border-slate-800 gap-3">
    <div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">All Locations</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Directory of all monitored regional population nodes and logistics access profiles across North East India.</p>
    </div>
    <div>
      <%= link_to accessibility_path, class: "inline-flex items-center px-4 py-2 bg-accent hover:opacity-90 text-white text-xs font-black rounded-full shadow-sm transition-all" do %>
        <i class="fas fa-bolt mr-1.5 text-xs"></i>
        <span>Accessibility Intelligence</span>
      <% end %>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
        <thead class="bg-slate-50 dark:bg-slate-800/60 font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider text-[10px]">
          <tr>
            <th scope="col" class="px-5 py-3">Location Name</th>
            <th scope="col" class="px-5 py-3">State</th>
            <th scope="col" class="px-5 py-3">District</th>
            <th scope="col" class="px-5 py-3">Population</th>
            <th scope="col" class="px-5 py-3">Accessibility</th>
            <th scope="col" class="px-5 py-3">Status</th>
            <th scope="col" class="px-5 py-3 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-300">
          <% @locations.each do |location| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="px-5 py-3.5 font-bold text-slate-900 dark:text-white"><%= location.name %></td>
              <td class="px-5 py-3.5 text-slate-500 dark:text-slate-400"><%= location.state %></td>
              <td class="px-5 py-3.5 text-slate-500 dark:text-slate-400"><%= location.district %></td>
              <td class="px-5 py-3.5"><%= number_with_delimiter(location.population) %></td>
              <td class="px-5 py-3.5 font-bold font-mono <%= location.accessibility_score.to_f < 40 ? 'text-red-600 dark:text-red-400' : (location.accessibility_score.to_f < 60 ? 'text-orange-600 dark:text-orange-400' : 'text-emerald-600 dark:text-emerald-400') %>">
                <%= location.accessibility_score %> / 100
              </td>
              <td class="px-5 py-3.5">
                <span class="px-2 py-0.5 inline-flex text-[10px] font-black uppercase rounded-full border <%= location.accessibility_badge_class %>">
                  <%= location.accessibility_tier %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-right">
                <%= link_to accessibility_location_path(location), class: "text-xs font-bold text-accent dark:text-accent hover:underline" do %>
                  <span>Report &rarr;</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
