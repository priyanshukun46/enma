<div class="space-y-6 max-w-7xl mx-auto pb-16">
  
  <!-- PAGE HEADER -->
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5 flex-wrap">
        <h1 class="text-2xl sm:text-3xl font-black text-ink tracking-tight font-hand">Predictive Cascading Impact Intelligence</h1>
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-black uppercase bg-accent/15 text-accent border border-accent/30">
          Anticipatory AI Engine
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono text-mute bg-surface border border-[var(--line)]">
          <i class="fas fa-stopwatch mr-1 text-[10px]"></i><%= @analysis.dig(:metadata, :execution_time_ms) || 45 %>ms latency
        </span>
        <% if @analysis.dig(:metadata, :cache_hits) %>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
            <i class="fas fa-bolt mr-1"></i>Baseline Cached
          </span>
        <% end %>
      </div>
      <p class="text-xs sm:text-sm text-mute mt-1">
        Forward-looking infrastructure failure forecasting, 5-stage cascading network propagation, and counterfactual intervention planning.
      </p>
    </div>

    <!-- Controls: Horizons, Export & Refresh -->
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Horizon Selector -->
      <div class="flex items-center bg-surface border border-[var(--line)] rounded-xl p-1 shadow-sm">
        <span class="text-[10px] font-mono text-mute font-bold uppercase px-2">Horizon:</span>
        <% [6, 12, 24, 48].each do |h| %>
          <%= link_to intelligence_predictions_path(horizon: h),
                      class: "px-2.5 py-1 rounded-lg text-xs font-mono font-bold transition #{h == @horizon ? 'bg-ink text-paper shadow-sm' : 'text-mute hover:text-ink hover:bg-ink/5'}" do %>
            <%= h %>h
          <% end %>
        <% end %>
      </div>

      <!-- Export JSON -->
      <%= link_to intelligence_predictions_path(horizon: @horizon, format: :json),
                  target: "_blank",
                  class: "inline-flex items-center px-3 py-2 rounded-xl text-xs font-bold bg-surface text-sketch border border-[var(--line)] hover:bg-ink/5 shadow-sm transition" do %>
        <i class="fas fa-code mr-1.5 text-xs text-mute"></i>
        <span>JSON API</span>
      <% end %>

      <!-- Live Network Link -->
      <%= link_to network_path,
                  class: "inline-flex items-center px-3.5 py-2 rounded-xl text-xs font-bold bg-ink text-paper shadow-sm hover:opacity-90 transition" do %>
        <i class="fas fa-project-diagram mr-1.5 text-xs"></i>
        <span>Network Graph</span>
      <% end %>
    </div>
  </div>

  <!-- KPI EXECUTIVE METRICS -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
    <!-- Overall Cascade Risk -->
    <div class="bg-surface rounded-2xl p-4 border border-[var(--line)] shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between text-xs text-mute font-bold">
        <span>Cascade Risk Index</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-black uppercase border <%= @analysis[:risk_badge_class] %>">
          <%= @analysis[:risk_level] %>
        </span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-black font-mono text-ink">
          <%= @analysis[:overall_cascade_risk] %><span class="text-sm text-mute font-normal"> / 100</span>
        </div>
        <div class="text-[11px] font-bold mt-0.5 flex items-center gap-1.5" style="color: <%= @analysis[:risk_color] %>">
          <i class="fas <%= @analysis.dig(:trend, :direction) == 'ESCALATING' ? 'fa-arrow-trend-up text-red-500' : 'fa-arrow-trend-down text-emerald-500' %>"></i>
          <span><%= @analysis.dig(:trend, :direction) %> (<%= @analysis[:forecast_horizon] %>h Horizon)</span>
        </div>
      </div>
      <div class="w-full bg-ink/10 rounded-full h-1.5 overflow-hidden">
        <div class="h-1.5 rounded-full" style="width: <%= @analysis[:overall_cascade_risk] %>%; background-color: <%= @analysis[:risk_color] %>"></div>
      </div>
    </div>

    <!-- Settlements at Risk -->
    <div class="bg-surface rounded-2xl p-4 border border-[var(--line)] shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between text-xs text-mute font-bold">
        <span>Settlements at Risk</span>
        <i class="fas fa-city <%= @analysis.dig(:projected_impact, :settlements_at_risk).to_i.positive? ? 'text-amber-500' : 'text-emerald-500' %>"></i>
      </div>
      <div class="my-2">
        <div class="text-3xl font-black font-mono text-ink">
          <%= @analysis.dig(:projected_impact, :settlements_at_risk) %>
          <span class="text-sm text-mute font-normal"> / <%= @analysis.dig(:projected_impact, :total_settlements) %></span>
        </div>
        <div class="text-[11px] text-mute mt-0.5">
          <%= @analysis.dig(:projected_impact, :isolated_settlements_count).to_i %> already isolated
        </div>
      </div>
      <div class="text-[10px] text-mute font-mono">
        Vulnerable hubs: <%= @analysis.dig(:threatened_roads)&.count { |r| r[:cascading_impact_proxy] >= 60.0 } || 0 %>
      </div>
    </div>

    <!-- Population Exposure -->
    <div class="bg-surface rounded-2xl p-4 border border-[var(--line)] shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between text-xs text-mute font-bold">
        <span>Population Threat</span>
        <i class="fas fa-users-rays text-accent"></i>
      </div>
      <div class="my-2">
        <div class="text-3xl font-black font-mono text-ink">
          <%= number_with_delimiter(@analysis.dig(:projected_impact, :population_at_risk) || 0) %>
        </div>
        <div class="text-[11px] text-mute mt-0.5">
          Civilians in cutoff sectors
        </div>
      </div>
      <div class="text-[10px] text-mute font-mono">
        Preemptive triage activated
      </div>
    </div>

    <!-- Warehouses at Risk -->
    <div class="bg-surface rounded-2xl p-4 border border-[var(--line)] shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between text-xs text-mute font-bold">
        <span>Supply Hubs at Risk</span>
        <i class="fas fa-warehouse <%= @analysis.dig(:projected_impact, :warehouses_at_risk).to_i.positive? ? 'text-amber-500' : 'text-emerald-500' %>"></i>
      </div>
      <div class="my-2">
        <div class="text-3xl font-black font-mono text-ink">
          <%= @analysis.dig(:projected_impact, :warehouses_at_risk) %>
          <span class="text-sm text-mute font-normal"> / <%= @analysis.dig(:projected_impact, :total_warehouses) %></span>
        </div>
        <div class="text-[11px] text-mute mt-0.5">
          Strategic stockpiles impacted
        </div>
      </div>
      <div class="text-[10px] text-mute font-mono">
        <%= @analysis.dig(:projected_impact, :warehouses_at_risk).to_i.zero? ? 'All supply depots secure' : 'Alternate depots recommended' %>
      </div>
    </div>

    <!-- Network Health Forecast -->
    <div class="bg-surface rounded-2xl p-4 border border-[var(--line)] shadow-sm flex flex-col justify-between col-span-2 md:col-span-1">
      <div class="flex items-center justify-between text-xs text-mute font-bold">
        <span>Network Health (<%= @analysis[:forecast_horizon] %>h)</span>
        <i class="fas fa-heart-pulse <%= @analysis.dig(:projected_impact, :network_health_forecast).to_f >= 70 ? 'text-emerald-500' : 'text-red-500' %>"></i>
      </div>
      <div class="my-2">
        <div class="text-3xl font-black font-mono text-ink">
          <%= @analysis.dig(:projected_impact, :network_health_forecast) %><span class="text-sm text-mute font-normal"> %</span>
        </div>
        <div class="text-[11px] text-mute mt-0.5">
          Simulated topological survivability
        </div>
      </div>
      <div class="w-full bg-ink/10 rounded-full h-1.5 overflow-hidden">
        <div class="h-1.5 rounded-full <%= @analysis.dig(:projected_impact, :network_health_forecast).to_f >= 70 ? 'bg-emerald-500' : 'bg-red-500' %>"
             style="width: <%= @analysis.dig(:projected_impact, :network_health_forecast) %>%"></div>
      </div>
    </div>
  </div>

  <!-- DYNAMIC EXECUTIVE NARRATIVE: "WHAT HAPPENS NEXT?" -->
  <div class="bg-surface rounded-2xl p-5 border border-[var(--line)] shadow-sm">
    <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] pb-3 mb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-accent/15 text-accent flex items-center justify-center font-bold text-xs">
          <i class="fas fa-wand-magic-sparkles"></i>
        </div>
        <h2 class="text-base sm:text-lg font-black text-ink tracking-tight font-hand">
          Executive Forecast: What Happens Next?
        </h2>
      </div>
      <span class="text-xs font-mono text-mute">
        Generated <%= @analysis[:generated_at]&.strftime("%H:%M IST") %>
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <div class="lg:col-span-2 space-y-2 text-xs sm:text-sm text-ink leading-relaxed">
        <% if @analysis[:explanation].present? %>
          <% @analysis[:explanation].each do |exp| %>
            <div class="flex items-start gap-2">
              <span class="text-accent mt-0.5 shrink-0"><i class="fas fa-chevron-right text-[10px]"></i></span>
              <p><%= exp %></p>
            </div>
          <% end %>
        <% else %>
          <p class="text-mute italic">No immediate cascading threats detected within the current <%= @analysis[:forecast_horizon] %>-hour window.</p>
        <% end %>
      </div>

      <!-- Trend & Signals Summary Box -->
      <div class="bg-ink/5 dark:bg-ink/10 rounded-xl p-3.5 border border-[var(--line)] space-y-2">
        <div class="flex items-center justify-between text-xs font-bold text-ink">
          <span>Signal Convergence</span>
          <span class="font-mono text-xs text-accent"><%= @analysis.dig(:trend, :score) %>/100</span>
        </div>
        <ul class="text-[11px] text-mute space-y-1">
          <% (@analysis.dig(:trend, :signals) || []).each do |sig| %>
            <li class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></span>
              <span><%= sig %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <!-- 5-STAGE CASCADING NETWORK PROPAGATION TIMELINE -->
  <div class="bg-surface rounded-2xl p-5 border border-[var(--line)] shadow-sm space-y-4">
    <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xs">
          <i class="fas fa-diagram-project"></i>
        </div>
        <div>
          <h2 class="text-base sm:text-lg font-black text-ink tracking-tight font-hand">5-Stage Cascading Propagation Chain</h2>
          <p class="text-[11px] text-mute">Chronological failure cascade from primary trigger to macroeconomic logistics paralysis</p>
        </div>
      </div>
      <span class="text-xs font-mono text-mute px-2.5 py-1 rounded bg-ink/5 border border-[var(--line)]">
        Deterministic Graph Propagation
      </span>
    </div>

    <!-- 5 Stages Horizontal Progression -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-3 pt-2">
      <% stages = @analysis[:cascade_stages] || [] %>
      <% stages.each_with_index do |stg, idx| %>
        <div class="relative bg-paper/70 dark:bg-ink/10 rounded-xl p-3.5 border border-[var(--line)] flex flex-col justify-between space-y-2">
          <!-- Stage badge -->
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono font-black uppercase px-2 py-0.5 rounded bg-ink text-paper">
              Stage <%= stg[:stage] %>
            </span>
            <span class="text-[10px] font-mono text-mute font-bold">
              <%= stg[:timeframe] %>
            </span>
          </div>

          <div>
            <h3 class="text-xs font-bold text-ink mt-1"><%= stg[:name] %></h3>
            <p class="text-[11px] text-mute mt-1 leading-snug"><%= stg[:description] %></p>
          </div>

          <!-- Corridors / nodes affected -->
          <div class="pt-2 border-t border-[var(--line)]/50">
            <div class="text-[10px] font-mono font-bold text-ink mb-1">Impact Vector:</div>
            <div class="flex flex-wrap gap-1">
              <% (stg[:impacted_roads] || []).first(2).each do |r_name| %>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-accent/10 text-accent border border-accent/20">
                  <%= r_name %>
                </span>
              <% end %>
              <% (stg[:impacted_settlements] || []).first(2).each do |s_name| %>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20">
                  <%= s_name %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- THREAT PRIORITIZATION MATRIX -->
  <div class="bg-surface rounded-2xl p-5 border border-[var(--line)] shadow-sm space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[var(--line)] pb-3">
      <div>
        <h2 class="text-base sm:text-lg font-black text-ink tracking-tight font-hand">Threat Prioritization Matrix</h2>
        <p class="text-[11px] text-mute">
          Ranked by Expected Operational Threat: <span class="font-mono text-accent font-bold">EOT = (P × I × C) / 10,000</span>
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1 text-[11px] font-mono text-mute">
          <span class="w-2 h-2 rounded-full bg-red-500"></span> Actionable
        </span>
        <span class="inline-flex items-center gap-1 text-[11px] font-mono text-mute">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span> Needs Verification
        </span>
        <span class="inline-flex items-center gap-1 text-[11px] font-mono text-mute">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Monitoring
        </span>
      </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto -mx-5 px-5">
      <table class="w-full text-left text-xs text-ink">
        <thead>
          <tr class="border-b border-[var(--line)] text-mute font-mono text-[10px] uppercase">
            <th class="py-2.5 pr-2">Rank</th>
            <th class="py-2.5 px-3">Corridor</th>
            <th class="py-2.5 px-3 text-center">Fail Prob (P)</th>
            <th class="py-2.5 px-3 text-center">Criticality (I)</th>
            <th class="py-2.5 px-3 text-center">Resilience (R)</th>
            <th class="py-2.5 px-3 text-center">Confidence (C)</th>
            <th class="py-2.5 px-3">EOT Priority Score</th>
            <th class="py-2.5 px-3 text-center">Operational Status</th>
            <th class="py-2.5 pl-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--line)]/50">
          <% candidates = @analysis[:top_candidates] || [] %>
          <% if candidates.any? %>
            <% candidates.each_with_index do |cand, idx| %>
              <tr class="hover:bg-ink/5 transition-colors">
                <td class="py-3 pr-2 font-mono font-black text-mute">
                  #<%= idx + 1 %>
                </td>
                <td class="py-3 px-3">
                  <div class="font-bold text-ink text-xs flex items-center gap-1.5">
                    <span><%= cand[:road_number] %></span>
                    <% if cand[:is_bridge] %>
                      <span class="px-1.5 py-0.2 rounded text-[9px] font-mono bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">Bridge</span>
                    <% end %>
                  </div>
                  <div class="text-[11px] text-mute truncate max-w-[180px]">
                    <%= cand[:road_name] %> • <%= cand[:state] %>
                  </div>
                </td>
                <!-- Fail Prob -->
                <td class="py-3 px-3 text-center">
                  <span class="font-mono font-bold text-xs <%= cand[:failure_probability].to_f >= 60 ? 'text-red-600 dark:text-red-400' : 'text-amber-600 dark:text-amber-400' %>">
                    <%= cand[:failure_probability] %>%
                  </span>
                  <div class="text-[9px] font-mono text-mute">
                    [<%= cand.dig(:uncertainty, :lower_bound) %>-<%= cand.dig(:uncertainty, :upper_bound) %>%]
                  </div>
                </td>
                <!-- Criticality -->
                <td class="py-3 px-3 text-center font-mono font-bold">
                  <%= cand[:criticality_score] %>/100
                </td>
                <!-- Route Resilience -->
                <td class="py-3 px-3 text-center">
                  <span class="font-mono font-bold text-xs">
                    <%= cand.dig(:route_resilience, :resilience_score) || cand[:resilience_score] || 35.0 %>/100
                  </span>
                  <div class="text-[9px] font-mono text-mute truncate max-w-[110px]">
                    <%= cand.dig(:route_resilience, :resilience_category)&.humanize || 'Constrained' %>
                  </div>
                </td>
                <!-- Confidence -->
                <td class="py-3 px-3 text-center">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold <%= cand[:prediction_confidence].to_f >= 75 ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20' : (cand[:prediction_confidence].to_f >= 55 ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20' : 'bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20') %>">
                    <%= cand[:prediction_confidence] %>%
                  </span>
                </td>
                <!-- EOT Priority -->
                <td class="py-3 px-3 min-w-[130px]">
                  <div class="flex items-center justify-between text-[11px] font-mono font-black text-ink mb-1">
                    <span><%= cand[:expected_operational_threat] || cand[:scenario_priority_score] %></span>
                    <span class="text-[9px] text-mute font-normal">/ 100</span>
                  </div>
                  <div class="w-full bg-ink/10 rounded-full h-1.5 overflow-hidden">
                    <div class="h-1.5 rounded-full <%= cand[:expected_operational_threat].to_f >= 50 ? 'bg-red-500' : 'bg-amber-500' %>"
                         style="width: <%= cand[:expected_operational_threat] || cand[:scenario_priority_score] %>%"></div>
                  </div>
                </td>
                <!-- Operational Status -->
                <td class="py-3 px-3 text-center">
                  <% op_status = cand[:operational_status] || 'MONITORING' %>
                  <% status_classes = case op_status
                                      when 'ACTIONABLE' then 'bg-red-500/10 text-red-600 dark:text-red-400 border-red-500/20'
                                      when 'NEEDS_VERIFICATION' then 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20'
                                      else 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20'
                                      end %>
                  <span class="px-2 py-0.5 rounded text-[9px] font-mono font-black uppercase border <%= status_classes %>">
                    <%= op_status %>
                  </span>
                </td>
                <!-- Action Button -->
                <td class="py-3 pl-3 text-right">
                  <%= link_to network_path(simulated_road_id: cand[:road_id]),
                              class: "inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-ink/5 hover:bg-ink text-ink hover:text-paper transition" do %>
                    <i class="fas fa-play mr-1 text-[9px]"></i>Simulate
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9" class="py-6 text-center text-xs text-mute italic">
                No active threats meeting priority escalation threshold.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- MULTI-HORIZON PROBABILITY TIMELINES -->
  <div class="bg-surface rounded-2xl p-5 border border-[var(--line)] shadow-sm space-y-4">
    <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] pb-3">
      <div>
        <h2 class="text-base sm:text-lg font-black text-ink tracking-tight font-hand">Multi-Horizon Failure Timeline</h2>
        <p class="text-[11px] text-mute">Non-linear failure escalation curves across 6h, 12h, 24h, and 48h horizons with uncertainty envelopes</p>
      </div>
      <span class="text-xs font-mono text-mute px-2 py-0.5 rounded bg-ink/5 border border-[var(--line)]">
        Weather-Accelerated Progression
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% (@analysis[:top_candidates] || []).first(3).each do |cand| %>
        <div class="bg-paper/70 dark:bg-ink/10 rounded-xl p-4 border border-[var(--line)] space-y-3">
          <div class="flex items-center justify-between">
            <div>
              <div class="font-black text-xs text-ink"><%= cand[:road_number] %></div>
              <div class="text-[10px] text-mute truncate max-w-[150px]"><%= cand[:road_name] %></div>
            </div>
            <span class="px-2 py-0.5 rounded text-[9px] font-mono font-black uppercase bg-accent/10 text-accent border border-accent/20">
              <%= cand.dig(:horizon_forecasts, :acceleration_pattern)&.humanize || 'Accelerating' %>
            </span>
          </div>

          <!-- 4 Horizons Grid -->
          <div class="grid grid-cols-4 gap-2 text-center pt-2">
            <% [6, 12, 24, 48].each do |h| %>
              <% h_val = cand.dig(:horizon_forecasts, "#{h}h".to_sym) || cand[:failure_probability] %>
              <div class="p-2 rounded-lg bg-surface border border-[var(--line)]">
                <div class="text-[9px] font-mono text-mute"><%= h %>h</div>
                <div class="text-xs font-mono font-black mt-0.5 <%= h_val.to_f >= 60 ? 'text-red-500' : 'text-ink' %>">
                  <%= h_val %>%
                </div>
              </div>
            <% end %>
          </div>

          <!-- Uncertainty Envelope -->
          <div class="flex items-center justify-between text-[10px] font-mono text-mute pt-1 border-t border-[var(--line)]/50">
            <span>Confidence Interval:</span>
            <span>±<%= cand.dig(:uncertainty, :margin_of_error) || 12.0 %>%</span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- PREDICTIVE CASCADING FAILURE SCENARIOS & DAG -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Scenarios (2 cols) -->
    <div class="lg:col-span-2 bg-surface rounded-2xl p-5 border border-[var(--line)] shadow-sm space-y-4">
      <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] pb-3">
        <div>
          <h2 class="text-base sm:text-lg font-black text-ink tracking-tight font-hand">Predictive Failure Scenarios</h2>
          <p class="text-[11px] text-mute">Simulated graph consequence scenarios and isolated population impact</p>
        </div>
        <span class="text-xs font-mono text-mute px-2 py-0.5 rounded bg-ink/5 border border-[var(--line)]">
          <%= @analysis[:scenarios]&.size || 0 %> Scenarios Modeled
        </span>
      </div>

      <div class="space-y-3">
        <% (@analysis[:scenarios] || []).first(4).each do |scen| %>
          <div class="bg-paper/70 dark:bg-ink/10 rounded-xl p-4 border border-[var(--line)] space-y-2.5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-black text-xs sm:text-sm text-ink"><%= scen[:name] %></span>
                  <span class="px-2 py-0.5 rounded text-[9px] font-mono font-black uppercase <%= scen[:impact_level] == 'CATASTROPHIC' ? 'bg-red-500/15 text-red-600 dark:text-red-400 border border-red-500/30' : (scen[:impact_level] == 'CRITICAL' ? 'bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30' : 'bg-blue-500/15 text-blue-600 dark:text-blue-400 border border-blue-500/30') %>">
                    <%= scen[:impact_level] %>
                  </span>
                </div>
                <div class="text-[11px] text-mute mt-0.5">
                  Type: <%= scen[:type] %> • Urgency: <%= scen[:urgency_window] || '< 12h' %>
                </div>
              </div>

              <!-- Metric Pills -->
              <div class="flex items-center gap-2">
                <div class="text-right">
                  <div class="text-[10px] font-mono text-mute">Fail Prob</div>
                  <div class="text-xs font-mono font-black text-red-500"><%= scen[:failure_probability] %>%</div>
                </div>
                <div class="text-right pl-2 border-l border-[var(--line)]">
                  <div class="text-[10px] font-mono text-mute">Cascade Score</div>
                  <div class="text-xs font-mono font-black text-accent"><%= scen[:cascade_score] %>/100</div>
                </div>
              </div>
            </div>

            <!-- Narrative / Consequence -->
            <p class="text-xs text-ink/90 leading-relaxed bg-surface/60 rounded-lg p-2.5 border border-[var(--line)]/50">
              <%= scen[:consequence_summary] %>
            </p>

            <!-- Isolated settlements tag cloud -->
            <% if scen[:isolated_settlements].present? %>
              <div class="flex items-center gap-1.5 flex-wrap pt-1">
                <span class="text-[10px] font-mono text-mute font-bold">Cutoff Nodes:</span>
                <% scen[:isolated_settlements].first(4).each do |settle| %>
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-ink/5 border border-[var(--line)] text-ink">
                    <%= settle[:name] %>
                  </span>
                <% end %>
                <% if scen[:isolated_settlements].size > 4 %>
                  <span class="text-[10px] font-mono text-mute">+<%= scen[:isolated_settlements].size - 4 %> more</span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- FAILURE DEPENDENCY GRAPH / DAG (1 col) -->
    <div class="bg-surface rounded-2xl p-5 border border-[var(--line)] shadow-sm space-y-4">
      <div class="border-b border-[var(--line)] pb-3">
        <h2 class="text-base sm:text-lg font-black text-ink tracking-tight font-hand">Dependency Tree (DAG)</h2>
        <p class="text-[11px] text-mute">Root corridor failure propagation directed acyclic graph</p>
      </div>

      <% dag = @analysis[:failure_dependency_graph] || {} %>
      <div class="space-y-3">
        <!-- Root node -->
        <div class="p-3 rounded-xl bg-red-500/10 border border-red-500/20">
          <div class="text-[10px] font-mono font-black uppercase text-red-600 dark:text-red-400">Root Vulnerability</div>
          <div class="text-xs font-black text-ink mt-0.5"><%= dag.dig(:root_road, :road_number) || 'Primary Corridor' %></div>
          <div class="text-[11px] text-mute truncate"><%= dag.dig(:root_road, :road_name) %></div>
        </div>

        <div class="flex justify-center text-mute text-xs">
          <i class="fas fa-arrow-down"></i>
        </div>

        <!-- Direct Children -->
        <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20">
          <div class="text-[10px] font-mono font-black uppercase text-amber-600 dark:text-amber-400">Direct Secondary Shifts</div>
          <% children = dag[:direct_children] || [] %>
          <% if children.any? %>
            <div class="mt-1 space-y-1">
              <% children.each do |ch| %>
                <div class="text-xs font-bold text-ink flex items-center justify-between">
                  <span><%= ch[:road_number] %></span>
                  <span class="text-[10px] font-mono text-mute">+<%= ch[:traffic_shift_pct] || 45 %>% Load</span>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-xs text-mute italic mt-1">Single isolated corridor</div>
          <% end %>
        </div>

        <div class="flex justify-center text-mute text-xs">
          <i class="fas fa-arrow-down"></i>
        </div>

        <!-- Macro Impact -->
        <div class="p-3 rounded-xl bg-surface border border-[var(--line)]">
          <div class="text-[10px] font-mono font-black uppercase text-mute">Terminal Consequence</div>
          <div class="text-xs font-bold text-ink mt-0.5">
            <%= dag.dig(:terminal_impact, :description) || 'District Supply Disruption' %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- COUNTERFACTUAL INTERVENTION ENGINE & WATCHLIST -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Counterfactual Actions (2 cols) -->
    <div class="lg:col-span-2 bg-surface rounded-2xl p-5 border border-[var(--line)] shadow-sm space-y-4">
      <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] pb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs">
            <i class="fas fa-shield-halved"></i>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-black text-ink tracking-tight font-hand">Counterfactual Decision Engine</h2>
            <p class="text-[11px] text-mute">Proactive intervention modeling and simulated risk reduction</p>
          </div>
        </div>
        <span class="text-xs font-mono text-mute px-2 py-0.5 rounded bg-ink/5 border border-[var(--line)]">
          Preemptive Actions
        </span>
      </div>

      <div class="space-y-3">
        <% (@analysis[:recommendations] || []).each_with_index do |rec, idx| %>
          <div class="bg-paper/70 dark:bg-ink/10 rounded-xl p-4 border border-[var(--line)] space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-black text-xs sm:text-sm text-ink"><%= rec[:title] %></span>
                <!-- Owner Badge -->
                <span class="px-2 py-0.5 rounded text-[9px] font-mono font-black uppercase bg-ink text-paper">
                  <%= rec[:owner_type] || 'OPERATIONS_HQ' %>
                </span>
                <!-- Priority Badge -->
                <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold uppercase <%= rec[:priority] == 'HIGH' ? 'bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20' : 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20' %>">
                  <%= rec[:priority] %> Priority
                </span>
              </div>

              <!-- Timeframe -->
              <span class="text-[10px] font-mono text-mute">
                <i class="far fa-clock mr-1"></i><%= rec[:timeframe] %>
              </span>
            </div>

            <p class="text-xs text-ink/90 leading-relaxed">
              <%= rec[:action] %>
            </p>

            <!-- Counterfactual Simulation Benefit -->
            <% if rec[:counterfactual_simulation].present? %>
              <div class="p-2.5 rounded-lg bg-emerald-500/5 border border-emerald-500/20 text-xs text-emerald-800 dark:text-emerald-300 flex items-center justify-between">
                <span class="flex items-center gap-1.5">
                  <i class="fas fa-check-double text-emerald-500"></i>
                  <span><strong>Intervention Impact:</strong> <%= rec[:counterfactual_simulation] %></span>
                </span>
                <% if rec[:simulated_risk_reduction_pct] %>
                  <span class="font-mono font-bold text-xs">-<%= rec[:simulated_risk_reduction_pct] %>% Risk</span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- WATCHLIST FLOOR (1 col) -->
    <div class="bg-surface rounded-2xl p-5 border border-[var(--line)] shadow-sm space-y-4">
      <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] pb-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xs">
            <i class="fas fa-binoculars"></i>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-black text-ink tracking-tight font-hand">Strategic Watchlist</h2>
            <p class="text-[11px] text-mute">High impact + low confidence floor</p>
          </div>
        </div>
      </div>

      <div class="space-y-3">
        <% watchlist = @analysis[:watchlist] || [] %>
        <% if watchlist.any? %>
          <% watchlist.each do |item| %>
            <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="font-black text-xs text-ink"><%= item[:name] %></span>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-black uppercase bg-amber-500 text-white">
                  Recon Required
                </span>
              </div>
              <p class="text-[11px] text-mute leading-snug">
                <%= item[:reason] %>
              </p>
              <div class="flex items-center justify-between text-[10px] font-mono text-ink pt-1 border-t border-[var(--line)]/50">
                <span>Confidence: <%= item[:prediction_confidence] %>%</span>
                <span class="text-red-500 font-bold">Impact: <%= item[:cascade_score] %>/100</span>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-6 text-xs text-mute italic">
            No unverified high-impact anomalies on watchlist.
          </div>
        <% end %>
      </div>
    </div>
  </div>

</div>
