<div class="space-y-6 max-w-6xl mx-auto pb-12">
  <!-- Header -->
  <div class="pb-3 border-b border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <div class="flex items-center space-x-2.5">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-purple-100 dark:bg-purple-950 text-purple-800 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
          Admin Command
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">User Administration</h2>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Manage platform credentials, role-based permissions, and operator provisioning.</p>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5">
      <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Total Registered Users</span>
      <span class="text-3xl font-black text-slate-900 dark:text-white mt-1 block"><%= @users.size %></span>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border-l-4 border-purple-600 border-t border-r border-b border-slate-200 dark:border-slate-800 p-5">
      <span class="text-xs font-bold text-purple-600 dark:text-purple-400 uppercase tracking-wider block">Administrators</span>
      <span class="text-3xl font-black text-slate-900 dark:text-white mt-1 block"><%= @admin_count %></span>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border-l-4 border-accent/20 border-t border-r border-b border-slate-200 dark:border-slate-800 p-5">
      <span class="text-xs font-bold text-accent dark:text-accent uppercase tracking-wider block">Field Operators</span>
      <span class="text-3xl font-black text-slate-900 dark:text-white mt-1 block"><%= @operator_count %></span>
    </div>
  </div>

  <!-- Users Table -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-900/60">
      <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
        <i class="fas fa-users-cog text-purple-600 dark:text-purple-400 mr-2"></i>
        Platform Operator Directory
      </h3>
      <span class="text-[11px] text-slate-400 font-mono">Security Scoped</span>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
        <thead class="bg-slate-50 dark:bg-slate-800/60 font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider text-[10px]">
          <tr>
            <th scope="col" class="px-5 py-3">Operator</th>
            <th scope="col" class="px-5 py-3">Email Address</th>
            <th scope="col" class="px-5 py-3">Role</th>
            <th scope="col" class="px-5 py-3">Auth Provider</th>
            <th scope="col" class="px-5 py-3">Joined Date</th>
            <th scope="col" class="px-5 py-3 text-right">Role Management</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-300">
          <% @users.each do |user| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="px-5 py-3.5 flex items-center space-x-3">
                <div class="w-8 h-8 rounded-lg bg-accent text-white font-bold flex items-center justify-center text-xs overflow-hidden flex-shrink-0">
                  <% if user.avatar_url.present? %>
                    <img src="<%= user.avatar_url %>" alt="" class="w-full h-full object-cover">
                  <% else %>
                    <span><%= user.initials %></span>
                  <% end %>
                </div>
                <span class="font-bold text-slate-900 dark:text-white"><%= user.name %></span>
              </td>
              <td class="px-5 py-3.5 font-mono text-slate-500 dark:text-slate-400"><%= user.email_address %></td>
              <td class="px-5 py-3.5">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase border <%= user.role_badge_class %>">
                  <%= user.role %>
                </span>
              </td>
              <td class="px-5 py-3.5">
                <span class="inline-flex items-center text-slate-800 dark:text-slate-200">
                  <i class="<%= user.provider_icon %> mr-1.5 text-sm"></i>
                  <%= user.provider_label %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-slate-500 dark:text-slate-400"><%= user.created_at.strftime("%b %d, %Y") %></td>
              <td class="px-5 py-3.5 text-right">
                <% if user.operator? %>
                  <%= button_to update_role_admin_user_path(user, role: :admin), method: :patch, class: "inline-flex items-center px-3 py-1.5 bg-purple-50 dark:bg-purple-950/80 hover:bg-purple-100 dark:hover:bg-purple-900 text-purple-800 dark:text-purple-300 font-bold text-xs rounded-xl border border-purple-200 dark:border-purple-800 cursor-pointer transition-colors" do %>
                    <i class="fas fa-user-shield mr-1.5 text-xs"></i>
                    <span>Promote to Admin</span>
                  <% end %>
                <% else %>
                  <%= button_to update_role_admin_user_path(user, role: :operator), method: :patch, class: "inline-flex items-center px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold text-xs rounded-xl border border-slate-300 dark:border-slate-700 cursor-pointer transition-colors" do %>
                    <i class="fas fa-user mr-1.5 text-xs"></i>
                    <span>Demote to Operator</span>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  </div>
</div>
