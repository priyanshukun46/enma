<div class="space-y-6">
  
  <div class="text-center space-y-1.5">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-accent text-white shadow-sm mb-1">
      <span class="text-xl font-black">🔐</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">Reset Password</h2>
    <p class="text-xs text-mute font-medium">ENMA AI Security &amp; Credentials Recovery</p>
  </div>

  <div class="sketch-border bg-surface rounded-2xl p-6 sm:p-8 space-y-5 shadow-sm">
    <div class="space-y-1">
      <h3 class="text-xl font-black text-ink tracking-tight">Recover your account</h3>
      <p class="text-xs text-sketch">Enter your registered email address to receive reset instructions.</p>
    </div>

    <%= form_with url: passwords_path, local: true, class: "space-y-4" do |f| %>
      <div>
        <label for="email_address" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">Email Address</label>
        <%= f.email_field :email_address,
                          id: "email_address",
                          required: true,
                          autofocus: true,
                          placeholder: "your.email@enma.ai",
                          class: "w-full px-4 py-2.5 bg-paper text-ink border border-[var(--line)] rounded-xl focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute" %>
      </div>

      <div class="pt-1">
        <button type="submit"
                class="w-full py-3 px-4 bg-ink hover:bg-ink/90 text-paper font-black text-xs sm:text-sm rounded-xl shadow-sm transition-all cursor-pointer flex items-center justify-center space-x-2">
          <span>Generate Reset Instructions</span>
          <i class="fas fa-arrow-right text-xs"></i>
        </button>
      </div>
    <% end %>

    <div class="text-center pt-3 border-t border-[var(--line)]">
      <%= link_to "Back to Sign In", login_path, class: "text-xs font-black text-accent hover:underline" %>
    </div>
  </div>
</div>
