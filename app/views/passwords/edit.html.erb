<div class="space-y-6">
  
  <div class="text-center space-y-1.5">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-none bg-accent text-white mb-1">
      <span class="text-xl font-black">🔐</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">Set New Password</h2>
    <p class="text-xs text-mute font-medium">ResQWay Security Recovery</p>
  </div>

  <div class="bg-white rounded-none p-6 sm:p-8 space-y-5 shadow-none border-none">
    <div class="space-y-1">
      <h3 class="text-xl font-black text-ink tracking-tight">Create your new password</h3>
      <p class="text-xs text-sketch">Enter a new secure password for <strong><%= @user.email_address %></strong>.</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :patch, local: true, class: "space-y-4" do |f| %>
      <div>
        <label for="password" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">New Password (Min 8 Characters)</label>
        <input type="password"
               name="password"
               id="password"
               required
               autofocus
               placeholder="••••••••"
               class="w-full px-4 py-2.5 bg-slate-50 text-ink border border-slate-200 rounded-none focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute">
      </div>

      <div>
        <label for="password_confirmation" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">Confirm New Password</label>
        <input type="password"
               name="password_confirmation"
               id="password_confirmation"
               required
               placeholder="••••••••"
               class="w-full px-4 py-2.5 bg-slate-50 text-ink border border-slate-200 rounded-none focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute">
      </div>

      <div class="pt-1">
        <button type="submit"
                class="w-full py-3 px-4 bg-ink hover:bg-ink/90 text-white font-black text-xs sm:text-sm rounded-none transition-all cursor-pointer flex items-center justify-center space-x-2">
          <span>Update Password &amp; Sign In</span>
          <i class="fas fa-arrow-right text-xs"></i>
        </button>
      </div>
    <% end %>

    <div class="text-center pt-3 border-t border-[var(--line)]">
      <%= link_to "Cancel and Return to Sign In", login_path, class: "text-xs font-black text-accent hover:underline" %>
    </div>
  </div>
</div>
