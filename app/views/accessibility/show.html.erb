<div class="space-y-6 max-w-7xl mx-auto">
  <!-- Navigation Breadcrumb -->
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-2 text-sm text-gray-500">
      <%= link_to accessibility_path, class: "text-indigo-600 hover:text-indigo-800 font-medium flex items-center" do %>
        <i class="fas fa-arrow-left mr-1.5 text-xs"></i>
        <span>Back to Intelligence Ranking</span>
      <% end %>
      <span>/</span>
      <span class="text-gray-900 font-semibold"><%= @location.name %> Analysis</span>
    </div>

    <div>
      <%= link_to map_path, class: "inline-flex items-center px-3.5 py-1.5 rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 text-xs font-semibold shadow-sm transition-colors" do %>
        <i class="fas fa-map-marked-alt mr-1.5 text-blue-600"></i>
        <span>View on Interactive Map</span>
      <% end %>
    </div>
  </div>

  <!-- Location Header Banner -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center space-x-3">
          <h1 class="text-3xl font-black text-gray-900"><%= @location.name %></h1>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-gray-100 text-gray-700">
            <%= @location.location_type %>
          </span>
        </div>
        <p class="text-sm text-gray-600 mt-1 flex items-center space-x-2">
          <span><i class="fas fa-map-pin text-gray-400 mr-1"></i> <%= @location.district %>, <%= @location.state %></span>
          <span>•</span>
          <span><i class="fas fa-users text-gray-400 mr-1"></i> Population: <%= number_with_delimiter(@location.population) %></span>
          <span>•</span>
          <span class="font-mono text-xs text-gray-500">GPS: <%= @location.latitude.round(4) %>°N, <%= @location.longitude.round(4) %>°E</span>
        </p>
      </div>

      <!-- Quick Status Badge -->
      <div>
        <%
          score = @analysis[:score]
          if score < 40.0
            badge_styles = "bg-red-100 text-red-800 border-red-300"
            banner_icon = "fa-radiation-alt"
          elsif score < 60.0
            badge_styles = "bg-orange-100 text-orange-800 border-orange-300"
            banner_icon = "fa-exclamation-triangle"
          elsif score < 80.0
            badge_styles = "bg-yellow-100 text-yellow-800 border-yellow-300"
            banner_icon = "fa-shield-alt"
          else
            badge_styles = "bg-green-100 text-green-800 border-green-300"
            banner_icon = "fa-check-circle"
          end
        %>
        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider border <%= badge_styles %>">
          <i class="fas <%= banner_icon %> mr-1.5"></i>
          <%= @analysis[:category] %>
        </span>
      </div>
    </div>
  </div>

  <!-- Big Score & Summary Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Score Intelligence Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between">
      <div>
        <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Overall Accessibility Score</p>
        <div class="mt-4 flex items-baseline space-x-2">
          <%
            if score < 40.0
              score_color = "text-red-600"
              progress_color = "bg-red-600"
            elsif score < 60.0
              score_color = "text-orange-600"
              progress_color = "bg-orange-500"
            elsif score < 80.0
              score_color = "text-yellow-600"
              progress_color = "bg-yellow-500"
            else
              score_color = "text-green-600"
              progress_color = "bg-green-600"
            end
          %>
          <span class="text-5xl font-black tracking-tight <%= score_color %>"><%= @analysis[:score] %></span>
          <span class="text-xl font-bold text-gray-400">/ 100</span>
        </div>

        <div class="mt-4">
          <div class="flex justify-between text-xs font-medium text-gray-500 mb-1.5">
            <span>Accessibility Index</span>
            <span class="font-bold text-gray-800"><%= @analysis[:category] %></span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-3 overflow-hidden p-0.5 border border-gray-200">
            <div class="<%= progress_color %> h-2 rounded-full transition-all duration-500" style="width: <%= [score, 100].min %>%"></div>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-gray-100">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Primary Risk Driver</p>
        <p class="text-sm font-bold text-gray-900 mt-1 flex items-center">
          <i class="fas fa-exclamation-circle text-red-500 mr-2"></i>
          <%= @analysis[:primary_risk_factor] %>
        </p>
      </div>
    </div>

    <!-- Algorithm Explainability Summary -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 lg:col-span-2 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between border-b border-gray-100 pb-3">
          <h3 class="text-base font-bold text-gray-900 flex items-center">
            <i class="fas fa-calculator text-indigo-600 mr-2"></i>
            Explainable Intelligence Engine Breakdown
          </h3>
          <span class="text-xs text-gray-500 font-medium">Base Score: 100 pts</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 text-xs">
          <div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
            <span class="text-gray-500 block font-medium">Total Risk Factor Penalty</span>
            <span class="text-base font-extrabold text-red-600 mt-0.5 block">
              -<%= (100.0 - @analysis[:score]).round(1) %> points
            </span>
            <p class="text-[11px] text-gray-500 mt-1">Aggregated deductions across 6 terrain &amp; logistics parameters.</p>
          </div>

          <div class="p-3 bg-gray-50 rounded-lg border border-gray-100">
            <span class="text-gray-500 block font-medium">Logistics Reachability</span>
            <span class="text-base font-extrabold text-gray-900 mt-0.5 block">
              <% if score >= 80.0 %>
                Full Capacity / Standard Lead-time
              <% elsif score >= 60.0 %>
                Moderate Transit Buffers Required
              <% elsif score >= 40.0 %>
                Significant Supply Lead-Time Delays
              <% else %>
                High Risk of Complete Isolation
              <% end %>
            </span>
            <p class="text-[11px] text-gray-500 mt-1">Directly impacts emergency supply chain throughput.</p>
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
        <span>Scoring formula: <code class="bg-gray-100 px-1.5 py-0.5 rounded font-mono text-indigo-700">max(0, 100 - Σ(Factor Penalties))</code></span>
        <span class="font-semibold text-gray-700">SIH 2026 Transparent Intelligence</span>
      </div>
    </div>
  </div>

  <!-- Factors Affecting Access Breakdown Grid -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="border-b border-gray-200 pb-4 mb-5">
      <h3 class="text-lg font-bold text-gray-900 flex items-center">
        <i class="fas fa-layer-group text-indigo-600 mr-2"></i>
        Factors Affecting Accessibility
      </h3>
      <p class="text-xs text-gray-500 mt-0.5">Granular multi-criteria risk assessment for disaster management authorities.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @analysis[:factors].each do |_factor_key, factor| %>
        <%
          impact_penalty = factor[:impact]
          if impact_penalty == 0
            impact_badge = "bg-green-100 text-green-800 border-green-200"
            penalty_color = "text-green-600"
          elsif impact_penalty.abs <= 10
            impact_badge = "bg-yellow-100 text-yellow-800 border-yellow-200"
            penalty_color = "text-yellow-600"
          elsif impact_penalty.abs <= 25
            impact_badge = "bg-orange-100 text-orange-800 border-orange-200"
            penalty_color = "text-orange-600"
          else
            impact_badge = "bg-red-100 text-red-800 border-red-200"
            penalty_color = "text-red-600"
          end
        %>
        <div class="p-4 rounded-xl border border-gray-200 bg-gray-50/50 hover:bg-white hover:border-indigo-200 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-gray-500 uppercase tracking-wider"><%= factor[:title] %></span>
              <span class="px-2 py-0.5 text-[11px] font-bold rounded-full border <%= impact_badge %>">
                <%= factor[:impact_level] %>
              </span>
            </div>

            <div class="mt-3 flex items-baseline justify-between">
              <div class="text-xl font-black text-gray-900"><%= factor[:value] %></div>
              <div class="text-sm font-extrabold font-mono <%= penalty_color %>">
                <%= impact_penalty.zero? ? "0 pts" : "#{impact_penalty} pts" %>
              </div>
            </div>

            <p class="text-xs text-gray-600 mt-2.5 leading-relaxed">
              <%= factor[:description] %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Recommended Actions Section -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="border-b border-gray-200 pb-4 mb-5 flex items-center justify-between">
      <div>
        <h3 class="text-lg font-bold text-gray-900 flex items-center">
          <i class="fas fa-clipboard-check text-indigo-600 mr-2"></i>
          Actionable Logistics &amp; Emergency Recommendations
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Targeted civil administration and disaster mitigation protocols generated by the Intelligence Engine.</p>
      </div>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
        <%= @recommendations.size %> Directives Generated
      </span>
    </div>

    <div class="space-y-3">
      <% @recommendations.each_with_index do |rec, index| %>
        <div class="p-4 rounded-xl border border-gray-200 bg-gray-50 hover:bg-white hover:shadow-sm transition-all flex items-start space-x-4">
          <div class="flex-shrink-0 mt-0.5">
            <span class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-800 text-xs font-bold flex items-center justify-center">
              <%= index + 1 %>
            </span>
          </div>

          <div class="flex-1">
            <div class="flex items-center space-x-2.5">
              <h4 class="text-sm font-bold text-gray-900"><%= rec[:action] %></h4>
              <span class="px-2 py-0.5 text-[10px] font-bold rounded-full border <%= rec[:badge_class] %> uppercase tracking-wider">
                <%= rec[:priority] %> Priority
              </span>
            </div>
            <p class="text-xs text-gray-600 mt-1 leading-relaxed"><%= rec[:detail] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
