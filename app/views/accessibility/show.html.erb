<div class="space-y-6 max-w-7xl mx-auto pb-12">
  <!-- Navigation Breadcrumb -->
  <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400">
      <%= link_to accessibility_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline font-bold flex items-center" do %>
        <i class="fas fa-arrow-left mr-1.5 text-xs"></i>
        <span>Back to Intelligence Ranking</span>
      <% end %>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-black"><%= @location.name %> Analysis</span>
    </div>

    <div>
      <%= link_to map_path, class: "inline-flex items-center px-3.5 py-1.5 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 text-xs font-bold shadow-sm transition-colors" do %>
        <i class="fas fa-map-marked-alt mr-1.5 text-indigo-600 dark:text-indigo-400"></i>
        <span>View on Map</span>
      <% end %>
    </div>
  </div>

  <!-- Location Header Banner -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center space-x-3">
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight"><%= @location.name %></h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            <%= @location.location_type %>
          </span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex flex-wrap items-center gap-2">
          <span class="flex items-center"><i class="fas fa-map-pin text-slate-400 mr-1.5"></i> <%= @location.district %>, <%= @location.state %></span>
          <span>&bull;</span>
          <span class="flex items-center"><i class="fas fa-users text-slate-400 mr-1.5"></i> Population: <%= number_with_delimiter(@location.population) %></span>
          <span>&bull;</span>
          <span class="font-mono text-xs text-slate-500 dark:text-slate-400">GPS: <%= @location.latitude.round(4) %>°N, <%= @location.longitude.round(4) %>°E</span>
        </p>
      </div>

      <!-- Quick Status Badge -->
      <div>
        <%
          score = @analysis[:score]
          if score < 40.0
            badge_styles = "bg-red-100 dark:bg-red-950/80 text-red-800 dark:text-red-300 border-red-300 dark:border-red-800"
            banner_icon = "fa-biohazard text-red-600 dark:text-red-400"
          elsif score < 60.0
            badge_styles = "bg-orange-100 dark:bg-orange-950/80 text-orange-800 dark:text-orange-300 border-orange-300 dark:border-orange-800"
            banner_icon = "fa-exclamation-triangle text-orange-600 dark:text-orange-400"
          elsif score < 80.0
            badge_styles = "bg-yellow-100 dark:bg-yellow-950/80 text-yellow-800 dark:text-yellow-300 border-yellow-300 dark:border-yellow-800"
            banner_icon = "fa-shield-alt text-yellow-600 dark:text-yellow-400"
          else
            badge_styles = "bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800"
            banner_icon = "fa-check-circle text-emerald-600 dark:text-emerald-400"
          end
        %>
        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider border <%= badge_styles %>">
          <i class="fas <%= banner_icon %> mr-1.5"></i>
          <%= @analysis[:category] %>
        </span>
      </div>
    </div>
  </div>

  <!-- Big Score & Summary Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Score Intelligence Card -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 flex flex-col justify-between space-y-4">
      <div>
        <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Overall Accessibility Score</p>
        <div class="mt-3 flex items-baseline space-x-2">
          <%
            if score < 40.0
              score_color = "text-red-600 dark:text-red-400"
              progress_color = "bg-red-600"
            elsif score < 60.0
              score_color = "text-orange-600 dark:text-orange-400"
              progress_color = "bg-orange-500"
            elsif score < 80.0
              score_color = "text-yellow-600 dark:text-yellow-400"
              progress_color = "bg-yellow-500"
            else
              score_color = "text-emerald-600 dark:text-emerald-400"
              progress_color = "bg-emerald-500"
            end
          %>
          <span class="text-5xl font-black tracking-tight <%= score_color %>"><%= @analysis[:score] %></span>
          <span class="text-xl font-bold text-slate-400">/ 100</span>
        </div>

        <div class="mt-4">
          <div class="flex justify-between text-xs font-medium text-slate-500 dark:text-slate-400 mb-1.5">
            <span>Accessibility Index</span>
            <span class="font-bold text-slate-800 dark:text-slate-200"><%= @analysis[:category] %></span>
          </div>
          <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-3 overflow-hidden p-0.5 border border-slate-200 dark:border-slate-700">
            <div class="<%= progress_color %> h-2 rounded-full transition-all duration-500" style="width: <%= [score, 100].min %>%"></div>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
        <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Primary Risk Driver</p>
        <p class="text-sm font-black text-slate-900 dark:text-white mt-1 flex items-center">
          <i class="fas fa-exclamation-circle text-red-500 mr-2"></i>
          <%= @analysis[:primary_risk_factor] %>
        </p>
      </div>
    </div>

    <!-- Algorithm Explainability Summary -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 lg:col-span-2 flex flex-col justify-between space-y-4">
      <div>
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
          <h3 class="text-sm font-black text-slate-900 dark:text-white flex items-center">
            <i class="fas fa-calculator text-indigo-600 dark:text-indigo-400 mr-2"></i>
            Explainable Intelligence Engine Breakdown
          </h3>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">Base: 100 pts</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 text-xs">
          <div class="p-3.5 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-700/60">
            <span class="text-slate-500 dark:text-slate-400 block font-bold">Total Risk Factor Penalty</span>
            <span class="text-lg font-black text-red-600 dark:text-red-400 mt-0.5 block">
              -<%= (100.0 - @analysis[:score]).round(1) %> points
            </span>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Aggregated deductions across 6 terrain &amp; logistics parameters.</p>
          </div>

          <div class="p-3.5 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-100 dark:border-slate-700/60">
            <span class="text-slate-500 dark:text-slate-400 block font-bold">Logistics Reachability</span>
            <span class="text-lg font-black text-slate-900 dark:text-white mt-0.5 block">
              <% if score >= 80.0 %>
                Full Capacity / Nominal Lead-time
              <% elsif score >= 60.0 %>
                Moderate Transit Buffers Required
              <% elsif score >= 40.0 %>
                Significant Supply Lead-Time Delays
              <% else %>
                High Risk of Complete Isolation
              <% end %>
            </span>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Directly impacts emergency supply chain throughput.</p>
          </div>
        </div>
      </div>

      <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
        <span>Formula: <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono text-indigo-600 dark:text-indigo-400">max(0, 100 - &Sigma;(Penalties))</code></span>
        <span class="font-bold text-slate-700 dark:text-slate-300">SIH 2026 Transparent Intelligence</span>
      </div>
    </div>
  </div>

  <!-- Factors Affecting Access Breakdown Grid -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 space-y-5">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3">
      <h3 class="text-base font-black text-slate-900 dark:text-white flex items-center">
        <i class="fas fa-layer-group text-indigo-600 dark:text-indigo-400 mr-2"></i>
        Factors Affecting Accessibility
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Granular multi-criteria risk assessment for disaster management authorities.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @analysis[:factors].each do |_factor_key, factor| %>
        <%
          impact_penalty = factor[:impact]
          if impact_penalty == 0
            impact_badge = "bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800"
            penalty_color = "text-emerald-600 dark:text-emerald-400"
          elsif impact_penalty.abs <= 10
            impact_badge = "bg-yellow-100 dark:bg-yellow-950 text-yellow-800 dark:text-yellow-300 border-yellow-200 dark:border-yellow-800"
            penalty_color = "text-yellow-600 dark:text-yellow-400"
          elsif impact_penalty.abs <= 25
            impact_badge = "bg-orange-100 dark:bg-orange-950 text-orange-800 dark:text-orange-300 border-orange-200 dark:border-orange-800"
            penalty_color = "text-orange-600 dark:text-orange-400"
          else
            impact_badge = "bg-red-100 dark:bg-red-950 text-red-800 dark:text-red-300 border-red-200 dark:border-red-800"
            penalty_color = "text-red-600 dark:text-red-400"
          end
        %>
        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 hover:border-indigo-200 dark:hover:border-indigo-800 transition-all flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider"><%= factor[:title] %></span>
              <div class="flex items-center space-x-1.5">
                <% if factor[:weather].present? %>
                  <% if factor[:weather][:source] == "live" %>
                    <span class="px-2 py-0.5 text-[9px] font-black rounded-full uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 flex items-center">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping mr-1"></span>
                      Live Weather
                    </span>
                  <% else %>
                    <span class="px-2 py-0.5 text-[9px] font-bold rounded-full uppercase tracking-wider bg-slate-200/80 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                      Demo Environmental Data
                    </span>
                  <% end %>
                <% end %>
                <span class="px-2 py-0.5 text-[10px] font-black rounded-full border <%= impact_badge %>">
                  <%= factor[:impact_level] %>
                </span>
              </div>
            </div>

            <div class="mt-2 flex items-baseline justify-between">
              <div class="text-lg font-black text-slate-900 dark:text-white"><%= factor[:value] %></div>
              <div class="text-xs font-black font-mono <%= penalty_color %>">
                <%= impact_penalty.zero? ? "0 pts" : "#{impact_penalty} pts" %>
              </div>
            </div>

            <% if factor[:weather].present? && factor[:weather][:source] == "live" %>
              <div class="grid grid-cols-3 gap-2 mt-2 pt-2 border-t border-slate-200 dark:border-slate-700/60 text-[11px] font-mono text-slate-600 dark:text-slate-300">
                <div>
                  <span class="text-[9px] text-slate-400 block uppercase font-bold">Temp</span>
                  <strong><%= factor[:weather][:temperature]&.round(1) %>°C</strong>
                </div>
                <div>
                  <span class="text-[9px] text-slate-400 block uppercase font-bold">Wind</span>
                  <strong><%= factor[:weather][:wind_speed]&.round(1) %> km/h</strong>
                </div>
                <div>
                  <span class="text-[9px] text-slate-400 block uppercase font-bold">Rainfall</span>
                  <strong class="text-indigo-600 dark:text-indigo-400"><%= factor[:weather][:precipitation]&.round(1) %> mm</strong>
                </div>
              </div>
            <% end %>

            <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
              <%= factor[:description] %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Recommended Actions Section -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 space-y-4">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
      <div>
        <h3 class="text-base font-black text-slate-900 dark:text-white flex items-center">
          <i class="fas fa-clipboard-check text-indigo-600 dark:text-indigo-400 mr-2"></i>
          Actionable Logistics &amp; Emergency Recommendations
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Targeted civil administration and disaster mitigation protocols generated by the Intelligence Engine.</p>
      </div>
      <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
        <%= @recommendations.size %> Directives Generated
      </span>
    </div>

    <div class="space-y-3">
      <% @recommendations.each_with_index do |rec, index| %>
        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 hover:border-slate-300 transition-all flex items-start space-x-3.5">
          <div class="flex-shrink-0 mt-0.5">
            <span class="w-6 h-6 rounded-full bg-indigo-100 dark:bg-indigo-950 text-indigo-800 dark:text-indigo-300 text-xs font-bold flex items-center justify-center">
              <%= index + 1 %>
            </span>
          </div>

          <div class="flex-1">
            <div class="flex items-center space-x-2.5">
              <h4 class="text-sm font-bold text-slate-900 dark:text-white"><%= rec[:action] %></h4>
              <span class="px-2 py-0.5 text-[10px] font-bold rounded-full border <%= rec[:badge_class] %> uppercase tracking-wider">
                <%= rec[:priority] %> Priority
              </span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 leading-relaxed"><%= rec[:detail] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
