<div class="space-y-6">
  <!-- Top Header with Title and Recalculate Action -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between pb-2 border-b border-gray-200 gap-4">
    <div>
      <div class="flex items-center space-x-3">
        <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Accessibility Intelligence</h2>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800">
          Engine v4.0 Active
        </span>
      </div>
      <p class="text-sm text-gray-600 mt-1">Identify communities with limited access to critical infrastructure and logistics networks.</p>
    </div>

    <div>
      <%= button_to recalculate_accessibility_path, method: :post, class: "inline-flex items-center px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-all duration-150 cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
        <i class="fas fa-sync-alt mr-2 text-xs"></i>
        <span>Recalculate Intelligence Scores</span>
      <% end %>
    </div>
  </div>

  <!-- Summary Cards Section -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <!-- Critical Zones (Score < 40) -->
    <div class="bg-white rounded-xl shadow-sm border-l-4 border-red-500 border-t border-r border-b border-gray-200 p-5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-red-600 uppercase tracking-wider">Critical Accessibility</p>
          <p class="text-2xl font-black text-gray-900 mt-1"><%= @critical_zones_count %></p>
          <p class="text-xs text-gray-500 mt-0.5">Score Range: 0 - 39</p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center text-red-600 text-xl shadow-inner">
          <i class="fas fa-biohazard"></i>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-gray-100 flex items-center text-xs font-medium text-red-600">
        <i class="fas fa-exclamation-triangle mr-1.5"></i>
        <span>Requires immediate pre-positioning</span>
      </div>
    </div>

    <!-- Difficult Access (Score 40-59) -->
    <div class="bg-white rounded-xl shadow-sm border-l-4 border-orange-500 border-t border-r border-b border-gray-200 p-5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-orange-600 uppercase tracking-wider">Difficult Access</p>
          <p class="text-2xl font-black text-gray-900 mt-1"><%= @difficult_access_count %></p>
          <p class="text-xs text-gray-500 mt-0.5">Score Range: 40 - 59</p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center text-orange-600 text-xl shadow-inner">
          <i class="fas fa-mountain"></i>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-gray-100 flex items-center text-xs font-medium text-orange-600">
        <i class="fas fa-truck-pickup mr-1.5"></i>
        <span>Vulnerable during monsoons</span>
      </div>
    </div>

    <!-- Moderate Access (Score 60-79) -->
    <div class="bg-white rounded-xl shadow-sm border-l-4 border-yellow-500 border-t border-r border-b border-gray-200 p-5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-yellow-600 uppercase tracking-wider">Moderate Access</p>
          <p class="text-2xl font-black text-gray-900 mt-1"><%= @moderate_access_count %></p>
          <p class="text-xs text-gray-500 mt-0.5">Score Range: 60 - 79</p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-yellow-50 flex items-center justify-center text-yellow-600 text-xl shadow-inner">
          <i class="fas fa-shield-alt"></i>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-gray-100 flex items-center text-xs font-medium text-yellow-600">
        <i class="fas fa-check-circle mr-1.5"></i>
        <span>Periodic logistics maintenance</span>
      </div>
    </div>

    <!-- Highly Accessible (Score 80-100) -->
    <div class="bg-white rounded-xl shadow-sm border-l-4 border-green-500 border-t border-r border-b border-gray-200 p-5 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-bold text-green-600 uppercase tracking-wider">Highly Accessible</p>
          <p class="text-2xl font-black text-gray-900 mt-1"><%= @highly_accessible_count %></p>
          <p class="text-xs text-gray-500 mt-0.5">Score Range: 80 - 100</p>
        </div>
        <div class="w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center text-green-600 text-xl shadow-inner">
          <i class="fas fa-check-double"></i>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-gray-100 flex items-center text-xs font-medium text-green-600">
        <i class="fas fa-warehouse mr-1.5"></i>
        <span>Primary dispatch staging hubs</span>
      </div>
    </div>
  </div>

  <!-- Priority Risk Ranking Table -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-5 border-b border-gray-200 bg-gray-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h3 class="text-lg font-bold text-gray-900 flex items-center">
          <i class="fas fa-sort-amount-down-alt mr-2 text-indigo-600"></i>
          Regional Accessibility Risk Priority Ranking
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Ranked in order of accessibility vulnerability (lowest scores prioritized first).</p>
      </div>
      <div class="text-xs text-gray-500 font-medium">
        Total Evaluated Communities: <strong class="text-gray-900"><%= @total_locations %></strong>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Rank</th>
            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Location</th>
            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">State / District</th>
            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Population</th>
            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Accessibility Score</th>
            <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Risk Level</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">Action</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @locations.each_with_index do |location, index| %>
            <%
              score = location.accessibility_score.to_f
              if score < 40.0
                rank_badge = "bg-red-600 text-white font-black"
                score_bar_color = "bg-red-500"
                score_text_color = "text-red-700"
                risk_badge = "bg-red-100 text-red-800 border-red-300 font-bold"
                risk_label = "CRITICAL"
              elsif score < 60.0
                rank_badge = "bg-orange-500 text-white font-bold"
                score_bar_color = "bg-orange-500"
                score_text_color = "text-orange-700"
                risk_badge = "bg-orange-100 text-orange-800 border-orange-300 font-semibold"
                risk_label = "DIFFICULT"
              elsif score < 80.0
                rank_badge = "bg-yellow-500 text-white font-semibold"
                score_bar_color = "bg-yellow-500"
                score_text_color = "text-yellow-700"
                risk_badge = "bg-yellow-100 text-yellow-800 border-yellow-300 font-medium"
                risk_label = "MODERATE"
              else
                rank_badge = "bg-green-600 text-white font-semibold"
                score_bar_color = "bg-green-500"
                score_text_color = "text-green-700"
                risk_badge = "bg-green-100 text-green-800 border-green-300 font-medium"
                risk_label = "LOW"
              end
            %>
            <tr class="hover:bg-indigo-50/40 transition-colors">
              <!-- Rank -->
              <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full <%= rank_badge %> text-xs shadow-sm">
                  #<%= index + 1 %>
                </span>
              </td>

              <!-- Location -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-bold text-gray-900"><%= location.name %></div>
                <div class="text-xs text-gray-500"><%= location.location_type %></div>
              </td>

              <!-- State / District -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-800"><%= location.state %></div>
                <div class="text-xs text-gray-500"><%= location.district %></div>
              </td>

              <!-- Population -->
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700">
                <%= number_with_delimiter(location.population) %>
              </td>

              <!-- Score with Mini Progress Bar -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="w-44">
                  <div class="flex justify-between items-center mb-1">
                    <span class="text-sm font-extrabold <%= score_text_color %>"><%= location.accessibility_score %>/100</span>
                    <span class="text-[11px] text-gray-500 font-medium"><%= location.accessibility_category %></span>
                  </div>
                  <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                    <div class="<%= score_bar_color %> h-2 rounded-full transition-all duration-300" style="width: <%= [score, 100].min %>%"></div>
                  </div>
                </div>
              </td>

              <!-- Risk Level Badge -->
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2.5 py-1 inline-flex text-xs leading-4 rounded-full border <%= risk_badge %> uppercase tracking-wider">
                  <%= risk_label %>
                </span>
              </td>

              <!-- Action Link -->
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <%= link_to accessibility_location_path(location), class: "inline-flex items-center px-3 py-1.5 rounded-lg bg-white border border-gray-300 text-indigo-600 hover:bg-indigo-50 hover:border-indigo-300 font-semibold text-xs transition-all shadow-sm" do %>
                  <span>View Analysis</span>
                  <i class="fas fa-chevron-right ml-1.5 text-[10px]"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
