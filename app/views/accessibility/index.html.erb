<div class="space-y-6 max-w-7xl mx-auto pb-12">
  
  <!-- Page Header (Google Stitch Style - Image 4) -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">Predictive Risk &amp; Accessibility</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Real-time analysis of potential disruptions, environmental risk, and accessibility gaps across North East India.</p>
    </div>

    <div class="flex items-center space-x-2.5">
      <%= form_with url: recalculate_accessibility_path, method: :post, local: true do |f| %>
        <%= f.button class: "inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 shadow-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-all cursor-pointer" do %>
          <i class="fas fa-sync-alt mr-1.5 text-xs text-accent dark:text-accent"></i>
          <span>Recalculate</span>
        <% end %>
      <% end %>

      <%= link_to analytics_report_path, target: "_blank", class: "inline-flex items-center px-4 py-1.5 rounded-full text-xs font-black bg-accent hover:opacity-90 text-white shadow-sm transition-all" do %>
        <i class="fas fa-file-alt mr-1.5 text-xs"></i>
        <span>Generate Report</span>
      <% end %>
    </div>
  </div>

  <!-- Main Dual Grid: Risk Trend Analysis (8 cols) + Accessibility Gaps (4 cols) (Image 4) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- Top Left: Risk Trend Analysis (8 cols) -->
    <div class="lg:col-span-8 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 space-y-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2.5">
          <h3 class="text-sm font-black text-slate-900 dark:text-white tracking-wide">Risk Trend Analysis</h3>
          <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
            Live Data
          </span>
        </div>

        <div class="text-slate-400 dark:text-slate-500">
          <i class="fas fa-ellipsis-v"></i>
        </div>
      </div>

      <!-- Predictive Risk Trend Visualization Canvas (High-Fidelity Telemetry Chart) -->
      <div class="w-full rounded-2xl bg-[#16120E] p-4 sm:p-5 text-[#ECE5D6] border border-[#2D2319] shadow-md relative overflow-hidden space-y-3">
        <div class="flex items-center justify-between text-xs">
          <div class="flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
            <span class="font-black text-slate-200 uppercase tracking-wider text-[11px]">7-Day Geospatial Risk Projection Curve</span>
          </div>
          <div class="flex items-center space-x-3 text-[10px] font-mono text-slate-400">
            <span class="flex items-center"><span class="w-2 h-2 rounded-full bg-rose-500 mr-1.5"></span> Landslide &amp; Flood Vector</span>
            <span class="flex items-center"><span class="w-2.5 h-0.5 bg-amber-400 mr-1.5"></span> Threshold (75)</span>
          </div>
        </div>

        <!-- SVG Vector Curve Graph -->
        <div class="w-full overflow-x-auto">
          <svg viewBox="0 0 700 160" class="w-full h-44 text-xs font-mono" preserveAspectRatio="none">
            <defs>
              <linearGradient id="riskAreaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.45" />
                <stop offset="50%" stop-color="#fb923c" stop-opacity="0.2" />
                <stop offset="100%" stop-color="#6366f1" stop-opacity="0.0" />
              </linearGradient>
              <linearGradient id="riskLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#38bdf8" />
                <stop offset="40%" stop-color="#f59e0b" />
                <stop offset="75%" stop-color="#f43f5e" />
                <stop offset="100%" stop-color="#e11d48" />
              </linearGradient>
            </defs>

            <!-- Background Grid Lines & Y-axis labels -->
            <line x1="40" y1="20" x2="680" y2="20" stroke="#334155" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
            <text x="32" y="24" fill="#64748b" text-anchor="end" font-size="9">100</text>

            <line x1="40" y1="52" x2="680" y2="52" stroke="#f59e0b" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.75" />
            <text x="32" y="56" fill="#f59e0b" text-anchor="end" font-size="9">75</text>
            <text x="675" y="48" fill="#f59e0b" text-anchor="end" font-size="8" font-weight="bold">CRITICAL THRESHOLD</text>

            <line x1="40" y1="84" x2="680" y2="84" stroke="#334155" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
            <text x="32" y="88" fill="#64748b" text-anchor="end" font-size="9">50</text>

            <line x1="40" y1="116" x2="680" y2="116" stroke="#334155" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
            <text x="32" y="120" fill="#64748b" text-anchor="end" font-size="9">25</text>

            <line x1="40" y1="135" x2="680" y2="135" stroke="#475569" stroke-width="1.5" />

            <!-- Risk Area Gradient Fill -->
            <path d="M 50 120 Q 130 112, 210 95 T 350 82 T 470 60 T 560 46 T 660 30 L 660 135 L 50 135 Z" fill="url(#riskAreaGrad)" />

            <!-- Main Risk Trajectory Polyline (Smooth Bezier) -->
            <path d="M 50 120 Q 130 112, 210 95 T 350 82 T 470 60 T 560 46 T 660 30" fill="none" stroke="url(#riskLineGrad)" stroke-width="3.5" stroke-linecap="round" />

            <!-- Data Point Circles & Hover Rings with Dynamic 7-Day Dates -->
            <g>
              <circle cx="50" cy="120" r="3.5" fill="#38bdf8" />
              <text x="50" y="150" fill="#94a3b8" text-anchor="middle" font-size="8.5"><%= (Date.current - 5.days).strftime("%a %d") %></text>

              <circle cx="150" cy="108" r="3.5" fill="#38bdf8" />
              <text x="150" y="150" fill="#94a3b8" text-anchor="middle" font-size="8.5"><%= (Date.current - 4.days).strftime("%a %d") %></text>

              <circle cx="250" cy="91" r="3.5" fill="#facc15" />
              <text x="250" y="150" fill="#94a3b8" text-anchor="middle" font-size="8.5"><%= (Date.current - 3.days).strftime("%a %d") %></text>

              <circle cx="350" cy="82" r="3.5" fill="#f59e0b" />
              <text x="350" y="150" fill="#94a3b8" text-anchor="middle" font-size="8.5"><%= (Date.current - 2.days).strftime("%a %d") %></text>

              <circle cx="450" cy="63" r="4" fill="#fb923c" />
              <text x="450" y="150" fill="#94a3b8" text-anchor="middle" font-size="8.5"><%= (Date.current - 1.day).strftime("%a %d") %></text>

              <!-- Active Live Point (Today - Score 78) -->
              <circle cx="560" cy="46" r="8" fill="#f43f5e" opacity="0.35" />
              <circle cx="560" cy="46" r="4.5" fill="#f43f5e" stroke="#ffffff" stroke-width="1.5" />
              <rect x="528" y="16" width="64" height="18" rx="4" fill="#e11d48" />
              <text x="560" y="28" fill="#ffffff" text-anchor="middle" font-size="9" font-weight="bold">TODAY (78)</text>
              <text x="560" y="150" fill="#f43f5e" font-weight="bold" text-anchor="middle" font-size="9">TODAY</text>

              <!-- Projection Point (+24h) -->
              <circle cx="660" cy="30" r="4" fill="#e11d48" stroke="#ffffff" stroke-width="1" stroke-dasharray="2 2" />
              <text x="660" y="150" fill="#fb7185" text-anchor="middle" font-size="8.5"><%= (Date.current + 1.day).strftime("%a %d") %> (84)</text>
            </g>
          </svg>
        </div>

        <!-- Telemetry Indicators Strip -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-2 border-t border-slate-800/80 text-[11px] font-mono">
          <div class="flex items-center space-x-2 text-slate-300">
            <i class="fas fa-cloud-showers-heavy text-accent"></i>
            <span>Precipitation: <strong class="text-white">86.4 mm</strong> <span class="text-rose-400">(+14%)</span></span>
          </div>
          <div class="flex items-center space-x-2 text-slate-300">
            <i class="fas fa-mountain text-amber-400"></i>
            <span>Slope Saturation: <strong class="text-amber-300">High Risk</strong></span>
          </div>
          <div class="flex items-center space-x-2 text-slate-300">
            <i class="fas fa-wave-square text-accent"></i>
            <span>Soil Pore Pressure: <strong class="text-white">4.8 kPa</strong></span>
          </div>
        </div>
      </div>

      <!-- 3 Metrics Bottom Boxes (Image 4) -->
      <div class="grid grid-cols-3 gap-3">
        
        <!-- Box 1: Overall Risk Score -->
        <div class="p-3.5 rounded-xl bg-accent/10 dark:bg-accent/10 border border-accent/25 dark:border-accent/20">
          <span class="text-[9px] font-black uppercase text-slate-500 dark:text-slate-400 tracking-wider block">Overall Risk Score</span>
          <span class="text-xl font-black text-red-600 dark:text-red-400 mt-1 block">78/100</span>
        </div>

        <!-- Box 2: Impacted Nodes -->
        <div class="p-3.5 rounded-xl bg-accent/10 dark:bg-accent/10 border border-accent/25 dark:border-accent/20">
          <span class="text-[9px] font-black uppercase text-slate-500 dark:text-slate-400 tracking-wider block">Impacted Nodes</span>
          <span class="text-xl font-black text-slate-900 dark:text-white mt-1 block"><%= @critical_zones_count + @difficult_access_count %></span>
        </div>

        <!-- Box 3: Confidence Level -->
        <div class="p-3.5 rounded-xl bg-accent/10 dark:bg-accent/10 border border-accent/25 dark:border-accent/20">
          <span class="text-[9px] font-black uppercase text-slate-500 dark:text-slate-400 tracking-wider block">Confidence Level</span>
          <span class="text-xl font-black text-slate-900 dark:text-white mt-1 block">94%</span>
        </div>

      </div>
    </div>

    <!-- Top Right: Accessibility Gaps Feed (4 cols) (Image 4) -->
    <div class="lg:col-span-4 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 dark:border-slate-800 pb-3">
        <i class="fas fa-exclamation-triangle text-amber-500 text-sm"></i>
        <h3 class="text-sm font-black text-slate-900 dark:text-white">Accessibility Gaps</h3>
      </div>

      <!-- Gap Item 1 (Red) -->
      <div class="flex items-start space-x-3 text-xs">
        <div class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-950/80 text-red-600 dark:text-red-400 flex items-center justify-center flex-shrink-0 mt-0.5">
          <i class="fas fa-ban text-xs"></i>
        </div>
        <div>
          <h4 class="font-black text-slate-900 dark:text-white">Sector 4 Transit Hub (Tawang)</h4>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
            Elevator &amp; heavy axle bridge malfunction reported. Heavy convoy transit restricted for mountain concourse.
          </p>
        </div>
      </div>

      <!-- Gap Item 2 (Yellow) -->
      <div class="flex items-start space-x-3 text-xs">
        <div class="w-8 h-8 rounded-full bg-amber-100 dark:bg-amber-950/80 text-amber-600 dark:text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
          <i class="fas fa-tools text-xs"></i>
        </div>
        <div>
          <h4 class="font-black text-slate-900 dark:text-white">Main Artery Highway Corridor</h4>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
            Unplanned monsoon culvert repair blocking secondary bypass lanes for freight logistics.
          </p>
        </div>
      </div>

      <!-- Gap Item 3 (Blue) -->
      <div class="flex items-start space-x-3 text-xs">
        <div class="w-8 h-8 rounded-full bg-accent/10 dark:bg-accent/10 text-accent dark:text-accent flex items-center justify-center flex-shrink-0 mt-0.5">
          <i class="fas fa-info text-xs"></i>
        </div>
        <div>
          <h4 class="font-black text-slate-900 dark:text-white">Brahmaputra Feeder Walkways</h4>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
            High density water level rise causing temporary access delays on low-lying approaches.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Section: Smart Route Recommendation Pipeline (Image 4) -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 md:p-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-4">
      <div>
        <h3 class="text-base font-black text-slate-900 dark:text-white">Smart Route Recommendation Pipeline</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Automated stage-gate pipeline executing multi-hazard logistics routing.</p>
      </div>

      <%= link_to routes_path, class: "inline-flex items-center px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-700 dark:hover:bg-slate-600 text-white font-black text-xs shadow-sm transition-all" do %>
        <span>Execute Plan &rarr;</span>
      <% end %>
    </div>

    <!-- 3 Pipeline Stages (Image 4) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 py-2">
      
      <!-- Stage 1: Analysis (Complete) -->
      <div class="flex flex-col items-center text-center space-y-2">
        <div class="w-12 h-12 rounded-full bg-slate-900 dark:bg-slate-800 text-white flex items-center justify-center text-base shadow-md">
          <i class="fas fa-check"></i>
        </div>
        <div>
          <span class="font-black text-xs text-slate-900 dark:text-white block">Analysis</span>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Complete</span>
        </div>
      </div>

      <!-- Stage 2: Optimization (In Progress) -->
      <div class="flex flex-col items-center text-center space-y-2">
        <div class="w-12 h-12 rounded-full bg-slate-900 dark:bg-slate-800 text-white flex items-center justify-center text-base shadow-md ring-4 ring-indigo-200 dark:ring-indigo-900">
          <i class="fas fa-project-diagram"></i>
        </div>
        <div>
          <span class="font-black text-xs text-slate-900 dark:text-white block">Optimization</span>
          <span class="text-[11px] text-accent dark:text-accent font-bold">In Progress</span>
        </div>
      </div>

      <!-- Stage 3: Deployment (Pending) -->
      <div class="flex flex-col items-center text-center space-y-2">
        <div class="w-12 h-12 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center text-base">
          <i class="fas fa-paper-plane"></i>
        </div>
        <div>
          <span class="font-black text-xs text-slate-600 dark:text-slate-400 block">Deployment</span>
          <span class="text-[11px] text-slate-400 font-medium">Pending</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Priority Risk Ranking Settlement Table -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-900/60">
      <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider">
        Monitored Settlement Accessibility Registry
      </h3>
      <span class="text-[11px] text-slate-400 font-mono"><%= @locations.size %> Settlements</span>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
        <thead class="bg-slate-50 dark:bg-slate-800/60 font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider text-[10px]">
          <tr>
            <th class="px-5 py-3">Settlement</th>
            <th class="px-5 py-3">State / District</th>
            <th class="px-5 py-3">Accessibility Score</th>
            <th class="px-5 py-3">Tier Category</th>
            <th class="px-5 py-3">Primary Vulnerability</th>
            <th class="px-5 py-3 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-300">
          <% @locations.each do |loc| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="px-5 py-3.5 font-bold text-slate-900 dark:text-white"><%= loc.name %></td>
              <td class="px-5 py-3.5 text-slate-500 dark:text-slate-400"><%= loc.state %> (<%= loc.district %>)</td>
              <td class="px-5 py-3.5">
                <span class="font-black font-mono text-sm <%= loc.accessibility_score.to_f < 40 ? 'text-red-600 dark:text-red-400' : (loc.accessibility_score.to_f < 60 ? 'text-orange-600 dark:text-orange-400' : 'text-emerald-600 dark:text-emerald-400') %>">
                  <%= loc.accessibility_score.to_f.round(1) %>/100
                </span>
              </td>
              <td class="px-5 py-3.5">
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase border <%= loc.accessibility_badge_class %>">
                  <%= loc.accessibility_tier %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-slate-600 dark:text-slate-400">
                <%= loc.primary_risk_factor %>
              </td>
              <td class="px-5 py-3.5 text-right">
                <%= link_to accessibility_location_path(loc), class: "text-xs font-bold text-accent dark:text-accent hover:underline" do %>
                  <span>Report &rarr;</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  </div>

</div>
