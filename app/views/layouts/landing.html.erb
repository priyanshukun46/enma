<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <title>ResQWay — AI Logistics &amp; Accessibility Intelligence for North East India</title>
    <%= tag.link rel: "icon", href: image_path("logo.png"), type: "image/png" %>
    <%= tag.link rel: "apple-touch-icon", href: image_path("logo.png") %>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <meta name="description" content="ResQWay — AI-Assisted Logistics, Machine Learning Road Disruption Prediction & Accessibility Intelligence Platform for the North Eastern Region of India.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- Instant Theme Bootstrap (ChaiCode reference: dsa.chaicode.com) -->
    <script nonce="<%= request.content_security_policy_nonce %>">
      try {
        var t = localStorage.getItem('theme');
        var isLight = (t === 'light');
        document.documentElement.dataset.theme = isLight ? 'light' : 'dark';
        if (isLight) {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      } catch(e) {
        document.documentElement.dataset.theme = 'dark';
        document.documentElement.classList.add('dark');
      }
    </script>

    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com" nonce="<%= request.content_security_policy_nonce %>"></script>
    <script nonce="<%= request.content_security_policy_nonce %>">
      tailwind.config = {
        darkMode: ['class', '[data-theme="dark"]'],
        theme: {
          extend: {
            colors: {
              paper: 'rgb(var(--paper) / <alpha-value>)',
              surface: 'rgb(var(--surface) / <alpha-value>)',
              ink: 'rgb(var(--ink) / <alpha-value>)',
              sketch: 'rgb(var(--sketch) / <alpha-value>)',
              mute: 'rgb(var(--mute) / <alpha-value>)',
              accent: 'rgb(var(--accent) / <alpha-value>)',
              accent2: 'rgb(var(--accent2) / <alpha-value>)',
            },
            fontFamily: {
              sans: ['"Inter"', 'system-ui', '-apple-system', 'sans-serif'],
              mono: ['"JetBrains Mono"', 'monospace'],
            }
          }
        }
      }
    </script>
    <%= stylesheet_link_tag "chaicode", "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen antialiased selection:bg-accent selection:text-white flex flex-col justify-between"
        data-controller="theme">
    
    <% if flash[:notice].present? || flash[:alert].present? %>
      <div class="fixed top-20 left-1/2 -translate-x-1/2 z-[9999] w-full max-w-md px-4 pointer-events-none space-y-2">
        <% if flash[:notice] %>
          <div data-controller="flash"
               data-flash-timeout-value="2000"
               data-action="mouseenter->flash#pause mouseleave->flash#resume"
               class="pointer-events-auto sketch-border px-4 py-3 text-xs font-bold shadow-xl backdrop-blur-md flex items-center justify-between transition-all"
               style="background-color: var(--done-bg); color: var(--done-text); border-color: var(--done-stroke);">
            <div class="flex items-center space-x-2.5">
              <i class="fas fa-check-circle"></i>
              <span><%= flash[:notice] %></span>
            </div>
            <button type="button" data-action="click->flash#dismiss" class="ml-2 text-current opacity-70 hover:opacity-100 cursor-pointer p-0.5">
              <i class="fas fa-times text-xs"></i>
            </button>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div data-controller="flash"
               data-flash-timeout-value="2000"
               data-action="mouseenter->flash#pause mouseleave->flash#resume"
               class="pointer-events-auto sketch-border px-4 py-3 text-xs font-bold shadow-xl backdrop-blur-md flex items-center justify-between transition-all"
               style="background-color: var(--dead-bg); color: var(--dead-text); border-color: var(--dead-stroke);">
            <div class="flex items-center space-x-2.5">
              <i class="fas fa-exclamation-circle"></i>
              <span><%= flash[:alert] %></span>
            </div>
            <button type="button" data-action="click->flash#dismiss" class="ml-2 text-current opacity-70 hover:opacity-100 cursor-pointer p-0.5">
              <i class="fas fa-times text-xs"></i>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
