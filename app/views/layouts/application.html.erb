<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title>ENMA AI - North East Smart Logistics &amp; Accessibility Intelligence</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com" nonce="<%= request.content_security_policy_nonce %>"></script>
    <script nonce="<%= request.content_security_policy_nonce %>">
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              slate: {
                950: '#000000',  // Deep True Pitch Black Canvas
                900: '#0d0d0f',  // Deep Ubuntu Jet Black Cards & Panels
                850: '#131316',
                800: '#19191d',  // Neutral Elevated Container
                700: '#26262c',  // Clean Neutral Dark Border
                600: '#52525b',
                500: '#71717a',
                400: '#a1a1aa',
                300: '#d4d4d8',
                200: '#e4e4e7',
                100: '#f4f4f5',
                50: '#fafafa'
              },
              indigo: {
                950: '#2b0c03',  // Dark Warm Auburn Accent
                900: '#431407',
                800: '#7c2d12',
                700: '#c2410c',
                600: '#E95420',  // Canonical Ubuntu Orange
                500: '#f97316',  // Vivid Orange
                400: '#fb923c',  // Warm Orange
                300: '#fdba74',
                200: '#fed7aa',
                100: '#ffedd5',
                50: '#fff7ed'
              },
              ubuntu: {
                orange: '#E95420',
                warm: '#FF6E38',
                aubergine: '#77216F',
                black: '#000000',
                card: '#0d0d0f'
              }
            }
          }
        }
      }
    </script>
    <script nonce="<%= request.content_security_policy_nonce %>">
      if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <style>
      .leaflet-container {
        font-family: inherit !important;
        width: 100% !important;
      }
      .custom-leaflet-icon {
        background: transparent !important;
        border: none !important;
      }
      /* Pure Black & Ubuntu Orange Theme Rules */
      .dark body {
        background-color: #000000 !important;
        color: #f4f4f5 !important;
      }
      .dark aside {
        background-color: #0d0d0f !important;
        border-color: #1c1c22 !important;
      }
      .dark header {
        background-color: rgba(13, 13, 15, 0.95) !important;
        border-color: #1c1c22 !important;
      }
      /* Leaflet Modern Popup Polish & High Contrast Button Fix */
      .leaflet-popup-content-wrapper {
        border-radius: 1.25rem !important;
        padding: 0.25rem !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.2) !important;
        border: 1px solid #e2e8f0 !important;
        font-family: inherit !important;
      }
      .dark .leaflet-popup-content-wrapper {
        background-color: #101014 !important;
        color: #f4f4f5 !important;
        border-color: #26262c !important;
      }
      .leaflet-popup-tip {
        box-shadow: none !important;
      }
      .dark .leaflet-popup-tip {
        background-color: #101014 !important;
      }
      .leaflet-popup-content {
        margin: 0.75rem 0.85rem !important;
        line-height: 1.5 !important;
      }
      .leaflet-popup-content a {
        color: #ffffff !important;
        text-decoration: none !important;
      }
      .leaflet-popup-content a:hover {
        color: #ffffff !important;
        opacity: 0.95 !important;
      }
      .leaflet-popup-close-button {
        padding: 0.4rem !important;
        color: #94a3b8 !important;
      }
    </style>
  </head>

  <body class="flex h-screen bg-slate-50 dark:bg-slate-950 font-sans text-slate-900 dark:text-slate-100 antialiased selection:bg-[#E95420] selection:text-white overflow-hidden"
        data-controller="sidebar theme qr-modal">

    <!-- Mobile Drawer Backdrop Overlay -->
    <div data-sidebar-target="backdrop"
         data-action="click->sidebar#close"
         class="fixed inset-0 bg-black/70 backdrop-blur-sm z-40 hidden md:hidden transition-opacity"></div>

    <!-- Google Stitch Left Sidebar Navigation -->
    <aside data-sidebar-target="sidebar"
           class="fixed inset-y-0 left-0 z-50 w-64 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 flex flex-col flex-shrink-0 border-r border-slate-200 dark:border-slate-800 shadow-sm transform -translate-x-full md:translate-x-0 md:static transition-transform duration-200 ease-in-out">
      
      <!-- Brand Header (Stitch Style) -->
      <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <%= link_to root_path, class: "flex items-center space-x-3 group" do %>
          <div class="w-10 h-10 rounded-xl bg-[#E95420] text-white flex items-center justify-center font-black text-sm shadow-md group-hover:scale-105 transition-transform">
            <span>EA</span>
          </div>
          <div>
            <h1 class="text-base font-black tracking-tight text-slate-900 dark:text-white leading-tight">ENMA AI</h1>
            <p class="text-[9px] font-black uppercase tracking-widest text-[#E95420] dark:text-[#FF6E38] font-mono">Intelligence Platform</p>
          </div>
        <% end %>

        <!-- Close Button (Mobile Only) -->
        <button type="button"
                data-action="click->sidebar#close"
                class="md:hidden p-1.5 rounded-lg text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <i class="fas fa-times text-base"></i>
        </button>
      </div>

      <!-- System Status Pill (Top) -->
      <div class="px-5 pt-3 pb-2">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-[11px] font-bold bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 w-full">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>System Status: Active</span>
        </div>
      </div>
      
      <!-- Nav Links List (Google Stitch Style) -->
      <nav class="flex-1 px-3 py-2 space-y-1 overflow-y-auto">
        <%= link_to root_path, class: "flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-bold #{current_page?(root_path) ? 'bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border-l-4 border-indigo-600' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'} transition-all" do %>
          <i class="fas fa-th-large text-sm w-4 text-center"></i>
          <span>Dashboard</span>
        <% end %>

        <%= link_to map_path, class: "flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-bold #{current_page?(map_path) ? 'bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border-l-4 border-indigo-600' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'} transition-all" do %>
          <i class="fas fa-map text-sm w-4 text-center"></i>
          <span>Intelligence Map</span>
        <% end %>

        <!-- Merged Single Predictive Risk & Accessibility Nav Item -->
        <%= link_to accessibility_path, class: "flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-bold #{request.path.start_with?('/accessibility') ? 'bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border-l-4 border-indigo-600' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'} transition-all" do %>
          <i class="fas fa-shield-alt text-sm w-4 text-center"></i>
          <span>Predictive Risk &amp; Accessibility</span>
        <% end %>

        <%= link_to routes_path, class: "flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-bold #{request.path.start_with?('/routes') ? 'bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border-l-4 border-indigo-600' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'} transition-all" do %>
          <i class="fas fa-route text-sm w-4 text-center"></i>
          <span>Smart Routes</span>
        <% end %>

        <%= link_to emergencies_path, class: "flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-bold #{request.path.start_with?('/emergencies') ? 'bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border-l-4 border-indigo-600' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'} transition-all" do %>
          <i class="fas fa-star-of-life text-sm w-4 text-center"></i>
          <span>Emergency Center</span>
        <% end %>

        <%= link_to incidents_path, class: "flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-bold #{request.path.start_with?('/incidents') ? 'bg-red-50 dark:bg-red-950/70 text-red-700 dark:text-red-300 border-l-4 border-red-600' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'} transition-all" do %>
          <i class="fas fa-camera text-sm w-4 text-center text-red-600 dark:text-red-400"></i>
          <span>Field Incidents</span>
        <% end %>

        <%= link_to warehouses_path, class: "flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-bold #{request.path.start_with?('/warehouses') ? 'bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border-l-4 border-indigo-600' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'} transition-all" do %>
          <i class="fas fa-warehouse text-sm w-4 text-center"></i>
          <span>Warehouses</span>
        <% end %>

        <%= link_to analytics_path, class: "flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-bold #{request.path.start_with?('/analytics') ? 'bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border-l-4 border-indigo-600' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'} transition-all" do %>
          <i class="fas fa-chart-bar text-sm w-4 text-center"></i>
          <span>Analytics</span>
        <% end %>

        <%= link_to demo_path, class: "flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-bold #{current_page?(demo_path) ? 'bg-amber-50 dark:bg-amber-950/70 text-amber-800 dark:text-amber-300 border-l-4 border-amber-500' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100/70 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'} transition-all" do %>
          <i class="fas fa-flask text-sm w-4 text-center"></i>
          <span>Demo Scenario</span>
        <% end %>

        <% if authenticated? && current_user.admin? %>
          <div class="pt-3 pb-1 px-3">
            <span class="text-[9px] font-black uppercase text-purple-600 dark:text-purple-400 tracking-wider">Admin</span>
          </div>

          <%= link_to admin_users_path, class: "flex items-center space-x-3 px-3.5 py-2 rounded-xl text-xs font-bold #{request.path.start_with?('/admin') ? 'bg-purple-50 dark:bg-purple-950/70 text-purple-700 dark:text-purple-300 border-l-4 border-purple-600' : 'text-purple-600 dark:text-purple-400 hover:bg-slate-100 dark:hover:bg-slate-800'} transition-all" do %>
            <i class="fas fa-users-cog text-sm w-4 text-center"></i>
            <span>User Admin</span>
          <% end %>
        <% end %>
      </nav>

      <!-- Sidebar Bottom Controls (Settings, Support, Theme) -->
      <div class="p-3 border-t border-slate-100 dark:border-slate-800 space-y-1">
        <%= link_to settings_path, class: "flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-all" do %>
          <i class="fas fa-cog text-sm w-4 text-center"></i>
          <span>Settings</span>
        <% end %>

        <%= link_to about_path, class: "flex items-center space-x-3 px-3 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-all" do %>
          <i class="fas fa-question-circle text-sm w-4 text-center"></i>
          <span>Support</span>
        <% end %>

        <!-- Dark Mode Toggle in Sidebar -->
        <button type="button"
                data-action="click->theme#toggle"
                class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer">
          <div class="flex items-center space-x-3">
            <i data-theme-target="icon" class="fas fa-moon text-sm w-4 text-center"></i>
            <span data-theme-target="text">Dark Mode</span>
          </div>
          <span class="text-[10px] font-mono uppercase text-slate-400">Toggle</span>
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-slate-50 dark:bg-slate-950">
      
      <!-- Top Navigation Bar (Google Stitch Navbar Design) -->
      <header class="flex justify-between items-center px-4 sm:px-6 py-2.5 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 shadow-sm z-20">
        
        <!-- Left: Brand + Hamburger (Mobile) + Search Pill Input -->
        <div class="flex items-center space-x-2 sm:space-x-4 max-w-xl flex-1 min-w-0">
          <!-- Mobile Hamburger Toggle -->
          <button type="button"
                  data-action="click->sidebar#toggle"
                  class="md:hidden p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none flex-shrink-0">
            <i class="fas fa-bars text-base"></i>
          </button>

          <!-- Search Pill Form -->
          <%= form_with url: search_path, method: :get, local: true, class: "relative flex-1 max-w-[130px] sm:max-w-xs md:max-w-md min-w-0" do |f| %>
            <i class="fas fa-search absolute left-3.5 top-2.5 text-slate-400 dark:text-slate-500 text-xs pointer-events-none"></i>
            <%= f.text_field :q,
                             placeholder: "Search nodes...",
                             class: "w-full pl-8 sm:pl-9 pr-3 sm:pr-4 py-1.5 text-xs bg-slate-100/80 dark:bg-slate-800/80 dark:text-white border border-slate-200 dark:border-slate-700 rounded-full focus:ring-2 focus:ring-indigo-500 focus:bg-white dark:focus:bg-slate-900 focus:outline-none transition-all placeholder:text-slate-400 truncate" %>
          <% end %>
        </div>

        <!-- Right Side: Global View, Logs, Alerts, Dark Mode, Notification & User -->
        <div class="flex items-center space-x-2 sm:space-x-3.5 pl-2 flex-shrink-0">
          <%= link_to "Global View", map_path, class: "hidden lg:inline-block text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>
          <%= link_to "Logs", analytics_path, class: "hidden lg:inline-block text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>
          <%= link_to "Help", overview_path, class: "hidden sm:inline-block text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>

          <!-- Desktop QR Code Modal Trigger -->
          <button type="button"
                  data-action="click->qr-modal#open"
                  title="Scan QR Code on Mobile"
                  class="hidden sm:inline-flex items-center p-2 rounded-full text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
            <i class="fas fa-qrcode text-sm"></i>
          </button>

          <!-- Dark Mode Icon Toggle -->
          <button type="button"
                  data-action="click->theme#toggle"
                  title="Toggle Dark / Light Mode"
                  class="p-2 rounded-full text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
            <i data-theme-target="icon" class="fas fa-moon text-sm"></i>
          </button>

          <!-- Notification Bell with Active Indicator -->
          <%= link_to emergencies_path, title: "Emergency Notifications", class: "relative p-2 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors" do %>
            <i class="fas fa-bell text-sm"></i>
            <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-red-500 ring-2 ring-white dark:ring-slate-900"></span>
          <% end %>

          <!-- User Profile & Auth Controls -->
          <% if authenticated? %>
            <div class="flex items-center space-x-1.5 sm:space-x-2">
              <%= link_to profile_path, class: "w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-xs shadow-sm overflow-hidden ring-2 ring-slate-200 dark:ring-slate-700 hover:ring-indigo-500 transition-all flex-shrink-0" do %>
                <% if current_user.avatar_url.present? %>
                  <img src="<%= current_user.avatar_url %>" alt="" class="w-full h-full object-cover">
                <% else %>
                  <span><%= current_user.initials %></span>
                <% end %>
              <% end %>

              <!-- Logout Button -->
              <%= button_to logout_path, method: :delete, title: "Sign Out", class: "inline-flex items-center p-1.5 sm:px-2.5 sm:py-1 text-xs font-bold rounded-lg text-slate-500 hover:text-red-600 dark:text-slate-400 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/60 transition-colors cursor-pointer" do %>
                <i class="fas fa-sign-out-alt text-xs sm:mr-1"></i>
                <span class="hidden sm:inline">Logout</span>
              <% end %>
            </div>
          <% else %>
            <%= link_to "Sign In", login_path, class: "px-3 sm:px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs rounded-full shadow-sm transition-colors" %>
          <% end %>
        </div>
      </header>

      <!-- Page Content Area -->
      <main class="flex-1 overflow-x-hidden overflow-y-auto p-3 sm:p-6 lg:p-8">
        <% if flash[:notice] %>
          <div class="mb-6 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 px-4 py-3 rounded-2xl flex items-center shadow-sm">
            <i class="fas fa-check-circle text-emerald-600 mr-3 text-lg"></i>
            <span class="text-xs font-bold"><%= flash[:notice] %></span>
          </div>
        <% end %>

        <% if flash[:alert] %>
          <div class="mb-6 bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800 text-red-900 dark:text-red-200 px-4 py-3 rounded-2xl flex items-center shadow-sm">
            <i class="fas fa-exclamation-circle text-red-600 mr-3 text-lg"></i>
            <span class="text-xs font-bold"><%= flash[:alert] %></span>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>

    <!-- Desktop QR Code Modal Overlay -->
    <div data-qr-modal-target="backdrop"
         data-action="click->qr-modal#close"
         class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden transition-opacity"></div>

    <div data-qr-modal-target="modal"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden pointer-events-none">
      <div class="pointer-events-auto max-w-lg w-full relative">
        <button type="button"
                data-action="click->qr-modal#close"
                title="Close Modal"
                class="absolute top-4 right-4 z-10 w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center text-sm shadow-sm transition-colors cursor-pointer">
          <i class="fas fa-times"></i>
        </button>
        <%= render "shared/qr_code_card", title: "Scan to Open ENMA AI", subtitle: "Open this live operational command platform on your smartphone or tablet." %>
      </div>
    </div>
  </body>
</html>
