<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title>ResQWay - North East Smart Logistics &amp; Accessibility Intelligence</title>
    <%= tag.link rel: "icon", href: image_path("logo.png"), type: "image/png" %>
    <%= tag.link rel: "apple-touch-icon", href: image_path("logo.png") %>
    <link rel="manifest" href="/manifest">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Nobile:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&family=Playwrite+GB+J:ital,wght@0,100..400;1,100..400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com" nonce="<%= request.content_security_policy_nonce %>"></script>
    <script nonce="<%= request.content_security_policy_nonce %>">
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              paper: 'rgb(var(--paper) / <alpha-value>)',
              surface: 'rgb(var(--surface) / <alpha-value>)',
              ink: 'rgb(var(--ink) / <alpha-value>)',
              sketch: 'rgb(var(--sketch) / <alpha-value>)',
              mute: 'rgb(var(--mute) / <alpha-value>)',
              accent: '#FF471D',
              accent2: '#102E39',
              slate: {
                50: '#F8FAFB',
                100: '#EAEEF0',
                200: '#D9E0E3',
                300: '#B8C4C9',
                400: '#8A9BA2',
                500: '#5F737B',
                600: '#43545B',
                700: '#2F3C42',
                800: '#1F292E',
                900: '#102E39',
                950: '#212121',
              },
            },
            fontFamily: {
              sans: ['"Montserrat"', 'system-ui', '-apple-system', 'sans-serif'],
              montserrat: ['"Montserrat"', 'system-ui', '-apple-system', 'sans-serif'],
              nobile: ['"Nobile"', 'system-ui', '-apple-system', 'sans-serif'],
              fraunces: ['"Fraunces"', 'serif'],
              playwrite: ['"Playwrite GB J"', 'cursive'],
              mono: ['"JetBrains Mono"', '"SF Mono"', 'monospace'],
            }
          }
        }
      }
    </script>
    <style>
      :root {
        --paper: 255 255 255;      /* #FFFFFF Pure white */
        --surface: 255 255 255;    /* #FFFFFF Crisp cards */
        --ink: 33 33 33;           /* #212121 Headers, Footers & Text */
        --sketch: 55 65 81;
        --mute: 100 116 139;
        --accent: 255 71 29;       /* #FF471D Buttons & essence */
        --accent2: 16 46 57;       /* #102E39 Essence & small designs */
        --line: rgba(16, 46, 57, 0.12);
        --line-hi: rgba(16, 46, 57, 0.25);
        --card: #FFFFFF;
        --card-hi: #FFFFFF;
      }
      body {
        background-color: #FFFFFF !important;
        color: #212121 !important;
        font-family: 'Montserrat', system-ui, -apple-system, sans-serif !important;
        letter-spacing: -0.011em;
        line-height: 1.5;
      }
      .dark {
        color-scheme: light !important;
      }
      .dark body {
        background-color: #FFFFFF !important;
        color: #212121 !important;
      }
      /* Prevent dark classes from rendering white text on white canvas or dark boxes */
      .dark [class*="dark:text-white"],
      .dark [class*="dark:text-slate-100"],
      .dark [class*="dark:text-slate-200"],
      .dark [class*="dark:text-slate-300"] {
        color: #212121 !important;
      }
      .dark [class*="dark:bg-slate-900"],
      .dark [class*="dark:bg-slate-800"],
      .dark [class*="dark:bg-slate-950"] {
        background-color: #FFFFFF !important;
      }
    </style>
  </head>

  <body class="min-h-screen flex flex-col bg-white text-[#212121] antialiased selection:bg-[#FF471D] selection:text-white font-sans"
        style="background-color: #FFFFFF !important; color: #212121 !important;"
        data-controller="landing-page search-modal qr-modal connectivity">

    <!-- Offline Indicator Banner -->
    <div data-connectivity-target="banner" class="hidden fixed top-0 inset-x-0 z-[100] bg-[#212121] text-white text-center py-2 px-4 shadow-md text-xs font-bold flex justify-center items-center">
      <i class="fas fa-wifi-slash mr-2 text-[#FF471D]"></i>
      You're offline — showing last synced data
    </div>

    <!-- Universal ResQWay Header (#212121) -->
    <%= render "shared/resqway_header" %>

    <!-- Header Spacer & Subpage Banner Container -->
    <div class="pt-16 sm:pt-20 flex-1 flex flex-col">
      
      <!-- Contextual Subpage Hero Banner with Breadcrumbs & Mockup (Attached Image 1) -->
      <%= render "shared/subpage_hero_banner" %>

      <!-- Flash Notification Messages -->
      <% if flash[:notice].present? || flash[:alert].present? %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 w-full">
          <% if flash[:notice] %>
            <div data-controller="flash"
                 data-flash-timeout-value="3000"
                 data-action="mouseenter->flash#pause mouseleave->flash#resume"
                 class="bg-emerald-50 border border-emerald-300 text-emerald-900 px-4 py-3 rounded-xl flex items-center justify-between shadow-sm transition-all">
              <div class="flex items-center space-x-2.5">
                <i class="fas fa-check-circle text-emerald-600 text-sm"></i>
                <span class="text-xs font-bold"><%= flash[:notice] %></span>
              </div>
              <button type="button" data-action="click->flash#dismiss" class="text-emerald-700 hover:text-emerald-900 cursor-pointer p-0.5">
                <i class="fas fa-times text-xs"></i>
              </button>
            </div>
          <% end %>

          <% if flash[:alert] %>
            <div data-controller="flash"
                 data-flash-timeout-value="3000"
                 data-action="mouseenter->flash#pause mouseleave->flash#resume"
                 class="bg-rose-50 border border-rose-300 text-rose-900 px-4 py-3 rounded-xl flex items-center justify-between shadow-sm transition-all mt-2">
              <div class="flex items-center space-x-2.5">
                <i class="fas fa-exclamation-circle text-rose-600 text-sm"></i>
                <span class="text-xs font-bold"><%= flash[:alert] %></span>
              </div>
              <button type="button" data-action="click->flash#dismiss" class="text-rose-700 hover:text-rose-900 cursor-pointer p-0.5">
                <i class="fas fa-times text-xs"></i>
              </button>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Main Content Area on #EAEEF0 -->
      <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <%= yield %>
      </main>

    </div>

    <!-- Universal ResQWay Footer (#212121) -->
    <%= render "shared/resqway_footer" %>

    <!-- Global Search Command Palette Modal (⌘K Spotlight) in #212121 / #102E39 / #FF471D -->
    <div data-search-modal-target="backdrop"
         data-action="click->search-modal#close"
         class="fixed inset-0 bg-black/75 z-50 hidden transition-opacity backdrop-blur-xs"></div>

    <div data-search-modal-target="modal"
         class="fixed inset-0 z-50 flex items-start justify-center pt-16 sm:pt-24 p-4 hidden pointer-events-none">
      <div class="pointer-events-auto max-w-xl w-full bg-white border border-slate-300 rounded-2xl shadow-2xl overflow-hidden flex flex-col text-[#212121]">
        
        <!-- Modal Search Header Input -->
        <div class="p-3.5 border-b border-slate-200 flex items-center gap-3 bg-slate-50">
          <i class="fas fa-search text-[#FF471D] text-sm ml-1"></i>
          <input type="text"
                 data-search-modal-target="input"
                 data-action="input->search-modal#onInput keydown->search-modal#onKeydown"
                 placeholder="Search vessels, routes, relief depots, emergencies..."
                 autocomplete="off"
                 class="w-full bg-transparent text-[#212121] placeholder:text-slate-400 text-sm font-medium focus:outline-none">
          <button type="button"
                  data-action="click->search-modal#close"
                  class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-slate-200 border border-slate-300 text-slate-600 hover:text-[#212121] cursor-pointer">
            ESC
          </button>
        </div>

        <!-- Quick Filter Tags -->
        <div class="px-4 py-2 border-b border-slate-200 bg-[#EAEEF0] flex items-center gap-1.5 overflow-x-auto text-[11px]">
          <span class="text-[10px] font-bold text-slate-500 uppercase mr-1 flex-shrink-0">Quick:</span>
          <button type="button" data-action="click->search-modal#setQuery" data-query="Fleet" class="px-2.5 py-0.5 rounded-full border border-slate-300 bg-white hover:border-[#FF471D] hover:text-[#FF471D] text-slate-700 text-[11px] cursor-pointer flex-shrink-0 transition-colors">🚢 Fleet</button>
          <button type="button" data-action="click->search-modal#setQuery" data-query="Tawang" class="px-2.5 py-0.5 rounded-full border border-slate-300 bg-white hover:border-[#FF471D] hover:text-[#FF471D] text-slate-700 text-[11px] cursor-pointer flex-shrink-0 transition-colors">📍 Tawang</button>
          <button type="button" data-action="click->search-modal#setQuery" data-query="NH-27" class="px-2.5 py-0.5 rounded-full border border-slate-300 bg-white hover:border-[#FF471D] hover:text-[#FF471D] text-slate-700 text-[11px] cursor-pointer flex-shrink-0 transition-colors">🛣️ NH-27</button>
          <button type="button" data-action="click->search-modal#setQuery" data-query="Depot" class="px-2.5 py-0.5 rounded-full border border-slate-300 bg-white hover:border-[#FF471D] hover:text-[#FF471D] text-slate-700 text-[11px] cursor-pointer flex-shrink-0 transition-colors">🏢 Warehouses</button>
          <button type="button" data-action="click->search-modal#setQuery" data-query="Landslide" class="px-2.5 py-0.5 rounded-full border border-slate-300 bg-white hover:border-[#FF471D] hover:text-[#FF471D] text-slate-700 text-[11px] cursor-pointer flex-shrink-0 transition-colors">🚨 Incidents</button>
        </div>

        <!-- Suggestions List -->
        <ul data-search-modal-target="resultsList" class="p-2 space-y-0.5 max-h-[360px] overflow-y-auto bg-white">
          <!-- Populated dynamically via search_modal_controller -->
        </ul>

        <!-- Modal Footer with Keyboard Shortcuts -->
        <div class="px-4 py-2.5 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-500 font-mono">
          <div class="flex items-center space-x-3">
            <span><kbd class="px-1.5 py-0.5 rounded bg-white border border-slate-300 text-slate-600 font-mono">↑↓</kbd> navigate</span>
            <span><kbd class="px-1.5 py-0.5 rounded bg-white border border-slate-300 text-slate-600 font-mono">↵</kbd> open</span>
            <span><kbd class="px-1.5 py-0.5 rounded bg-white border border-slate-300 text-slate-600 font-mono">esc</kbd> close</span>
          </div>
          <span class="text-[10px] text-[#FF471D] font-semibold">ResQWay Operational Index</span>
        </div>

      </div>
    </div>

    <!-- Desktop QR Code Modal Overlay -->
    <div data-qr-modal-target="backdrop"
         data-action="click->qr-modal#close"
         class="fixed inset-0 bg-black/75 z-50 hidden transition-opacity"></div>

    <div data-qr-modal-target="modal"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden pointer-events-none">
      <div class="pointer-events-auto max-w-2xl w-full relative bg-white rounded-2xl shadow-2xl overflow-hidden">
        <button type="button"
                data-action="click->qr-modal#close"
                title="Close Modal"
                class="absolute top-4 right-4 z-10 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-[#212121] flex items-center justify-center text-sm shadow-sm transition-all cursor-pointer">
          <i class="fas fa-times"></i>
        </button>
        <%= render "shared/qr_code_card", title: "Scan to Open ResQWay", subtitle: "Open this live operational command platform on your smartphone or tablet." %>
      </div>
    </div>

  </body>
</html>
