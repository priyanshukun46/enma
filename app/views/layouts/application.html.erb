<!DOCTYPE html>
<html lang="en" class="dark h-full" style="color-scheme: dark; background-color: #000000;">
  <head>
    <title>ENMA AI - North East Smart Logistics &amp; Accessibility Intelligence</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Nunito:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com" nonce="<%= request.content_security_policy_nonce %>"></script>
    <script nonce="<%= request.content_security_policy_nonce %>">
      tailwind.config = {
        darkMode: ['class', '[data-theme="dark"]'],
        theme: {
          extend: {
            colors: {
              paper: 'rgb(var(--paper) / <alpha-value>)',
              surface: 'rgb(var(--surface) / <alpha-value>)',
              ink: 'rgb(var(--ink) / <alpha-value>)',
              sketch: 'rgb(var(--sketch) / <alpha-value>)',
              mute: 'rgb(var(--mute) / <alpha-value>)',
              accent: 'rgb(var(--accent) / <alpha-value>)',
              accent2: 'rgb(var(--accent2) / <alpha-value>)',
            },
            fontFamily: {
              sans: ['"Nunito"', '"Inter"', 'system-ui', '-apple-system', 'sans-serif'],
              hand: ['"Nunito"', 'system-ui', '-apple-system', 'sans-serif'],
              sketch: ['"Nunito"', 'system-ui', '-apple-system', 'sans-serif'],
              mono: ['"JetBrains Mono"', '"SF Mono"', 'monospace'],
            }
          }
        }
      }
    </script>
    <script nonce="<%= request.content_security_policy_nonce %>">
      // ChaiCode Dynamic Theme Bootstrap (dsa.chaicode.com)
      try {
        var t = localStorage.getItem('theme');
        var isLight = (t === 'light');
        document.documentElement.dataset.theme = isLight ? 'light' : 'dark';
        if (isLight) {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      } catch(e) {
        document.documentElement.dataset.theme = 'dark';
        document.documentElement.classList.add('dark');
      }
    </script>
    <style>
      /* ChaiCode (dsa.chaicode.com) Design System Tokens */
      :root, [data-theme=light] {
        color-scheme: light;
        --paper: 250 246 238;          /* #FAF6EE warm parchment */
        --surface: 255 252 247;        /* #FFFCF7 warm surface */
        --ink: 24 18 14;               /* #18120E high-contrast espresso ink */
        --sketch: 76 62 50;            /* #4C3E32 warm charcoal text */
        --mute: 118 104 90;            /* #76685A deep legible taupe (>4.5:1 ratio) */
        --accent: 226 84 56;           /* #E25438 rich warm reddish terracotta */
        --accent2: 200 60 45;          /* #C83C2D deep rust red */
        --border: 31 31 31;
        --shadow: 31 31 31;
        --card: rgba(31, 24, 18, 0.035);
        --card-hi: rgba(31, 24, 18, 0.07);
        --line: rgba(38, 30, 24, 0.15);
        --line-hi: rgba(38, 30, 24, 0.30);
        --done-bg: #DFF0E2;
        --done-text: #2F7D4A;
        --done-stroke: #3A9D5D;
        --dead-bg: #FDE2E2;
        --dead-text: #B03A3A;
        --dead-stroke: #C84A4A;
        --gold-bg: #FFF4D6;
        --gold-text: #917400;
        --gold-stroke: #CAA400;
        --compare-bg: #F5EBE6;
        --radius-card: 16px;
      }

      [data-theme=dark], .dark {
        color-scheme: dark;
        --paper: 20 16 12;             /* #14100C dark espresso */
        --surface: 27 22 17;           /* #1B1611 dark roasted surface */
        --ink: 236 229 214;            /* #ECE5D6 warm cream ivory */
        --sketch: 184 176 160;         /* #B8B0A0 warm parchment */
        --mute: 146 138 123;           /* #928A7B muted cocoa */
        --accent: 236 94 66;           /* #EC5E42 warm glowing reddish coral */
        --accent2: 216 74 46;          /* #D84A2E rich terracotta red */
        --border: 90 82 68;
        --shadow: 0 0 0;
        --card: rgba(255, 255, 255, 0.035);
        --card-hi: rgba(255, 255, 255, 0.065);
        --line: rgba(236, 229, 214, 0.12);
        --line-hi: rgba(236, 229, 214, 0.22);
        --done-bg: #17301F;
        --done-text: #6FC28D;
        --done-stroke: #4FB374;
        --dead-bg: #351A1A;
        --dead-text: #E88A8A;
        --dead-stroke: #E06B6B;
        --gold-bg: #332A12;
        --gold-text: #D8B638;
        --gold-stroke: #D8B638;
        --compare-bg: #2C1E1A;
        --radius-card: 16px;
      }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        background-color: rgb(var(--paper)) !important;
        color: rgb(var(--ink)) !important;
        transition: background-color 0.25s ease, color 0.25s ease;
      }

      .landing-gradient-bg, html, body {
        background-color: rgb(var(--paper)) !important;
        color: rgb(var(--ink)) !important;
      }

      aside {
        background: rgb(var(--surface)) !important;
        border-right: 1px solid var(--line) !important;
        color: rgb(var(--ink)) !important;
      }

      header, .nav-blur {
        backdrop-filter: blur(16px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
        background: rgb(var(--surface) / 0.88) !important;
        border-bottom: 1px solid var(--line) !important;
      }

      main {
        background: rgb(var(--paper)) !important;
      }

      /* ChaiCode Surface Cards */
      .glass-card,
      .bg-surface,
      .bg-white,
      .bg-slate-900,
      .bg-slate-900\/80,
      .dark\:bg-slate-900 {
        background: rgb(var(--surface)) !important;
        border: 1px solid var(--line) !important;
        box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.04) !important;
        color: rgb(var(--ink)) !important;
        border-radius: 16px !important;
      }

      .dark .bg-slate-900,
      [data-theme=dark] .bg-slate-900 {
        background: rgb(var(--surface)) !important;
        color: rgb(var(--ink)) !important;
      }

      .glass-card-hover:hover,
      .glass-card:hover {
        border-color: rgb(var(--accent) / 0.45) !important;
        box-shadow: 0 10px 30px -5px rgb(var(--accent) / 0.12) !important;
      }

      .bg-slate-50,
      .dark\:bg-slate-800\/60,
      .dark\:bg-slate-800\/50,
      .dark\:bg-slate-800\/40,
      .dark\:bg-slate-800,
      .bg-black\/40,
      .bg-black\/30,
      .bg-slate-100 {
        background-color: var(--card) !important;
        border-color: var(--line) !important;
      }

      /* ChaiCode Accent Text Gradient */
      .gradient-text, .text-gradient-aurora {
        background: linear-gradient(135deg, rgb(var(--ink)) 30%, rgb(var(--accent)) 100%) !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
        background-clip: text !important;
      }

      .gradient-text-orange, .text-gradient-cyan {
        background: linear-gradient(135deg, rgb(var(--accent)) 0%, rgb(var(--accent2)) 100%) !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
        background-clip: text !important;
      }

      .stat-counter { font-variant-numeric: tabular-nums; }

      /* Universal High-Contrast Adaptive Text Colors */
      .text-slate-900,
      .text-gray-900,
      .text-slate-800,
      .text-gray-800,
      .text-slate-950,
      .text-neutral-900,
      .text-zinc-900 {
        color: rgb(var(--ink)) !important;
      }
      .text-slate-700,
      .text-slate-600,
      .text-gray-700,
      .text-gray-600,
      .text-neutral-700,
      .text-zinc-700 {
        color: rgb(var(--sketch)) !important;
      }
      .text-slate-500,
      .text-slate-400,
      .text-gray-500,
      .text-gray-400,
      .text-neutral-500,
      .text-zinc-500 {
        color: rgb(var(--mute)) !important;
      }

      /* In dark mode, ensure elements marked with dark:text-white render in bright ivory */
      .dark .dark\:text-white,
      [data-theme=dark] .dark\:text-white,
      .dark .dark\:text-slate-200,
      [data-theme=dark] .dark\:text-slate-200 {
        color: rgb(var(--ink)) !important;
      }

      /* In light mode, ensure elements with dark:text-white render as crisp dark ink */
      :root:not(.dark) .dark\:text-white,
      [data-theme=light] .dark\:text-white {
        color: rgb(var(--ink)) !important;
      }

      /* Universal border colors */
      .border-slate-200,
      .border-slate-100,
      .border-slate-300,
      .border-gray-200,
      .border-gray-100,
      .border-slate-800,
      .border-slate-700 {
        border-color: var(--line) !important;
      }

      /* Universal form inputs & dropdowns */
      input[type="text"],
      input[type="search"],
      input[type="password"],
      input[type="email"],
      input[type="number"],
      select,
      textarea {
        background-color: rgb(var(--surface)) !important;
        color: rgb(var(--ink)) !important;
        border: 1px solid var(--line) !important;
      }
      select option {
        background-color: rgb(var(--surface)) !important;
        color: rgb(var(--ink)) !important;
      }

      /* Universal Tables */
      table thead {
        background-color: var(--card) !important;
        color: rgb(var(--mute)) !important;
      }
      table tbody tr:hover {
        background-color: var(--card) !important;
      }
      table tbody tr td {
        border-color: var(--line) !important;
      }

      /* Leaflet Modern Popup Polish & High Contrast Button Fix */
      .leaflet-container {
        font-family: inherit !important;
        width: 100% !important;
      }
      .custom-leaflet-icon {
        background: transparent !important;
        border: none !important;
      }
      .leaflet-popup-content-wrapper {
        border-radius: 1.25rem !important;
        padding: 0.25rem !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.3) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        background-color: #101014 !important;
        color: #f4f4f5 !important;
        font-family: inherit !important;
      }
      .leaflet-popup-tip {
        box-shadow: none !important;
        background-color: #101014 !important;
      }
      .leaflet-popup-content {
        margin: 0.75rem 0.85rem !important;
        line-height: 1.5 !important;
        color: #f4f4f5 !important;
      }
      .leaflet-popup-content a {
        color: #ffffff !important;
        text-decoration: none !important;
      }
      .leaflet-popup-content a:hover {
        color: #ffffff !important;
        opacity: 0.95 !important;
      }
      .leaflet-popup-close-button {
        padding: 0.4rem !important;
        color: #94a3b8 !important;
      }

      /* Scrollbar */
      ::-webkit-scrollbar { width: 5px; height: 5px; }
      ::-webkit-scrollbar-track { background: rgb(var(--paper)); }
      ::-webkit-scrollbar-thumb { background: rgb(var(--mute) / 0.4); border-radius: 10px; }
      ::-webkit-scrollbar-thumb:hover { background: rgb(var(--accent)); }
    </style>
  </head>

  <body class="flex h-screen bg-paper text-ink antialiased overflow-hidden"
        data-controller="sidebar theme qr-modal search-modal">

    <!-- Mobile Drawer Backdrop Overlay -->
    <div data-sidebar-target="backdrop"
         data-action="click->sidebar#close"
         class="fixed inset-0 bg-ink/30 backdrop-blur-[2px] z-40 hidden md:hidden transition-opacity"></div>

    <!-- Left Sidebar Navigation (Chai Visual Reference: dsa.chaicode.com) -->
    <aside data-sidebar-target="sidebar"
           class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] h-dvh overflow-y-auto border-r-2 border-ink/20 bg-paper px-4 py-6 flex flex-col flex-shrink-0 shadow-xl transform -translate-x-full md:translate-x-0 md:static transition-transform duration-200 ease-in-out">
      
      <!-- Top Track Navigation & Close -->
      <div class="flex items-center justify-between mb-2">
        <%= link_to root_path, class: "font-sketch text-xs text-mute hover:text-ink transition-colors inline-flex items-center gap-1.5" do %>
          <span>← all tracks</span>
        <% end %>

        <button type="button"
                data-action="click->sidebar#close"
                class="md:hidden p-1.5 text-mute hover:text-ink transition-colors"
                aria-label="Close navigation">
          <i class="fas fa-times text-sm"></i>
        </button>
      </div>

      <!-- Brand Logo in ChaiCode font-hand style -->
      <%= link_to dashboard_path, class: "flex items-center gap-2 font-hand text-3xl text-ink leading-none group" do %>
        <div class="w-8 h-8 rounded-lg bg-accent text-white flex items-center justify-center font-black text-xs shadow-sm">
          <i class="fas fa-brain text-sm"></i>
        </div>
        <span class="inline-flex items-baseline gap-1">
          ENMA <span class="text-accent">AI</span>
        </span>
      <% end %>
      <p class="font-sketch text-xs text-mute mt-1">logistics &amp; accessibility intelligence</p>

      <!-- Search in Sidebar (Opens Command Palette Modal directly, no page reload) -->
      <button type="button"
              data-action="click->search-modal#open"
              class="mt-3 sketch-border-soft bg-surface/60 px-3 py-1.5 flex items-center gap-2 font-sketch text-sm text-mute hover:bg-surface hover:text-ink transition-colors w-full cursor-pointer text-left"
              title="Search command palette (⌘K)">
        <i class="fas fa-search text-xs shrink-0"></i>
        <span class="flex-1 text-left text-xs font-sketch">Search…</span>
        <kbd class="font-mono text-[10px] border border-ink/25 rounded px-1 py-0.5 hidden lg:inline">⌘K</kbd>
      </button>

      <!-- Live Telemetry Status Pill (ChaiCode Streak Style) -->
      <div class="mt-3 relative flex items-center justify-between sketch-border-soft bg-surface/60 px-3 py-1.5 font-sketch text-xs">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[rgb(var(--done-stroke))] animate-pulse"></span>
          <span class="text-ink font-semibold">Live Telemetry</span>
        </div>
        <span class="font-mono text-[10px] text-mute">&lt; 2ms latency</span>
      </div>

      <!-- Navigation Tree (ChaiCode Pattern & Problem List Style) -->
      <nav class="mt-6 space-y-5 flex-1 overflow-y-auto pr-1">
        
        <!-- Category 1: Operational Engines -->
        <div class="space-y-1">
          <div class="flex items-center gap-1.5 text-left font-hand text-lg text-ink/80 px-1">
            <span class="text-ink/60 text-[10px] leading-none shrink-0">▶</span>
            <span class="font-bold truncate">Operational Engines</span>
          </div>

          <ul class="space-y-1 pl-3.5 mt-1">
            <% is_dash = request.path == '/dashboard' %>
            <li>
              <%= link_to dashboard_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_dash ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_dash %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Dashboard
                    <span class="block text-xs text-mute <%= is_dash ? 'text-paper/70' : '' %>">Intelligence Overview</span>
                  </span>
                </span>
              <% end %>
            </li>

            <% is_map = current_page?(map_path) %>
            <li>
              <%= link_to map_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_map ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_map %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Intelligence Map
                    <span class="block text-xs text-mute <%= is_map ? 'text-paper/70' : '' %>">CartoDB GIS Radar</span>
                  </span>
                </span>
              <% end %>
            </li>

            <% is_access = request.path.start_with?('/accessibility') %>
            <li>
              <%= link_to accessibility_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_access ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_access %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Predictive Risk
                    <span class="block text-xs text-mute <%= is_access ? 'text-paper/70' : '' %>">Accessibility Analysis</span>
                  </span>
                </span>
              <% end %>
            </li>

            <% is_routes = request.path.start_with?('/routes') %>
            <li>
              <%= link_to routes_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_routes ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_routes %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Smart Routes
                    <span class="block text-xs text-mute <%= is_routes ? 'text-paper/70' : '' %>">Double-Buffered Optimizer</span>
                  </span>
                </span>
              <% end %>
            </li>

            <% is_fleet = request.path.start_with?('/shipments') || request.path.start_with?('/vehicles') %>
            <li>
              <%= link_to shipments_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_fleet ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_fleet %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Live Fleet
                    <span class="block text-xs text-mute <%= is_fleet ? 'text-paper/70' : '' %>">GPS Rerouting</span>
                  </span>
                </span>
              <% end %>
            </li>
          </ul>
        </div>

        <!-- Category 2: Incident Response -->
        <div class="space-y-1">
          <div class="flex items-center gap-1.5 text-left font-hand text-lg text-ink/80 px-1">
            <span class="text-ink/60 text-[10px] leading-none shrink-0">▶</span>
            <span class="font-bold truncate">Tactical Response</span>
          </div>

          <ul class="space-y-1 pl-3.5 mt-1">
            <% is_em = request.path.start_with?('/emergencies') %>
            <li>
              <%= link_to emergencies_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_em ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_em %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Emergency Center
                    <span class="block text-xs text-mute <%= is_em ? 'text-paper/70' : '' %>">Active Incidents</span>
                  </span>
                </span>
              <% end %>
            </li>

            <% is_inc = request.path.start_with?('/incidents') %>
            <li>
              <%= link_to incidents_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_inc ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_inc %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Field Incidents
                    <span class="block text-xs text-mute <%= is_inc ? 'text-paper/70' : '' %>">Citizen Reports &amp; Photos</span>
                  </span>
                </span>
              <% end %>
            </li>

            <% is_wh = request.path.start_with?('/warehouses') %>
            <li>
              <%= link_to warehouses_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_wh ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_wh %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Relief Depots
                    <span class="block text-xs text-mute <%= is_wh ? 'text-paper/70' : '' %>">Warehouse Readiness</span>
                  </span>
                </span>
              <% end %>
            </li>
          </ul>
        </div>

        <!-- Category 3: Insights & Tools -->
        <div class="space-y-1">
          <div class="flex items-center gap-1.5 text-left font-hand text-lg text-ink/80 px-1">
            <span class="text-ink/60 text-[10px] leading-none shrink-0">▶</span>
            <span class="font-bold truncate">Insights &amp; Simulation</span>
          </div>

          <ul class="space-y-1 pl-3.5 mt-1">
            <% is_ana = request.path.start_with?('/analytics') %>
            <li>
              <%= link_to analytics_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_ana ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_ana %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Analytics
                    <span class="block text-xs text-mute <%= is_ana ? 'text-paper/70' : '' %>">Historical Performance</span>
                  </span>
                </span>
              <% end %>
            </li>

            <% is_demo = current_page?(demo_path) %>
            <li>
              <%= link_to demo_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_demo ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                <span class="flex items-start gap-1.5">
                  <% if is_demo %>
                    <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                  <% end %>
                  <span class="min-w-0 flex-1">
                    Demo Scenario
                    <span class="block text-xs text-mute <%= is_demo ? 'text-paper/70' : '' %>">SIH Interactive Simulator</span>
                  </span>
                </span>
              <% end %>
            </li>

            <% if authenticated? && current_user.admin? %>
              <% is_adm = request.path.start_with?('/admin') %>
              <li>
                <%= link_to admin_users_path, class: "block flex-1 min-w-0 font-sketch text-[14px] leading-snug px-2.5 py-1.5 rounded-lg transition #{is_adm ? 'bg-ink text-paper font-semibold shadow-sm' : 'text-sketch hover:bg-ink/5 hover:text-ink'}" do %>
                  <span class="flex items-start gap-1.5">
                    <% if is_adm %>
                      <span class="shrink-0 mt-[3px] text-paper/80"><i class="fas fa-check text-[10px]"></i></span>
                    <% end %>
                    <span class="min-w-0 flex-1">
                      User Administration
                      <span class="block text-xs text-mute <%= is_adm ? 'text-paper/70' : '' %>">Access Controls</span>
                    </span>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>

      </nav>

      <!-- Bottom User Card & Theme Toggle in Sidebar (ChaiCode Style) -->
      <div class="pt-3 mt-auto border-t border-ink/15 space-y-2">
        <button type="button"
                data-action="click->theme#toggle"
                class="w-full sketch-border-soft bg-surface/60 px-3 py-2 flex items-center justify-between font-sketch text-xs text-sketch hover:bg-surface hover:text-ink transition-colors cursor-pointer">
          <div class="flex items-center gap-2">
            <i data-theme-target="icon" class="fas fa-moon text-xs text-accent"></i>
            <span data-theme-target="text">Dark Theme</span>
          </div>
          <span class="font-mono text-[10px] text-mute uppercase">Toggle</span>
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-paper">
      
      <!-- Top Navigation Bar -->
      <header class="w-full flex justify-between items-center px-4 sm:px-8 lg:px-10 py-2.5 bg-surface/90 backdrop-blur-xl border-b border-[var(--line)] shadow-sm z-20">
        
        <!-- Left: Brand + Hamburger (Mobile) + Search Pill Input -->
        <div class="flex items-center space-x-2 sm:space-x-4 max-w-xl flex-1 min-w-0">
          <!-- Mobile Hamburger Toggle -->
          <button type="button"
                  data-action="click->sidebar#toggle"
                  class="md:hidden p-2 rounded-xl text-sketch hover:bg-ink/5 transition-colors focus:outline-none flex-shrink-0">
            <i class="fas fa-bars text-base"></i>
          </button>

          <!-- Search Pill Form with Live Suggestions -->
          <div data-controller="search-autocomplete"
               data-action="click@window->search-autocomplete#onClickOutside"
               class="relative flex-1 max-w-[170px] sm:max-w-xs md:max-w-md min-w-0">
            <%= form_with url: search_path, method: :get, local: true, class: "relative w-full" do |f| %>
              <i class="fas fa-search absolute left-3.5 top-2.5 text-mute text-xs pointer-events-none"></i>
              <%= f.text_field :q,
                               placeholder: "Search nodes, corridors...",
                               autocomplete: "off",
                               data: {
                                 "search-autocomplete-target": "input",
                                 action: "focus->search-autocomplete#onFocus input->search-autocomplete#onInput keydown->search-autocomplete#onKeydown"
                               },
                               class: "w-full pl-8 sm:pl-9 pr-3 sm:pr-4 py-1.5 text-xs bg-paper text-ink border border-[var(--line)] rounded-full focus:ring-2 focus:ring-accent focus:outline-none transition-all placeholder:text-mute truncate" %>
            <% end %>

            <!-- Live Suggestions Floating Dropdown -->
            <div data-search-autocomplete-target="dropdown"
                 class="hidden absolute left-0 right-0 sm:right-auto sm:w-[380px] top-full mt-2 bg-surface sketch-border rounded-2xl shadow-2xl z-50 overflow-hidden">
              <div class="p-2">
                <div class="px-3 py-1.5 text-[10px] font-black uppercase text-mute tracking-wider flex items-center justify-between border-b border-[var(--line)]/50 pb-1.5 mb-1">
                  <span class="flex items-center gap-1.5">
                    <i class="fas fa-bolt text-accent text-[10px]"></i>
                    <span>Live Suggestions</span>
                  </span>
                  <span class="text-[9px] font-mono text-mute">interactive</span>
                </div>
                <ul data-search-autocomplete-target="resultsList" class="space-y-0.5 max-h-[360px] overflow-y-auto">
                  <!-- Rendered via Stimulus -->
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: Global View, Logs, Alerts, Dark Mode, Notification & User -->
        <div class="flex items-center space-x-2 sm:space-x-3.5 pl-2 flex-shrink-0">
          <%= link_to "Global View", map_path, class: "hidden lg:inline-block text-xs font-bold text-sketch hover:text-accent transition-colors" %>
          <%= link_to "Logs", analytics_path, class: "hidden lg:inline-block text-xs font-bold text-sketch hover:text-accent transition-colors" %>
          <%= link_to "Help", overview_path, class: "hidden sm:inline-block text-xs font-bold text-sketch hover:text-accent transition-colors" %>

          <!-- Desktop QR Code Modal Trigger -->
          <button type="button"
                  data-action="click->qr-modal#open"
                  title="Scan QR Code on Mobile"
                  class="hidden sm:inline-flex items-center p-2 rounded-full text-sketch hover:text-accent hover:bg-ink/5 transition-colors cursor-pointer">
            <i class="fas fa-qrcode text-sm"></i>
          </button>

          <!-- Dark/Light Mode Icon Toggle -->
          <button type="button"
                  data-action="click->theme#toggle"
                  title="Toggle Light / Dark Mode"
                  class="p-2 rounded-full text-accent hover:opacity-80 hover:bg-ink/5 transition-colors cursor-pointer">
            <i data-theme-target="icon" class="fas fa-moon text-sm"></i>
          </button>

          <!-- Notification Bell with Active Indicator -->
          <%= link_to emergencies_path, title: "Emergency Notifications", class: "relative p-2 text-sketch hover:text-ink transition-colors" do %>
            <i class="fas fa-bell text-sm"></i>
            <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-red-500 ring-2 ring-surface"></span>
          <% end %>

          <!-- User Profile & Auth Controls -->
          <% if authenticated? %>
            <div class="flex items-center space-x-1.5 sm:space-x-2">
              <%= link_to profile_path, class: "w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-accent text-white font-bold flex items-center justify-center text-xs shadow-sm overflow-hidden ring-2 ring-ink/10 hover:ring-accent transition-all flex-shrink-0" do %>
                <% if current_user.avatar_url.present? %>
                  <img src="<%= current_user.avatar_url %>" alt="" class="w-full h-full object-cover">
                <% else %>
                  <span><%= current_user.initials %></span>
                <% end %>
              <% end %>

              <!-- Logout Button -->
              <%= button_to logout_path, method: :delete, title: "Sign Out", class: "inline-flex items-center p-1.5 sm:px-2.5 sm:py-1 text-xs font-bold rounded-lg text-sketch hover:text-red-500 hover:bg-red-500/10 transition-colors cursor-pointer" do %>
                <i class="fas fa-sign-out-alt text-xs sm:mr-1"></i>
                <span class="hidden sm:inline">Logout</span>
              <% end %>
            </div>
          <% else %>
            <%= link_to "Sign In", login_path, class: "px-3 sm:px-3.5 py-1.5 bg-ink hover:bg-ink/90 text-paper font-black text-xs rounded-xl shadow-sm transition-colors" %>
          <% end %>
        </div>
      </header>

      <!-- Page Content Area -->
      <main class="flex-1 overflow-x-hidden overflow-y-auto p-3 sm:p-6 lg:p-8 bg-paper">
        <% if flash[:notice] %>
          <div data-controller="flash"
               data-flash-timeout-value="3500"
               data-action="mouseenter->flash#pause mouseleave->flash#resume"
               class="mb-6 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 px-4 py-3 rounded-2xl flex items-center justify-between shadow-sm transition-all">
            <div class="flex items-center space-x-3">
              <i class="fas fa-check-circle text-emerald-600 dark:text-emerald-400 text-base flex-shrink-0"></i>
              <span class="text-xs font-bold"><%= flash[:notice] %></span>
            </div>
            <button type="button"
                    data-action="click->flash#dismiss"
                    title="Dismiss"
                    class="ml-3 text-emerald-700/60 dark:text-emerald-300/60 hover:text-emerald-900 dark:hover:text-white transition-colors cursor-pointer p-1">
              <i class="fas fa-times text-xs"></i>
            </button>
          </div>
        <% end %>

        <% if flash[:alert] %>
          <div data-controller="flash"
               data-flash-timeout-value="5000"
               data-action="mouseenter->flash#pause mouseleave->flash#resume"
               class="mb-6 bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800 text-red-900 dark:text-red-200 px-4 py-3 rounded-2xl flex items-center justify-between shadow-sm transition-all">
            <div class="flex items-center space-x-3">
              <i class="fas fa-exclamation-circle text-red-600 dark:text-red-400 text-base flex-shrink-0"></i>
              <span class="text-xs font-bold"><%= flash[:alert] %></span>
            </div>
            <button type="button"
                    data-action="click->flash#dismiss"
                    title="Dismiss"
                    class="ml-3 text-red-700/60 dark:text-red-300/60 hover:text-red-900 dark:hover:text-white transition-colors cursor-pointer p-1">
              <i class="fas fa-times text-xs"></i>
            </button>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>

    <!-- Desktop QR Code Modal Overlay -->
    <div data-qr-modal-target="backdrop"
         data-action="click->qr-modal#close"
         class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden transition-opacity"></div>

    <div data-qr-modal-target="modal"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden pointer-events-none">
      <div class="pointer-events-auto max-w-2xl w-full relative">
        <button type="button"
                data-action="click->qr-modal#close"
                title="Close Modal"
                class="absolute top-4 right-4 z-10 w-8 h-8 rounded-full bg-surface sketch-border-soft text-mute hover:text-ink hover:border-accent flex items-center justify-center text-sm shadow-sm transition-all cursor-pointer">
          <i class="fas fa-times"></i>
        </button>
        <%= render "shared/qr_code_card", title: "Scan to Open ENMA AI", subtitle: "Open this live operational command platform on your smartphone or tablet." %>
      </div>
    </div>

    <!-- Global Search Command Palette Modal (⌘K Spotlight) -->
    <div data-search-modal-target="backdrop"
         data-action="click->search-modal#close"
         class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 hidden transition-opacity"></div>

    <div data-search-modal-target="modal"
         class="fixed inset-0 z-50 flex items-start justify-center pt-14 sm:pt-20 p-4 hidden pointer-events-none">
      <div class="pointer-events-auto max-w-xl w-full bg-surface sketch-border rounded-2xl shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150 flex flex-col">
        
        <!-- Modal Search Header Input -->
        <div class="p-3.5 border-b border-[var(--line)] flex items-center gap-3 bg-surface">
          <i class="fas fa-search text-accent text-sm ml-1"></i>
          <input type="text"
                 data-search-modal-target="input"
                 data-action="input->search-modal#onInput keydown->search-modal#onKeydown"
                 placeholder="Search nodes, corridors, relief depots, emergencies..."
                 autocomplete="off"
                 class="w-full bg-transparent text-ink placeholder:text-mute text-sm font-medium focus:outline-none">
          <button type="button"
                  data-action="click->search-modal#close"
                  class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-ink/5 border border-ink/15 text-mute hover:text-ink cursor-pointer">
            ESC
          </button>
        </div>

        <!-- Quick Filter Tags -->
        <div class="px-4 py-2 border-b border-[var(--line)]/50 bg-paper/50 flex items-center gap-1.5 overflow-x-auto text-[11px]">
          <span class="text-[10px] font-bold text-mute uppercase mr-1 flex-shrink-0">Quick:</span>
          <button type="button" data-action="click->search-modal#setQuery" data-query="Tawang" class="px-2.5 py-0.5 rounded-full sketch-border-soft bg-surface hover:border-accent text-ink text-[11px] cursor-pointer flex-shrink-0">📍 Tawang</button>
          <button type="button" data-action="click->search-modal#setQuery" data-query="NH-13" class="px-2.5 py-0.5 rounded-full sketch-border-soft bg-surface hover:border-accent text-ink text-[11px] cursor-pointer flex-shrink-0">🛣️ NH-13</button>
          <button type="button" data-action="click->search-modal#setQuery" data-query="Depot" class="px-2.5 py-0.5 rounded-full sketch-border-soft bg-surface hover:border-accent text-ink text-[11px] cursor-pointer flex-shrink-0">🏢 Warehouses</button>
          <button type="button" data-action="click->search-modal#setQuery" data-query="Landslide" class="px-2.5 py-0.5 rounded-full sketch-border-soft bg-surface hover:border-accent text-ink text-[11px] cursor-pointer flex-shrink-0">🚨 Landslides</button>
          <button type="button" data-action="click->search-modal#setQuery" data-query="Guwahati" class="px-2.5 py-0.5 rounded-full sketch-border-soft bg-surface hover:border-accent text-ink text-[11px] cursor-pointer flex-shrink-0">📍 Guwahati</button>
        </div>

        <!-- Suggestions List -->
        <ul data-search-modal-target="resultsList" class="p-2 space-y-0.5 max-h-[360px] overflow-y-auto">
          <!-- Populated dynamically via search_modal_controller -->
        </ul>

        <!-- Modal Footer with Keyboard Shortcuts -->
        <div class="px-4 py-2.5 bg-paper/60 border-t border-[var(--line)] flex items-center justify-between text-[11px] text-mute font-mono">
          <div class="flex items-center space-x-3">
            <span><kbd class="px-1.5 py-0.5 rounded bg-ink/5 border border-ink/15 font-mono">↑↓</kbd> navigate</span>
            <span><kbd class="px-1.5 py-0.5 rounded bg-ink/5 border border-ink/15 font-mono">↵</kbd> open</span>
            <span><kbd class="px-1.5 py-0.5 rounded bg-ink/5 border border-ink/15 font-mono">esc</kbd> close</span>
          </div>
          <span class="text-[10px] text-accent font-semibold">ENMA AI Global Index</span>
        </div>

      </div>
    </div>
  </body>
</html>
