<!DOCTYPE html>
<html>
  <head>
    <title>ENMA AI - North East Smart Logistics &amp; Accessibility Intelligence</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com" nonce="<%= request.content_security_policy_nonce %>"></script>
  </head>

  <body class="flex h-screen bg-gray-100 font-sans">
    <!-- Left Sidebar Navigation -->
    <aside class="w-64 bg-gray-800 text-white flex flex-col">
      <div class="p-4 border-b border-gray-700">
        <div class="flex items-center space-x-2">
          <span class="text-2xl">⚡</span>
          <h1 class="text-2xl font-bold tracking-tight text-white">ENMA AI</h1>
        </div>
        <p class="text-xs text-gray-400 mt-1">Smart Logistics &amp; Accessibility Intelligence</p>
      </div>
      <nav class="flex-1 p-4 space-y-1.5">
        <%= link_to root_path, class: "flex items-center space-x-2.5 py-2.5 px-4 rounded-lg #{current_page?(root_path) ? 'bg-blue-600 text-white font-medium shadow-sm' : 'text-gray-300 hover:bg-gray-700 hover:text-white'} transition-colors duration-150" do %>
          <span>🏠</span>
          <span>Dashboard</span>
        <% end %>

        <%= link_to locations_path, class: "flex items-center space-x-2.5 py-2.5 px-4 rounded-lg #{current_page?(locations_path) ? 'bg-blue-600 text-white font-medium shadow-sm' : 'text-gray-300 hover:bg-gray-700 hover:text-white'} transition-colors duration-150" do %>
          <span>📍</span>
          <span>Locations</span>
        <% end %>

        <%= link_to map_path, class: "flex items-center space-x-2.5 py-2.5 px-4 rounded-lg #{current_page?(map_path) ? 'bg-blue-600 text-white font-medium shadow-sm' : 'text-gray-300 hover:bg-gray-700 hover:text-white'} transition-colors duration-150" do %>
          <span>🗺</span>
          <span>GIS Map</span>
        <% end %>

        <%= link_to accessibility_path, class: "flex items-center space-x-2.5 py-2.5 px-4 rounded-lg #{request.path.start_with?('/accessibility') ? 'bg-blue-600 text-white font-medium shadow-sm' : 'text-gray-300 hover:bg-gray-700 hover:text-white'} transition-colors duration-150" do %>
          <span>⚡</span>
          <span>Accessibility Engine</span>
        <% end %>

        <%= link_to routes_path, class: "flex items-center space-x-2.5 py-2.5 px-4 rounded-lg #{request.path.start_with?('/routes') ? 'bg-blue-600 text-white font-medium shadow-sm' : 'text-gray-300 hover:bg-gray-700 hover:text-white'} transition-colors duration-150" do %>
          <span>🚚</span>
          <span>Smart Route Planner</span>
        <% end %>

        <button type="button" disabled class="w-full flex items-center space-x-2.5 py-2.5 px-4 rounded-lg text-gray-500 cursor-not-allowed">
          <span>🚨</span>
          <span>Emergencies (Coming Soon)</span>
        </button>

        <button type="button" disabled class="w-full flex items-center space-x-2.5 py-2.5 px-4 rounded-lg text-gray-500 cursor-not-allowed">
          <span>📊</span>
          <span>Analytics (Coming Soon)</span>
        </button>
      </nav>
      <div class="p-4 border-t border-gray-700 text-xs text-gray-400 text-center">
        Smart India Hackathon 2026
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden">
      <!-- Top Navigation Bar -->
      <header class="flex justify-between items-center p-4 bg-white border-b border-gray-200 shadow-sm">
        <div class="text-lg font-semibold text-gray-800 flex items-center space-x-2">
          <span>ENMA AI • North East Logistics Intelligence</span>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-800 font-semibold uppercase tracking-wide">Phase 5 Active</span>
        </div>
        <div class="flex items-center space-x-3 text-sm text-gray-600">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
          <span>Good Morning, Administrator</span>
        </div>
      </header>

      <!-- Page Content -->
      <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100 p-6">
        <% if flash[:notice] %>
          <div class="mb-6 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-xl flex items-center shadow-sm">
            <i class="fas fa-check-circle text-green-600 mr-3 text-lg"></i>
            <span class="text-sm font-medium"><%= flash[:notice] %></span>
          </div>
        <% end %>

        <% if flash[:alert] %>
          <div class="mb-6 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl flex items-center shadow-sm">
            <i class="fas fa-exclamation-circle text-red-600 mr-3 text-lg"></i>
            <span class="text-sm font-medium"><%= flash[:alert] %></span>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
