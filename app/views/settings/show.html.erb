<div class="space-y-6 max-w-4xl mx-auto pb-12">
  <!-- Page Header -->
  <div class="border-b border-slate-200 dark:border-slate-800 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <div class="flex items-center space-x-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-accent/15 dark:bg-accent/10 text-accent dark:text-accent border border-accent/20 dark:border-accent/20">
          Account Security
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">Security &amp; Credentials Settings</h2>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Manage your operational authentication, password credentials, and third-party Single Sign-On (SSO) links.</p>
    </div>
  </div>

  <!-- Password Change Section -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 md:p-8 space-y-6">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
      <div>
        <h3 class="text-sm font-black text-slate-900 dark:text-white flex items-center">
          <i class="fas fa-shield-alt text-accent dark:text-accent mr-2 text-xs"></i>
          <span>Update Account Password</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Ensure your account uses a strong password of at least 8 characters.</p>
      </div>
      <% if @user.encrypted_password.present? %>
        <span class="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">Password Active</span>
      <% else %>
        <span class="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">SSO Only (No Password)</span>
      <% end %>
    </div>

    <%= form_with url: update_password_settings_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-4" do |f| %>
      <% if @user.encrypted_password.present? %>
        <div>
          <%= f.label :current_password, "Current Password", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :current_password,
                               required: true,
                               placeholder: "••••••••",
                               class: "w-full max-w-sm px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :new_password, "New Password", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :new_password,
                               required: true,
                               placeholder: "Minimum 8 characters",
                               class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password_confirmation,
                               required: true,
                               placeholder: "Repeat new password",
                               class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>
      </div>

      <div class="pt-2">
        <%= f.submit "Update Password",
                     class: "inline-flex items-center justify-center px-6 py-2.5 bg-accent hover:opacity-90 text-white font-black text-xs rounded-xl shadow-md transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Connected Accounts Section -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 md:p-8 space-y-6">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
      <div>
        <h3 class="text-sm font-black text-slate-900 dark:text-white flex items-center">
          <i class="fas fa-link text-accent dark:text-accent mr-2 text-xs"></i>
          <span>Connected Single Sign-On (SSO) Accounts</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Link or disconnect third-party identity providers to your ENMA AI credentials.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Google SSO Card -->
      <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 flex flex-col justify-between space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-white dark:bg-slate-800 shadow-sm border border-slate-200 dark:border-slate-700 flex items-center justify-center text-lg text-red-500 flex-shrink-0">
              <i class="fab fa-google"></i>
            </div>
            <div>
              <span class="font-bold text-sm text-slate-900 dark:text-white block">Google Account</span>
              <span class="text-xs text-slate-500 dark:text-slate-400">
                <%= @user.provider.to_s.include?("google") ? "Connected to profile" : "Not connected" %>
              </span>
            </div>
          </div>

          <% if @user.provider.to_s.include?("google") %>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
              <i class="fas fa-check-circle mr-1"></i> Active
            </span>
          <% else %>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold text-slate-500 dark:text-slate-400 bg-slate-200/80 dark:bg-slate-800">
              Unlinked
            </span>
          <% end %>
        </div>

        <div class="pt-2 border-t border-slate-200 dark:border-slate-700/60 flex items-center justify-between gap-2">
          <% if @user.provider.to_s.include?("google") %>
            <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">UID: <%= @user.uid %></span>
            <%= form_with url: disconnect_sso_settings_path, method: :delete, local: true, data: { turbo: false } do |f| %>
              <button type="submit" class="px-3.5 py-1.5 bg-red-50 dark:bg-red-950 hover:bg-red-100 dark:hover:bg-red-900 text-red-700 dark:text-red-300 text-xs font-bold rounded-xl border border-red-200 dark:border-red-800 transition-colors cursor-pointer flex items-center">
                <i class="fas fa-unlink mr-1.5 text-xs"></i>
                <span>Disconnect</span>
              </button>
            <% end %>
          <% else %>
            <%= form_with url: connect_sso_settings_path(provider: "google"), method: :post, local: true, data: { turbo: false }, class: "w-full" do |f| %>
              <button type="submit" class="w-full py-2.5 px-3 bg-red-600 hover:bg-red-700 text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center cursor-pointer">
                <i class="fab fa-google mr-2 text-xs"></i>
                <span>Connect Google</span>
              </button>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- GitHub SSO Card -->
      <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 flex flex-col justify-between space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-white dark:bg-slate-800 shadow-sm border border-slate-200 dark:border-slate-700 flex items-center justify-center text-lg text-slate-900 dark:text-white flex-shrink-0">
              <i class="fab fa-github"></i>
            </div>
            <div>
              <span class="font-bold text-sm text-slate-900 dark:text-white block">GitHub Account</span>
              <span class="text-xs text-slate-500 dark:text-slate-400">
                <%= @user.provider.to_s.include?("github") ? "Connected to profile" : "Not connected" %>
              </span>
            </div>
          </div>

          <% if @user.provider.to_s.include?("github") %>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
              <i class="fas fa-check-circle mr-1"></i> Active
            </span>
          <% else %>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold text-slate-500 dark:text-slate-400 bg-slate-200/80 dark:bg-slate-800">
              Unlinked
            </span>
          <% end %>
        </div>

        <div class="pt-2 border-t border-slate-200 dark:border-slate-700/60 flex items-center justify-between gap-2">
          <% if @user.provider.to_s.include?("github") %>
            <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">UID: <%= @user.uid %></span>
            <%= form_with url: disconnect_sso_settings_path, method: :delete, local: true, data: { turbo: false } do |f| %>
              <button type="submit" class="px-3.5 py-1.5 bg-red-50 dark:bg-red-950 hover:bg-red-100 dark:hover:bg-red-900 text-red-700 dark:text-red-300 text-xs font-bold rounded-xl border border-red-200 dark:border-red-800 transition-colors cursor-pointer flex items-center">
                <i class="fas fa-unlink mr-1.5 text-xs"></i>
                <span>Disconnect</span>
              </button>
            <% end %>
          <% else %>
            <%= form_with url: connect_sso_settings_path(provider: "github"), method: :post, local: true, data: { turbo: false }, class: "w-full" do |f| %>
              <button type="submit" class="w-full py-2.5 px-3 bg-slate-900 hover:bg-black dark:bg-slate-800 dark:hover:bg-slate-700 text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center cursor-pointer">
                <i class="fab fa-github mr-2 text-xs"></i>
                <span>Connect GitHub</span>
              </button>
            <% end %>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
