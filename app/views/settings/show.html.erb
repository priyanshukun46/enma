<div class="space-y-6 max-w-4xl mx-auto pb-12">
  <!-- Page Header -->
  <div class="border-b border-gray-200 pb-4 flex items-center justify-between">
    <div>
      <div class="flex items-center space-x-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-indigo-100 text-indigo-800 border border-indigo-200">
          Account Security
        </span>
        <h2 class="text-2xl font-black text-gray-900 tracking-tight">Security &amp; Credentials Settings</h2>
      </div>
      <p class="text-xs text-gray-500 mt-1">Manage your operational authentication, password credentials, and third-party Single Sign-On (SSO) links.</p>
    </div>
  </div>

  <!-- Password Change Section -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 space-y-6">
    <div class="border-b border-gray-100 pb-3 flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-gray-900 flex items-center">
          <i class="fas fa-shield-alt text-indigo-600 mr-2"></i>
          Update Account Password
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Ensure your account uses a strong password of at least 8 characters.</p>
      </div>
      <% if @user.password_digest.present? %>
        <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-green-50 text-green-700 border border-green-200">Password Active</span>
      <% else %>
        <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">SSO Only (No Password)</span>
      <% end %>
    </div>

    <%= form_with url: update_password_settings_path, method: :patch, local: true, class: "space-y-4" do |f| %>
      <% if @user.password_digest.present? %>
        <div>
          <%= f.label :current_password, "Current Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :current_password,
                               required: true,
                               placeholder: "••••••••",
                               class: "w-full sm:w-80 px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :new_password, "New Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :new_password,
                               required: true,
                               placeholder: "Minimum 8 characters",
                               class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password_confirmation,
                               required: true,
                               placeholder: "Repeat new password",
                               class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>
      </div>

      <div class="pt-2">
        <%= f.submit "Update Password",
                     class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs rounded-xl shadow-md transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Connected Accounts Section -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 space-y-6">
    <div class="border-b border-gray-100 pb-3 flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-gray-900 flex items-center">
          <i class="fas fa-link text-indigo-600 mr-2"></i>
          Connected Single Sign-On (SSO) Accounts
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Link or disconnect third-party identity providers to your ENMA AI credentials.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Google SSO Card -->
      <div class="p-5 rounded-2xl border border-gray-200 bg-gray-50/70 flex flex-col justify-between space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-white shadow-sm border border-gray-200 flex items-center justify-center text-lg text-red-500">
              <i class="fab fa-google"></i>
            </div>
            <div>
              <span class="font-bold text-sm text-gray-900 block">Google Account</span>
              <span class="text-xs text-gray-500">
                <%= @user.provider.to_s.include?("google") ? "Connected to profile" : "Not connected" %>
              </span>
            </div>
          </div>

          <% if @user.provider.to_s.include?("google") %>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-emerald-100 text-emerald-800 border border-emerald-300">
              <i class="fas fa-check-circle mr-1"></i> Active
            </span>
          <% else %>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold text-gray-500 bg-gray-200/80">
              Unlinked
            </span>
          <% end %>
        </div>

        <div class="pt-2 border-t border-gray-200 flex items-center justify-between gap-2">
          <% if @user.provider.to_s.include?("google") %>
            <span class="text-[11px] text-gray-500 font-mono truncate">UID: <%= @user.uid %></span>
            <%= button_to disconnect_sso_settings_path, method: :delete, class: "px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 text-xs font-bold rounded-lg border border-red-200 transition-colors cursor-pointer" do %>
              <i class="fas fa-unlink mr-1"></i> Disconnect
            <% end %>
          <% else %>
            <div class="flex items-center space-x-2 w-full">
              <%= button_to connect_sso_settings_path(provider: "google"), method: :post, class: "flex-1 py-2 px-3 bg-red-600 hover:bg-red-700 text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center cursor-pointer" do %>
                <i class="fab fa-google mr-1.5"></i>
                <span>Connect Google</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- GitHub SSO Card -->
      <div class="p-5 rounded-2xl border border-gray-200 bg-gray-50/70 flex flex-col justify-between space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-white shadow-sm border border-gray-200 flex items-center justify-center text-lg text-gray-900">
              <i class="fab fa-github"></i>
            </div>
            <div>
              <span class="font-bold text-sm text-gray-900 block">GitHub Account</span>
              <span class="text-xs text-gray-500">
                <%= @user.provider.to_s.include?("github") ? "Connected to profile" : "Not connected" %>
              </span>
            </div>
          </div>

          <% if @user.provider.to_s.include?("github") %>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-emerald-100 text-emerald-800 border border-emerald-300">
              <i class="fas fa-check-circle mr-1"></i> Active
            </span>
          <% else %>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold text-gray-500 bg-gray-200/80">
              Unlinked
            </span>
          <% end %>
        </div>

        <div class="pt-2 border-t border-gray-200 flex items-center justify-between gap-2">
          <% if @user.provider.to_s.include?("github") %>
            <span class="text-[11px] text-gray-500 font-mono truncate">UID: <%= @user.uid %></span>
            <%= button_to disconnect_sso_settings_path, method: :delete, class: "px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 text-xs font-bold rounded-lg border border-red-200 transition-colors cursor-pointer" do %>
              <i class="fas fa-unlink mr-1"></i> Disconnect
            <% end %>
          <% else %>
            <div class="flex items-center space-x-2 w-full">
              <%= button_to connect_sso_settings_path(provider: "github"), method: :post, class: "flex-1 py-2 px-3 bg-gray-900 hover:bg-black text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center cursor-pointer" do %>
                <i class="fab fa-github mr-1.5"></i>
                <span>Connect GitHub</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
