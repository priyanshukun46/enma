<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header -->
  <div class="pb-4 border-b border-gray-200 flex items-center justify-between">
    <div>
      <h2 class="text-3xl font-black text-gray-900 tracking-tight">Account &amp; Security Settings</h2>
      <p class="text-xs text-gray-600 mt-0.5">Manage authentication credentials, password security, and OAuth linkages.</p>
    </div>
  </div>

  <!-- Security / Password Section -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 space-y-5">
    <div class="border-b border-gray-100 pb-3 flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-gray-900 flex items-center">
          <i class="fas fa-lock text-indigo-600 mr-2"></i>
          Password &amp; Security
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Update account password and authentication keys.</p>
      </div>
    </div>

    <% if @user.password_digest.present? %>
      <%= form_with url: update_password_settings_path, method: :patch, local: true, class: "space-y-4 max-w-xl" do |f| %>
        <div>
          <%= f.label :current_password, "Current Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :current_password,
                               required: true,
                               placeholder: "••••••••",
                               class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div>
          <%= f.label :new_password, "New Password (Min 8 Characters)", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :new_password,
                               required: true,
                               placeholder: "••••••••",
                               class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password_confirmation,
                               required: true,
                               placeholder: "••••••••",
                               class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900 bg-gray-50/50 hover:bg-white transition-colors" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Update Password",
                       class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-md transition-colors cursor-pointer" %>
        </div>
      <% end %>
    <% else %>
      <div class="p-4 rounded-xl bg-gray-50 border border-gray-200 text-xs text-gray-700 space-y-2">
        <p class="font-bold flex items-center text-gray-900">
          <i class="fas fa-info-circle text-indigo-600 mr-2"></i>
          OAuth Authentication Active
        </p>
        <p>This account is authenticated securely via <strong><%= @user.provider_label %></strong>. Direct password authentication is not configured.</p>
      </div>
    <% end %>
  </div>

  <!-- Connected Accounts Section -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 space-y-5">
    <div class="border-b border-gray-100 pb-3 flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-gray-900 flex items-center">
          <i class="fas fa-link text-indigo-600 mr-2"></i>
          Connected Single Sign-On (SSO) Accounts
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Third-party identity providers linked to your ENMA AI credentials.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Google SSO -->
      <div class="p-4 rounded-xl border border-gray-200 bg-gray-50/70 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-white shadow-sm border border-gray-200 flex items-center justify-center text-lg text-red-500">
            <i class="fab fa-google"></i>
          </div>
          <div>
            <span class="font-bold text-sm text-gray-900 block">Google Account</span>
            <span class="text-xs text-gray-500"><%= @user.provider.to_s.include?("google") ? "Connected" : "Not connected" %></span>
          </div>
        </div>

        <% if @user.provider.to_s.include?("google") %>
          <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-green-100 text-green-800 border border-green-200">
            Active
          </span>
        <% else %>
          <span class="text-xs text-gray-400 font-medium">Available</span>
        <% end %>
      </div>

      <!-- GitHub SSO -->
      <div class="p-4 rounded-xl border border-gray-200 bg-gray-50/70 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-white shadow-sm border border-gray-200 flex items-center justify-center text-lg text-gray-900">
            <i class="fab fa-github"></i>
          </div>
          <div>
            <span class="font-bold text-sm text-gray-900 block">GitHub Account</span>
            <span class="text-xs text-gray-500"><%= @user.provider.to_s.include?("github") ? "Connected" : "Not connected" %></span>
          </div>
        </div>

        <% if @user.provider.to_s.include?("github") %>
          <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-green-100 text-green-800 border border-green-200">
            Active
          </span>
        <% else %>
          <span class="text-xs text-gray-400 font-medium">Available</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
