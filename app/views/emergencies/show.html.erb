<div class="space-y-6 max-w-7xl mx-auto pb-12">
  <!-- Navigation Breadcrumb & Quick Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 border-b border-slate-200 dark:border-slate-800 gap-3">
    <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400">
      <%= link_to emergencies_path, class: "text-accent dark:text-accent hover:underline font-bold flex items-center" do %>
        <i class="fas fa-arrow-left mr-1.5 text-xs"></i>
        <span>Disaster Registry</span>
      <% end %>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-black">Mission: <%= @emergency.title.truncate(30) %></span>
    </div>

    <!-- Status Change & Plan Trigger Actions -->
    <div class="flex flex-wrap items-center gap-2">
      <%= form_with url: generate_plan_emergency_path(@emergency), method: :post, local: true do %>
        <button type="submit" class="px-3.5 py-1.5 bg-accent hover:opacity-90 text-white font-black text-xs rounded-xl shadow-sm cursor-pointer transition-colors flex items-center space-x-1.5">
          <i class="fas fa-sync-alt text-[10px]"></i>
          <span>Regenerate AI Plan</span>
        </button>
      <% end %>

      <%= link_to export_briefing_emergency_path(@emergency, format: :txt), class: "px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-bold text-xs rounded-xl transition-colors flex items-center space-x-1.5" do %>
        <i class="fas fa-file-download text-[10px]"></i>
        <span>Export Briefing</span>
      <% end %>

      <!-- Status Change Form -->
      <%= form_with url: update_status_emergency_path(@emergency), method: :patch, local: true, class: "flex items-center space-x-1.5" do |f| %>
        <%= select_tag :status,
                       options_for_select(%w[Active Responding Monitoring Resolved], @emergency.status),
                       class: "text-xs font-bold px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-red-500 text-slate-900 dark:text-white" %>
        <%= f.submit "Update", class: "px-3 py-1.5 bg-slate-900 hover:bg-slate-800 dark:bg-slate-700 dark:hover:bg-slate-600 text-white font-bold text-xs rounded-xl cursor-pointer transition-colors" %>
      <% end %>
    </div>
  </div>

  <!-- Big Emergency Alert Banner (Google Stitch High-Contrast Design) -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 shadow-sm border-l-4 <%= @emergency.severity.to_s.downcase == 'critical' ? 'border-l-red-600' : (@emergency.severity.to_s.downcase.include?('med') ? 'border-l-amber-500' : 'border-l-emerald-500') %> border-t border-r border-b border-slate-200 dark:border-slate-800 space-y-4">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="space-y-3 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-100 dark:bg-red-950 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800 flex items-center">
            <i class="fas fa-exclamation-triangle mr-1.5 text-red-600"></i>
            <%= @emergency.status.upcase %> EMERGENCY
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
            <%= @analysis[:severity_level] %> SEVERITY (<%= @analysis[:severity_score] %>/100)
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            <%= @emergency.emergency_type %>
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
            <%= @analysis.dig(:weather_context, :source) == "live" ? "Live Weather Ingested" : "Baseline Weather Telemetry" %>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white"><%= @emergency.title %></h1>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-4xl leading-relaxed">
          <%= @emergency.description.presence || "Active #{(@emergency.emergency_type || 'hazard').downcase} incident detected in North East logistics corridor. Automated spatial buffer, community priority index, and relief dispatch routing initiated." %>
        </p>

        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400 font-mono pt-1">
          <span class="flex items-center"><i class="fas fa-crosshairs mr-1.5 text-red-500"></i> Epicenter: <%= @emergency.latitude.round(4) %>°N, <%= @emergency.longitude.round(4) %>°E</span>
          <span>&bull;</span>
          <span class="flex items-center"><i class="fas fa-bullseye mr-1.5 text-amber-500"></i> Radius: <%= @emergency.affected_radius %> km</span>
          <% if @emergency.simulated_at %>
            <span>&bull;</span>
            <span class="flex items-center"><i class="far fa-clock mr-1.5 text-accent"></i> Triggered: <%= @emergency.simulated_at.strftime("%b %d, %H:%M") %></span>
          <% end %>
        </div>
      </div>

      <!-- Threat Level Gauge -->
      <div class="flex-shrink-0 bg-red-50 dark:bg-red-950/60 rounded-2xl p-5 border border-red-200 dark:border-red-900/60 text-center min-w-[200px]">
        <span class="text-[10px] uppercase tracking-wider font-bold text-red-700 dark:text-red-400 block">Threat Score</span>
        <div class="text-3xl sm:text-4xl font-black text-red-700 dark:text-red-300 mt-1">
          <%= @analysis[:severity_score] %><span class="text-lg font-bold text-red-500">/100</span>
        </div>
        <span class="text-xs text-red-600 dark:text-red-400 font-bold block mt-1"><%= @analysis[:severity_level] %> LEVEL</span>
      </div>
    </div>
  </div>

  <!-- Key Impact Statistics Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5">
      <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Affected Communities</p>
      <div class="mt-2 flex items-baseline justify-between">
        <span class="text-3xl font-black text-slate-900 dark:text-white"><%= @analysis[:affected_count] %></span>
        <span class="text-xs font-bold text-accent dark:text-accent bg-accent/10 dark:bg-accent/10 px-2 py-0.5 rounded">Within <%= @emergency.affected_radius %> km</span>
      </div>
      <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">Populated settlements under hazard exposure.</p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5">
      <p class="text-xs font-bold text-red-600 dark:text-red-400 uppercase tracking-wider">Immediate Response</p>
      <div class="mt-2 flex items-baseline justify-between">
        <span class="text-3xl font-black text-red-600 dark:text-red-400"><%= @analysis[:critical_count] %></span>
        <span class="text-xs font-bold text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/80 px-2 py-0.5 rounded">Priority &ge; 75</span>
      </div>
      <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">High vulnerability &amp; access cutoff.</p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5">
      <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Population at Risk</p>
      <div class="mt-2 flex items-baseline justify-between">
        <span class="text-3xl font-black text-slate-900 dark:text-white"><%= number_with_delimiter(@analysis[:total_population_at_risk]) %></span>
        <span class="text-xs font-bold text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/80 px-2 py-0.5 rounded">Civilians</span>
      </div>
      <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">Cumulative population across sectors.</p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5">
      <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Accessibility Impact</p>
      <div class="mt-2 flex items-baseline justify-between">
        <span class="text-2xl font-black <%= @analysis[:accessibility_impact_level] == 'CRITICAL' ? 'text-red-600 dark:text-red-400' : 'text-orange-600 dark:text-orange-400' %>">
          <%= @analysis[:accessibility_impact_level] %>
        </span>
        <span class="text-xs font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded">Supply Index</span>
      </div>
      <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">Corridor throughput degradation.</p>
    </div>
  </div>

  <!-- STRUCTURED AI EMERGENCY RESPONSE PLAN CARD -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 shadow-sm border-2 border-accent dark:border-accent space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-slate-100 dark:border-slate-800 pb-4 gap-3">
      <div>
        <div class="flex items-center space-x-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-accent/15 dark:bg-accent/10 text-accent dark:text-accent border border-accent/20 dark:border-accent/20 flex items-center">
            <i class="fas fa-brain mr-1"></i> ResQWay DECISION SUPPORT SYSTEM
          </span>
          <span class="text-[10px] font-mono text-slate-400">Plan #<%= @response_plan.id %> &bull; <%= @response_plan.generated_at&.strftime("%H:%M:%S UTC") || "Active" %></span>
        </div>
        <h2 class="text-xl font-black text-slate-900 dark:text-white mt-1">Operational Disaster Action Plan</h2>
      </div>

      <div class="flex items-center space-x-2">
        <% if @analysis[:recommended_warehouse] && @analysis[:affected_communities].first %>
          <% wh = @analysis[:recommended_warehouse] %>
          <% comm = @analysis[:affected_communities].first %>
          <%= button_to calculate_routes_path(origin_id: wh[:id], destination_id: comm[:id], vehicle_type: "Emergency Vehicle"), method: :post, class: "px-3.5 py-1.5 bg-accent/10 hover:bg-accent/15 dark:bg-accent/10 dark:hover:bg-accent/15 text-accent dark:text-accent font-bold text-xs rounded-xl transition-colors flex items-center cursor-pointer border border-accent/20 dark:border-accent/20" do %>
            <i class="fas fa-route text-xs mr-1.5"></i>
            <span>Open in Route Planner</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- 7-Question Intelligence Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block">1. Incident Severity</span>
        <div class="text-base font-black text-slate-900 dark:text-white mt-1"><%= @analysis[:severity_level] %> (<%= @analysis[:severity_score] %>/100)</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1"><%= @analysis[:emergency_type] %> with active weather exposure.</p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block">2. Population at Risk</span>
        <div class="text-base font-black text-slate-900 dark:text-white mt-1"><%= number_with_delimiter(@analysis[:total_population_at_risk]) %> Civilians</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1"><%= @analysis[:affected_count] %> populated community nodes.</p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block">3. Designated Hub</span>
        <div class="text-base font-black text-emerald-600 dark:text-emerald-400 mt-1"><%= @analysis.dig(:recommended_warehouse, :name) || "Guwahati Hub" %></div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Score: <%= @analysis.dig(:recommended_warehouse, :recommendation_score) || 90 %>/100 &bull; <%= number_with_delimiter(@analysis.dig(:recommended_warehouse, :capacity)) %> units.</p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block">4. Est. Response ETA</span>
        <div class="text-base font-black text-accent dark:text-accent mt-1"><%= @analysis.dig(:emergency_route, :estimated_time) || "3.5 hrs" %></div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1"><%= @analysis.dig(:emergency_route, :distance_km) %> km via <%= @analysis.dig(:emergency_route, :route_title) %>.</p>
      </div>
    </div>

    <!-- Primary Risks & Action Directives -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-2">
      <!-- Primary Risks Identified -->
      <div class="space-y-3">
        <h4 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-radiation-alt text-amber-500 mr-2"></i>
          Primary Risks Identified
        </h4>
        <div class="space-y-2">
          <% @analysis[:primary_risks].each do |risk| %>
            <div class="p-3 rounded-xl bg-amber-50/60 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-900/60 text-xs text-amber-900 dark:text-amber-200 flex items-start space-x-2.5">
              <i class="fas fa-exclamation-circle text-amber-600 dark:text-amber-400 mt-0.5 flex-shrink-0"></i>
              <span><%= risk %></span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Tactical Directives -->
      <div class="space-y-3">
        <h4 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-tasks text-accent mr-2"></i>
          Tactical Action Directives
        </h4>
        <div class="space-y-2">
          <% @analysis[:action_items].first(4).each do |action| %>
            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 space-y-1">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-900 dark:text-white"><%= action[:action] %></span>
                <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-full <%= action[:badge_class] %>"><%= action[:priority] %></span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed"><%= action[:detail] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Optimal Warehouse Allocation Card (Enhanced with WarehouseRecommendationService) -->
  <% if @analysis[:recommended_warehouse] %>
    <% wh = @analysis[:recommended_warehouse] %>
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border-2 border-emerald-500 p-6 space-y-5">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div class="space-y-2 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
              <i class="fas fa-star mr-1 text-emerald-600"></i> ResQWay Recommended Relief Warehouse
            </span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Response Score: <strong class="text-emerald-600 dark:text-emerald-400"><%= wh[:response_score] || wh[:recommendation_score] %>/100</strong></span>
          </div>

          <h3 class="text-2xl font-black text-slate-900 dark:text-white"><%= wh[:name] %></h3>

          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
            <%= @analysis[:warehouse_reasoning] || wh[:selection_reasoning] %>
          </p>
        </div>

        <div class="flex items-center space-x-4 bg-emerald-50/60 dark:bg-emerald-950/40 rounded-xl p-4 border border-emerald-100 dark:border-emerald-900/60 flex-shrink-0">
          <div class="text-center">
            <span class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 block">ETA</span>
            <span class="text-lg font-black text-emerald-700 dark:text-emerald-300 block mt-0.5"><%= wh[:eta_formatted] || "—" %></span>
          </div>
          <div class="border-l border-emerald-200 dark:border-emerald-800 pl-4 text-center">
            <span class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 block">Distance</span>
            <span class="text-lg font-black text-slate-900 dark:text-white block mt-0.5"><%= wh[:distance_km] %> <span class="text-xs text-slate-500">km</span></span>
          </div>
          <div class="border-l border-emerald-200 dark:border-emerald-800 pl-4 text-center">
            <span class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 block">Capacity</span>
            <span class="text-lg font-black text-slate-900 dark:text-white block mt-0.5"><%= number_with_delimiter(wh[:capacity]) %></span>
          </div>
          <div class="border-l border-emerald-200 dark:border-emerald-800 pl-4 text-center">
            <span class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 block">Status</span>
            <span class="text-xs font-black uppercase mt-1 block <%= wh[:operational_status] == 'OPERATIONAL' ? 'text-emerald-600' : 'text-amber-500' %>"><%= wh[:operational_status] || "N/A" %></span>
          </div>
        </div>
      </div>

      <!-- Score Breakdown + Why This Warehouse -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Score Component Bars -->
        <div class="bg-slate-50 dark:bg-slate-800/60 rounded-xl p-4 border border-slate-100 dark:border-slate-700/60">
          <h4 class="text-[10px] font-black uppercase text-slate-600 dark:text-slate-400 tracking-wider mb-3">Response Score Breakdown</h4>
          <div class="space-y-2.5">
            <% [ 
              { label: "Route Safety (30%)", val: wh[:route_safety_score], color: "emerald" },
              { label: "Response Time (25%)", val: wh[:response_time_score], color: "blue" },
              { label: "Resource Match (20%)", val: wh[:resource_score], color: "indigo" },
              { label: "Available Capacity (15%)", val: wh[:capacity_score], color: "violet" },
              { label: "Readiness (10%)", val: wh[:readiness_component], color: "amber" }
            ].each do |bar| %>
              <% score_val = bar[:val] || 0 %>
              <div class="flex items-center space-x-3">
                <span class="text-[10px] font-bold text-slate-600 dark:text-slate-400 w-36 flex-shrink-0"><%= bar[:label] %></span>
                <div class="flex-1 h-2 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                  <div class="h-full rounded-full bg-<%= bar[:color] %>-500" style="width: <%= [score_val, 100].min %>%"></div>
                </div>
                <span class="text-[10px] font-black font-mono text-slate-700 dark:text-slate-300 w-8 text-right"><%= score_val.round(0) %></span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Why This Warehouse -->
        <div class="bg-slate-50 dark:bg-slate-800/60 rounded-xl p-4 border border-slate-100 dark:border-slate-700/60">
          <h4 class="text-[10px] font-black uppercase text-slate-600 dark:text-slate-400 tracking-wider mb-3">Why This Warehouse?</h4>
          <% if wh[:positive_factors].present? %>
            <div class="space-y-1.5 mb-3">
              <% wh[:positive_factors].each do |f| %>
                <p class="text-xs text-emerald-700 dark:text-emerald-300 flex items-start"><span class="mr-1.5 flex-shrink-0">✓</span> <%= f.sub(/^✓\s*/, '') %></p>
              <% end %>
            </div>
          <% end %>
          <% if wh[:negative_factors].present? %>
            <div class="space-y-1.5">
              <% wh[:negative_factors].each do |f| %>
                <p class="text-xs text-amber-700 dark:text-amber-300 flex items-start"><span class="mr-1.5 flex-shrink-0">⚠</span> <%= f.sub(/^⚠\s*/, '') %></p>
              <% end %>
            </div>
          <% end %>
          <% if wh[:positive_factors].blank? && wh[:negative_factors].blank? %>
            <p class="text-xs text-slate-500 dark:text-slate-400">Highest composite response score across all evaluation criteria.</p>
          <% end %>
        </div>
      </div>

      <!-- Candidate Comparison Table -->
      <% candidates = @analysis[:warehouse_candidates] %>
      <% if candidates.present? && candidates.size > 1 %>
        <div class="border-t border-slate-200 dark:border-slate-700 pt-4">
          <h4 class="text-[10px] font-black uppercase text-slate-600 dark:text-slate-400 tracking-wider mb-3">All Candidates Evaluated</h4>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-xs">
              <thead class="bg-slate-50 dark:bg-slate-800/60 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                <tr>
                  <th class="px-3 py-2 text-left">Rank</th>
                  <th class="px-3 py-2 text-left">Warehouse</th>
                  <th class="px-3 py-2">Distance</th>
                  <th class="px-3 py-2">ETA</th>
                  <th class="px-3 py-2">Safety</th>
                  <th class="px-3 py-2">Resources</th>
                  <th class="px-3 py-2">Status</th>
                  <th class="px-3 py-2 text-right">Score</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                <% candidates.each do |c| %>
                  <tr class="<%= c[:rank] == 1 ? 'bg-emerald-50/60 dark:bg-emerald-950/30' : '' %> hover:bg-slate-50 dark:hover:bg-slate-800/50">
                    <td class="px-3 py-2 font-black <%= c[:rank] == 1 ? 'text-emerald-600' : 'text-slate-500' %>">
                      <%= c[:rank] == 1 ? "★ #{c[:rank]}" : "##{c[:rank]}" %>
                    </td>
                    <td class="px-3 py-2 font-bold text-slate-900 dark:text-white"><%= c[:name].truncate(35) %></td>
                    <td class="px-3 py-2 text-center font-mono"><%= c[:distance_km] %> km</td>
                    <td class="px-3 py-2 text-center font-mono"><%= c[:eta_formatted] || "—" %></td>
                    <td class="px-3 py-2 text-center">
                      <span class="font-bold <%= c[:route_safety_score].to_f >= 65 ? 'text-emerald-600' : (c[:route_safety_score].to_f >= 40 ? 'text-amber-600' : 'text-red-600') %>">
                        <%= c[:route_safety_score] || "—" %>
                      </span>
                    </td>
                    <td class="px-3 py-2 text-center font-mono"><%= c[:resource_score] || "—" %></td>
                    <td class="px-3 py-2 text-center">
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-black uppercase <%= c[:operational_status] == 'OPERATIONAL' ? 'text-emerald-700 bg-emerald-50 dark:bg-emerald-950 dark:text-emerald-300' : 'text-amber-700 bg-amber-50 dark:bg-amber-950 dark:text-amber-300' %>">
                        <%= c[:operational_status] || "—" %>
                      </span>
                    </td>
                    <td class="px-3 py-2 text-right font-black font-mono <%= c[:rank] == 1 ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-700 dark:text-slate-300' %>">
                      <%= c[:response_score] %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Interactive Disaster GIS Map -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden"
       data-controller="emergency-map"
       data-emergency-map-emergency-value="<%= @emergency.to_json %>"
       data-emergency-map-affected-communities-value="<%= @analysis[:affected_communities].to_json %>"
       data-emergency-map-recommended-warehouse-value="<%= @analysis[:recommended_warehouse].to_json %>"
       data-emergency-map-emergency-route-value="<%= @analysis[:emergency_route].to_json %>">
    
    <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/80 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-map-marked-alt text-red-600 mr-2"></i>
          Disaster Spatial Impact &amp; Relief Corridor Map
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Visualizing <%= @emergency.affected_radius %> km impact buffer, community priority nodes, and recommended relief convoy track.</p>
      </div>

      <!-- Map Legend -->
      <div class="flex flex-wrap items-center gap-3 text-xs font-bold">
        <span class="flex items-center text-red-600 dark:text-red-400"><span class="w-2.5 h-2.5 rounded-full bg-red-600 inline-block mr-1.5"></span> Epicenter</span>
        <span class="flex items-center text-orange-600 dark:text-orange-400"><span class="w-2.5 h-2.5 rounded-full bg-orange-500 inline-block mr-1.5"></span> Affected</span>
        <span class="flex items-center text-emerald-600 dark:text-emerald-400"><span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block mr-1.5"></span> Relief Hub</span>
        <span class="flex items-center text-accent dark:text-accent"><span class="w-3.5 h-1 bg-accent inline-block mr-1.5"></span> Convoy Route</span>
      </div>
    </div>

    <div data-emergency-map-target="container" style="min-height: 300px; width: 100%; display: block;" class="w-full z-10 h-[340px] sm:h-[420px] lg:h-[520px]"></div>
  </div>

  <!-- Smart Emergency Response Route Details -->
  <% if @analysis[:emergency_route] %>
    <% route = @analysis[:emergency_route] %>
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 md:p-8 space-y-6">
      <div class="border-b border-slate-100 dark:border-slate-800 pb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <h3 class="text-base font-black text-slate-900 dark:text-white flex items-center">
            <i class="fas fa-ambulance text-emerald-600 mr-2"></i>
            Priority Emergency Dispatch Corridor
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Automated route calculation from <%= route[:origin_name] %> to <%= route[:destination_name] %>.</p>
        </div>
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
          <%= route[:route_title] %> Active
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Corridor Distance</span>
          <span class="text-2xl font-black text-slate-900 dark:text-white mt-1 block"><%= route[:distance_km] %> km</span>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Calculated via safest bypass routing.</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Est. Response Time</span>
          <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1 block"><%= route[:estimated_time] %></span>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Priority emergency fleet profile.</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">Corridor Risk Score</span>
          <span class="text-2xl font-black text-slate-900 dark:text-white mt-1 block"><%= route[:risk_score] %>/100 (<%= route[:risk_level] %>)</span>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Hazard deductions applied.</p>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-xs text-emerald-900 dark:text-emerald-200 flex items-start space-x-3">
        <i class="fas fa-info-circle text-emerald-600 dark:text-emerald-400 mt-0.5 text-sm flex-shrink-0"></i>
        <span><%= route[:selection_reason] %></span>
      </div>
    </div>
  <% end %>

  <!-- Affected Communities Priority Ranking Table -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-900/60">
      <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
        <i class="fas fa-sort-amount-down text-red-600 mr-2"></i>
        Affected Communities Priority Ranking
      </h3>
      <span class="text-[11px] text-slate-400 font-mono">
        <%= @analysis[:affected_count] %> settlements detected within impact zone
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
        <thead class="bg-slate-50 dark:bg-slate-800/60 font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider text-[10px]">
          <tr>
            <th class="px-5 py-3">Rank</th>
            <th class="px-5 py-3">Community</th>
            <th class="px-5 py-3">State / District</th>
            <th class="px-5 py-3">Population</th>
            <th class="px-5 py-3">Distance</th>
            <th class="px-5 py-3">Accessibility</th>
            <th class="px-5 py-3">Priority Score</th>
            <th class="px-5 py-3">Tier</th>
            <th class="px-5 py-3">Exposure</th>
            <th class="px-5 py-3 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-300">
          <% @analysis[:affected_communities].each do |comm| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="px-5 py-3.5 font-bold">#<%= comm[:rank] %></td>
              <td class="px-5 py-3.5 font-bold text-slate-900 dark:text-white"><%= comm[:name] %></td>
              <td class="px-5 py-3.5 text-slate-500 dark:text-slate-400"><%= comm[:location]&.state %> (<%= comm[:location]&.district %>)</td>
              <td class="px-5 py-3.5"><%= number_with_delimiter(comm[:population]) %></td>
              <td class="px-5 py-3.5 font-mono"><%= comm[:distance_km] %> km</td>
              <td class="px-5 py-3.5 font-mono"><%= comm[:accessibility_score] %>/100</td>
              <td class="px-5 py-3.5 font-black text-red-600 dark:text-red-400 font-mono"><%= comm[:priority_score] %>/100</td>
              <td class="px-5 py-3.5">
                <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase <%= comm[:priority_badge_class] %>">
                  <%= comm[:priority_level] %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-[11px] text-slate-500 font-medium"><%= comm[:spatial_status] %></td>
              <td class="px-5 py-3.5 text-right">
                <% if comm[:location] %>
                  <%= link_to accessibility_location_path(comm[:location]), class: "text-xs font-bold text-accent dark:text-accent hover:underline" do %>
                    <span>Profile &rarr;</span>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
