<div class="space-y-8 max-w-7xl mx-auto">
  <!-- Navigation Breadcrumb & Quick Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-2 border-b border-gray-200 gap-4">
    <div class="flex items-center space-x-2 text-sm text-gray-500">
      <%= link_to emergencies_path, class: "text-indigo-600 hover:text-indigo-800 font-medium flex items-center" do %>
        <i class="fas fa-arrow-left mr-1.5 text-xs"></i>
        <span>Disaster Registry</span>
      <% end %>
      <span>/</span>
      <span class="text-gray-900 font-bold">Mission: <%= @emergency.title.truncate(30) %></span>
    </div>

    <!-- Status Change Form -->
    <div class="flex items-center space-x-3">
      <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Status:</span>
      <%= form_with url: update_status_emergency_path(@emergency), method: :patch, local: true, class: "flex items-center space-x-2" do |f| %>
        <%= select_tag :status,
                       options_for_select(%w[Active Responding Monitoring Resolved], @emergency.status),
                       class: "text-xs font-bold px-3 py-1.5 rounded-lg border border-gray-300 bg-white focus:ring-2 focus:ring-red-500 text-gray-900" %>
        <%= f.submit "Update", class: "px-3 py-1.5 bg-gray-900 hover:bg-gray-800 text-white font-bold text-xs rounded-lg cursor-pointer transition-colors" %>
      <% end %>
    </div>
  </div>

  <!-- Big Emergency Alert Banner -->
  <div class="bg-gradient-to-r from-red-900 via-red-800 to-rose-900 rounded-2xl p-6 md:p-8 text-white shadow-xl border border-red-700/50">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-white text-red-900 shadow-sm flex items-center animate-pulse">
            <i class="fas fa-exclamation-triangle mr-1.5 text-red-600"></i>
            <%= @emergency.status.upcase %> EMERGENCY
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-red-950/80 text-red-200 border border-red-600/50">
            <%= @emergency.severity.upcase %> SEVERITY
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-black/40 text-red-200">
            <%= @emergency.emergency_type %>
          </span>
        </div>

        <h1 class="text-3xl font-black tracking-tight text-white"><%= @emergency.title %></h1>

        <p class="text-sm text-red-100 max-w-4xl leading-relaxed">
          <%= @emergency.description.presence || "Active #{(@emergency.emergency_type || 'hazard').downcase} incident detected in North East logistics corridor. Automated spatial buffer, community priority index, and relief dispatch routing initiated." %>
        </p>

        <div class="flex flex-wrap items-center gap-4 text-xs text-red-200 font-mono pt-2">
          <span><i class="fas fa-crosshairs mr-1"></i> Epicenter: <%= @emergency.latitude.round(4) %>°N, <%= @emergency.longitude.round(4) %>°E</span>
          <span>•</span>
          <span><i class="fas fa-bullseye mr-1"></i> Affected Radius: <%= @emergency.affected_radius %> km</span>
          <% if @emergency.simulated_at %>
            <span>•</span>
            <span><i class="fas fa-clock mr-1"></i> Triggered: <%= @emergency.simulated_at.strftime("%b %d, %H:%M") %></span>
          <% end %>
        </div>
      </div>

      <!-- Quick Summary Gauge -->
      <div class="flex-shrink-0 bg-black/30 backdrop-blur-md rounded-2xl p-5 border border-white/10 text-center min-w-[200px]">
        <span class="text-[11px] uppercase tracking-wider font-bold text-red-200">Threat Level</span>
        <div class="text-4xl font-black text-white mt-1">
          <% if @emergency.severity.to_s.downcase == "critical" %>
            CRITICAL
          <% else %>
            <%= @emergency.severity.upcase %>
          <% end %>
        </div>
        <span class="text-xs text-amber-300 font-semibold block mt-1">Immediate Response Active</span>
      </div>
    </div>
  </div>

  <!-- Key Impact Statistics Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Affected Communities</p>
      <div class="mt-2 flex items-baseline justify-between">
        <span class="text-3xl font-black text-gray-900"><%= @analysis[:affected_count] %></span>
        <span class="text-xs font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">Within <%= @emergency.affected_radius %> km</span>
      </div>
      <p class="text-[11px] text-gray-500 mt-2">Populated settlements under disaster zone.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5">
      <p class="text-xs font-bold text-red-600 uppercase tracking-wider">Critical Communities</p>
      <div class="mt-2 flex items-baseline justify-between">
        <span class="text-3xl font-black text-red-600"><%= @analysis[:critical_count] %></span>
        <span class="text-xs font-bold text-red-700 bg-red-50 px-2 py-0.5 rounded">Priority &ge; 76</span>
      </div>
      <p class="text-[11px] text-gray-500 mt-2">Severe cutoff / isolation hazard.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Population at Risk</p>
      <div class="mt-2 flex items-baseline justify-between">
        <span class="text-3xl font-black text-gray-900"><%= number_with_delimiter(@analysis[:total_population_at_risk]) %></span>
        <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded">Civilians</span>
      </div>
      <p class="text-[11px] text-gray-500 mt-2">Cumulative regional headcount.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5">
      <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Accessibility Impact</p>
      <div class="mt-2 flex items-baseline justify-between">
        <span class="text-2xl font-black <%= @analysis[:accessibility_impact_level] == 'CRITICAL' ? 'text-red-600' : 'text-orange-600' %>">
          <%= @analysis[:accessibility_impact_level] %>
        </span>
        <span class="text-xs font-bold text-gray-600 bg-gray-100 px-2 py-0.5 rounded">Supply Index</span>
      </div>
      <p class="text-[11px] text-gray-500 mt-2">Logistics corridor throughput degradation.</p>
    </div>
  </div>

  <!-- Optimal Warehouse Allocation Card -->
  <% if @analysis[:recommended_warehouse] %>
    <% wh = @analysis[:recommended_warehouse] %>
    <div class="bg-white rounded-2xl shadow-sm border-2 border-emerald-500 p-6 md:p-7">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="space-y-2">
          <div class="flex items-center space-x-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300">
              ⭐ ENMA AI Recommended Relief Warehouse
            </span>
            <span class="text-xs text-gray-500 font-medium">Multi-Criteria Score: <strong><%= wh[:recommendation_score] %>/100</strong></span>
          </div>

          <h3 class="text-2xl font-black text-gray-900"><%= wh[:name] %></h3>

          <p class="text-xs text-gray-700 leading-relaxed max-w-3xl">
            <%= wh[:selection_reasoning] %>
          </p>
        </div>

        <div class="flex items-center space-x-6 bg-emerald-50/60 rounded-xl p-4 border border-emerald-100">
          <div>
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Stock Capacity</span>
            <span class="text-xl font-black text-gray-900 block mt-0.5"><%= number_with_delimiter(wh[:capacity]) %> <span class="text-xs font-semibold text-gray-500">units</span></span>
          </div>
          <div class="border-l border-emerald-200 pl-6">
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Distance to Incident</span>
            <span class="text-xl font-black text-emerald-700 block mt-0.5"><%= wh[:distance_km] %> <span class="text-xs font-semibold text-emerald-600">km</span></span>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Interactive Disaster GIS Map -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden"
       data-controller="emergency-map"
       data-emergency-map-emergency-value="<%= @emergency.to_json %>"
       data-emergency-map-affected-communities-value="<%= @analysis[:affected_communities].to_json %>"
       data-emergency-map-recommended-warehouse-value="<%= @analysis[:recommended_warehouse].to_json %>"
       data-emergency-map-emergency-route-value="<%= @analysis[:emergency_route].to_json %>">
    
    <div class="p-5 border-b border-gray-200 bg-gray-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h3 class="text-base font-bold text-gray-900 flex items-center">
          <i class="fas fa-map-marked-alt text-red-600 mr-2"></i>
          Disaster Spatial Impact &amp; Relief Corridor Map
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Visualizing <%= @emergency.affected_radius %> km impact buffer, community priority nodes, and recommended relief convoy track.</p>
      </div>

      <!-- Map Legend -->
      <div class="flex flex-wrap items-center gap-3 text-xs font-bold">
        <span class="flex items-center text-red-600"><span class="w-3 h-3 rounded-full bg-red-600 inline-block mr-1"></span> Epicenter</span>
        <span class="flex items-center text-orange-600"><span class="w-3 h-3 rounded-full bg-orange-500 inline-block mr-1"></span> Affected</span>
        <span class="flex items-center text-emerald-600"><span class="w-3 h-3 rounded-full bg-emerald-600 inline-block mr-1"></span> Relief Hub</span>
        <span class="flex items-center text-indigo-600"><span class="w-4 h-0.5 bg-indigo-600 inline-block mr-1"></span> Convoy Route</span>
      </div>
    </div>

    <div data-emergency-map-target="container" style="height: 520px; min-height: 480px; width: 100%; display: block;" class="w-full z-10"></div>
  </div>

  <!-- Smart Emergency Response Route Details -->
  <% if @analysis[:emergency_route] %>
    <% route = @analysis[:emergency_route] %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
      <div class="border-b border-gray-100 pb-4 mb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <h3 class="text-lg font-bold text-gray-900 flex items-center">
            <i class="fas fa-ambulance text-emerald-600 mr-2.5"></i>
            Priority Emergency Dispatch Corridor
          </h3>
          <p class="text-xs text-gray-500 mt-0.5">Automated route calculation from <%= route[:origin_name] %> to <%= route[:destination_name] %>.</p>
        </div>
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
          <%= route[:route_title] %> Active
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
          <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block">Corridor Distance</span>
          <span class="text-2xl font-black text-gray-900 mt-1 block"><%= route[:distance_km] %> km</span>
          <p class="text-[11px] text-gray-500 mt-1">Calculated via safest bypass routing.</p>
        </div>

        <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
          <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block">Est. Response Time</span>
          <span class="text-2xl font-black text-emerald-600 mt-1 block"><%= route[:estimated_time] %></span>
          <p class="text-[11px] text-gray-500 mt-1">Priority emergency fleet speed profile.</p>
        </div>

        <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
          <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block">Corridor Risk Score</span>
          <span class="text-2xl font-black text-gray-900 mt-1 block"><%= route[:risk_score] %>/100 (<%= route[:risk_level] %>)</span>
          <p class="text-[11px] text-gray-500 mt-1">Hazard deductions applied.</p>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-emerald-50/50 border border-emerald-200 text-xs text-emerald-900 flex items-start space-x-3">
        <i class="fas fa-info-circle text-emerald-600 mt-0.5 text-sm flex-shrink-0"></i>
        <span><%= route[:selection_reason] %></span>
      </div>
    </div>
  <% end %>

  <!-- Affected Communities Priority Ranking Table -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-5 border-b border-gray-200 bg-gray-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h3 class="text-base font-bold text-gray-900 flex items-center">
          <i class="fas fa-sort-amount-down text-red-600 mr-2"></i>
          Affected Communities Priority Ranking
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Ranked in order of emergency response urgency (highest Priority Score first).</p>
      </div>
      <span class="text-xs font-bold text-gray-600">
        Total Detected: <strong><%= @analysis[:affected_count] %></strong> settlements
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 text-left text-xs">
        <thead class="bg-gray-50 font-bold text-gray-600 uppercase tracking-wider">
          <tr>
            <th scope="col" class="px-6 py-3.5">Rank</th>
            <th scope="col" class="px-6 py-3.5">Community</th>
            <th scope="col" class="px-6 py-3.5">State / District</th>
            <th scope="col" class="px-6 py-3.5">Population</th>
            <th scope="col" class="px-6 py-3.5">Distance from Epicenter</th>
            <th scope="col" class="px-6 py-3.5">Accessibility</th>
            <th scope="col" class="px-6 py-3.5">Emergency Priority Score</th>
            <th scope="col" class="px-6 py-3.5">Status</th>
            <th scope="col" class="px-6 py-3.5 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white font-medium text-gray-700">
          <% @analysis[:affected_communities].each_with_index do |comm, idx| %>
            <tr class="hover:bg-red-50/20 transition-colors">
              <td class="px-6 py-3.5">
                <span class="w-6 h-6 rounded-full bg-gray-900 text-white font-black text-xs flex items-center justify-center">
                  #<%= idx + 1 %>
                </span>
              </td>
              <td class="px-6 py-3.5 font-bold text-gray-900 text-sm"><%= comm[:name] %></td>
              <td class="px-6 py-3.5"><%= comm[:district] %>, <%= comm[:state] %></td>
              <td class="px-6 py-3.5"><%= number_with_delimiter(comm[:population]) %></td>
              <td class="px-6 py-3.5 font-mono"><%= comm[:distance_km] %> km</td>
              <td class="px-6 py-3.5">
                <span class="font-bold <%= comm[:accessibility_score] < 40 ? 'text-red-600' : (comm[:accessibility_score] < 60 ? 'text-orange-600' : 'text-gray-800') %>">
                  <%= comm[:accessibility_score] %>/100
                </span>
              </td>
              <td class="px-6 py-3.5">
                <div class="w-36">
                  <div class="flex justify-between items-center mb-1">
                    <span class="font-black text-red-600 text-sm"><%= comm[:priority_score] %>/100</span>
                  </div>
                  <div class="w-full bg-gray-200 rounded-full h-1.5 overflow-hidden">
                    <div class="bg-red-600 h-1.5 rounded-full" style="width: <%= comm[:priority_score] %>%"></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-3.5">
                <span class="px-2.5 py-1 rounded-full text-[10px] uppercase border <%= comm[:priority_badge_class] %>">
                  <%= comm[:priority_level] %>
                </span>
              </td>
              <td class="px-6 py-3.5 text-right">
                <%= link_to "Analysis", accessibility_location_path(comm[:id]), class: "text-xs font-bold text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-2.5 py-1 rounded border border-indigo-200" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Tactical Emergency Directives Section -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
    <div class="border-b border-gray-100 pb-4 mb-5 flex items-center justify-between">
      <div>
        <h3 class="text-lg font-bold text-gray-900 flex items-center">
          <i class="fas fa-clipboard-list text-red-600 mr-2.5"></i>
          Tactical Response Directives
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Multi-agency operational protocols generated automatically for <%= @emergency.emergency_type %>.</p>
      </div>
      <span class="text-xs font-bold px-3 py-1 rounded-full bg-red-50 text-red-700 border border-red-200">
        <%= @analysis[:response_directives].size %> Directives Issued
      </span>
    </div>

    <div class="space-y-3">
      <% @analysis[:response_directives].each_with_index do |dir, index| %>
        <div class="p-4 rounded-xl border border-gray-200 bg-gray-50 hover:bg-white transition-all flex items-start space-x-4">
          <span class="w-6 h-6 rounded-full bg-red-100 text-red-800 text-xs font-black flex items-center justify-center flex-shrink-0 mt-0.5">
            <%= index + 1 %>
          </span>
          <div class="flex-1">
            <div class="flex items-center space-x-2.5">
              <h4 class="text-sm font-bold text-gray-900"><%= dir[:action] %></h4>
              <span class="px-2 py-0.5 text-[10px] font-black rounded-full border <%= dir[:badge_class] %> uppercase">
                <%= dir[:priority] %>
              </span>
            </div>
            <p class="text-xs text-gray-600 mt-1 leading-relaxed"><%= dir[:detail] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- ENMA AI 6-Step Decision Timeline (Perfect for SIH Presentation) -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
    <div class="border-b border-gray-100 pb-4 mb-6">
      <h3 class="text-lg font-bold text-gray-900 flex items-center">
        <i class="fas fa-project-diagram text-indigo-600 mr-2.5"></i>
        ENMA AI Decision Timeline
      </h3>
      <p class="text-xs text-gray-500 mt-0.5">End-to-end audit sequence from disaster telemetry ingest to tactical plan dispatch.</p>
    </div>

    <div class="relative pl-6 space-y-6 before:absolute before:left-3 before:top-2 before:bottom-2 before:w-0.5 before:bg-indigo-200">
      <% @analysis[:decision_timeline].each do |step| %>
        <div class="relative flex items-start space-x-4">
          <!-- Dot -->
          <div class="absolute -left-6 top-1 w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-black ring-4 ring-white shadow">
            <%= step[:step] %>
          </div>

          <div class="flex-1 bg-gray-50 p-4 rounded-xl border border-gray-100">
            <div class="flex items-center justify-between">
              <h4 class="text-sm font-bold text-gray-900"><%= step[:title] %></h4>
              <span class="text-[11px] font-mono font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded"><%= step[:time] %></span>
            </div>
            <p class="text-xs text-gray-600 mt-1 leading-relaxed"><%= step[:detail] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
