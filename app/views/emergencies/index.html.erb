<div class="space-y-6 max-w-7xl mx-auto pb-12">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 border-b border-slate-200 dark:border-slate-800 gap-3">
    <div>
      <div class="flex items-center space-x-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider bg-red-100 dark:bg-red-950 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800">
          <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse mr-1.5"></span>
          Tactical Command
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">Active Incidents</h2>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Real-time disaster telemetry and tactical dispatch registry across North East India.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <%= form_with url: demo_scenario_emergencies_path, method: :post, local: true, data: { turbo: false } do |f| %>
        <button type="submit" class="inline-flex items-center px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs rounded-xl shadow-sm transition-all cursor-pointer">
          <i class="fas fa-bolt mr-1.5 text-xs"></i>
          <span>Launch SIH Scenario</span>
        </button>
      <% end %>

      <%= link_to new_emergency_path, class: "inline-flex items-center px-4 py-2 bg-accent hover:opacity-90 text-white font-black text-xs rounded-xl shadow-sm transition-all" do %>
        <i class="fas fa-plus mr-1.5 text-xs"></i>
        <span>Simulate Incident</span>
      <% end %>
    </div>
  </div>

  <!-- Main Layout: Active Incidents List + Resource Availability -->
  <div class="flex flex-col lg:flex-row gap-5 items-start w-full">
    
    <!-- Left Column: Incident Cards -->
    <div class="w-full lg:flex-1 min-w-0 space-y-4">
      <div class="flex items-center justify-between px-1">
        <div class="flex items-center space-x-2">
          <span class="text-xs font-black uppercase text-slate-800 dark:text-slate-200 tracking-wider">Live Incident Feed</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase bg-red-50 dark:bg-red-950 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800">
            <%= @emergencies.count { |e| e.status.to_s.downcase != "resolved" } %> Active
          </span>
        </div>
        <span class="text-[11px] font-mono text-slate-400">Auto-refresh 5s</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% if @emergencies.any? %>
          <% @emergencies.first(4).each do |em| %>
            <% 
              sev_badge = case em.severity.to_s.downcase
                          when "critical" then "bg-red-50 dark:bg-red-950/80 text-red-700 dark:text-red-300 border-red-200 dark:border-red-800/80 font-black"
                          when "high"     then "bg-orange-50 dark:bg-orange-950/80 text-orange-700 dark:text-orange-300 border-orange-200 dark:border-orange-800/80 font-bold"
                          when "medium", "moderate" then "bg-yellow-50 dark:bg-yellow-950/80 text-yellow-800 dark:text-yellow-300 border-yellow-200 dark:border-yellow-800/80 font-bold"
                          else "bg-emerald-50 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/80 font-bold"
                          end
              
              icon_box = case em.emergency_type.to_s.downcase
                         when /landslide|mudslide/ then { icon: "fa-mountain", color: "bg-amber-500/10 text-amber-600 dark:text-amber-400" }
                         when /flood|water/       then { icon: "fa-water", color: "bg-accent/10 text-accent" }
                         when /power|outage/      then { icon: "fa-bolt", color: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" }
                         when /road|blockage/     then { icon: "fa-road-barrier", color: "bg-rose-500/10 text-rose-600 dark:text-rose-400" }
                         else { icon: "fa-fire-alt", color: "bg-red-500/10 text-red-600 dark:text-red-400" }
                         end
            %>
            <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-4 hover:border-slate-300 dark:hover:border-slate-700 hover:shadow-md transition-all">
              
              <!-- Card Top: Icon + Title + Severity Pill -->
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 rounded-xl <%= icon_box[:color] %> flex items-center justify-center text-xs flex-shrink-0 font-bold">
                      <i class="fas <%= icon_box[:icon] %>"></i>
                    </div>
                    <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                      <%= em.emergency_type %>
                    </span>
                  </div>

                  <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider border <%= sev_badge %>">
                    <%= em.severity %>
                  </span>
                </div>

                <div>
                  <h3 class="font-black text-sm text-slate-900 dark:text-white leading-snug line-clamp-2">
                    <%= em.title %>
                  </h3>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center">
                    <i class="fas fa-location-dot text-[10px] text-accent mr-1.5 flex-shrink-0"></i>
                    <span class="truncate"><%= em.location&.name || "District Sector" %>, <%= em.location&.state || "North East" %></span>
                  </p>
                </div>
              </div>

              <!-- Card Bottom: Elapsed Time & View Details Link -->
              <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
                <div>
                  <span class="text-[9px] font-black uppercase text-slate-400 tracking-wider block">Elapsed Time</span>
                  <span class="text-xs font-mono font-bold text-slate-800 dark:text-slate-200 flex items-center mt-0.5">
                    <i class="far fa-clock text-[10px] text-slate-400 mr-1"></i>
                    <%= em.simulated_at ? sprintf("%02d:%02d:%02d", ((Time.current - em.simulated_at) / 3600).to_i, (((Time.current - em.simulated_at) % 3600) / 60).to_i, ((Time.current - em.simulated_at) % 60).to_i) : "00:14:32" %>
                  </span>
                </div>

                <%= link_to emergency_path(em), class: "inline-flex items-center px-3 py-1 bg-accent/10 dark:bg-accent/10 text-accent dark:text-accent hover:bg-accent hover:text-white dark:hover:bg-accent dark:hover:text-white text-xs font-bold rounded-lg border border-accent/20 dark:border-accent/20 shadow-sm transition-all" do %>
                  <span>Details</span>
                  <i class="fas fa-arrow-right ml-1.5 text-[9px]"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Right Column: Resource Availability Card -->
    <div class="w-full lg:w-[380px] xl:w-[420px] lg:flex-shrink-0 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-5 sm:p-6 space-y-5">
      <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
        <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-cubes text-accent dark:text-accent mr-2 text-xs"></i>
          <span>Resource Availability</span>
        </h3>
        <span class="text-[10px] font-mono text-slate-400">Tactical Fleet</span>
      </div>

      <div class="space-y-4">
        <!-- Resource 1: Medical Teams -->
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60 space-y-2.5">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
              <div class="w-7 h-7 rounded-lg bg-accent/15 dark:bg-accent/10 text-accent dark:text-accent flex items-center justify-center text-xs flex-shrink-0">
                <i class="fas fa-user-md"></i>
              </div>
              <span class="font-bold text-xs text-slate-900 dark:text-white">Medical Teams</span>
            </div>
            <span class="text-xs font-black text-accent dark:text-accent font-mono">68% Ready</span>
          </div>

          <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-1.5 overflow-hidden">
            <div class="bg-accent h-1.5 rounded-full" style="width: 68%"></div>
          </div>
          <div class="flex justify-between text-[11px] text-slate-500 dark:text-slate-400 font-mono">
            <span>4 / 12 Dispatched</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">8 Ready</span>
          </div>
        </div>

        <!-- Resource 2: Fire & Rescue -->
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60 space-y-2.5">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
              <div class="w-7 h-7 rounded-lg bg-red-100 dark:bg-red-950 text-red-700 dark:text-red-300 flex items-center justify-center text-xs flex-shrink-0">
                <i class="fas fa-fire-extinguisher"></i>
              </div>
              <span class="font-bold text-xs text-slate-900 dark:text-white">Fire &amp; Rescue</span>
            </div>
            <span class="text-xs font-black text-red-600 dark:text-red-400 font-mono">20% Ready</span>
          </div>

          <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-1.5 overflow-hidden">
            <div class="bg-red-500 h-1.5 rounded-full" style="width: 20%"></div>
          </div>
          <div class="flex justify-between text-[11px] text-slate-500 dark:text-slate-400 font-mono">
            <span>8 / 10 Deployed</span>
            <span class="font-bold text-amber-600 dark:text-amber-400">2 Ready</span>
          </div>
        </div>

        <!-- Resource 3: Hazmat Units -->
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60 space-y-2.5">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
              <div class="w-7 h-7 rounded-lg bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-xs flex-shrink-0">
                <i class="fas fa-biohazard"></i>
              </div>
              <span class="font-bold text-xs text-slate-900 dark:text-white">Hazmat &amp; Heavy Units</span>
            </div>
            <span class="text-xs font-black text-emerald-600 dark:text-emerald-400 font-mono">80% Ready</span>
          </div>

          <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-1.5 overflow-hidden">
            <div class="bg-emerald-500 h-1.5 rounded-full" style="width: 80%"></div>
          </div>
          <div class="flex justify-between text-[11px] text-slate-500 dark:text-slate-400 font-mono">
            <span>1 / 5 Dispatched</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">4 Ready</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Full Disaster Registry Table (High-Fidelity Stitch Table) -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-slate-50/50 dark:bg-slate-900/60">
      <div>
        <h3 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider flex items-center">
          <i class="fas fa-clipboard-list text-accent dark:text-accent mr-2 text-xs"></i>
          <span>Full Disaster Registry</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Comprehensive chronological database of recorded disaster events and active operations.</p>
      </div>
      <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 self-start sm:self-auto">
        <%= @emergencies.size %> Incidents Logged
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
        <thead class="bg-slate-50 dark:bg-slate-800/60 font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wider text-[10px]">
          <tr>
            <th class="px-5 py-3.5">Emergency Incident</th>
            <th class="px-5 py-3.5">Hazard Type</th>
            <th class="px-5 py-3.5">Severity</th>
            <th class="px-5 py-3.5">Epicenter Location</th>
            <th class="px-5 py-3.5">Status</th>
            <th class="px-5 py-3.5 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-300">
          <% @emergencies.each do |em| %>
            <% 
              sev_badge = case em.severity.to_s.downcase
                          when "critical" then "bg-red-50 dark:bg-red-950/80 text-red-700 dark:text-red-300 border-red-200 dark:border-red-800/80 font-black"
                          when "high"     then "bg-orange-50 dark:bg-orange-950/80 text-orange-700 dark:text-orange-300 border-orange-200 dark:border-orange-800/80 font-bold"
                          when "medium", "moderate" then "bg-yellow-50 dark:bg-yellow-950/80 text-yellow-800 dark:text-yellow-300 border-yellow-200 dark:border-yellow-800/80 font-bold"
                          else "bg-emerald-50 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/80 font-bold"
                          end
              
              stat_badge = case em.status.to_s.downcase
                           when "active"     then "bg-red-50 dark:bg-red-950/80 text-red-700 dark:text-red-300 border-red-200 dark:border-red-800/80 font-black"
                           when "responding" then "bg-amber-50 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border-amber-200 dark:border-amber-800/80 font-bold"
                           when "monitoring" then "bg-yellow-50 dark:bg-yellow-950/80 text-yellow-800 dark:text-yellow-300 border-yellow-200 dark:border-yellow-800/80 font-medium"
                           when "resolved"   then "bg-emerald-50 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/80 font-medium"
                           else "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-300 dark:border-slate-700"
                           end
            %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="px-5 py-3.5">
                <div class="font-bold text-slate-900 dark:text-white text-xs sm:text-sm"><%= em.title %></div>
                <div class="text-[10px] text-slate-400 font-mono"><%= em.simulated_at ? em.simulated_at.strftime("%b %d, %H:%M UTC") : "Live Telemetry" %></div>
              </td>
              <td class="px-5 py-3.5">
                <span class="font-bold text-slate-700 dark:text-slate-300"><%= em.emergency_type %></span>
              </td>
              <td class="px-5 py-3.5">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider border <%= sev_badge %>">
                  <%= em.severity %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-slate-600 dark:text-slate-400">
                <div class="font-bold text-slate-800 dark:text-slate-200"><%= em.location&.name || "Regional Sector" %></div>
                <div class="text-[10px] text-slate-400"><%= em.location&.state || "North East" %></div>
              </td>
              <td class="px-5 py-3.5">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider border <%= stat_badge %>">
                  <%= em.status %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-right whitespace-nowrap">
                <%= link_to emergency_path(em), class: "inline-flex items-center px-3 py-1.5 bg-accent/10 dark:bg-accent/10 text-accent dark:text-accent hover:bg-accent hover:text-white dark:hover:bg-accent dark:hover:text-white text-xs font-bold rounded-xl border border-accent/20 dark:border-accent/20 shadow-sm transition-all" do %>
                  <span>Command Center</span>
                  <i class="fas fa-arrow-right ml-1.5 text-[9px]"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  </div>
</div>

