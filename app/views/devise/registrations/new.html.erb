<div class="space-y-6">
  
  <!-- Header with Branding (Square Badge, Flat) -->
  <div class="text-center space-y-1.5">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-none bg-accent text-white mb-1">
      <span class="text-xl font-black">⚡</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">ResQWay</h2>
    <p class="text-xs text-mute font-medium">Smart Logistics, Risk Intelligence &amp; Emergency Mobility</p>
  </div>

  <!-- Main Auth Card: Square Box, Flat Surface, No Drop Shadows, No Outer Strokes -->
  <div class="bg-white rounded-none p-6 sm:p-8 space-y-5 shadow-none border-none">
    
    <div class="space-y-1">
      <h3 class="text-xl font-black text-ink tracking-tight">Create your account</h3>
      <p class="text-xs text-sketch">Sign up to access terrain risk models and logistics dispatch.</p>
    </div>

    <!-- Registration Form -->
    <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), local: true, data: { turbo: false }, class: "space-y-4" do |f| %>
      
      <div>
        <label for="user_name" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">Full Name</label>
        <%= f.text_field :name,
                         id: "user_name",
                         required: true,
                         autofocus: true,
                         placeholder: "e.g. Captain Ananya Roy",
                         class: "w-full px-4 py-2.5 bg-slate-50 text-ink border border-slate-200 rounded-none focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute" %>
      </div>

      <div>
        <label for="user_email_address" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">Email Address</label>
        <%= f.email_field :email_address,
                          id: "user_email_address",
                          required: true,
                          placeholder: "officer@ndrf.gov.in",
                          class: "w-full px-4 py-2.5 bg-slate-50 text-ink border border-slate-200 rounded-none focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute" %>
      </div>

      <div>
        <label for="user_username" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">Username (Optional)</label>
        <%= f.text_field :username,
                         id: "user_username",
                         placeholder: "e.g. ananya_roy",
                         class: "w-full px-4 py-2.5 bg-slate-50 text-ink border border-slate-200 rounded-none focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute" %>
      </div>

      <div>
        <label for="user_password" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">Password</label>
        <%= f.password_field :password,
                             id: "user_password",
                             required: true,
                             placeholder: "Minimum 8 characters",
                             class: "w-full px-4 py-2.5 bg-slate-50 text-ink border border-slate-200 rounded-none focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute" %>
      </div>

      <div>
        <label for="user_password_confirmation" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">Confirm Password</label>
        <%= f.password_field :password_confirmation,
                             id: "user_password_confirmation",
                             required: true,
                             placeholder: "Re-enter password",
                             class: "w-full px-4 py-2.5 bg-slate-50 text-ink border border-slate-200 rounded-none focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute" %>
      </div>

      <div class="pt-1">
        <button type="submit"
                class="w-full py-3 px-4 bg-ink hover:bg-ink/90 text-white font-black text-xs sm:text-sm rounded-none transition-all cursor-pointer flex items-center justify-center space-x-2">
          <span>Create Account</span>
          <i class="fas fa-arrow-right text-xs"></i>
        </button>
      </div>
    <% end %>

    <!-- Link to Log In -->
    <div class="text-center pt-3 border-t border-[var(--line)]">
      <p class="text-xs text-sketch">
        Already have an operational account?
        <%= link_to "Log in instead", login_path, class: "font-black text-accent hover:underline ml-1" %>
      </p>
    </div>

  </div>
</div>
