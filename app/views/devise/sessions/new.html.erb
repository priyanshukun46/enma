<div class="space-y-6">
  
  <!-- Header with Branding (Square Badge, Flat) -->
  <div class="text-center space-y-1.5">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-none bg-accent text-white mb-1">
      <span class="text-xl font-black">⚡</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">ResQWay</h2>
    <p class="text-xs text-mute font-medium">Smart Logistics, Risk Intelligence &amp; Emergency Mobility</p>
  </div>

  <!-- Main Auth Card: Square Box, Flat Surface, No Drop Shadows, No Outer Strokes -->
  <div class="bg-white rounded-none p-6 sm:p-8 space-y-5 shadow-none border-none">
    
    <div class="space-y-1">
      <h3 class="text-xl font-black text-ink tracking-tight">Sign in to your account</h3>
      <p class="text-xs text-sketch">Enter your credentials to access the platform.</p>
    </div>

    <!-- Email / Username & Password Form -->
    <%= form_with url: login_path, local: true, data: { turbo: false }, id: "login-form", class: "space-y-4" do |f| %>
      <div>
        <label for="login" class="block text-xs font-bold text-ink uppercase tracking-wider mb-1.5">Username or Email</label>
        <input type="text"
               name="login"
               id="login"
               required
               autofocus
               placeholder="admin, operator, or officer@resqway.ai"
               value="<%= params[:login] %>"
               class="w-full px-4 py-2.5 bg-slate-50 text-ink border border-slate-200 rounded-none focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute">
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="password" class="block text-xs font-bold text-ink uppercase tracking-wider">Password</label>
          <%= link_to "Forgot Password?", new_password_path, class: "text-xs font-bold text-accent hover:underline" %>
        </div>
        <input type="password"
               name="password"
               id="password"
               required
               placeholder="••••••••"
               class="w-full px-4 py-2.5 bg-slate-50 text-ink border border-slate-200 rounded-none focus:ring-2 focus:ring-accent focus:outline-none text-xs sm:text-sm transition-all placeholder:text-mute">
      </div>

      <div class="pt-1">
        <button type="submit"
                class="w-full py-3 px-4 bg-ink hover:bg-ink/90 text-white font-black text-xs sm:text-sm rounded-none transition-all cursor-pointer flex items-center justify-center space-x-2">
          <span>Sign In to Platform</span>
          <i class="fas fa-arrow-right text-xs"></i>
        </button>
      </div>
    <% end %>

    <!-- SIH 2026 Fast Access Box -->
    <div class="p-3.5 rounded-none bg-slate-50 space-y-2.5">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-bold uppercase text-[#102E39] tracking-wider flex items-center">
          <i class="fas fa-bolt mr-1 text-[#FF471D]"></i> Quick Demo Access
        </span>
        <span class="text-[10px] text-slate-500 font-bold">1-Click</span>
      </div>
      
      <div class="grid grid-cols-2 gap-2 w-full">
        <%= button_to login_path, method: :post, params: { login: "admin", password: "password123" }, data: { turbo: false }, title: "1-Click Login as Admin (admin / password123)", class: "w-full py-2 px-3 bg-[#FF471D] hover:bg-[#e03d15] text-white font-bold text-xs uppercase tracking-wider rounded-none cursor-pointer transition-opacity text-center flex items-center justify-center space-x-1.5 shadow-none border-0" do %>
          <i class="fas fa-user-shield text-xs"></i>
          <span>Admin Access</span>
        <% end %>

        <%= button_to login_path, method: :post, params: { login: "operator", password: "password123" }, data: { turbo: false }, title: "1-Click Login as Operator (operator / password123)", class: "w-full py-2 px-3 bg-white hover:bg-slate-100 text-[#102E39] border border-slate-300 font-bold text-xs uppercase tracking-wider rounded-none cursor-pointer transition-colors text-center flex items-center justify-center space-x-1.5 shadow-none" do %>
          <i class="fas fa-user-gear text-xs"></i>
          <span>Operator Access</span>
        <% end %>
      </div>
    </div>

    <script>
      function quickLogin(username, password) {
        var loginField = document.getElementById('login');
        var passField = document.getElementById('password');
        var form = document.getElementById('login-form');

        if (loginField) {
          loginField.value = username;
          loginField.dispatchEvent(new Event('input', { bubbles: true }));
          loginField.dispatchEvent(new Event('change', { bubbles: true }));
        }

        if (passField) {
          passField.value = password;
          passField.dispatchEvent(new Event('input', { bubbles: true }));
          passField.dispatchEvent(new Event('change', { bubbles: true }));
        }

        if (form) {
          if (typeof form.requestSubmit === 'function') {
            form.requestSubmit();
          } else {
            form.submit();
          }
        }
      }
    </script>

    <!-- Link to Sign Up -->
    <div class="text-center pt-3 border-t border-[var(--line)]">
      <p class="text-xs text-sketch">
        Don't have an operational account?
        <%= link_to "Create your account", sign_up_path, class: "font-black text-accent hover:underline ml-1" %>
      </p>
    </div>

  </div>
</div>
