<div class="max-w-4xl mx-auto space-y-6 pb-12">
  <!-- Header -->
  <div class="pb-3 border-b border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">Operator Profile</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Your official ResQWay platform identity and operational credentials.</p>
    </div>

    <%= link_to settings_path, class: "inline-flex items-center text-xs font-bold text-accent dark:text-accent bg-accent/10 dark:bg-accent/10 px-3.5 py-2 rounded-xl border border-accent/20 dark:border-accent/20" do %>
      <i class="fas fa-cog mr-1.5 text-xs"></i>
      <span>Security &amp; Account Settings</span>
    <% end %>
  </div>

  <!-- Profile Card -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 md:p-8 space-y-6">
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 pb-6 border-b border-slate-100 dark:border-slate-800">
      <!-- Avatar with initials or image -->
      <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-700 text-white flex items-center justify-center text-2xl font-black shadow-md flex-shrink-0 overflow-hidden ring-4 ring-indigo-50 dark:ring-indigo-950">
        <% if @user.avatar_url.present? %>
          <img src="<%= @user.avatar_url %>" alt="<%= @user.name %>" class="w-full h-full object-cover">
        <% else %>
          <span><%= @user.initials %></span>
        <% end %>
      </div>

      <div class="space-y-2 flex-1 text-center sm:text-left">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
          <h3 class="text-2xl font-black text-slate-900 dark:text-white"><%= @user.name %></h3>
          <span class="px-3 py-0.5 rounded-full text-xs font-black uppercase tracking-wider border <%= @user.role_badge_class %>">
            <%= @user.role.upcase %>
          </span>
        </div>

        <p class="text-xs font-mono text-slate-500 dark:text-slate-400"><%= @user.email_address %></p>

        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 text-xs text-slate-500 dark:text-slate-400 pt-1">
          <span class="flex items-center"><i class="<%= @user.provider_icon %> mr-1.5"></i> Signed in via <%= @user.provider_label %></span>
          <span>&bull;</span>
          <span class="flex items-center"><i class="fas fa-calendar-alt mr-1.5"></i> Member since <%= @user.created_at.strftime("%B %Y") %></span>
        </div>
      </div>
    </div>

    <!-- Edit Profile Form -->
    <div class="pt-2">
      <h4 class="text-xs font-black uppercase text-slate-900 dark:text-white tracking-wider mb-4">Edit Profile Details</h4>

      <%= form_with model: @user, url: profile_path, method: :patch, local: true, class: "space-y-4 max-w-xl" do |f| %>
        <div>
          <%= f.label :name, "Display Name", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :name,
                           required: true,
                           class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors" %>
        </div>

        <div>
          <%= f.label :avatar_url, "Avatar Image URL (Optional)", class: "block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5" %>
          <%= f.url_field :avatar_url,
                          placeholder: "https://example.com/avatar.jpg",
                          class: "w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 text-xs sm:text-sm text-slate-900 dark:text-white bg-slate-50/50 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 transition-colors placeholder:text-slate-400" %>
        </div>

        <div>
          <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Assigned Operational Role</span>
          <div class="px-4 py-2.5 bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
            <span><%= @user.role.titleize %></span>
            <span class="text-xs text-slate-400 font-normal">Managed by Administrators</span>
          </div>
        </div>

        <div class="pt-2">
          <%= f.submit "Save Profile",
                       class: "px-6 py-2.5 bg-accent hover:opacity-90 text-white font-black text-xs rounded-xl shadow-md transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
