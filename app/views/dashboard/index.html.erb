<div class="space-y-6 max-w-7xl mx-auto pb-12 text-[#212121]">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-slate-200 gap-4">
    <div>
      <div class="flex items-center space-x-2.5">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#212121] tracking-tight font-sans">Overview</h2>
        <span class="text-xs text-slate-500 font-mono hidden sm:inline">&bull; Intelligence Dashboard</span>
      </div>
      <p class="text-xs text-slate-500 mt-1">Real-time telemetry, risk diagnostics &amp; predictive logistics across North East India.</p>
    </div>

    <div class="flex items-center space-x-2.5">
      <%= link_to demo_path, class: "inline-flex items-center px-4 py-2 rounded-none text-xs font-bold uppercase tracking-wider bg-[#FF471D] hover:bg-[#e03d15] text-white shadow-none transition-all cursor-pointer" do %>
        <i class="fas fa-bolt mr-1.5 text-xs"></i>
        <span>SIH Demo Mode</span>
      <% end %>

      <%= link_to overview_path, class: "inline-flex items-center px-4 py-2 rounded-none text-xs font-bold uppercase tracking-wider border border-[#102E39] text-[#102E39] hover:bg-[#102E39] hover:text-white bg-white shadow-none transition-all cursor-pointer" do %>
        <i class="fas fa-info-circle mr-1.5 text-[#102E39]"></i>
        <span>Judge Briefing</span>
      <% end %>
    </div>
  </div>

  <!-- 4 Top Metric Cards (Clean Minimal Style Matching Homepage) -->
  <% cache ["dashboard_top_metrics_v3", @total_routes_count, @critical_accessibility_zones, @active_emergencies, @avg_accessibility], expires_in: 3.minutes do %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
    
    <!-- Card 1: Total Active Routes -->
    <div class="p-5 rounded-none bg-slate-50 shadow-none border-none hover:bg-slate-100/70 transition-all flex flex-col justify-between space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Active Routes</span>
        <div class="w-8 h-8 rounded-none bg-[#102E39]/5 text-[#102E39] flex items-center justify-center text-sm">
          <i class="fas fa-car"></i>
        </div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-[#212121] tracking-tight font-sans">
          <%= number_with_delimiter(@total_routes_count) %>
        </div>
        <p class="text-[11px] font-medium text-slate-500 mt-1 flex items-center">
          <i class="fas fa-arrow-trend-up mr-1 text-[10px] text-slate-400"></i>
          <span>+12% corridor load</span>
        </p>
      </div>
    </div>

    <!-- Card 2: Risk Alerts -->
    <div class="p-5 rounded-none bg-slate-50 shadow-none border-none hover:bg-slate-100/70 transition-all flex flex-col justify-between space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Hazard &amp; Risk Alerts</span>
        <div class="w-8 h-8 rounded-none bg-[#102E39]/5 text-[#102E39] flex items-center justify-center text-sm">
          <i class="fas fa-exclamation-triangle"></i>
        </div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-[#212121] tracking-tight font-sans">
          <%= @critical_accessibility_zones + @active_emergencies %>
        </div>
        <div class="mt-1">
          <span class="inline-block text-[11px] font-bold <%= (@active_emergencies > 0) ? 'text-[#FF471D]' : 'text-slate-500' %>">
            Critical: <%= @active_emergencies %> active
          </span>
        </div>
      </div>
    </div>

    <!-- Card 3: Accessibility Score -->
    <div class="p-5 rounded-none bg-slate-50 shadow-none border-none hover:bg-slate-100/70 transition-all flex flex-col justify-between space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Accessibility Index</span>
        <div class="w-8 h-8 rounded-none bg-[#102E39]/5 text-[#102E39] flex items-center justify-center text-sm">
          <i class="fas fa-universal-access"></i>
        </div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-[#212121] tracking-tight font-sans">
          <%= @avg_accessibility.round %><span class="text-base font-normal text-slate-400">/100</span>
        </div>
        <p class="text-[11px] font-medium text-slate-500 mt-1">
          <%= @avg_accessibility >= 70 ? "Optimal Network Clearance" : "Standard Baseline" %>
        </p>
      </div>
    </div>

    <!-- Card 4: Emergency Responses -->
    <div class="p-5 rounded-none bg-slate-50 shadow-none border-none hover:bg-slate-100/70 transition-all flex flex-col justify-between space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Dispatches in Transit</span>
        <div class="w-8 h-8 rounded-none bg-[#102E39]/5 text-[#102E39] flex items-center justify-center text-sm">
          <i class="fas fa-star-of-life"></i>
        </div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-[#212121] tracking-tight font-sans">
          <%= sprintf("%02d", @active_emergencies) %>
        </div>
        <p class="text-[11px] font-medium text-slate-500 mt-1 flex items-center">
          <i class="far fa-clock mr-1 text-[10px] text-slate-400"></i>
          <span>Avg response: 4.2m</span>
        </p>
      </div>
    </div>

  </div>
  <% end %>

  <!-- Main Layout: Predictive Risk Heatmap + Operational Status -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
    
    <!-- Left Column: Predictive Risk Heatmap (Expands to fill available width) -->
    <div class="col-span-1 lg:col-span-7 xl:col-span-8 min-w-0 bg-slate-50 rounded-none shadow-none border-none overflow-hidden w-full"
         data-controller="map"
         data-map-locations-value="<%= @map_locations.to_json %>"
         data-map-warehouses-value="<%= @map_warehouses.to_json %>"
         data-map-emergencies-value="<%= @map_emergencies.to_json %>">
      
      <!-- Card Top Bar -->
      <div class="p-4 bg-slate-50 border-b border-slate-200/60 flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <h3 class="text-xs font-bold uppercase text-[#212121] tracking-wider font-sans">Predictive Risk Heatmap</h3>
        </div>

        <%= link_to map_path, class: "inline-flex items-center px-3 py-1.5 bg-white hover:bg-slate-100 text-[#102E39] font-bold text-xs uppercase tracking-wider rounded-none shadow-none transition-colors" do %>
          <i class="fas fa-arrow-up-right-from-square mr-1.5 text-xs text-[#102E39]"></i>
          <span>Interactive GIS View</span>
        <% end %>
      </div>

      <!-- Leaflet Map Container -->
      <div data-map-target="container"
           style="min-height: 380px; width: 100%; display: block;"
           class="w-full z-10 h-[380px] sm:h-[420px] lg:h-[480px]">
      </div>
    </div>

    <!-- Right Column: Operational Status Accordion (Dedicated Sidebar) -->
    <div class="col-span-1 lg:col-span-5 xl:col-span-4 bg-slate-50 rounded-none shadow-none border-none p-5 space-y-4 w-full">
      <div class="flex items-center space-x-2 border-b border-slate-200/60 pb-3">
        <i class="fas fa-sliders text-[#102E39] text-sm"></i>
        <h3 class="text-xs font-bold uppercase text-[#212121] tracking-wider font-sans">System Diagnostic Engine</h3>
      </div>

      <!-- Accordion 1: Data Ingestion Engine -->
      <div class="p-4 rounded-none bg-white space-y-3 shadow-none border-none">
        <div class="flex items-center justify-between">
          <span class="font-bold text-xs text-[#212121]">Live Data Ingestion</span>
          <span class="px-2 py-0.5 rounded-none text-[9px] font-bold uppercase bg-slate-100 text-[#102E39] flex items-center space-x-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block mr-1"></span>
            <span>Operational</span>
          </span>
        </div>

        <!-- Processing Capacity Bar -->
        <div class="space-y-1">
          <div class="flex items-center justify-between text-[11px] font-medium text-slate-500">
            <span>Buffer Throughput</span>
            <span class="text-[#212121] font-mono font-bold">98.4%</span>
          </div>
          <div class="w-full bg-slate-100 rounded-none h-2 overflow-hidden">
            <div class="bg-[#102E39] h-2 rounded-none" style="width: 98%"></div>
          </div>
        </div>

        <!-- Latency -->
        <div class="flex items-center justify-between text-[11px]">
          <span class="text-slate-500 font-medium">Telemetry Latency</span>
          <span class="text-[#212121] font-mono font-bold">1.2ms (triple buffered)</span>
        </div>

        <!-- Notice Box (Clean Slate with #102E39 Accent) -->
        <div class="p-3 rounded-none bg-slate-50 border-l-2 border-[#102E39] text-[11px] text-slate-600 leading-relaxed">
          Triple-buffer routing pre-cache active. Instantaneous sub-millisecond corridor generation online.
        </div>
      </div>

      <!-- Module 2: ML Model Status -->
      <div class="p-3.5 rounded-none bg-white flex items-center justify-between text-xs font-bold text-[#212121] shadow-none border-none">
        <div class="flex items-center space-x-2.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
          <span>FastAPI ML Disruption Engine</span>
        </div>
        <span class="text-[10px] font-mono text-slate-500 font-bold">PORT 8000</span>
      </div>

      <!-- Module 3: Weather Engine -->
      <div class="p-3.5 rounded-none bg-white flex items-center justify-between text-xs font-bold text-[#212121] shadow-none border-none">
        <div class="flex items-center space-x-2.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
          <span>Open-Meteo Weather Grid</span>
        </div>
        <span class="text-[10px] font-mono text-slate-500 font-bold">Cached (30m)</span>
      </div>
    </div>
  </div>

  <!-- ResQWay Hybrid Road Risk Intelligence Center Widget -->
  <div class="bg-slate-50 rounded-none shadow-none border-none p-5 sm:p-6 space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 border-b border-slate-200/60 gap-3">
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-none bg-[#102E39] text-white flex items-center justify-center text-sm">
          <i class="fas fa-microchip"></i>
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-sm sm:text-base font-bold text-[#212121] uppercase tracking-wider font-sans">ResQWay Hybrid Road Risk Intelligence</h3>
            <span class="px-2 py-0.5 rounded-none text-[9px] font-bold uppercase bg-slate-200/70 text-slate-700">Active</span>
            <span class="px-2 py-0.5 rounded-none text-[9px] font-bold uppercase bg-slate-200/70 text-slate-700 flex items-center">
              <i class="fas fa-brain mr-1 text-[8px] text-[#102E39]"></i> ML Disruption Model v1
            </span>
          </div>
          <p class="text-[11px] text-slate-500 mt-0.5">Continuous multi-factor analysis: Weather • Historical Hazards • Field Incidents • Road Condition • Geographic Slope</p>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <%= link_to map_path, class: "inline-flex items-center px-4 py-2 bg-[#FF471D] hover:bg-[#e03d15] text-white font-bold text-xs uppercase tracking-wider rounded-none shadow-none transition-all cursor-pointer" do %>
          <i class="fas fa-map-location-dot mr-1.5 text-xs"></i>
          <span>Open Full GIS Map</span>
        <% end %>
      </div>
    </div>

    <!-- 5 Live Intelligence Metric Cards (Clean minimal white cards, no rainbow colors) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      <div class="p-3.5 rounded-none bg-white shadow-none border-none">
        <span class="text-[10px] font-bold uppercase text-slate-500 block">Monitored Corridors</span>
        <div class="text-2xl font-extrabold text-[#212121] font-sans mt-0.5"><%= @total_roads_analyzed %></div>
        <span class="text-[10px] text-slate-400 font-mono">Avg Risk: <%= @avg_road_risk %>/100</span>
      </div>

      <div class="p-3.5 rounded-none bg-white shadow-none border-none">
        <span class="text-[10px] font-bold uppercase text-slate-500 block">Critical Risk</span>
        <div class="text-2xl font-extrabold <%= @critical_risk_roads_count > 0 ? 'text-[#FF471D]' : 'text-[#212121]' %> font-sans mt-0.5"><%= @critical_risk_roads_count %></div>
        <span class="text-[10px] text-slate-400">Impassable / Blocked</span>
      </div>

      <div class="p-3.5 rounded-none bg-white shadow-none border-none">
        <span class="text-[10px] font-bold uppercase text-slate-500 block">High Risk</span>
        <div class="text-2xl font-extrabold text-[#212121] font-sans mt-0.5"><%= @high_risk_roads_count %></div>
        <span class="text-[10px] text-slate-400">Active Detour Alert</span>
      </div>

      <div class="p-3.5 rounded-none bg-white shadow-none border-none">
        <span class="text-[10px] font-bold uppercase text-slate-500 block">Safe Corridors</span>
        <div class="text-2xl font-extrabold text-[#212121] font-sans mt-0.5"><%= @safe_roads_count %></div>
        <span class="text-[10px] text-slate-400">Optimal Transit</span>
      </div>

      <div class="p-3.5 rounded-none bg-white shadow-none border-none">
        <span class="text-[10px] font-bold uppercase text-slate-500 block">Sensor Nodes</span>
        <div class="text-2xl font-extrabold text-[#212121] font-sans mt-0.5"><%= @sensor_nodes_count %></div>
        <span class="text-[10px] text-slate-400">Live Ingestion</span>
      </div>
    </div>

    <!-- Active Monitored Corridors Mini-Grid -->
    <% if @top_risk_roads&.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2">
        <% @top_risk_roads.each do |road| %>
          <% ml_data = road.latest_ml_prediction_data %>
          <div class="p-3.5 rounded-none bg-white shadow-none border-none space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs text-[#102E39] font-mono"><%= road.road_number %></span>
              <span class="px-2 py-0.5 rounded-none text-[9px] font-bold uppercase <%= road.risk_level.to_s.downcase == 'critical' ? 'bg-[#FF471D]/10 text-[#FF471D]' : 'bg-slate-100 text-slate-700' %>">
                <%= road.risk_level %>
              </span>
            </div>
            <div>
              <div class="font-bold text-xs text-[#212121] truncate"><%= road.name %></div>
              <div class="text-[10px] text-slate-500"><%= road.district %>, <%= road.state %></div>
            </div>
            <div class="space-y-1 pt-1 border-t border-slate-100 text-[10px] font-mono">
              <div class="flex items-center justify-between">
                <span class="text-slate-500">Hybrid Risk:</span>
                <span class="font-bold <%= road.risk_score >= 75 ? 'text-[#FF471D]' : 'text-[#212121]' %>"><%= road.risk_score.round %>/100</span>
              </div>
              <div class="flex items-center justify-between text-slate-600 font-medium">
                <span>ML Disruption:</span>
                <span class="font-bold text-[#102E39]"><%= ml_data[:probability_percentage] %>%</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Bottom Card: Recent Intelligence Logs Table -->
  <div class="bg-slate-50 rounded-none shadow-none border-none overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-200/60 flex items-center justify-between bg-slate-50">
      <h3 class="text-xs font-bold uppercase text-[#212121] tracking-wider font-sans flex items-center">
        <i class="fas fa-satellite-dish text-[#102E39] mr-2"></i>
        Recent Corridor Intelligence Logs
      </h3>
      <span class="text-[11px] text-slate-500 font-mono">Live Sensor Feed</span>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200/60 text-left text-xs bg-white">
        <thead class="bg-slate-50 font-bold text-slate-500 uppercase tracking-wider text-[10px]">
          <tr>
            <th class="px-5 py-3">Timestamp</th>
            <th class="px-5 py-3">Event</th>
            <th class="px-5 py-3">Location</th>
            <th class="px-5 py-3">Risk Level</th>
            <th class="px-5 py-3 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium text-[#212121]">
          <% if @active_emergency_records.any? %>
            <% @active_emergency_records.each do |em| %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="px-5 py-3.5 font-mono text-[11px] text-slate-500">
                  <%= em.simulated_at ? em.simulated_at.strftime("%I:%M %p") : "10:42 AM" %>
                </td>
                <td class="px-5 py-3.5 font-bold text-[#212121]">
                  <%= em.title %>
                </td>
                <td class="px-5 py-3.5 text-slate-500">
                  <%= em.location&.name || "Sector 4, Alpha Node" %>, <%= em.location&.state || "North East" %>
                </td>
                <td class="px-5 py-3.5">
                  <span class="inline-block px-2.5 py-0.5 rounded-none text-[10px] font-bold uppercase <%= em.severity.to_s.downcase == 'critical' ? 'bg-[#FF471D]/10 text-[#FF471D]' : 'bg-slate-100 text-slate-700' %>">
                    <%= em.severity.presence || "Elevated" %>
                  </span>
                </td>
                <td class="px-5 py-3.5 text-right">
                  <%= link_to emergency_path(em), class: "text-xs font-bold text-[#102E39] hover:text-[#FF471D] uppercase tracking-wider" do %>
                    <span>Details &rarr;</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr class="hover:bg-slate-50/80 transition-colors">
              <td class="px-5 py-3.5 font-mono text-[11px] text-slate-500">10:42 AM</td>
              <td class="px-5 py-3.5 font-bold text-[#212121]">Route Deviation Detected</td>
              <td class="px-5 py-3.5 text-slate-500">Sector 4, Alpha Node</td>
              <td class="px-5 py-3.5">
                <span class="inline-block px-2.5 py-0.5 rounded-none text-[10px] font-bold uppercase bg-slate-100 text-slate-700">
                  Elevated
                </span>
              </td>
              <td class="px-5 py-3.5 text-right">
                <%= link_to routes_path, class: "text-xs font-bold text-[#102E39] hover:text-[#FF471D] uppercase tracking-wider" do %>
                  <span>View</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
