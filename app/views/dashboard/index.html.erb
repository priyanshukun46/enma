<div class="space-y-6">
  <h2 class="text-2xl font-bold text-gray-800">Good Morning, Administrator</h2>
  <p class="text-gray-600">North East India Logistics & Accessibility Intelligence</p>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <%= render 'shared/statistic_card', title: "Total Monitored Locations", value: @total_locations, description: "Locations currently under monitoring", icon: "<i class='fas fa-map-marker-alt'></i>" %>
    <%= render 'shared/statistic_card', title: "Critical Accessibility Zones", value: @critical_accessibility_zones, description: "Locations with accessibility score below 40", icon: "<i class='fas fa-exclamation-triangle'></i>", color: "text-red-500" %>
    <%= render 'shared/statistic_card', title: "Active Emergencies", value: @active_emergencies, description: "Ongoing emergency situations", icon: "<i class='fas fa-bell'></i>", color: "text-yellow-500" %>
    <%= render 'shared/statistic_card', title: "Total Warehouses", value: @total_warehouses, description: "Available storage and distribution centers", icon: "<i class='fas fa-warehouse'></i>" %>
  </div>

  <!-- Critical Accessibility Zones Section -->
  <div class="bg-white shadow rounded-lg p-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-gray-100 mb-4 gap-2">
      <div>
        <h3 class="text-xl font-semibold text-gray-800">Critical Accessibility Zones</h3>
        <p class="text-xs text-gray-500 mt-0.5">Top high-vulnerability locations requiring priority logistics intervention.</p>
      </div>
      <%= link_to accessibility_path, class: "inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-800 transition-colors" do %>
        <span>View Full Intelligence Report</span>
        <i class="fas fa-arrow-right ml-1.5 text-xs"></i>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location Name</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">State / District</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Population</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Accessibility Score</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Risk Level</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @critical_locations.each do |location| %>
            <%
              score = location.accessibility_score.to_f
              if score < 40.0
                status_class = "bg-red-100 text-red-800 border border-red-200"
                status_text = "CRITICAL"
                score_color = "text-red-600 font-extrabold"
              elsif score < 60.0
                status_class = "bg-orange-100 text-orange-800 border border-orange-200"
                status_text = "HIGH RISK"
                score_color = "text-orange-600 font-bold"
              elsif score < 80.0
                status_class = "bg-yellow-100 text-yellow-800 border border-yellow-200"
                status_text = "MODERATE"
                score_color = "text-yellow-600 font-semibold"
              else
                status_class = "bg-green-100 text-green-800 border border-green-200"
                status_text = "LOW RISK"
                score_color = "text-green-600 font-semibold"
              end
            %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= location.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= location.district %>, <%= location.state %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= number_with_delimiter(location.population) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm <%= score_color %>"><%= location.accessibility_score %> / 100</td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                  <%= status_text %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <%= link_to "Analysis", accessibility_location_path(location), class: "text-xs font-semibold text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-2.5 py-1 rounded" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent Emergencies Section -->
  <div class="bg-white shadow rounded-lg p-6">
    <h3 class="text-xl font-semibold text-gray-800 mb-4">Recent Emergencies</h3>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Emergency Title</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Severity</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @recent_emergencies = Emergency.order(created_at: :desc).limit(5) %>
          <% @recent_emergencies.each do |emergency| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= emergency.title %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= emergency.emergency_type %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% severity_class = case emergency.severity
                                   when "Critical" then "bg-red-100 text-red-800"
                                   when "High" then "bg-orange-100 text-orange-800"
                                   when "Medium" then "bg-yellow-100 text-yellow-800"
                                   when "Low" then "bg-green-100 text-green-800"
                                   else "bg-gray-100 text-gray-800"
                                   end
                %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= severity_class %>">
                  <%= emergency.severity %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% status_class = case emergency.status
                                   when "Active" then "bg-red-100 text-red-800"
                                   when "Monitoring" then "bg-yellow-100 text-yellow-800"
                                   when "Resolved" then "bg-green-100 text-green-800"
                                   else "bg-gray-100 text-gray-800"
                                   end
                %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
                  <%= emergency.status %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
