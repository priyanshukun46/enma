<footer class="bg-[#212121] border-t border-white/10 text-slate-400 text-xs pt-16 pb-12 w-full" style="background-color: #212121 !important;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- 5 Column Grid Matching Reference Screenshot -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 lg:gap-12">
      
      <!-- Col 1: Our Company -->
      <div class="space-y-3">
        <p class="text-xs font-black uppercase tracking-wider text-white">Our Company</p>
        <ul class="space-y-2">
          <li><%= link_to "About ResQWay", about_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><%= link_to "Global Route Network", routes_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><%= link_to "Fleet Telemetry & Careers", shipments_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><%= link_to "International Transit Schedules", analytics_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><a href="#" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Conditions of Carriage &amp; Claims</a></li>
          <li><a href="#" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Binding Corporate Rules</a></li>
          <li><%= link_to "MEISA Logistics Newsroom", overview_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
        </ul>
      </div>

      <!-- Col 2: New Customer -->
      <div class="space-y-3">
        <p class="text-xs font-black uppercase tracking-wider text-white">New Customer</p>
        <ul class="space-y-2">
          <li><%= link_to "Open an Account (Save 65%*)", sign_up_path, class: "text-[#FF6200] font-bold hover:text-orange-400 hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><%= link_to "Register for a Login", sign_up_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><%= link_to "New Customer Center", overview_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><%= link_to "Demo Interactive Mode", demo_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
        </ul>
      </div>

      <!-- Col 3: Customer Support -->
      <div class="space-y-3">
        <p class="text-xs font-black uppercase tracking-wider text-white">Customer Support</p>
        <ul class="space-y-2">
          <li><a href="#" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Contact ResQWay (24/7 Hotline)</a></li>
          <li><a href="#" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Write to the Top</a></li>
          <li><%= link_to "Emergency Response Dispatch", intelligence_command_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><%= link_to "Citizen Incident Reports", incidents_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><a href="#" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Claim Resolution Portal</a></li>
        </ul>
      </div>

      <!-- Col 4: More From ResQWay -->
      <div class="space-y-3">
        <p class="text-xs font-black uppercase tracking-wider text-white">More From ResQWay</p>
        <ul class="space-y-2">
          <li><a href="#" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Sign up for eNews &amp; Alerts</a></li>
          <li><%= link_to "ResQWay Developer Portal", architecture_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><%= link_to "Fuel Surcharge Index", analytics_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><a href="#" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Rates &amp; Surcharges</a></li>
          <li><%= link_to "Relief Depot Resources", warehouses_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
          <li><%= link_to "ResQWay Locations &amp; Hubs", locations_path, class: "hover:text-white hover:translate-x-0.5 transition-all inline-block" %></li>
        </ul>
      </div>

      <!-- Col 5: Language / Country Selector -->
      <div class="space-y-3 col-span-2 md:col-span-1">
        <p class="text-xs font-black uppercase tracking-wider text-white">Language</p>
        <div class="space-y-2">
          <div class="flex items-center space-x-2 text-slate-300">
            <i class="fas fa-globe text-sm text-slate-400"></i>
            <span class="font-medium">India</span>
          </div>

          <div class="relative">
            <select class="w-full bg-[#102E39] border border-[#102E39] text-white text-xs rounded-lg py-2 pl-3 pr-8 appearance-none focus:outline-none focus:border-[#FF6200] transition-colors cursor-pointer">
              <option selected>English</option>
              <option>Hindi (हिंदी)</option>
              <option>Assamese (অসমীয়া)</option>
              <option>Bengali (বাংলা)</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-slate-300">
              <i class="fas fa-chevron-down text-[10px]"></i>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar: Logo & Copyright -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-2.5">
        <%= image_tag "logo_icon.png", alt: "ResQWay", class: "h-6 w-auto object-contain transition-transform hover:scale-105" %>
        <span class="text-sm font-black tracking-tight text-white font-sans">ResQ<span class="text-[#FF6200]">Way</span></span>
        <span class="text-[11px] text-slate-400 ml-2">&copy; <%= Date.current.year %> ResQWay. All rights reserved.</span>
      </div>
      <div class="flex items-center space-x-4 text-[11px] text-slate-400">
        <span>Smart India Hackathon 2026 Ready</span>
        <span>&bull;</span>
        <span class="text-[#FF6200] font-semibold">North East India Logistics Intelligence</span>
      </div>
    </div>

  </div>
</footer>
