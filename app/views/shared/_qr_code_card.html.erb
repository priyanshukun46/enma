<%# 
  Reusable ENMA AI QR Code Component
  Accepts optional locals:
    - title (default: "Scan to Open ENMA AI")
    - subtitle (default: "Continue the experience on your mobile device.")
    - module_size (default: 5)
    - custom_url (optional, defaults to current public app URL)
    - show_mobile_notice (default: true)
%>
<% target_url = local_assigns[:custom_url].presence || current_app_public_url %>
<% card_title = local_assigns[:title].presence || "Scan to Open ENMA AI" %>
<% card_subtitle = local_assigns[:subtitle].presence || "Continue the experience on your mobile device." %>
<% size = local_assigns[:module_size] || 5 %>

<div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-lg text-slate-900 dark:text-white space-y-5"
     data-controller="qr-modal">
  
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
    <!-- QR Code SVG Box -->
    <div class="p-4 bg-white rounded-2xl shadow-md border-2 border-slate-100 dark:border-slate-800 flex items-center justify-center flex-shrink-0">
      <div class="w-40 h-40 sm:w-44 sm:h-44 text-slate-900 flex items-center justify-center">
        <%= render_qr_svg(target_url, module_size: size, color: "#0f172a", fill: "#ffffff") %>
      </div>
    </div>

    <!-- Details & Call to Action -->
    <div class="flex-1 text-center sm:text-left space-y-3">
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
        <i class="fas fa-qrcode text-indigo-600 dark:text-indigo-400 mr-1"></i>
        <span>Instant Mobile Access</span>
      </div>

      <h3 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 dark:text-white"><%= card_title %></h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed"><%= card_subtitle %></p>

      <!-- URL Display & Copy Button -->
      <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
        <div class="px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-mono text-slate-700 dark:text-slate-300 truncate max-w-full sm:max-w-xs flex-1 select-all"
             data-qr-modal-target="urlText">
          <%= target_url %>
        </div>

        <button type="button"
                data-action="click->qr-modal#copyLink"
                data-qr-modal-target="copyButton"
                class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center space-x-1.5 cursor-pointer">
          <i class="fas fa-copy text-xs"></i>
          <span data-qr-modal-target="copyText">Copy Link</span>
        </button>
      </div>

      <!-- Mobile User Notice -->
      <% if local_assigns.fetch(:show_mobile_notice, true) %>
        <div class="block sm:hidden pt-1 text-[11px] text-slate-400 font-medium italic">
          <i class="fas fa-mobile-alt mr-1 text-slate-400"></i>
          <span>You are already viewing ENMA AI on mobile. Share the link above with other devices.</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
