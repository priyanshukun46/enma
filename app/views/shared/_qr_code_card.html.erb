<%# 
  Reusable ENMA AI QR Code Component
  Accepts optional locals:
    - title (default: "Scan to Open ENMA AI")
    - subtitle (default: "Open this live operational command platform on your smartphone or tablet.")
    - module_size (default: 4)
    - custom_url (optional, defaults to current public app URL)
    - show_mobile_notice (default: true)
%>
<% target_url = local_assigns[:custom_url].presence || current_app_public_url %>
<% card_title = local_assigns[:title].presence || "Scan to Open ENMA AI" %>
<% card_subtitle = local_assigns[:subtitle].presence || "Open this live operational command platform on your smartphone or tablet." %>
<% size = local_assigns[:module_size] || 4 %>

<div class="bg-surface sketch-border rounded-3xl p-5 sm:p-7 shadow-2xl text-ink space-y-4 overflow-hidden w-full">
  
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 sm:gap-6">
    <!-- QR Code SVG Box (Compact, razor sharp contrast on white base) -->
    <div class="p-2.5 bg-white rounded-2xl shadow-sm border-2 border-stone-200 flex items-center justify-center flex-shrink-0">
      <div class="w-32 h-32 sm:w-36 sm:h-36 flex items-center justify-center">
        <%= render_qr_svg(target_url, module_size: size, color: "18120e", fill: "ffffff") %>
      </div>
    </div>

    <!-- Details & Call to Action -->
    <div class="flex-1 min-w-0 text-center sm:text-left space-y-2.5 pr-2 sm:pr-6">
      <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-accent/10 text-accent border border-accent/20">
        <i class="fas fa-qrcode text-accent mr-1"></i>
        <span>Instant Mobile Access</span>
      </div>

      <h3 class="text-lg sm:text-xl font-black tracking-tight text-ink leading-tight break-words">
        <%= card_title %>
      </h3>

      <p class="text-xs sm:text-sm text-mute leading-relaxed break-words">
        <%= card_subtitle %>
      </p>

      <!-- URL Display & Copy Button -->
      <div class="pt-1.5 flex flex-col sm:flex-row items-stretch sm:items-center gap-2 max-w-md">
        <div class="px-3 py-2 rounded-xl bg-paper sketch-border-soft text-xs font-mono text-ink truncate flex-1 select-all"
             data-qr-modal-target="urlText">
          <%= target_url %>
        </div>

        <button type="button"
                data-action="click->qr-modal#copyLink"
                data-qr-modal-target="copyButton"
                class="px-4 py-2 bg-accent hover:opacity-90 text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center space-x-1.5 cursor-pointer flex-shrink-0">
          <i class="fas fa-copy text-xs"></i>
          <span data-qr-modal-target="copyText">Copy Link</span>
        </button>
      </div>

      <!-- Mobile User Notice -->
      <% if local_assigns.fetch(:show_mobile_notice, true) %>
        <div class="block sm:hidden pt-1 text-[11px] text-mute font-medium italic">
          <i class="fas fa-mobile-alt mr-1 text-accent"></i>
          <span>Viewing on mobile? Share this link with other team devices.</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
