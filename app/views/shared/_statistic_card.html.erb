<div class="bg-white shadow rounded-lg p-5 flex items-center justify-between">
  <div>
    <h4 class="text-lg font-semibold text-gray-500"><%= title %></h4>
    <p class="text-3xl font-bold text-gray-900 mt-1"><%= value %></p>
    <p class="text-sm text-gray-500 mt-2"><%= description %></p>
  </div>
  <div class="text-5xl <%= local_assigns[:color] || 'text-indigo-500' %>">
    <%= icon.html_safe %>
  </div>
</div>