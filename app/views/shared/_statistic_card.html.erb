<div class="bg-white dark:bg-slate-900 shadow-sm border border-slate-200 dark:border-slate-800 rounded-2xl p-5 flex items-center justify-between">
  <div>
    <h4 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider"><%= title %></h4>
    <p class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white mt-1 tracking-tight"><%= value %></p>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1"><%= description %></p>
  </div>
  <div class="w-12 h-12 rounded-xl bg-slate-50 dark:bg-slate-800/80 flex items-center justify-center text-xl <%= local_assigns[:color] || 'text-indigo-600 dark:text-indigo-400' %> shadow-sm flex-shrink-0">
    <%= icon.html_safe %>
  </div>
</div>