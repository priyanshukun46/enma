<%
  # Determine current module context based on request path and controller
  path = request.path
  
  if path.start_with?('/map')
    menu_name = "Operational Engine"
    tab_title = "Intelligence Map"
    badge_text = "LIVE SATELLITE AIS"
    badge_icon = "fas fa-satellite-dish"
    headline = "Discover global fleet & corridor intelligence"
    description = "Live satellite AIS telemetry, maritime corridors, and automated transshipment routing built to protect your global supply chain."
    section_title = "Easy, real-time corridor & fleet intelligence"
    section_subtitle = "Monitor real-time vessel waypoints, canal chokepoints, and weather-diverted trade routes across international waters."
  elsif path.start_with?('/dashboard')
    menu_name = "Operational Engine"
    tab_title = "Dashboard"
    badge_text = "LIVE OPERATIONAL TELEMETRY"
    badge_icon = "fas fa-gauge-high"
    headline = "Real-time logistics command & corridor intelligence"
    description = "Unified freight telemetry, multi-tier disruption alerts, and emergency reroute orchestration across national lifelines."
    section_title = "Operational Engine & Real-Time Logistics Control"
    section_subtitle = "Continuous asset tracking, active incident triage, and warehouse inventory staging."
  elsif path.start_with?('/accessibility')
    menu_name = "Operational Engine"
    tab_title = "Predictive Risks"
    badge_text = "AI DISRUPTION RADAR"
    badge_icon = "fas fa-triangle-exclamation"
    headline = "Predictive accessibility & corridor risk intelligence"
    description = "Early warning machine learning models predicting route bottlenecks, monsoon landslides, and washouts up to 72 hours in advance."
    section_title = "Corridor Accessibility & Vulnerability Index"
    section_subtitle = "Dynamic route risk scoring, weather impact diagnostics, and terrain vulnerability heatmaps."
  elsif path.start_with?('/network')
    menu_name = "Operational Engine"
    tab_title = "Network Graph"
    badge_text = "TOPOLOGICAL GRAPH INTELLIGENCE"
    badge_icon = "fas fa-project-diagram"
    headline = "Resilient corridor connectivity & critical nodes"
    description = "Graph-based connectivity modeling identifying single points of failure, isolated transit hubs, and alternative bridge links."
    section_title = "Topological Network Architecture & Hub Connectivity"
    section_subtitle = "Interactive network graph analyzing corridor density, centrality scores, and isolated cluster dependencies."
  elsif path.start_with?('/intelligence/predictions')
    menu_name = "Operational Engine"
    tab_title = "Cascade Predictions"
    badge_text = "PREDICTIVE CASCADE ENGINE"
    badge_icon = "fas fa-wave-square"
    headline = "Multi-modal disruption cascades & risk waves"
    description = "Simulate ripple effects across supply chains when arterial highway bridges or rail crossings face acute disruptions."
    section_title = "Cascading Impact Simulation & Propagation Radar"
    section_subtitle = "Multi-tier disruption modeling assessing knock-on inventory delays and economic exposure."
  elsif path.start_with?('/intelligence/response')
    menu_name = "Operational Engine"
    tab_title = "Autonomous Response"
    badge_text = "AUTONOMOUS STAGING OPTIMIZER"
    badge_icon = "fas fa-robot"
    headline = "Closed-loop decision & resource pre-staging"
    description = "Algorithmic inventory dispatch recommendations and automated convoy rerouting triggers."
    section_title = "Autonomous Tactical Response & Resource Optimization"
    section_subtitle = "Automated replenishment workflows and multi-depot emergency fulfillment coordination."
  elsif path.start_with?('/intelligence/command')
    menu_name = "Operational Engine"
    tab_title = "Unified Command"
    badge_text = "UNIFIED MISSION COMMAND"
    badge_icon = "fas fa-shield-halved"
    headline = "Unified multi-agency logistics control cockpit"
    description = "Coordinated command center with live convoy monitoring, driver comms, and direct asset reallocation."
    section_title = "Mission Command Center & Live Dispatch"
    section_subtitle = "Centralized operational overview coordinating state agencies, transport fleets, and relief depots."
  elsif path.start_with?('/routes')
    menu_name = "Operational Engine"
    tab_title = "Smart Routes"
    badge_text = "TRIPLE-BUFFERED OPTIMIZER"
    badge_icon = "fas fa-route"
    headline = "Dynamic multi-modal route optimization engine"
    description = "Instant in-memory topological detour computation avoiding active road hazards and extreme elevation gradients."
    section_title = "Smart Corridor Routing & Automated Detours"
    section_subtitle = "Multi-criteria shortest path routing optimized for cargo tonnage, road clearance, and weather risk."
  elsif path.start_with?('/shipments') || path.start_with?('/vehicles')
    menu_name = "Operational Engine"
    tab_title = "Live Fleet Telemetry"
    badge_text = "AIS & SATCOM GPS TRACKING"
    badge_icon = "fas fa-truck-fast"
    headline = "Global fleet tracking & real-time telemetry"
    description = "Active GPS telemetry across ocean vessels, cargo aircraft, intermodal rail lines, and regional road fleets."
    section_title = "Fleet Telematics & Live Movement Radar"
    section_subtitle = "Continuous vehicle location telemetry, fuel diagnostics, ETA projections, and driver safety alerts."
  elsif path.start_with?('/emergencies')
    menu_name = "Tactical Response"
    tab_title = "Emergency Center"
    badge_text = "CRISIS RESPONSE DISPATCH"
    badge_icon = "fas fa-kit-medical"
    headline = "Tactical emergency center & rapid cargo diversion"
    description = "Emergency dispatch coordination, medical/food relief mobilization, and high-priority transit channel activation."
    section_title = "Active Emergency Triage & Relief Logistics"
    section_subtitle = "Real-time incident response management, relief convoy dispatch, and casualty transit corridors."
  elsif path.start_with?('/incidents')
    menu_name = "Tactical Response"
    tab_title = "Field Incidents"
    badge_text = "CITIZEN & SENSOR RADAR"
    badge_icon = "fas fa-camera"
    headline = "Field incident reports & geo-tagged photo dispatch"
    description = "Verified on-ground situational reports submitted by truck operators, citizens, and automated highway sensors."
    section_title = "Field Incident Intelligence & Ground Verification"
    section_subtitle = "Geo-tagged photo submissions, roadblock verification, and crowdsourced hazard reporting."
  elsif path.start_with?('/warehouses')
    menu_name = "Tactical Response"
    tab_title = "Relief Depots"
    badge_text = "STRATEGIC DEPOT READINESS"
    badge_icon = "fas fa-warehouse"
    headline = "Relief depots & pre-staged stock intelligence"
    description = "Monitor warehouse capacity, pre-staged humanitarian and medical inventory, and emergency fulfillment readiness."
    section_title = "Strategic Relief Depots & Supply Reserves"
    section_subtitle = "Warehouse capacity tracking, inventory shelf-life monitoring, and rapid staging protocols."
  elsif path.start_with?('/logistics_alerts')
    menu_name = "Tactical Response"
    tab_title = "Corridor Disruption Alerts"
    badge_text = "CORRIDOR ALERT STREAM"
    badge_icon = "fas fa-bell"
    headline = "Corridor disruption alerts & active bottleneck notices"
    description = "Real-time operational alerts regarding bridge closures, flash floods, landslides, and customs bottlenecks."
    section_title = "Active Supply Chain Alerts & Notices"
    section_subtitle = "Critical route warning stream, disruption notifications, and operational advisories."
  elsif path.start_with?('/analytics')
    menu_name = "Insights and Simulations"
    tab_title = "Analytics"
    badge_text = "HISTORICAL PERFORMANCE"
    badge_icon = "fas fa-chart-pie"
    headline = "Historical supply chain analytics & reliability metrics"
    description = "Comprehensive transit analytics, bottleneck latency distributions, and corridor resilience benchmarks."
    section_title = "Comprehensive Performance Analytics & Corridor KPIs"
    section_subtitle = "Historical transit metrics, seasonal bottleneck trends, and fleet utilization reports."
  elsif path.start_with?('/demo')
    menu_name = "Insights and Simulations"
    tab_title = "Demo Scenario"
    badge_text = "INTERACTIVE SIMULATOR"
    badge_icon = "fas fa-bolt"
    headline = "Smart India Hackathon 2026 interactive scenario simulator"
    description = "Simulate major natural disruptions in real time: trigger landslides, compute autonomous reroutes, and deploy relief convoys."
    section_title = "Interactive Disruption Simulation Sandbox"
    section_subtitle = "Step-by-step interactive demonstration of ResQWay's autonomous decision and rerouting loop."
  elsif path.start_with?('/architecture')
    menu_name = "Insights and Simulations"
    tab_title = "System Architecture"
    badge_text = "ENGINEERING BLUEPRINT"
    badge_icon = "fas fa-microchip"
    headline = "ResQWay multi-layer resilient system architecture"
    description = "In-memory graph processing, offline peer-to-peer sync, machine learning inference pipeline, and CartoDB GIS layers."
    section_title = "System Architecture & Engineering Specifications"
    section_subtitle = "Technical blueprints, streaming pipelines, offline failover protocols, and data models."
  elsif path.start_with?('/overview')
    menu_name = "Insights and Simulations"
    tab_title = "SIH Overview"
    badge_text = "SIH 2026 READY"
    badge_icon = "fas fa-award"
    headline = "Smart India Hackathon 2026 operational overview"
    description = "Problem statement PS-1678 resolution: Building disaster-resilient supply chains for the North Eastern Region of India."
    section_title = "Project Overview & SIH 2026 Alignment"
    section_subtitle = "Key innovations, regional impact metrics, and alignment with national logistics infrastructure."
  else
    menu_name = "Operational Engine"
    tab_title = controller_name.humanize.titleize
    badge_text = "RESQWAY INTELLIGENCE"
    badge_icon = "fas fa-shield-halved"
    headline = "#{tab_title} Module"
    description = "Real-time logistics resilience, proactive risk mitigation, and automated supply chain routing."
    section_title = "Active Logistics Management"
    section_subtitle = "Manage operational parameters, view real-time diagnostics, and configure automated workflows."
  end
%>

<!-- ====================================================================== -->
<!-- 1. SUB-HEADER BREADCRUMB BAR                                           -->
<!-- ====================================================================== -->
<div class="bg-white border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-11 text-xs font-semibold text-slate-600">
      
      <!-- Breadcrumbs: ⌂ Home > [Module Name] -->
      <div class="flex items-center space-x-2">
        <%= link_to root_path, class: "hover:text-[#FF471D] transition-colors flex items-center space-x-1.5 text-slate-700" do %>
          <i class="fas fa-house text-xs text-slate-400"></i>
          <span>Home</span>
        <% end %>
        <span class="text-slate-300 font-normal">&gt;</span>
        <span class="text-[#212121] font-bold"><%= tab_title %></span>
      </div>

      <!-- Return Button -->
      <%= link_to root_path, class: "inline-flex items-center space-x-1.5 px-3 py-1 rounded-md text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-[#EAEEF0] hover:text-[#212121] border border-slate-200 transition-colors" do %>
        <i class="fas fa-arrow-left text-[10px] text-slate-500"></i>
        <span>Return to ResQWay Home</span>
      <% end %>

    </div>
  </div>
</div>

<!-- ====================================================================== -->
<!-- 2. HERO ESSENCE BANNER (#102E39) WITH TELEMATICS MOCKUP                -->
<!-- ====================================================================== -->
<section class="bg-[#102E39] text-white py-12 sm:py-14 lg:py-16 relative overflow-hidden border-b border-[#0a1e26]">
  <!-- Decorative subtle background glow -->
  <div class="absolute -right-24 -top-24 w-96 h-96 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>
  <div class="absolute left-1/3 -bottom-24 w-80 h-80 rounded-full bg-[#FF471D]/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Contextual Badge, Headline, Subtext -->
      <div class="lg:col-span-7 space-y-4 text-left">
        
        <!-- Live Badge Pill -->
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-black/40 border border-white/10 backdrop-blur-sm text-[11px] font-mono font-bold tracking-wider text-white">
          <span class="w-2 h-2 rounded-full bg-[#FF471D] animate-pulse"></span>
          <i class="<%= badge_icon %> text-xs text-[#FF471D]"></i>
          <span class="uppercase"><%= badge_text %></span>
        </div>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
          <%= headline %>
        </h1>

        <!-- Subtext -->
        <p class="text-sm sm:text-base text-slate-300 font-normal leading-relaxed max-w-2xl">
          <%= description %>
        </p>

      </div>

      <!-- Right Column: Telematics Device Mockup & Mobile Companion (Attached Image 1) -->
      <div class="lg:col-span-5 flex items-center justify-center lg:justify-end relative">
        <div class="relative w-full max-w-[420px]">
          
          <!-- Tablet Telematics Console Frame -->
          <div class="bg-[#151c24] rounded-2xl p-4 shadow-2xl border border-slate-700/80 relative z-10">
            
            <!-- Browser/OS Header Bar -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-800/80 mb-3">
              <div class="flex items-center space-x-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
              </div>
              <span class="text-[11px] font-mono text-slate-400">telematics.resqway.com</span>
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            </div>

            <!-- Telematics Dashboard Cards Row -->
            <div class="grid grid-cols-3 gap-2 text-center font-mono my-3">
              
              <!-- Card 1: Status -->
              <div class="bg-[#1b2633] p-2.5 rounded-xl border border-slate-700/60">
                <span class="text-[9px] text-slate-400 block uppercase tracking-wider mb-1">Status</span>
                <span class="text-xs font-black text-emerald-400 flex items-center justify-center space-x-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span>Nominal</span>
                </span>
              </div>

              <!-- Card 2: AIS Fleets -->
              <div class="bg-[#1b2633] p-2.5 rounded-xl border border-slate-700/60">
                <span class="text-[9px] text-slate-400 block uppercase tracking-wider mb-1">AIS Fleets</span>
                <span class="text-xs font-black text-white">48 Active</span>
              </div>

              <!-- Card 3: ETA Accuracy -->
              <div class="bg-[#1b2633] p-2.5 rounded-xl border border-slate-700/60">
                <span class="text-[9px] text-slate-400 block uppercase tracking-wider mb-1">ETA Accuracy</span>
                <span class="text-xs font-black text-[#FF471D]">99.8%</span>
              </div>

            </div>

            <!-- Console Footer Status -->
            <div class="flex items-center justify-between pt-2 border-t border-slate-800/80 text-[10px] font-mono text-slate-400 px-1">
              <span>SATCOM128-BIT VERIFIED</span>
              <span class="text-[#FF471D] font-bold">PACIFIC CORRIDOR</span>
            </div>

          </div>

          <!-- Smartphone Companion Preview (Overlapping as shown in Attached Image 1) -->
          <div class="absolute -bottom-5 -right-3 sm:-right-6 w-32 sm:w-36 bg-[#0f141a] rounded-2xl p-2 border-2 border-slate-700 shadow-2xl z-20 hidden xs:block">
            <div class="w-full bg-gradient-to-b from-[#2a3b4c] via-[#FF471D]/40 to-[#FF471D] rounded-xl p-2 text-center text-white space-y-1">
              <span class="text-[9px] font-black uppercase tracking-wider block">ResQWay Track</span>
              <div class="h-10 flex items-center justify-center">
                <i class="fas fa-location-crosshairs text-lg animate-pulse text-white"></i>
              </div>
              <span class="text-[8px] font-mono bg-black/60 px-1.5 py-0.5 rounded text-white block truncate">WFC-89241-US</span>
            </div>
            <div class="w-6 h-1 bg-slate-700 rounded-full mx-auto mt-2"></div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- ====================================================================== -->
<!-- 3. SECTION INTRODUCTION HEADING (ON #EAEEF0 CANVAS)                    -->
<!-- ====================================================================== -->
<div class="bg-[#EAEEF0] pt-10 pb-4 text-center">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl sm:text-3xl font-black text-[#212121] tracking-tight">
      <%= section_title %>
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 font-medium mt-1.5 max-w-2xl mx-auto">
      <%= section_subtitle %>
    </p>
  </div>
</div>
